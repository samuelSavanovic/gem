  tcp_write: "gem_tcp_write_fn",
  tcp_close: "gem_tcp_close_fn",
  epoch_ms: "gem_epoch_ms_fn",
  format_time: "gem_format_time_fn",
  format_time_local: "gem_format_time_local_fn",
  sqlite_open: "gem_sqlite_open_fn",
  sqlite_close: "gem_sqlite_close_fn",
  sqlite_exec: "gem_sqlite_exec_fn",
  sqlite_query: "gem_sqlite_query_fn",
  sqlite_last_insert_id: "gem_sqlite_last_insert_id_fn",
  sqlite_changes: "gem_sqlite_changes_fn",
  __len: "gem_len_fn",
  __type: "gem_type_fn",
  __has_key: "gem_has_key_fn",
  __is_array_n: "gem_is_array_n_fn",
  __for_len: "gem_for_len_fn",
  __for_items: "gem_for_items_fn",
  __table_key_at: "gem_table_key_at_fn",
  __table_val_at: "gem_table_val_at_fn"
}

# Builtins a leaf function may call (codegen.gem, "Leaf-function
# detection"): each runs only C, never a Gem function or closure, and
# never yields to the scheduler, so the leaf calling it stays the innermost
# Gem frame while it runs. One may raise: the error report shows the leaf
# on top, as for an arithmetic error in its body.
let LEAF_BUILTINS = {
  print: true, eprint: true, error: true, len: true, type: true,
  to_string: true, push: true, keys: true, values: true, str_replace: true,
  has_key: true, substr: true, find: true, chr: true, ord: true,
  to_int: true, to_float: true, buf_new: true, buf_push: true,
  delete: true, pop: true, insert: true, remove_at: true,
  floor: true, ceil: true, round: true, abs: true, pow: true, sqrt: true,
  random: true, band: true, bor: true, bxor: true, bnot: true, bshl: true,
  bshr: true, self: true, make_ref: true, time_ms: true, epoch_ms: true,
  __len: true, __type: true, __has_key: true, __is_array_n: true,
  __for_len: true, __for_items: true, __table_key_at: true, __table_val_at: true
}

# Builtins with a direct C entry point for one arity: "<name>/<argc>" →
# an inline function in runtime/gem.h taking the arguments as C
# parameters (no argument array, no argc check). Each one handles the
# argument types it is mostly called with inline (`len`: strings and
# tables; `ord`: strings; `type`: all; the `for` helpers: tables) and
# passes anything else to the builtin's `(env, args, argc)` function, so
# behaviour and errors are the builtin's.
let DIRECT_BUILTINS = {
  "len/1": "gem_len_1",
  "__len/1": "gem_len_1",
  "type/1": "gem_type_1",
  "__type/1": "gem_type_1",
  "ord/1": "gem_ord_1",
  "ord/2": "gem_ord_2",
  "__for_len/1": "gem_for_len_1",
  "__for_items/1": "gem_for_items_1",
  "__table_key_at/2": "gem_table_key_at_2",
  "__table_val_at/2": "gem_table_val_at_2"
}

# User-visible builtin names, sorted lexicographically. The double-underscore
# entries (`__table_key_at`, `__type`, ...) are compiler-internal: lower()
# emits most of them in desugared for-loops and match patterns, so a user binding
# named `len`, `type` or `has_key` can't capture those calls. Source may
# only call them (compiler/lexer.gem, `check_reserved_names`). They're
# filtered out so completion doesn't offer them.
fn user_builtin_names()
  let out = []
  for k, _ in BUILTIN_FNS
    if not (len(k) >= 2 and substr(k, 0, 2) == "__")
      push(out, k)
    end
  end
  sort(out)
  out
end

let BUILTIN_NAMES = user_builtin_names()

export BUILTIN_FNS, BUILTIN_NAMES, LEAF_BUILTINS, DIRECT_BUILTINS
