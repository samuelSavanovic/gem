# Free variables, captures and closure writes: what a closure captures and which locals need a pinned box.
# `is_global(name)` comes from codegen: true for a named fn or an unshadowed builtin.

load "./cgutil" (set_add, set_contains, is_node, each_child, any_child, walk_scoped, walk_scoped_fn)

fn ignore(name, bound)
  nil
end

fn free_visitor(free, is_global)
  let note = fn(name, bound)
    if bound[name] != true and not is_global(name)
      free[name] = true
    end
  end
  {read: note, write: note, closure: fn(node, bound) true end}
end

# names a fn literal reads or assigns that neither it nor `defined` binds, minus globals
fn closure_free_vars(node, defined, is_global)
  let free = {}
  walk_scoped_fn(node, defined, free_visitor(free, is_global))
  free
end

# names a closure in `stmts` reads or assigns that are bound where it sits (scope_vars, or a let, arm binding or
# param before it); a closure passed straight to pcall (non_escaping) doesn't count
fn find_captured_in_scope(stmts, scope_vars, is_global)
  let captured = {}
  walk_scoped(stmts, scope_vars, {read: ignore, write: ignore, closure: fn(node, bound)
    if node.non_escaping != true
      for name, _ in closure_free_vars(node, {}, is_global)
        if bound[name] == true
          captured[name] = true
        end
      end
    end
    false
  end})
  captured
end

# Which scope_vars get reassigned (`name = value`) where a closure can see it. Those a closure captures need a
# pinned box shared by creator and closure, the rest get a write-once copy (a non_escaping closure's env points
# at the creator's C locals instead); `x.f = ` and `x[k] = ` don't count.
# Outside closures every assign counts; inside, a name the closure binds itself doesn't.

fn closure_writes_visitor(scope_vars, writes)
  {read: ignore, closure: fn(node, bound) true end, write: fn(name, bound)
    if scope_vars[name] == true and bound[name] != true
      writes[name] = true
    end
  end}
end

fn find_capture_writes_in_scope(stmts, scope_vars)
  let writes = {}
  let inner = closure_writes_visitor(scope_vars, writes)
  walk_scoped(stmts, {}, {read: ignore, write: fn(name, bound)
    if scope_vars[name] == true
      writes[name] = true
    end
  end, closure: fn(node, bound)
    walk_scoped_fn(node, {}, inner)
    false
  end})
  writes
end

# captures a closure body (or one nested in it) assigns; `defined` (its own params and lets) don't count
fn find_writes_in_closure_body(body, captures_set, defined)
  let writes = {}
  walk_scoped(body, defined, closure_writes_visitor(captures_set, writes))
  writes
end

# A closure passed straight to `pcall` runs and is dropped before its creator returns, so its captures need
# no boxing; only closures with no nested fn literal (which could escape) qualify. Not `sort`: it resets after
# comparator calls, and that reset can't see captures a comparator assigns in its creator's C locals.

let non_escape_callees = {}
set_add(non_escape_callees, "pcall")

fn contains_anon_fn(node)
  if type(node) != "table"
    return false
  end
  if node.tag == "anon_fn"
    return true
  end
  any_child(node, contains_anon_fn)
end

# is `name` bound anywhere under node (let, param, loop var, pattern)? then a call to it may not be the builtin
fn binds_name(node, name)
  if type(node) != "table"
    return false
  end
  if node.tag == "let" and node.name == name
    return true
  end
  if node.tag == "fn_def" or node.tag == "anon_fn"
    if node.rest_param == name
      return true
    end
    if node.params != nil
      for p in node.params
        if p == name
          return true
        end
      end
    end
  end
  any_child(node, fn(c) binds_name(c, name) end)
end

fn mark_non_escaping(node, shadowed)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end

  if node.tag == "call" and node.func != nil and is_node(node.func, "var") and set_contains(non_escape_callees, node.func.name) and not set_contains(shadowed, node.func.name)
    if node.args != nil
      for a in node.args
        if is_node(a, "anon_fn") and not contains_anon_fn(a.body) and not contains_anon_fn(a.defaults)
          a.non_escaping = true
        end
      end
    end
  end

  each_child(node, fn(c) mark_non_escaping(c, shadowed) end)
end

# `scope`: the fn_def or top-level statement list; binding `pcall` anywhere in it turns marking off for all of it
fn mark_non_escaping_stmts(stmts, scope)
  let shadowed = {}
  for callee, _ in non_escape_callees
    if binds_name(scope, callee)
      set_add(shadowed, callee)
    end
  end
  for s in stmts
    mark_non_escaping(s, shadowed)
  end
end

export closure_free_vars, find_captured_in_scope, find_capture_writes_in_scope, find_writes_in_closure_body, mark_non_escaping_stmts
