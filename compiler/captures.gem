# Free-variable, capture and closure-write analysis, plus the non-escaping
# closure marking that lets a `pcall` / `sort` closure skip boxing. Codegen
# uses these to decide what a closure captures and which locals need a
# pinned box (see compile_anon_fn / compile_fn in codegen.gem).
#
# `is_global(name)` tells the free-variable walk which names are not
# captures because they resolve to a named fn or a builtin the current
# scope doesn't shadow; codegen supplies it.

load "./cgutil" (set_add, set_contains, set_union, set_intersect, sorted_array_to_set, is_node)
load "./scope" (collect_block_lets)

# ─── Free variable analysis ──

fn collect_free_node(node, defined, free, is_global)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end

  match node
  when {tag: "var", name: name}
    if not set_contains(defined, name) and not is_global(name)
      set_add(free, name)
    end
  when {tag: "let", value: value}
    collect_free_node(value, defined, free, is_global)
  when {tag: "assign", name: name, value: value}
    if not set_contains(defined, name) and not is_global(name)
      set_add(free, name)
    end
    collect_free_node(value, defined, free, is_global)
  when {tag: "anon_fn", params: params, rest_param: rest_param, body: body}
    let inner_defined = set_union(defined, sorted_array_to_set(params))
    if rest_param != nil
      set_add(inner_defined, rest_param)
    end
    let inner_free = collect_free_vars(body, inner_defined, is_global)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          collect_free_node(d, inner_defined, inner_free, is_global)
        end
      end
    end
    for ifk, _ in inner_free
      set_add(free, ifk)
    end
  when {tag: "fn_def"}
    # Named functions are global — skip
  when {tag: "if", cond: cond, then: thens, else: el}
    collect_free_node(cond, defined, free, is_global)
    let d = set_union(defined, {})
    for i = 0, len(thens)
      collect_free_node(thens[i], d, free, is_global)
      if is_node(thens[i], "let")
        set_add(d, thens[i].name)
      end
    end
    if el != nil
      d = set_union(defined, {})
      for i = 0, len(el)
        collect_free_node(el[i], d, free, is_global)
        if is_node(el[i], "let")
          set_add(d, el[i].name)
        end
      end
    end
  when {tag: "while", cond: cond, body: body}
    collect_free_node(cond, defined, free, is_global)
    let d = set_union(defined, {})
    for i = 0, len(body)
      collect_free_node(body[i], d, free, is_global)
      if is_node(body[i], "let")
        set_add(d, body[i].name)
      end
    end
  when {tag: "match", target: target, target_var: target_var, whens: whens, else: el}
    collect_free_node(target, defined, free, is_global)
    let match_def = set_union(defined, {})
    if target_var != nil
      set_add(match_def, target_var)
    end
    for i = 0, len(whens)
      let w = whens[i]
      collect_free_node(w.value, match_def, free, is_global)
      let d = set_union(match_def, {})
      if w.bindings != nil
        for bi = 0, len(w.bindings)
          collect_free_node(w.bindings[bi], d, free, is_global)
          if is_node(w.bindings[bi], "let")
            set_add(d, w.bindings[bi].name)
          end
        end
      end
      for j = 0, len(w.body)
        collect_free_node(w.body[j], d, free, is_global)
        if is_node(w.body[j], "let")
          set_add(d, w.body[j].name)
        end
      end
    end
    if el != nil
      let d = set_union(defined, {})
      for j = 0, len(el)
        collect_free_node(el[j], d, free, is_global)
        if is_node(el[j], "let")
          set_add(d, el[j].name)
        end
      end
    end
  when {tag: "when_clause", value: value, bindings: bindings, body: body}
    collect_free_node(value, defined, free, is_global)
    let d = set_union(defined, {})
    if bindings != nil
      for bi = 0, len(bindings)
        collect_free_node(bindings[bi], d, free, is_global)
        if is_node(bindings[bi], "let")
          set_add(d, bindings[bi].name)
        end
      end
    end
    for i = 0, len(body)
      collect_free_node(body[i], d, free, is_global)
      if is_node(body[i], "let")
        set_add(d, body[i].name)
      end
    end
  when {tag: "receive_match", arms: rm_arms, after_ms: rm_after_ms, after_body: rm_after_body}
    let recv_def = set_union(defined, {})
    if node.recv_var != nil
      set_add(recv_def, node.recv_var)
    end
    for i = 0, len(rm_arms)
      let arm = rm_arms[i]
      collect_free_node(arm.pattern.condition, recv_def, free, is_global)
      let d = set_union(recv_def, {})
      if arm.pattern.bindings != nil
        for bi = 0, len(arm.pattern.bindings)
          collect_free_node(arm.pattern.bindings[bi], d, free, is_global)
          if is_node(arm.pattern.bindings[bi], "let")
            set_add(d, arm.pattern.bindings[bi].name)
          end
        end
      end
      for j = 0, len(arm.body)
        collect_free_node(arm.body[j], d, free, is_global)
        if is_node(arm.body[j], "let")
          set_add(d, arm.body[j].name)
        end
      end
    end
    if rm_after_ms != nil
      collect_free_node(rm_after_ms, recv_def, free, is_global)
    end
    if rm_after_body != nil
      let d = set_union(recv_def, {})
      for j = 0, len(rm_after_body)
        collect_free_node(rm_after_body[j], d, free, is_global)
        if is_node(rm_after_body[j], "let")
          set_add(d, rm_after_body[j].name)
        end
      end
    end
  when {tag: "table", entries: entries}
    for i = 0, len(entries)
      collect_free_node(entries[i].value, defined, free, is_global)
    end
  when {tag: "array", elements: elements}
    for i = 0, len(elements)
      collect_free_node(elements[i], defined, free, is_global)
    end
  when {tag: "block", stmts: stmts}
    let d = set_union(defined, {})
    for i = 0, len(stmts)
      collect_free_node(stmts[i], d, free, is_global)
      if is_node(stmts[i], "let")
        set_add(d, stmts[i].name)
      end
    end
  when {tag: "return", value: value}
    if value != nil
      collect_free_node(value, defined, free, is_global)
    end
  else
    # Generic recursion for binop, unop, call, dot, index, etc.
    for nk, v in node
      if nk != "tag"
        if type(v) == "table"
          let vks = keys(v)
          if len(vks) > 0 and type(vks[0]) == "int"
            let vi = 0
            while vi < len(v)
              if type(v[vi]) == "table"
                collect_free_node(v[vi], defined, free, is_global)
              end
              vi += 1
            end
          else
            collect_free_node(v, defined, free, is_global)
          end
        end
      end
    end
  end
end

fn collect_free_vars(stmts, defined, is_global)
  let free = {}
  let d = set_union(defined, {})
  for i = 0, len(stmts)
    collect_free_node(stmts[i], d, free, is_global)
    if is_node(stmts[i], "let")
      set_add(d, stmts[i].name)
    end
    collect_block_lets(stmts[i], d)
  end
  free
end

# ─── Capture analysis ──

fn walk_captures_node(node, scope_vars, captured, is_global)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end

  match node
  when {tag: "anon_fn", params: params, rest_param: rest_param, body: body}
    if node.non_escaping == true
      # Marked as immediate-call arg of an allowlisted callee (pcall/sort)
      # with no nested anon_fns. References to outer scope_vars don't
      # force boxing in the enclosing frame.
      return nil
    end
    let inner_defined = sorted_array_to_set(params)
    if rest_param != nil
      set_add(inner_defined, rest_param)
    end
    let free = collect_free_vars(body, inner_defined, is_global)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          collect_free_node(d, inner_defined, free, is_global)
        end
      end
    end
    let inter = set_intersect(free, scope_vars)
    for ik, _ in inter
      set_add(captured, ik)
    end
  when {tag: "fn_def"}
    # Named fns are global — skip
  when {tag: "if", cond: cond, then: thens, else: el}
    walk_captures_node(cond, scope_vars, captured, is_global)
    walk_captures(thens, scope_vars, captured, is_global)
    if el != nil
      walk_captures(el, scope_vars, captured, is_global)
    end
  when {tag: "while", cond: cond, body: body}
    walk_captures_node(cond, scope_vars, captured, is_global)
    walk_captures(body, scope_vars, captured, is_global)
  when {tag: "match", target: target, whens: whens, else: el}
    walk_captures_node(target, scope_vars, captured, is_global)
    for i = 0, len(whens)
      walk_captures_node(whens[i].value, scope_vars, captured, is_global)
      if whens[i].bindings != nil
        for bi = 0, len(whens[i].bindings)
          walk_captures_node(whens[i].bindings[bi], scope_vars, captured, is_global)
        end
      end
      walk_captures(whens[i].body, scope_vars, captured, is_global)
    end
    if el != nil
      walk_captures(el, scope_vars, captured, is_global)
    end
  when {tag: "receive_match", arms: rm_arms, after_ms: rm_after_ms, after_body: rm_after_body}
    for i = 0, len(rm_arms)
      walk_captures_node(rm_arms[i].pattern.condition, scope_vars, captured, is_global)
      if rm_arms[i].pattern.bindings != nil
        for bi = 0, len(rm_arms[i].pattern.bindings)
          walk_captures_node(rm_arms[i].pattern.bindings[bi], scope_vars, captured, is_global)
        end
      end
      walk_captures(rm_arms[i].body, scope_vars, captured, is_global)
    end
    if rm_after_ms != nil
      walk_captures_node(rm_after_ms, scope_vars, captured, is_global)
    end
    if rm_after_body != nil
      walk_captures(rm_after_body, scope_vars, captured, is_global)
    end
  when {tag: "table", entries: entries}
    for i = 0, len(entries)
      walk_captures_node(entries[i].value, scope_vars, captured, is_global)
    end
  when {tag: "array", elements: elements}
    for i = 0, len(elements)
      walk_captures_node(elements[i], scope_vars, captured, is_global)
    end
  when {tag: "block", stmts: stmts}
    walk_captures(stmts, scope_vars, captured, is_global)
  when {tag: "return", value: value}
    if value != nil
      walk_captures_node(value, scope_vars, captured, is_global)
    end
  when {tag: "let", value: value}
    walk_captures_node(value, scope_vars, captured, is_global)
  when {tag: "assign", value: value}
    walk_captures_node(value, scope_vars, captured, is_global)
  else
    # Generic recursion
    for nk, v in node
      if nk != "tag"
        if type(v) == "table"
          let vks = keys(v)
          if len(vks) > 0 and type(vks[0]) == "int"
            let vi = 0
            while vi < len(v)
              if type(v[vi]) == "table"
                walk_captures_node(v[vi], scope_vars, captured, is_global)
              end
              vi += 1
            end
          else
            walk_captures_node(v, scope_vars, captured, is_global)
          end
        end
      end
    end
  end
end

fn walk_captures(stmts, scope_vars, captured, is_global)
  let sv = set_union(scope_vars, {})
  for i = 0, len(stmts)
    walk_captures_node(stmts[i], sv, captured, is_global)
    if is_node(stmts[i], "let")
      set_add(sv, stmts[i].name)
    end
    collect_block_lets(stmts[i], sv)
  end
end

fn find_captured_in_scope(body, scope_vars, is_global)
  let captured = {}
  walk_captures(body, scope_vars, captured, is_global)
  captured
end

# ─── Mutation classification for captures ──
#
# For a body and its scope_vars, return the subset of scope_vars that any
# escaping anon_fn within body (or any anon_fn nested within those) writes
# to via a bare `name = value` assign. Captures not in this set are
# read-only-from-the-outer's-perspective and qualify for Route A: the env
# stores a `GemVal` snapshot rather than a `GemVal *`, and the outer frame
# need not box them.
#
# The same walker also handles the per-closure perspective: passing
# inside_anon=true treats the body itself as already inside a closure, so
# direct assigns to scope_vars at the body level (not inside a further
# nested anon_fn) also count. Used by compile_closure_fn to classify which
# of its incoming env captures it itself mutates.
#
# `dot_assign` / `index_assign` mutate the value, not the binding, so they
# do not count. `let` introduces a fresh local that shadows the outer name
# for subsequent statements in scope.

fn walk_writes_node(node, scope_vars, defined, writes, inside_anon)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end

  match node
  when {tag: "assign", name: name, value: value}
    # A captured name needs boxing whenever it is reassigned anywhere in
    # its lexical scope — whether the assign is inside a nested closure
    # (closure mutates outer's binding) or outside (later closures must
    # see the new value via the shared box, matching established
    # closure-rebind-after-capture semantics).
    if set_contains(scope_vars, name) and not set_contains(defined, name)
      set_add(writes, name)
    end
    walk_writes_node(value, scope_vars, defined, writes, inside_anon)
  when {tag: "let", value: value}
    walk_writes_node(value, scope_vars, defined, writes, inside_anon)
  when {tag: "anon_fn", params: params, rest_param: rest_param, body: body}
    if node.non_escaping == true and not inside_anon
      # Non-escaping closures use stack-pointer semantics; their writes
      # mutate the outer's local directly without forcing it to be boxed,
      # so they don't contribute to the writes set we use to decide boxing.
      # Inside an escaping closure they do count: there the name is a
      # capture of that closure, and an unmutated capture gets a
      # write-once snapshot box, which the non-escaping closure would
      # then assign (the write would be lost to the creator, and the
      # snapshot box, older than any loop mark, would point into a reset
      # region).
      return nil
    end
    # When transitioning from outside-any-closure into an anon_fn, reset
    # `defined` to just this anon's params: the surrounding scope's lets
    # are the *targets* of mutation analysis, not local shadows. When
    # already inside an anon (anon-in-anon), carry the outer anon's locals
    # forward — those do shadow further-out names from this inner anon's
    # perspective.
    let inner_def = nil
    if inside_anon
      inner_def = set_union(defined, sorted_array_to_set(params))
    else
      inner_def = sorted_array_to_set(params)
    end
    if rest_param != nil
      set_add(inner_def, rest_param)
    end
    walk_writes(body, scope_vars, inner_def, writes, true)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_writes_node(d, scope_vars, inner_def, writes, true)
        end
      end
    end
  when {tag: "fn_def"}
    # Named fns are global — skip
  when {tag: "if", cond: cond, then: thens, else: el}
    walk_writes_node(cond, scope_vars, defined, writes, inside_anon)
    walk_writes(thens, scope_vars, defined, writes, inside_anon)
    if el != nil
      walk_writes(el, scope_vars, defined, writes, inside_anon)
    end
  when {tag: "while", cond: cond, body: body}
    walk_writes_node(cond, scope_vars, defined, writes, inside_anon)
    walk_writes(body, scope_vars, defined, writes, inside_anon)
  when {tag: "match", target: target, target_var: target_var, whens: whens, else: el}
    walk_writes_node(target, scope_vars, defined, writes, inside_anon)
    let match_def = set_union(defined, {})
    if target_var != nil
      set_add(match_def, target_var)
    end
    for i = 0, len(whens)
      let w = whens[i]
      walk_writes_node(w.value, scope_vars, match_def, writes, inside_anon)
      let d = set_union(match_def, {})
      if w.bindings != nil
        for bi = 0, len(w.bindings)
          walk_writes_node(w.bindings[bi], scope_vars, d, writes, inside_anon)
          if is_node(w.bindings[bi], "let")
            set_add(d, w.bindings[bi].name)
          end
        end
      end
      walk_writes(w.body, scope_vars, d, writes, inside_anon)
    end
    if el != nil
      walk_writes(el, scope_vars, defined, writes, inside_anon)
    end
  when {tag: "receive_match", arms: rm_arms, after_ms: rm_after_ms, after_body: rm_after_body}
    let recv_def = set_union(defined, {})
    if node.recv_var != nil
      set_add(recv_def, node.recv_var)
    end
    for i = 0, len(rm_arms)
      let arm = rm_arms[i]
      walk_writes_node(arm.pattern.condition, scope_vars, recv_def, writes, inside_anon)
      let d = set_union(recv_def, {})
      if arm.pattern.bindings != nil
        for bi = 0, len(arm.pattern.bindings)
          walk_writes_node(arm.pattern.bindings[bi], scope_vars, d, writes, inside_anon)
          if is_node(arm.pattern.bindings[bi], "let")
            set_add(d, arm.pattern.bindings[bi].name)
          end
        end
      end
      walk_writes(arm.body, scope_vars, d, writes, inside_anon)
    end
    if rm_after_ms != nil
      walk_writes_node(rm_after_ms, scope_vars, recv_def, writes, inside_anon)
    end
    if rm_after_body != nil
      walk_writes(rm_after_body, scope_vars, recv_def, writes, inside_anon)
    end
  when {tag: "table", entries: entries}
    for i = 0, len(entries)
      walk_writes_node(entries[i].value, scope_vars, defined, writes, inside_anon)
    end
  when {tag: "array", elements: elements}
    for i = 0, len(elements)
      walk_writes_node(elements[i], scope_vars, defined, writes, inside_anon)
    end
  when {tag: "block", stmts: stmts}
    walk_writes(stmts, scope_vars, defined, writes, inside_anon)
  when {tag: "return", value: value}
    if value != nil
      walk_writes_node(value, scope_vars, defined, writes, inside_anon)
    end
  else
    # Generic recursion
    for nk, v in node
      if nk != "tag"
        if type(v) == "table"
          let vks = keys(v)
          if len(vks) > 0 and type(vks[0]) == "int"
            let vi = 0
            while vi < len(v)
              if type(v[vi]) == "table"
                walk_writes_node(v[vi], scope_vars, defined, writes, inside_anon)
              end
              vi += 1
            end
          else
            walk_writes_node(v, scope_vars, defined, writes, inside_anon)
          end
        end
      end
    end
  end
end

fn walk_writes(stmts, scope_vars, defined, writes, inside_anon)
  let sv = set_union(defined, {})
  for i = 0, len(stmts)
    walk_writes_node(stmts[i], scope_vars, sv, writes, inside_anon)
    # Only growing `defined` when walking inside an anon: there, lets are
    # locals that shadow scope_vars (outer captures). At the outer scope
    # itself, lets are *the binding sites* of scope_vars — assigns that
    # follow them target those same bindings and must count as writes.
    if inside_anon
      if is_node(stmts[i], "let")
        set_add(sv, stmts[i].name)
      end
      collect_block_lets(stmts[i], sv)
    end
  end
end

# Outer-fn perspective: which scope_vars are written by any anon_fn within?
fn find_capture_writes_in_scope(body, scope_vars)
  let writes = {}
  walk_writes(body, scope_vars, {}, writes, false)
  writes
end

# Closure-body perspective: which captures does this closure body itself
# (or any anon_fn nested within) write to? `defined` is the closure's own
# local scope (params + body lets) — assigns to those don't count.
fn find_writes_in_closure_body(body, captures_set, defined)
  let writes = {}
  walk_writes(body, captures_set, defined, writes, true)
  writes
end

# ─── Non-escaping closure detection ──
#
# Mark anon_fn nodes that appear as the immediate argument of a call to an
# allowlisted callee (`pcall`, `sort`). Such closures are invoked
# synchronously and discarded — they cannot outlive the C frame holding
# their captures, so the enclosing function need not box those captures.
# Conservative: we only mark closures whose own body contains no nested
# anon_fns, sidestepping the case where a nested escaping closure could
# smuggle outer captures past the synchronous call.

let non_escape_callees = {}
set_add(non_escape_callees, "pcall")
set_add(non_escape_callees, "sort")

fn contains_anon_fn(node)
  if node == nil
    return false
  end
  if type(node) != "table"
    return false
  end
  if node.tag == nil
    return false
  end
  if node.tag == "anon_fn"
    return true
  end
  for nk, v in node
    if nk != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        let vi = 0
        while vi < len(v)
          if type(v[vi]) == "table"
            if contains_anon_fn(v[vi])
              return true
            end
          end
          vi += 1
        end
      else
        if contains_anon_fn(v)
          return true
        end
      end
    end
  end
  false
end

fn body_has_anon_fn(stmts)
  for s in stmts
    if contains_anon_fn(s)
      return true
    end
  end
  false
end

# True when `name` is bound anywhere under `node` (a let — lowered
# for-loop vars and pattern bindings included — or a parameter). A
# call to such a name may reach the user's binding instead of the
# builtin, so mark_non_escaping must not trust it.
fn binds_name(node, name)
  if type(node) != "table"
    return false
  end
  if node.tag == "let" and node.name == name
    return true
  end
  if node.tag == "fn_def" or node.tag == "anon_fn"
    if node.rest_param == name
      return true
    end
    if node.params != nil
      for p in node.params
        if p == name
          return true
        end
      end
    end
  end
  for _, v in node
    if type(v) == "table" and binds_name(v, name)
      return true
    end
  end
  false
end

fn mark_non_escaping(node, shadowed)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end

  if node.tag == "call" and node.func != nil and is_node(node.func, "var") and set_contains(non_escape_callees, node.func.name) and not set_contains(shadowed, node.func.name)
    if node.args != nil
      for a in node.args
        if is_node(a, "anon_fn") and not body_has_anon_fn(a.body)
          a.non_escaping = true
        end
      end
    end
  end

  for nk, v in node
    if nk != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        let vi = 0
        while vi < len(v)
          if type(v[vi]) == "table"
            mark_non_escaping(v[vi], shadowed)
          end
          vi += 1
        end
      else
        mark_non_escaping(v, shadowed)
      end
    end
  end
end

# `scope` is the fn_def (or the top-level statement list) being marked.
# Conservative: a builtin name bound anywhere in it disables the
# allowlist entry for all of it.
fn mark_non_escaping_stmts(stmts, scope)
  # Allowlisted callees a binding in `scope` shadows.
  let shadowed = {}
  for callee, _ in non_escape_callees
    if binds_name(scope, callee)
      set_add(shadowed, callee)
    end
  end
  for s in stmts
    mark_non_escaping(s, shadowed)
  end
end

export collect_free_vars, collect_free_node, walk_captures_node, walk_writes_node, find_captured_in_scope, find_capture_writes_in_scope, find_writes_in_closure_body, mark_non_escaping_stmts
