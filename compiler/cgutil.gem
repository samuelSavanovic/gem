# helpers shared by the compiler passes: AST child walks, C literals, name sets, "did you mean" lookup

fn escape_c_string(s)
  let cr = chr(13)
  let b = buf_new()
  for i = 0, len(s)
    let ch = s[i]
    if ch == "\\"
      buf_push(b, "\\\\")
    elif ch == "\""
      buf_push(b, "\\\"")
    elif ch == "\n"
      buf_push(b, "\\n")
    elif ch == cr
      buf_push(b, "\\r")
    elif ch == "\t"
      buf_push(b, "\\t")
    elif ch == "?" and i > 0 and s[i - 1] == "?"
      # no trigraphs
      buf_push(b, "\\?")
    elif ord(ch) < 32 or ord(ch) >= 127
      # control bytes and non-ASCII (cc warns on bad UTF-8): 3-digit octal, so a following digit isn't absorbed
      let o = ord(ch)
      buf_push(b, "\\" + to_string(o / 64) + to_string(o / 8 % 8) + to_string(o % 8))
    else
      buf_push(b, ch)
    end
  end
  to_string(b)
end

fn repeat_str(s, n)
  let b = buf_new()
  for i = 0, n
    buf_push(b, s)
  end
  to_string(b)
end

fn pad_for(indent)
  repeat_str("    ", indent)
end

# INT64_MIN has no C literal (`-9223372036854775808` negates an out-of-range constant)
fn c_int_literal(n)
  if n == 0 - 9223372036854775807 - 1 then return "INT64_MIN" end
  to_string(n)
end

fn format_float(val)
  # to_string's shortest round-trip form is valid C, except inf/nan (folding can produce them)
  let s = to_string(val)
  if s == "inf"
    return "__builtin_inf()"
  elif s == "-inf"
    return "(-__builtin_inf())"
  elif s == "nan"
    return "__builtin_nan(\"\")"
  end
  let has_dot = false
  for i = 0, len(s)
    if s[i] == "." or s[i] == "e"
      has_dot = true
    end
  end
  if not has_dot
    s = s + ".0"
  end
  s
end

fn set_add(s, val)
  if s[val] != true
    s[val] = true
  end
end

fn set_contains(s, val)
  s[val] == true
end

fn set_union(a, b)
  let result = {}
  for k, _ in a
    result[k] = true
  end
  for k, _ in b
    result[k] = true
  end
  result
end

fn set_intersect(a, b)
  let result = {}
  for k, _ in a
    if b[k] == true
      result[k] = true
    end
  end
  result
end

fn sorted_array_to_set(arr)
  let s = {}
  for item in arr
    s[item] = true
  end
  s
end

fn levenshtein(a, b)
  let alen = len(a)
  let blen = len(b)
  if alen == 0 then return blen end
  if blen == 0 then return alen end
  let prev = []
  let i = 0
  while i <= blen
    prev[i] = i
    i += 1
  end
  let curr = []
  i = 1
  while i <= alen
    curr[0] = i
    let j = 1
    while j <= blen
      let cost = if ord(a, i - 1) == ord(b, j - 1) then 0 else 1 end
      let del = prev[j] + 1
      let ins = curr[j - 1] + 1
      let sub = prev[j - 1] + cost
      let m = del
      if ins < m then m = ins end
      if sub < m then m = sub end
      curr[j] = m
      j += 1
    end
    let tmp = prev
    prev = curr
    curr = tmp
    i += 1
  end
  prev[blen]
end

fn find_closest_export(field, exports)
  let best = nil
  let best_d = 999
  for ename in exports
    let d = levenshtein(field, ename)
    if d < best_d
      best_d = d
      best = ename
    end
  end
  let flen = len(field)
  let threshold = if flen <= 4 then 1 else 2 end
  if best_d <= threshold
    return best
  end
  nil
end

# f(child) for every node directly below `node`, looking through lists and untagged records (table entries),
# in `for k, v in node` order
fn each_child(node, f)
  for k, v in node
    if type(v) == "table" and k != "liveness_result"
      if v.tag != nil
        f(v)
      else
        each_child(v, f)
      end
    end
  end
  nil
end

# each_child that stops at the first child for which f returns true
fn any_child(node, f)
  for k, v in node
    if type(v) == "table" and k != "liveness_result"
      if v.tag != nil
        if f(v) == true
          return true
        end
      elif any_child(v, f)
        return true
      end
    end
  end
  false
end

# an arm's pattern bindings (lets) followed by its body, so the bindings are in scope there
fn arm_stmts(bindings, body)
  let out = []
  if bindings != nil
    for b in bindings
      push(out, b)
    end
  end
  for s in body
    push(out, s)
  end
  out
end

fn is_node(node, tag)
  type(node) == "table" and node.tag == tag
end

# A fn literal's defaults (evaluated with its params bound) followed by its body
fn fn_stmts(node)
  let out = []
  if node.defaults != nil
    for d in node.defaults
      if d != nil
        push(out, d)
      end
    end
  end
  for s in node.body
    push(out, s)
  end
  out
end

# Walks lowered statements in order with `bound`, the names bound at each point: the lets before it in its
# list (a block's lets count for the rest of the list holding it), arm bindings, match and receive temporaries,
# and the params of the fn literals it enters. Calls v.read(name, bound) on a var, v.write(name, bound) on
# `name = ...`, and v.closure(node, bound) on a fn literal, whose defaults and body it walks when that returns
# true. If v.node is set, v.node(node, bound) sees each node first and returns true when it walked the node
# itself. Named fns are not entered.
fn walk_scoped(stmts, bound, v)
  if stmts == nil
    return nil
  end
  let b = set_union(bound, {})
  for s in stmts
    walk_scoped_node(s, b, v)
    if is_node(s, "let")
      b[s.name] = true
    elif is_node(s, "block")
      for inner in s.stmts
        if is_node(inner, "let")
          b[inner.name] = true
        end
      end
    end
  end
  nil
end

fn walk_scoped_fn(node, bound, v)
  let b = set_union(bound, sorted_array_to_set(node.params))
  if node.rest_param != nil
    b[node.rest_param] = true
  end
  walk_scoped(fn_stmts(node), b, v)
end

fn walk_scoped_node(node, bound, v)
  if type(node) != "table" or node.tag == nil
    return nil
  end
  if v.node != nil and v.node(node, bound) == true
    return nil
  end
  let tag = node.tag
  if tag == "var"
    v.read(node.name, bound)
  elif tag == "assign"
    v.write(node.name, bound)
    walk_scoped_node(node.value, bound, v)
  elif tag == "anon_fn"
    if v.closure(node, bound) == true
      walk_scoped_fn(node, bound, v)
    end
  elif tag == "fn_def"
    return nil
  elif tag == "if"
    walk_scoped_node(node.cond, bound, v)
    walk_scoped(node.then, bound, v)
    walk_scoped(node.else, bound, v)
  elif tag == "while"
    walk_scoped_node(node.cond, bound, v)
    walk_scoped(node.body, bound, v)
  elif tag == "block"
    walk_scoped(node.stmts, bound, v)
  elif tag == "match"
    walk_scoped_node(node.target, bound, v)
    walk_scoped_arms(node.whens, with_name(bound, node.target_var), v)
    walk_scoped(node.else, bound, v)
  elif tag == "receive_match"
    let b = with_name(bound, node.recv_var)
    walk_scoped_arms(node.arms, b, v)
    walk_scoped_node(node.after_ms, b, v)
    walk_scoped(node.after_body, b, v)
  else
    each_child(node, fn(c) walk_scoped_node(c, bound, v) end)
  end
  nil
end

fn walk_scoped_arms(arms, bound, v)
  for w in arms
    walk_scoped_node(w.value, bound, v)
    walk_scoped(arm_stmts(w.bindings, w.body), bound, v)
  end
end

fn with_name(set, name)
  let out = set_union(set, {})
  if name != nil
    out[name] = true
  end
  out
end

export escape_c_string, pad_for, c_int_literal, format_float, set_add, set_contains, set_union, set_intersect, sorted_array_to_set, find_closest_export, is_node, each_child, any_child, arm_stmts, fn_stmts, walk_scoped, walk_scoped_fn, walk_scoped_node
