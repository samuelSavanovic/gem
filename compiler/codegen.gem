# Code generator — compiles AST to C source code.
# Faithful port of bootstrap/gem.py CodeGen class.
# Uses closure-based pattern: fn make_codegen() returns a table of methods.

load "./liveness" (compute_live_for_pt_loops_in_stmts, is_spawn_callee_name)
load "./errors" (make_error_sink)
load "./builtins" (BUILTIN_FNS)

# ─── String helpers ─────────────────────────────────────────────

fn escape_c_string(s)
  let cr = chr(13)
  let b = buf_new()
  for i = 0, len(s)
    let ch = s[i]
    if ch == "\\"
      buf_push(b, "\\\\")
    elif ch == "\""
      buf_push(b, "\\\"")
    elif ch == "\n"
      buf_push(b, "\\n")
    elif ch == cr
      buf_push(b, "\\r")
    elif ch == "\t"
      buf_push(b, "\\t")
    elif ord(ch) == 0
      # 3-digit octal so a following digit char isn't absorbed into the escape.
      buf_push(b, "\\000")
    else
      buf_push(b, ch)
    end
  end
  to_string(b)
end

fn repeat_str(s, n)
  let b = buf_new()
  for i = 0, n
    buf_push(b, s)
  end
  to_string(b)
end

fn pad_for(indent)
  repeat_str("    ", indent)
end

# An int as a C constant. INT64_MIN has no literal of its own in C
# (`-9223372036854775808` negates an out-of-range constant), so spell it.
fn c_int_literal(n)
  if n == 0 - 9223372036854775807 - 1 then return "INT64_MIN" end
  to_string(n)
end

fn format_float(val)
  # to_string gives the shortest text that reads back to the same double
  # ("0.1", "2.0", "1e-05", "1e+16"), which is also a valid C double literal,
  # except for the non-finite values (constant folding can produce inf).
  let s = to_string(val)
  if s == "inf"
    return "__builtin_inf()"
  elif s == "-inf"
    return "(-__builtin_inf())"
  elif s == "nan"
    return "__builtin_nan(\"\")"
  end
  let has_dot = false
  for i = 0, len(s)
    if s[i] == "." or s[i] == "e"
      has_dot = true
    end
  end
  if not has_dot
    s = s + ".0"
  end
  s
end

# ─── Array/set helpers ────────────────────────────────────────────

fn set_add(s, val)
  if s[val] != true
    s[val] = true
  end
end

fn set_contains(s, val)
  s[val] == true
end

fn set_union(a, b)
  let result = {}
  for k, _ in a
    result[k] = true
  end
  for k, _ in b
    result[k] = true
  end
  result
end

fn set_intersect(a, b)
  let result = {}
  for k, _ in a
    if b[k] == true
      result[k] = true
    end
  end
  result
end

fn sorted_array_to_set(arr)
  let s = {}
  for item in arr
    s[item] = true
  end
  s
end

fn levenshtein(a, b)
  let alen = len(a)
  let blen = len(b)
  if alen == 0 then return blen end
  if blen == 0 then return alen end
  let prev = []
  let i = 0
  while i <= blen
    prev[i] = i
    i += 1
  end
  let curr = []
  i = 1
  while i <= alen
    curr[0] = i
    let j = 1
    while j <= blen
      let cost = 1
      if ord(a, i - 1) == ord(b, j - 1) then cost = 0 end
      let del = prev[j] + 1
      let ins = curr[j - 1] + 1
      let sub = prev[j - 1] + cost
      let m = del
      if ins < m then m = ins end
      if sub < m then m = sub end
      curr[j] = m
      j += 1
    end
    let tmp = prev
    prev = curr
    curr = tmp
    i += 1
  end
  prev[blen]
end

fn find_closest_export(field, exports)
  let best = nil
  let best_d = 999
  for ename in exports
    let d = levenshtein(field, ename)
    if d < best_d
      best_d = d
      best = ename
    end
  end
  let flen = len(field)
  let threshold = 2
  if flen <= 4 then threshold = 1 end
  if best_d <= threshold
    return best
  end
  nil
end

fn is_node(node, tag)
  type(node) == "table" and node.tag == tag
end

# ─── Codegen constructor ───────────────────────────────────────

fn collect_block_lets(stmt, result)
  if is_node(stmt, "block")
    for j = 0, len(stmt.stmts)
      if is_node(stmt.stmts[j], "let")
        set_add(result, stmt.stmts[j].name)
      end
    end
  end
end

fn collect_top_let_names(stmts, result)
  for i = 0, len(stmts)
    let s = stmts[i]
    if is_node(s, "let")
      set_add(result, s.name)
    end
    collect_block_lets(s, result)
  end
end

# ─── Shadowing lets ──────────────────────────────────────────────
#
# A `let` always makes a new variable. When its name is already visible
# (a parameter, an earlier `let` in this or an enclosing block, a captured
# local, a module-level binding, a named or extern fn, a builtin) the new
# variable shadows the old one: its initializer still reads the old one,
# closures created before it keep the old one, and a shadow made in a
# nested block ends with that block. Codegen, liveness, capture and boxing analysis are all keyed
# by name, and C does not allow `GemVal gem_v_n = gem_v_n - 1` (a
# redefinition in the same C block; in a nested block the initializer reads
# the new, uninitialized variable). So this pass alpha-renames every
# shadowing let (and the references and assignments it scopes) to a fresh
# `_sh<N>_<name>`. After it no let reuses a name visible at that point, and
# every later pass sees distinct variables. A parameter named like a named
# or extern fn is renamed the same way (`shadow_param_name`).
#
# The one exception is a `let` in the module's own statement list (or
# directly in a top-level `block`, the shape of a lowered `for` header or a
# destructuring `let`): that is a module-level binding, a per-process slot
# keyed by name (`top_level_vars`), which named fns and closures read live.
# A second module-level `let` of a name rebinds that same slot. A `let`
# nested in a top-level `if` / `while` / `for` body / `match` or `receive`
# arm is block-scoped, like a `let` in a fn body, and is renamed when it
# reuses a module-level name, so it never writes the slot and a closure
# created in the block captures the block's binding.
#
# Scoping is strict: a `let` (or a `for` variable or pattern binding) is
# visible from its declaration to the end of its block and nowhere else.
# The pass also reports every use (read or assignment) of a name after the
# block that declared it ended, or before its `let` (outside closures),
# unless an outer binding of the name is visible there
# (`shadow_check_use`). Without the check such a use would
# reach C as an undeclared or stale `gem_v_<name>` (codegen's local set
# is fn-wide).
#
# Runs on the post-lower AST, before any analysis keyed on names (capture,
# liveness, process-tail tagging).
#
# `env` maps every name visible in the current scope (params, lets) to the
# name it compiles to (itself, or its fresh `_sh<N>_` name). `mode` is
# "module" (module-scope statement list: lets are slots), "block" (nested
# top-level scope) or "fn" (inside a fn or closure body). Module-level
# bindings and named fns count as visible everywhere outside module scope
# (`ctx.globals`, `ctx.fns`), wherever they are declared; extern fns and
# builtins everywhere. `ctx.ended` maps a name some ended block declared to
# its declaration line (reset per named fn).

fn copy_scope_env(env)
  let r = {}
  for k, v in env
    r[k] = v
  end
  r
end

let shadow_node = nil
let shadow_stmt = nil
let shadow_stmts = nil
let shadow_children = nil

# Where a `let` is declared, for the out-of-scope hint: {line, file}.
# Pattern bindings come from lowering without a line of their own (nil).
# The file matters because one scope walk covers the top-level code of
# every loaded module.
fn shadow_decl_site(let_node)
  let line = let_node.line
  if line == 0
    line = nil
  end
  {line: line, file: let_node.file}
end

fn shadow_bind(let_node, env, mode, ctx)
  let name = let_node.name
  if name == nil
    return nil
  end
  if mode != "module" and (has_key(env, name) or set_contains(ctx.globals, name) or set_contains(ctx.fns, name) or set_contains(ctx.externs, name) or has_key(ctx.builtins, name))
    ctx.n = ctx.n + 1
    let fresh = "_sh{ctx.n}_{name}"
    let_node.name = fresh
    env[name] = fresh
  else
    env[name] = name
  end
  ctx.lines[env[name]] = shadow_decl_site(let_node)
end

# A block whose scope was `inner` ends; `outer` is the enclosing scope.
# Every name it declared (or re-declared as a shadow) goes out of scope:
# remember where it was declared, for the error at a later use.
fn shadow_end_scope(inner, outer, ctx)
  for k, v in inner
    if not has_key(outer, k) or outer[k] != v
      ctx.ended[k] = ctx.lines[v]
    end
  end
end

# A use (read or assignment) of `name` where no binding of it is visible.
# A name a block declared is visible only to the end of that block, so a
# use after it is an error. Names that never were declared are left to
# codegen's undeclared-identifier check (same message, deduplicated by
# the sink).
#
# The same holds for a use before the declaration when it is not inside a
# block of the declaration's scope, e.g. a `while` condition reading a
# `let` of the loop body (`ctx.later`: every let of the body being walked,
# the current named fn, closure or top-level code, outside nested
# closures). A closure's use of a let of an enclosing body (`ctx.outer_later`:
# a closure calling itself through the let it initializes, or reading a let
# made after it) is reported too, as "later_closure": the closure's env is
# built when it is created, before the let exists.
fn shadow_check_use(node, name, env, ctx)
  if has_key(env, name)
    return nil
  end
  if set_contains(ctx.globals, name) or set_contains(ctx.fns, name) or set_contains(ctx.externs, name) or has_key(ctx.builtins, name)
    return nil
  end
  if has_key(ctx.ended, name)
    ctx.report(node, name, "ended", ctx.ended[name])
  elif has_key(ctx.later, name)
    ctx.report(node, name, "later", ctx.later[name])
  elif has_key(ctx.outer_later, name)
    ctx.report(node, name, "later_closure", ctx.outer_later[name])
  end
end

# Every name a `let` (incl. `for` variables and pattern bindings) declares
# in `node`, outside nested fns and closures, with its first line (nil
# when unknown).
let shadow_collect_lets = nil
shadow_collect_lets = fn(node, out)
  if node == nil or type(node) != "table"
    return nil
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    return nil
  end
  if node.tag == "let" and node.name != nil and not has_key(out, node.name)
    out[node.name] = shadow_decl_site(node)
  end
  for k, v in node
    if k != "tag" and type(v) == "table"
      shadow_collect_lets(v, out)
    end
  end
end

# A named fn (or the top-level code): its own scope-tracking state.
fn shadow_named_fn(node, ctx)
  let saved = {ended: ctx.ended, later: ctx.later, outer_later: ctx.outer_later, depth: ctx.closure_depth}
  ctx.ended = {}
  ctx.later = {}
  ctx.outer_later = {}
  shadow_collect_lets(node.body, ctx.later)
  ctx.closure_depth = 0
  shadow_fn(node, {}, ctx)
  ctx.ended = saved.ended
  ctx.later = saved.later
  ctx.outer_later = saved.outer_later
  ctx.closure_depth = saved.depth
end

fn shadow_child_mode(mode)
  if mode == "module"
    return "block"
  end
  mode
end

# A param named like a named or extern fn: codegen resolves such a name
# to the fn wherever it is not a local of the fn being compiled (a closure
# capturing the param, a `do` block), so the param gets a fresh name.
fn shadow_param_name(p, ctx)
  if set_contains(ctx.fns, p) or set_contains(ctx.externs, p)
    ctx.n = ctx.n + 1
    return "_sh{ctx.n}_{p}"
  end
  p
end

# A fn or closure: its params are new C params, visible in the body
# (hiding any outer binding of the same name). A param keeps its name,
# except one named like a named or extern fn (`shadow_param_name`).
fn shadow_fn(node, env, ctx)
  let inner = copy_scope_env(env)
  if node.params != nil
    let params = []
    for p in node.params
      let c = shadow_param_name(p, ctx)
      inner[p] = c
      push(params, c)
    end
    node.params = params
  end
  if node.rest_param != nil
    let c = shadow_param_name(node.rest_param, ctx)
    inner[node.rest_param] = c
    node.rest_param = c
  end
  if node.defaults != nil
    for d in node.defaults
      shadow_node(d, inner, "fn", ctx)
    end
  end
  shadow_stmts(node.body, inner, "fn", ctx)
end

shadow_stmts = fn(stmts, env, mode, ctx)
  if stmts == nil
    return nil
  end
  let scope = copy_scope_env(env)
  for s in stmts
    shadow_stmt(s, scope, mode, ctx)
  end
  shadow_end_scope(scope, env, ctx)
end

# A statement in a list whose scope is `env` (mutated: lets bind into it).
# `block` is transparent: its lets belong to the enclosing list's scope.
shadow_stmt = fn(s, env, mode, ctx)
  if is_node(s, "let")
    shadow_node(s.value, env, mode, ctx)
    shadow_bind(s, env, mode, ctx)
  elif is_node(s, "block")
    for c in s.stmts
      shadow_stmt(c, env, mode, ctx)
    end
  else
    shadow_node(s, env, mode, ctx)
  end
end

# Arm bindings (`when` / `receive` patterns) are lets scoped to the arm.
fn shadow_arm(cond, bindings, body, env, mode, ctx)
  let arm = copy_scope_env(env)
  let cm = shadow_child_mode(mode)
  shadow_node(cond, arm, mode, ctx)
  if bindings != nil
    for b in bindings
      if is_node(b, "let")
        shadow_node(b.value, arm, mode, ctx)
        shadow_bind(b, arm, cm, ctx)
      end
    end
  end
  shadow_stmts(body, arm, cm, ctx)
  shadow_end_scope(arm, env, ctx)
end

shadow_node = fn(node, env, mode, ctx)
  if node == nil or type(node) != "table" or node.tag == nil
    return nil
  end
  let tag = node.tag
  let cm = shadow_child_mode(mode)
  if tag == "var"
    shadow_check_use(node, node.name, env, ctx)
    if has_key(env, node.name)
      node.name = env[node.name]
    end
  elif tag == "assign"
    shadow_node(node.value, env, mode, ctx)
    shadow_check_use(node, node.name, env, ctx)
    if has_key(env, node.name)
      node.name = env[node.name]
    end
  elif tag == "let" or tag == "block"
    # Only reachable as a statement; route through the list walker.
    shadow_stmt(node, env, mode, ctx)
  elif tag == "fn_def"
    # Named fns are module-level and never see block locals.
    shadow_named_fn(node, ctx)
  elif tag == "anon_fn"
    # The closure body's own lets are its `later`; the enclosing bodies'
    # lets become `outer_later`.
    let saved_later = ctx.later
    let saved_outer = ctx.outer_later
    let outer = copy_scope_env(saved_outer)
    for k, v in saved_later
      outer[k] = v
    end
    ctx.outer_later = outer
    ctx.later = {}
    shadow_collect_lets(node.body, ctx.later)
    ctx.closure_depth = ctx.closure_depth + 1
    shadow_fn(node, env, ctx)
    ctx.closure_depth = ctx.closure_depth - 1
    ctx.later = saved_later
    ctx.outer_later = saved_outer
  elif tag == "if"
    shadow_node(node.cond, env, mode, ctx)
    shadow_stmts(node.then, env, cm, ctx)
    if node.elifs != nil
      for ei in node.elifs
        shadow_node(ei.cond, env, mode, ctx)
        shadow_stmts(ei.body, env, cm, ctx)
      end
    end
    shadow_stmts(node.else, env, cm, ctx)
  elif tag == "while"
    shadow_node(node.cond, env, mode, ctx)
    shadow_stmts(node.body, env, cm, ctx)
  elif tag == "match"
    shadow_node(node.target, env, mode, ctx)
    if node.whens != nil
      for w in node.whens
        shadow_arm(w.value, w.bindings, w.body, env, mode, ctx)
      end
    end
    shadow_stmts(node.else, env, cm, ctx)
  elif tag == "receive_match"
    if node.arms != nil
      for a in node.arms
        let cond = nil
        let bindings = nil
        if a.pattern != nil
          cond = a.pattern.condition
          bindings = a.pattern.bindings
        end
        shadow_arm(cond, bindings, a.body, env, mode, ctx)
      end
    end
    shadow_node(node.after_ms, env, mode, ctx)
    shadow_stmts(node.after_body, env, cm, ctx)
  else
    for k, v in node
      if k != "tag" and type(v) == "table"
        shadow_children(v, env, mode, ctx)
      end
    end
  end
  nil
end

# Expression children: a node, or a tagless container (arg list, table
# entries `{key, value}`) holding nodes.
shadow_children = fn(v, env, mode, ctx)
  if v.tag != nil
    shadow_node(v, env, mode, ctx)
    return nil
  end
  for _, c in v
    if type(c) == "table"
      shadow_children(c, env, mode, ctx)
    end
  end
end

# `builtins` and `externs` are names that resolve without a binding;
# `report(node, name, kind, decl)` reports a use of a name whose
# `let` is not visible there: kind "ended" (its block ended), "later"
# (declared after the use, outside any block containing it) or
# "later_closure" (the same, from inside a closure). `decl` is the
# declaration's {line, file}.
fn scope_shadowing_lets(fn_defs, top_stmts, builtins, externs, report)
  let globals = {}
  collect_top_let_names(top_stmts, globals)
  let fns = {}
  for fd in fn_defs
    set_add(fns, fd.name)
  end
  let ctx = {globals: globals, fns: fns, builtins: builtins, n: 0,
             externs: {}, lines: {}, ended: {}, later: {}, outer_later: {}, closure_depth: 0,
             report: report}
  for e in externs
    set_add(ctx.externs, e)
  end
  for s in top_stmts
    shadow_collect_lets(s, ctx.later)
  end
  let env = {}
  for s in top_stmts
    shadow_stmt(s, env, "module", ctx)
  end
  for fd in fn_defs
    shadow_named_fn(fd, ctx)
  end
end

# Whole-module load bindings (`let m = <frozen namespace table>`, from
# resolve_loads in main.gem) whose name is never rebound or assigned:
# out[m] = {export: "_mod_<mod>_<export>"}. Codegen compiles `m.export`
# straight to that binding, so it is the module's own value in the
# running process.
# `assigned`: names assigned (`name = …`) anywhere in the program.
fn collect_module_namespaces(top_stmts, assigned, out)
  let rebound = assigned
  for s in top_stmts
    if is_node(s, "let")
      if is_node(s.value, "table") and s.value.frozen == true
        let fields = {}
        for e in s.value.entries
          if type(e.key) == "string" and is_node(e.value, "var")
            fields[e.key] = e.value.name
          end
        end
        let prev = out[s.name]
        if prev != nil
          # The same module loaded again under the same name is fine; a
          # different one is a rebinding.
          let same = len(keys(prev)) == len(keys(fields))
          for k, v in fields
            if prev[k] != v
              same = false
            end
          end
          if not same
            set_add(rebound, s.name)
          end
        end
        out[s.name] = fields
      else
        set_add(rebound, s.name)
      end
    end
  end
  # A let directly in a top-level block (a lowered `for` header or a
  # destructuring let) also writes a module slot.
  for s in top_stmts
    if is_node(s, "block")
      for b in s.stmts
        if is_node(b, "let")
          set_add(rebound, b.name)
        end
      end
    end
  end
  for name, _ in rebound
    delete(out, name)
  end
end

# Collects all let-bound names anywhere in this fn body (descending through
# control flow), but not into nested anon_fn or fn_def. Used by compile_fn
# to over-approximate the set of locally-shadowed names — anything in here
# must not be confused with a top-level boxed global of the same name.
let collect_shadow_lets_in_node = nil
let collect_shadow_lets_in_stmts = nil

collect_shadow_lets_in_stmts = fn(stmts, result)
  if stmts == nil
    return nil
  end
  for i = 0, len(stmts)
    collect_shadow_lets_in_node(stmts[i], result)
  end
end

collect_shadow_lets_in_node = fn(node, result)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    return nil
  end
  if node.tag == "let"
    set_add(result, node.name)
    return nil
  end
  if node.tag == "block"
    collect_shadow_lets_in_stmts(node.stmts, result)
    return nil
  end
  if node.tag == "if"
    collect_shadow_lets_in_stmts(node.then, result)
    if node.elifs != nil
      for ei in node.elifs
        collect_shadow_lets_in_stmts(ei.body, result)
      end
    end
    collect_shadow_lets_in_stmts(node.else, result)
    return nil
  end
  if node.tag == "while"
    collect_shadow_lets_in_stmts(node.body, result)
    return nil
  end
  if node.tag == "for" or node.tag == "for_kv" or node.tag == "for_range"
    if node.var != nil
      set_add(result, node.var)
    end
    if node.kvar != nil
      set_add(result, node.kvar)
    end
    if node.vvar != nil
      set_add(result, node.vvar)
    end
    if node.name != nil and (node.tag == "for" or node.tag == "for_range")
      set_add(result, node.name)
    end
    collect_shadow_lets_in_stmts(node.body, result)
    return nil
  end
  if node.tag == "match"
    if node.target_var != nil
      set_add(result, node.target_var)
    end
    if node.whens != nil
      for w in node.whens
        if w.bindings != nil
          for b in w.bindings
            if type(b) == "table" and b.name != nil and (b.tag == "let" or b.tag == "var")
              set_add(result, b.name)
            end
          end
        end
        collect_shadow_lets_in_stmts(w.body, result)
      end
    end
    collect_shadow_lets_in_stmts(node.else, result)
    return nil
  end
  if node.tag == "receive_match"
    if node.recv_var != nil
      set_add(result, node.recv_var)
    end
    if node.arms != nil
      for a in node.arms
        if a.pattern != nil and a.pattern.bindings != nil
          for b in a.pattern.bindings
            if type(b) == "table" and b.name != nil and (b.tag == "let" or b.tag == "var")
              set_add(result, b.name)
            end
          end
        end
        collect_shadow_lets_in_stmts(a.body, result)
      end
    end
    if node.after_body != nil
      collect_shadow_lets_in_stmts(node.after_body, result)
    end
    return nil
  end
  nil
end

let collect_shadow_lets_in_fn = nil
collect_shadow_lets_in_fn = fn(stmts, result)
  collect_shadow_lets_in_stmts(stmts, result)
end

# ─── Liveness-driven arm-let hoist ────────────────────────────────
#
# Lifts `let X = expr` declarations inside if/match/receive arms of a
# PT-while body to fn-top placeholders, rewriting the per-arm decl to an
# assign. Required so X has an addressable C local enclosing the back-edge
# rescue check (`&gem_v_X`) when X is live across that edge but declared
# in only one arm.

fn hoist_has_let(node, name)
  if node == nil
    return false
  end
  if type(node) != "table"
    return false
  end
  let nks = keys(node)
  if len(nks) > 0 and type(nks[0]) == "int"
    for child in node
      if type(child) == "table"
        if hoist_has_let(child, name)
          return true
        end
      end
    end
    return false
  end
  if node.tag == nil
    return false
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    return false
  end
  if node.tag == "let" and node.name == name
    return true
  end
  for k, v in node
    if k != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        for child in v
          if type(child) == "table"
            if hoist_has_let(child, name)
              return true
            end
          end
        end
      else
        if hoist_has_let(v, name)
          return true
        end
      end
    end
  end
  false
end

let captured_arm_lets_node = nil
let captured_arm_lets_stmts = nil

# `scope` accumulates names known to be addressable above this stmt list:
# enclosing fn params, lets in any ancestor block. We refuse to hoist a name
# already in `scope` (would shadow the outer binding and silently change
# semantics). `block_lets` is built up as we walk this stmt list — names
# declared via `let` to its left of the current position.
captured_arm_lets_stmts = fn(stmts, scope)
  if stmts == nil
    return nil
  end
  let block_lets = {}
  for s in stmts
    if is_node(s, "let") and s.name != nil
      set_add(block_lets, s.name)
    end
  end

  let i = 0
  while i < len(stmts)
    let s = stmts[i]
    let merged = set_union(scope, block_lets)
    captured_arm_lets_node(s, merged)

    if is_node(s, "while") and s.process_tail == true and s.liveness_result != nil and s.liveness_result.ok == true
      let live = s.liveness_result.live
      let to_hoist = []
      for n, _ in live
        if not set_contains(merged, n)
          if hoist_has_let(s.body, n)
            push(to_hoist, n)
          end
        end
      end
      if len(to_hoist) > 0
        # Insert `let X = nil` placeholders before the while. We deliberately
        # do NOT rewrite the inner arm-lets to assigns: the per-iter `let`
        # remains a fresh block-scoped shadow, the closure captures from
        # that shadow (fresh box per iter, dies with the arm), and the
        # placeholder exists only to satisfy `filter_live_for_rescue`'s
        # fn-scope addressability check. The placeholder always holds nil,
        # so the rescue copies a no-op and the inner shadow's box (per-iter
        # arena) dies cleanly with the arena reset.
        for n in to_hoist
          insert(stmts, i, {tag: "let", name: n, value: {tag: "nil"}, line: s.line, rescue_placeholder: true})
          set_add(block_lets, n)
          i += 1
        end
      end
    end
    i += 1
  end
end

captured_arm_lets_node = fn(node, scope)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    let inner_scope = {}
    if node.params != nil
      for p in node.params
        set_add(inner_scope, p)
      end
    end
    if node.rest_param != nil
      set_add(inner_scope, node.rest_param)
    end
    captured_arm_lets_stmts(node.body, inner_scope)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          captured_arm_lets_node(d, scope)
        end
      end
    end
    return nil
  end
  if node.tag == "if"
    captured_arm_lets_node(node.cond, scope)
    captured_arm_lets_stmts(node.then, scope)
    if node.elifs != nil
      for ei in node.elifs
        captured_arm_lets_stmts(ei.body, scope)
      end
    end
    captured_arm_lets_stmts(node.else, scope)
    return nil
  end
  if node.tag == "while"
    captured_arm_lets_node(node.cond, scope)
    captured_arm_lets_stmts(node.body, scope)
    return nil
  end
  if node.tag == "for" or node.tag == "for_kv" or node.tag == "for_range"
    let body_scope = set_union(scope, {})
    if node.var != nil
      set_add(body_scope, node.var)
    end
    if node.kvar != nil
      set_add(body_scope, node.kvar)
    end
    if node.vvar != nil
      set_add(body_scope, node.vvar)
    end
    if node.name != nil and (node.tag == "for" or node.tag == "for_range")
      set_add(body_scope, node.name)
    end
    for k, v in node
      if k != "tag" and k != "body" and type(v) == "table"
        captured_arm_lets_node(v, scope)
      end
    end
    captured_arm_lets_stmts(node.body, body_scope)
    return nil
  end
  if node.tag == "match"
    captured_arm_lets_node(node.target, scope)
    if node.whens != nil
      for w in node.whens
        let arm_scope = set_union(scope, {})
        if w.bindings != nil
          for b in w.bindings
            if type(b) == "table" and b.tag == "var" and b.name != nil
              set_add(arm_scope, b.name)
            end
          end
        end
        captured_arm_lets_stmts(w.body, arm_scope)
      end
    end
    captured_arm_lets_stmts(node.else, scope)
    return nil
  end
  if node.tag == "receive_match"
    if node.arms != nil
      for a in node.arms
        let arm_scope = set_union(scope, {})
        if a.pattern != nil and a.pattern.bindings != nil
          for b in a.pattern.bindings
            if type(b) == "table" and b.tag == "var" and b.name != nil
              set_add(arm_scope, b.name)
            end
          end
        end
        captured_arm_lets_stmts(a.body, arm_scope)
      end
    end
    if node.after_body != nil
      captured_arm_lets_stmts(node.after_body, scope)
    end
    return nil
  end
  if node.tag == "block"
    captured_arm_lets_stmts(node.stmts, scope)
    return nil
  end
  for k, v in node
    if k != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        for child in v
          if type(child) == "table"
            captured_arm_lets_node(child, scope)
          end
        end
      else
        captured_arm_lets_node(v, scope)
      end
    end
  end
  nil
end

fn lift_captured_arm_lets_in_fn(fn_node)
  let scope = {}
  if fn_node.params != nil
    for p in fn_node.params
      set_add(scope, p)
    end
  end
  if fn_node.rest_param != nil
    set_add(scope, fn_node.rest_param)
  end
  captured_arm_lets_stmts(fn_node.body, scope)
  if fn_node.defaults != nil
    for d in fn_node.defaults
      if d != nil
        captured_arm_lets_node(d, scope)
      end
    end
  end
end

fn lift_captured_arm_lets_top_stmts(stmts)
  captured_arm_lets_stmts(stmts, {})
end

# Names of the rescue placeholders above that landed at module scope: in
# the top-level statement list, or directly in a top-level `block` (the
# header of a lowered `for`), the positions collect_top_let_names treats
# as module bindings.
fn top_rescue_placeholders(stmts)
  let out = []
  for s in stmts
    if is_node(s, "let") and s.rescue_placeholder == true
      push(out, s.name)
    elif is_node(s, "block")
      for c in s.stmts
        if is_node(c, "let") and c.rescue_placeholder == true
          push(out, c.name)
        end
      end
    end
  end
  out
end

# ─── Loop tagging for the back-edge arena reset ─────────────────
#
# Walks every fn_def body, closure body and the top-level program, tagging
# each `while` node (including lowered `for` loops) with
# `process_tail = true` directly on the AST node. The codegen
# (`compile_while`) emits a region mark + back-edge reset for every tagged
# loop whose live set liveness can root. (The name is historical: resets
# used to be limited to loops reachable from a process root by tail calls
# only. Region resets are sound in any call context, see compile_while.)

let walk_for_tagging_node = nil
let walk_for_tagging_stmts = nil

walk_for_tagging_stmts = fn(stmts, is_pt, source_name)
  if stmts == nil
    return nil
  end
  for s in stmts
    walk_for_tagging_node(s, is_pt, source_name)
  end
end

walk_for_tagging_node = fn(node, is_pt, source_name)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end
  if node.tag == "fn_def"
    # Top-level fn_defs are walked separately by tag_process_tail_while_loops;
    # parser disallows nested fn_def. Skip.
    return nil
  end
  if node.tag == "anon_fn"
    # Region resets are sound in any context (see compile_while), so every
    # closure body is tagged too.
    walk_for_tagging_stmts(node.body, is_pt, source_name)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_for_tagging_node(d, is_pt, source_name)
        end
      end
    end
    return nil
  end
  if node.tag == "while" and is_pt
    node.process_tail = true
    walk_for_tagging_stmts(node.body, is_pt, source_name)
    return nil
  end
  if node.tag == "call" and is_node(node.func, "var") and is_spawn_callee_name(node.func.name)
    if node.args != nil and len(node.args) > 0 and is_node(node.args[0], "anon_fn")
      let anon = node.args[0]
      walk_for_tagging_stmts(anon.body, true, source_name)
      if anon.defaults != nil
        for d in anon.defaults
          if d != nil
            walk_for_tagging_node(d, is_pt, source_name)
          end
        end
      end
      let i = 1
      while i < len(node.args)
        walk_for_tagging_node(node.args[i], is_pt, source_name)
        i += 1
      end
      return nil
    end
    # Fall through to generic recursion so nested spawns inside the args still
    # get walked (e.g. `spawn(make_loop(spawn(fn() … end)))`).
  end
  # Generic recursion over child nodes/arrays.
  for k, v in node
    if k != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        let vi = 0
        while vi < len(v)
          if type(v[vi]) == "table"
            walk_for_tagging_node(v[vi], is_pt, source_name)
          end
          vi += 1
        end
      else
        walk_for_tagging_node(v, is_pt, source_name)
      end
    end
  end
  nil
end

let tag_process_tail_while_loops = nil
tag_process_tail_while_loops = fn(fn_defs, top_stmts, source_name)
  # Every loop is a reset candidate: a region reset frees only memory
  # allocated after the loop started, so it is sound whatever the call
  # context (see compile_while). `process_tail` now just means "emit the
  # back-edge reset if liveness can root the live set".
  for fd in fn_defs
    walk_for_tagging_stmts(fd.body, true, source_name)
  end
  # Top-level statements run in `gem_main_pid` and are PT-tagged uniformly with fn bodies.
  walk_for_tagging_stmts(top_stmts, true, source_name)
end

fn make_codegen(source_name, module_bindings = nil, show_path = nil, sources_by_file = nil, sink = nil, global_display = nil)
  if module_bindings == nil
    module_bindings = {}
  end
  if global_display == nil
    global_display = {}
  end
  if sources_by_file == nil
    sources_by_file = {}
  end
  if sink == nil
    sink = make_error_sink()
  end

  # The path shown for a source file in `#line` directives, stack-frame
  # records and notes: project-relative (make_show_path in
  # compiler/loader.gem), which keeps them reproducible across machines.
  # Identity when the driver passes no show_path.
  let rel_path = fn(p)
    if show_path == nil
      return p
    end
    show_path(p)
  end

  # The name a user wrote for a compiler-mangled binding, for messages:
  # drops `_sh<N>_` shadow renames (scope_shadowing_lets), then maps a
  # module slot `_mod_<mod>_<name>` to `<mod>.<name>` via global_display
  # (built from the loaded-module table in main.gem). Other names pass
  # through; entry-file `_main_<name>` builtin shadows are display_name's
  # job (defined below, so callers compose the two).
  let user_var_name = fn(name)
    let n = name
    while len(n) > 4 and substr(n, 0, 3) == "_sh"
      let i = 3
      while i < len(n) and ord(n, i) >= 48 and ord(n, i) <= 57
        i += 1
      end
      if i == 3 or i >= len(n) or n[i] != "_"
        break
      end
      n = substr(n, i + 1, len(n) - i - 1)
    end
    if global_display[n] != nil
      return global_display[n]
    end
    n
  end

  # Diagnostic location helpers. Defined up front so any closure inside
  # make_codegen that reports an error can capture them. Returns the source
  # file of an AST node (set per-file by tag_source_file in main.gem), or
  # source_name for entry-file / synthetic nodes.
  let file_of = fn(node)
    if node != nil and node.file != nil
      return node.file
    end
    source_name
  end

  let loc_of = fn(node)
    let f = file_of(node)
    if node != nil and node.line != nil
      return "{rel_path(f)}:{node.line}"
    end
    rel_path(f)
  end

  # Source text for the file containing `node`, used by sink.report() so
  # diagnostics render the offending line + caret. Falls back to nil when
  # a loaded file's text isn't available; print_one_error degrades to
  # message-only output in that case.
  let source_of = fn(node)
    let f = file_of(node)
    if has_key(sources_by_file, f)
      return sources_by_file[f]
    end
    nil
  end

  let functions = []
  let forward_decls = []
  let extern_c_decls = []
  let tmp_counter = 0
  let mark_counter = 0
  let ic_counter = 0
  let ic_init = chr(123) + "0" + chr(125)
  let anon_counter = 0
  let defined_fns = {}
  # The builtin name → C symbol map lives in compiler/builtins.gem so the
  # LSP can read the same list (lsp/completion.gem) without forking it.
  let builtin_fns = BUILTIN_FNS
  let builtins = {}
  for k, _ in builtin_fns
    builtins[k] = true
  end
  # The name to show the user for a binding: an entry-file binding that
  # shadows a builtin is renamed `_main_<name>` (shadow_entry_builtins in
  # compiler/main.gem), shown as `<name>` in messages and stack traces.
  let display_name = fn(name)
    if len(name) > 6 and substr(name, 0, 6) == "_main_"
      let orig = substr(name, 6, len(name) - 6)
      if has_key(builtin_fns, orig)
        return orig
      end
    end
    name
  end
  # The fn name a stack frame shows (printed traces, the pcall `stack`
  # table, crash reports and stack-overflow messages all read it from the
  # frame): fn literals are `anonymous fn`, `_sh<N>_` shadow renames and
  # entry-file `_main_<name>` builtin shadows drop their prefix, and a
  # loaded module's `_mod_<mod>_<name>` is `<mod>.<name>`.
  let frame_name = fn(name)
    if len(name) > 6 and substr(name, 0, 6) == "_anon_"
      return "anonymous fn"
    end
    display_name(user_var_name(name))
  end
  let boxed_vars = {}
  let top_level_vars = {}
  # Whole-module loads: binding name -> {export: top-level name it holds}
  # (`_mod_<mod>_<export>`), for module bindings never rebound (see
  # collect_module_namespaces). `m.x` compiles straight to that slot or fn.
  let module_ns = {}
  # Reverse of module_ns: "_mod_<mod>_<export>" -> [{binding, field}], the
  # namespace entries that hold that binding's value.
  let ns_targets = {}
  let in_top_level = false
  let local_names = {}
  # Subset of `local_names` whose names have an addressable C local at the
  # current fn's top-level scope (params + top-of-body lets, or top-level
  # vars at module scope). Used by `filter_live_for_rescue` to distinguish
  # arm-lets (declared inside a nested if/match block — block-scoped, not
  # addressable from the enclosing while's back-edge) from fn-scope locals.
  let fn_scope_locals = {}
  # Captures of the current `compile_closure_fn` body — env fields backed by
  # `_cls->gem_v_<name>`, each a `GemVal *` to the capture's storage.
  # `filter_live_for_rescue` roots a live capture through that pointer.
  let closure_captures = {}
  # Captures the current closure body assigns when that closure is
  # non-escaping (stack env, `mark_non_escaping`): its env fields point at
  # the creator's unboxed C locals, so an assign stores a value allocated
  # after this body's loop marks into a frame older than those marks. Every
  # loop in the body roots them at its back-edge whether or not liveness
  # finds them live (any statement can raise back to the creator, which
  # then reads them). Empty outside a non-escaping closure.
  let stack_env_writes = {}
  let current_closure_struct_name = nil
  let current_closure_captures = nil
  let tco_fn_name = nil
  let tco_params = nil
  let tco_boxed = nil
  # Rebind mode: the TCO fn has default or rest params, so a self tail call
  # stores its args in `_tco_argv` and jumps to the loop's rebind block,
  # which binds params exactly like function entry does (defaults for
  # omitted args, a fresh rest table). `tco_argv_max` sizes `_tco_argv`.
  let tco_rebind = false
  let tco_argv_max = 0
  # Call graph saved by mark_process_tail for note_spawn_global_writes.
  let pt_caller_records = {}
  let pt_anon_parent = {}
  let pt_anon_nodes = {}
  let pt_name_to_fn = {}
  let mutating_builtins = {}
  for mb_name in ["push", "pop", "insert", "delete", "remove_at", "sort"]
    set_add(mutating_builtins, mb_name)
  end
  # ─── Mutual-tail-call SCC bookkeeping ───
  # `scc_member_to_id[name]` (int) when `name` is a top-level fn_def in a
  # tail-cycle SCC of size >= 2 that survived viability filtering. Set by
  # `find_tail_call_sccs`.
  # `scc_id_to_members[id]` is a sorted array of member names (used to
  # generate stable C identifiers and to seed cross-SCC tail-call detection).
  # `scc_id_max_params[id]` is the largest parameter count among the members:
  # the wrapper copies that many TLB slots, since no body reads more.
  let scc_member_to_id = {}
  let scc_id_to_members = {}
  let scc_id_max_params = {}
  let scc_counter = 0
  # Set inside the body of an SCC member during compile_fn — gives
  # compile_stmt_return a way to recognize "tail call to a sibling in my SCC"
  # and emit the trampoline marker instead of a regular call.
  let current_scc_id = nil
  let append_buf_vars = {}
  # Set when emitting a leaf function (no Gem-level calls in body): instead
  # of `gem_push_frame`/`gem_pop_frame`/`gem_set_line` it records itself in
  # the cheaper leaf slot (gem.h `GemLeafSite`): `gem_leaf_site = &site` on
  # entry, `gem_leaf_line = N` per statement, `gem_leaf_site = NULL` on
  # return. A leaf calls nothing, so it is always the innermost frame and
  # error reports show it on top of the call stack.
  let in_leaf_fn = false

  # ─── Helpers ──

  let tmp = fn()
    tmp_counter += 1
    "_t{tmp_counter}"
  end

  # True for a compiled expression with no side effects whose value can't
  # change while later code runs: a literal, or a temp the setup already
  # computed. Anything else (a call, a variable read) must be evaluated
  # into a temp before a later operand's setup or call runs, so operands
  # run left to right (C leaves the order inside an initializer list or a
  # call's arguments unspecified).
  let is_inert_expr = fn(e)
    if substr(e, 0, 2) == "_t" and len(e) > 2
      for i = 2, len(e)
        let c = e[i]
        if c < "0" or c > "9"
          return false
        end
      end
      return true
    end
    e == "GEM_NIL" or e == "gem_bool(1)" or e == "gem_bool(0)" or substr(e, 0, 8) == "gem_int(" or substr(e, 0, 10) == "gem_float(" or substr(e, 0, 21) == "gem_string_with_len(\"" or e == "gem_string(\"\")"
  end

  # Evaluate a compiled operand now, into a temp, unless it is inert.
  # Returns the setup to append and the expression to use.
  let pin_operand = fn(r)
    if is_inert_expr(r.expr)
      return r
    end
    let t = tmp()
    {expr: t, setup: r.setup + "    GemVal {t} = {r.expr};\n"}
  end

  let anon_name = fn()
    anon_counter += 1
    "_anon_{anon_counter}"
  end

  let mangle = fn(name)
    "gem_v_{name}"
  end

  # ─── Module globals ──
  #
  # Top-level bindings (`top_level_vars`) are per-process module slots:
  # `gem_gi_<name>` is `#define`d to the slot index and `gem_g_<name>` to
  # `gem_global_get(<index>)`, a read of the running process's slot
  # (runtime/gem.h). Writes go through `gem_global_set` (plain assignment)
  # or `gem_global_ref` (read-modify-write lvalue); both tell the runtime
  # the slot changed, which lazy module copy at spawn relies on. A name refers to the module slot when it
  # is a top-level var and the current scope has no local of that name:
  # in top-level code every top-level var name is the slot; inside a fn or
  # closure, a param/let/capture of the same name shadows it. Module slots
  # are never captured by closures (every reader sees the live value) and
  # never passed as reset roots (the runtime roots all slots).
  let is_global_ref = fn(name)
    if not set_contains(top_level_vars, name)
      return false
    end
    if in_top_level
      return true
    end
    not set_contains(fn_scope_locals, name) and not set_contains(closure_captures, name)
  end

  let gmangle = fn(name)
    "gem_g_{name}"
  end

  let gindex = fn(name)
    "gem_gi_{name}"
  end

  let join_c = fn(items)
    let out = ""
    for i = 0, len(items)
      if i > 0
        out = out + ", "
      end
      out = out + items[i]
    end
    out
  end

  let emit_region_reset = fn(p, mark, roots, pinned)
    let b = buf_new()
    buf_push(b, "{p}if (gem_arena_reset_due(&{mark})) \{\n")
    let roots_arg = "NULL"
    let pinned_arg = "NULL"
    if len(roots) > 0
      buf_push(b, "{p}    GemVal *_rr[] = \{{join_c(roots)}};\n")
      roots_arg = "_rr"
    end
    if len(pinned) > 0
      buf_push(b, "{p}    GemVal *_rp[] = \{{join_c(pinned)}};\n")
      pinned_arg = "_rp"
    end
    buf_push(b, "{p}    gem_arena_reset_region(&{mark}, {roots_arg}, {len(roots)}, {pinned_arg}, {len(pinned)});\n")
    buf_push(b, "{p}}\n")
    to_string(b)
  end

  # After a write to an exported module binding: update the namespace
  # tables that hold it (`let ns = m; ns.x` stays the module's live `x`;
  # `m.x` itself compiles straight to the binding). Empty for anything else.
  let ns_refresh = fn(name, p)
    if ns_targets[name] == nil or not is_global_ref(name)
      return ""
    end
    let out = ""
    for t in ns_targets[name]
      if set_contains(top_level_vars, t.binding)
        out = out + "{p}gem_ns_refresh({gmangle(t.binding)}, \"{escape_c_string(t.field)}\", {gmangle(name)});\n"
      end
    end
    out
  end

  # C lvalue for variable `name` in the current scope.
  let var_lvalue = fn(name)
    if is_global_ref(name)
      return "(*gem_global_ref({gindex(name)}))"
    end
    if set_contains(boxed_vars, name)
      return "(*{mangle(name)})"
    end
    mangle(name)
  end

  # C statement storing `expr` into variable `name` (no trailing newline).
  let var_store = fn(name, expr)
    if is_global_ref(name)
      return "gem_global_set({gindex(name)}, {expr});"
    end
    "{var_lvalue(name)} = {expr};"
  end

  # Frame bookkeeping helpers — return empty strings inside leaf fns so the
  # generated C drops the runtime call entirely. Every site that emits
  # `gem_pop_frame()` or `gem_set_line(...)` must go through these.
  let pop_str = fn(p)
    if in_leaf_fn
      "{p}gem_leaf_site = NULL;\n"
    else
      "{p}gem_pop_frame();\n"
    end
  end
  let setline_str = fn(line, p)
    if in_leaf_fn
      "{p}gem_leaf_line = {line};\n"
    else
      "{p}gem_set_line({line});\n"
    end
  end
  # Entry bookkeeping of a leaf fn (after its param bindings: a default
  # expression may call another fn). The line is set here only when the
  # first statement doesn't set it.
  let leaf_entry_str = fn(name, file, line, body)
    let b = buf_new()
    buf_push(b, "    static const GemLeafSite _leaf_site = \{\"{escape_c_string(name)}\", \"{escape_c_string(file)}\"};\n")
    buf_push(b, "    gem_leaf_site = &_leaf_site;\n")
    if len(body) == 0 or type(body[0]) != "table" or body[0].line == nil
      buf_push(b, "    gem_leaf_line = {line};\n")
    end
    to_string(b)
  end

  # ─── Free variable analysis ──

  let collect_free_vars = nil
  let collect_free_node = nil

  collect_free_node = fn(node, defined, free)
    if node == nil
      return nil
    end
    if type(node) != "table"
      return nil
    end
    if node.tag == nil
      return nil
    end

    match node
    when {tag: "var", name: name}
      if not set_contains(defined, name) and (not set_contains(builtins, name) or set_contains(local_names, name)) and not set_contains(defined_fns, name)
        set_add(free, name)
      end
    when {tag: "let", value: value}
      collect_free_node(value, defined, free)
    when {tag: "assign", name: name, value: value}
      if not set_contains(defined, name) and (not set_contains(builtins, name) or set_contains(local_names, name)) and not set_contains(defined_fns, name)
        set_add(free, name)
      end
      collect_free_node(value, defined, free)
    when {tag: "anon_fn", params: params, rest_param: rest_param, body: body}
      let inner_defined = set_union(defined, sorted_array_to_set(params))
      if rest_param != nil
        set_add(inner_defined, rest_param)
      end
      let inner_free = collect_free_vars(body, inner_defined)
      if node.defaults != nil
        for d in node.defaults
          if d != nil
            collect_free_node(d, inner_defined, inner_free)
          end
        end
      end
      for ifk, _ in inner_free
        set_add(free, ifk)
      end
    when {tag: "fn_def"}
      # Named functions are global — skip
    when {tag: "if", cond: cond, then: thens, else: el}
      collect_free_node(cond, defined, free)
      let d = set_union(defined, {})
      for i = 0, len(thens)
        collect_free_node(thens[i], d, free)
        if is_node(thens[i], "let")
          set_add(d, thens[i].name)
        end
      end
      if el != nil
        d = set_union(defined, {})
        for i = 0, len(el)
          collect_free_node(el[i], d, free)
          if is_node(el[i], "let")
            set_add(d, el[i].name)
          end
        end
      end
    when {tag: "while", cond: cond, body: body}
      collect_free_node(cond, defined, free)
      let d = set_union(defined, {})
      for i = 0, len(body)
        collect_free_node(body[i], d, free)
        if is_node(body[i], "let")
          set_add(d, body[i].name)
        end
      end
    when {tag: "match", target: target, target_var: target_var, whens: whens, else: el}
      collect_free_node(target, defined, free)
      let match_def = set_union(defined, {})
      if target_var != nil
        set_add(match_def, target_var)
      end
      for i = 0, len(whens)
        let w = whens[i]
        collect_free_node(w.value, match_def, free)
        let d = set_union(match_def, {})
        if w.bindings != nil
          for bi = 0, len(w.bindings)
            collect_free_node(w.bindings[bi], d, free)
            if is_node(w.bindings[bi], "let")
              set_add(d, w.bindings[bi].name)
            end
          end
        end
        for j = 0, len(w.body)
          collect_free_node(w.body[j], d, free)
          if is_node(w.body[j], "let")
            set_add(d, w.body[j].name)
          end
        end
      end
      if el != nil
        let d = set_union(defined, {})
        for j = 0, len(el)
          collect_free_node(el[j], d, free)
          if is_node(el[j], "let")
            set_add(d, el[j].name)
          end
        end
      end
    when {tag: "when_clause", value: value, bindings: bindings, body: body}
      collect_free_node(value, defined, free)
      let d = set_union(defined, {})
      if bindings != nil
        for bi = 0, len(bindings)
          collect_free_node(bindings[bi], d, free)
          if is_node(bindings[bi], "let")
            set_add(d, bindings[bi].name)
          end
        end
      end
      for i = 0, len(body)
        collect_free_node(body[i], d, free)
        if is_node(body[i], "let")
          set_add(d, body[i].name)
        end
      end
    when {tag: "receive_match", arms: rm_arms, after_ms: rm_after_ms, after_body: rm_after_body}
      let recv_def = set_union(defined, {})
      if node.recv_var != nil
        set_add(recv_def, node.recv_var)
      end
      for i = 0, len(rm_arms)
        let arm = rm_arms[i]
        collect_free_node(arm.pattern.condition, recv_def, free)
        let d = set_union(recv_def, {})
        if arm.pattern.bindings != nil
          for bi = 0, len(arm.pattern.bindings)
            collect_free_node(arm.pattern.bindings[bi], d, free)
            if is_node(arm.pattern.bindings[bi], "let")
              set_add(d, arm.pattern.bindings[bi].name)
            end
          end
        end
        for j = 0, len(arm.body)
          collect_free_node(arm.body[j], d, free)
          if is_node(arm.body[j], "let")
            set_add(d, arm.body[j].name)
          end
        end
      end
      if rm_after_ms != nil
        collect_free_node(rm_after_ms, recv_def, free)
      end
      if rm_after_body != nil
        let d = set_union(recv_def, {})
        for j = 0, len(rm_after_body)
          collect_free_node(rm_after_body[j], d, free)
          if is_node(rm_after_body[j], "let")
            set_add(d, rm_after_body[j].name)
          end
        end
      end
    when {tag: "table", entries: entries}
      for i = 0, len(entries)
        collect_free_node(entries[i].value, defined, free)
      end
    when {tag: "array", elements: elements}
      for i = 0, len(elements)
        collect_free_node(elements[i], defined, free)
      end
    when {tag: "block", stmts: stmts}
      let d = set_union(defined, {})
      for i = 0, len(stmts)
        collect_free_node(stmts[i], d, free)
        if is_node(stmts[i], "let")
          set_add(d, stmts[i].name)
        end
      end
    when {tag: "return", value: value}
      if value != nil
        collect_free_node(value, defined, free)
      end
    else
      # Generic recursion for binop, unop, call, dot, index, etc.
      for nk, v in node
        if nk != "tag"
          if type(v) == "table"
            let vks = keys(v)
            if len(vks) > 0 and type(vks[0]) == "int"
              let vi = 0
              while vi < len(v)
                if type(v[vi]) == "table"
                  collect_free_node(v[vi], defined, free)
                end
                vi += 1
              end
            else
              collect_free_node(v, defined, free)
            end
          end
        end
      end
    end
  end

  collect_free_vars = fn(stmts, defined)
    let free = {}
    let d = set_union(defined, {})
    for i = 0, len(stmts)
      collect_free_node(stmts[i], d, free)
      if is_node(stmts[i], "let")
        set_add(d, stmts[i].name)
      end
      collect_block_lets(stmts[i], d)
    end
    free
  end

  # ─── Capture analysis ──

  let walk_captures = nil
  let walk_captures_node = nil

  walk_captures_node = fn(node, scope_vars, captured)
    if node == nil
      return nil
    end
    if type(node) != "table"
      return nil
    end
    if node.tag == nil
      return nil
    end

    match node
    when {tag: "anon_fn", params: params, rest_param: rest_param, body: body}
      if node.non_escaping == true
        # Marked as immediate-call arg of an allowlisted callee (pcall/sort)
        # with no nested anon_fns. References to outer scope_vars don't
        # force boxing in the enclosing frame.
        return nil
      end
      let inner_defined = sorted_array_to_set(params)
      if rest_param != nil
        set_add(inner_defined, rest_param)
      end
      let free = collect_free_vars(body, inner_defined)
      if node.defaults != nil
        for d in node.defaults
          if d != nil
            collect_free_node(d, inner_defined, free)
          end
        end
      end
      let inter = set_intersect(free, scope_vars)
      for ik, _ in inter
        set_add(captured, ik)
      end
    when {tag: "fn_def"}
      # Named fns are global — skip
    when {tag: "if", cond: cond, then: thens, else: el}
      walk_captures_node(cond, scope_vars, captured)
      walk_captures(thens, scope_vars, captured)
      if el != nil
        walk_captures(el, scope_vars, captured)
      end
    when {tag: "while", cond: cond, body: body}
      walk_captures_node(cond, scope_vars, captured)
      walk_captures(body, scope_vars, captured)
    when {tag: "match", target: target, whens: whens, else: el}
      walk_captures_node(target, scope_vars, captured)
      for i = 0, len(whens)
        walk_captures_node(whens[i].value, scope_vars, captured)
        if whens[i].bindings != nil
          for bi = 0, len(whens[i].bindings)
            walk_captures_node(whens[i].bindings[bi], scope_vars, captured)
          end
        end
        walk_captures(whens[i].body, scope_vars, captured)
      end
      if el != nil
        walk_captures(el, scope_vars, captured)
      end
    when {tag: "receive_match", arms: rm_arms, after_ms: rm_after_ms, after_body: rm_after_body}
      for i = 0, len(rm_arms)
        walk_captures_node(rm_arms[i].pattern.condition, scope_vars, captured)
        if rm_arms[i].pattern.bindings != nil
          for bi = 0, len(rm_arms[i].pattern.bindings)
            walk_captures_node(rm_arms[i].pattern.bindings[bi], scope_vars, captured)
          end
        end
        walk_captures(rm_arms[i].body, scope_vars, captured)
      end
      if rm_after_ms != nil
        walk_captures_node(rm_after_ms, scope_vars, captured)
      end
      if rm_after_body != nil
        walk_captures(rm_after_body, scope_vars, captured)
      end
    when {tag: "table", entries: entries}
      for i = 0, len(entries)
        walk_captures_node(entries[i].value, scope_vars, captured)
      end
    when {tag: "array", elements: elements}
      for i = 0, len(elements)
        walk_captures_node(elements[i], scope_vars, captured)
      end
    when {tag: "block", stmts: stmts}
      walk_captures(stmts, scope_vars, captured)
    when {tag: "return", value: value}
      if value != nil
        walk_captures_node(value, scope_vars, captured)
      end
    when {tag: "let", value: value}
      walk_captures_node(value, scope_vars, captured)
    when {tag: "assign", value: value}
      walk_captures_node(value, scope_vars, captured)
    else
      # Generic recursion
      for nk, v in node
        if nk != "tag"
          if type(v) == "table"
            let vks = keys(v)
            if len(vks) > 0 and type(vks[0]) == "int"
              let vi = 0
              while vi < len(v)
                if type(v[vi]) == "table"
                  walk_captures_node(v[vi], scope_vars, captured)
                end
                vi += 1
              end
            else
              walk_captures_node(v, scope_vars, captured)
            end
          end
        end
      end
    end
  end

  walk_captures = fn(stmts, scope_vars, captured)
    let sv = set_union(scope_vars, {})
    for i = 0, len(stmts)
      walk_captures_node(stmts[i], sv, captured)
      if is_node(stmts[i], "let")
        set_add(sv, stmts[i].name)
      end
      collect_block_lets(stmts[i], sv)
    end
  end

  let find_captured_in_scope = fn(body, scope_vars)
    let captured = {}
    walk_captures(body, scope_vars, captured)
    captured
  end

  # ─── Mutation classification for captures ──
  #
  # For a body and its scope_vars, return the subset of scope_vars that any
  # escaping anon_fn within body (or any anon_fn nested within those) writes
  # to via a bare `name = value` assign. Captures not in this set are
  # read-only-from-the-outer's-perspective and qualify for Route A: the env
  # stores a `GemVal` snapshot rather than a `GemVal *`, and the outer frame
  # need not box them.
  #
  # The same walker also handles the per-closure perspective: passing
  # inside_anon=true treats the body itself as already inside a closure, so
  # direct assigns to scope_vars at the body level (not inside a further
  # nested anon_fn) also count. Used by compile_closure_fn to classify which
  # of its incoming env captures it itself mutates.
  #
  # `dot_assign` / `index_assign` mutate the value, not the binding, so they
  # do not count. `let` introduces a fresh local that shadows the outer name
  # for subsequent statements in scope.
  let walk_writes = nil
  let walk_writes_node = nil

  walk_writes_node = fn(node, scope_vars, defined, writes, inside_anon)
    if node == nil
      return nil
    end
    if type(node) != "table"
      return nil
    end
    if node.tag == nil
      return nil
    end

    match node
    when {tag: "assign", name: name, value: value}
      # A captured name needs boxing whenever it is reassigned anywhere in
      # its lexical scope — whether the assign is inside a nested closure
      # (closure mutates outer's binding) or outside (later closures must
      # see the new value via the shared box, matching established
      # closure-rebind-after-capture semantics).
      if set_contains(scope_vars, name) and not set_contains(defined, name)
        set_add(writes, name)
      end
      walk_writes_node(value, scope_vars, defined, writes, inside_anon)
    when {tag: "let", value: value}
      walk_writes_node(value, scope_vars, defined, writes, inside_anon)
    when {tag: "anon_fn", params: params, rest_param: rest_param, body: body}
      if node.non_escaping == true and not inside_anon
        # Non-escaping closures use stack-pointer semantics; their writes
        # mutate the outer's local directly without forcing it to be boxed,
        # so they don't contribute to the writes set we use to decide boxing.
        # Inside an escaping closure they do count: there the name is a
        # capture of that closure, and an unmutated capture gets a
        # write-once snapshot box, which the non-escaping closure would
        # then assign (the write would be lost to the creator, and the
        # snapshot box, older than any loop mark, would point into a reset
        # region).
        return nil
      end
      # When transitioning from outside-any-closure into an anon_fn, reset
      # `defined` to just this anon's params: the surrounding scope's lets
      # are the *targets* of mutation analysis, not local shadows. When
      # already inside an anon (anon-in-anon), carry the outer anon's locals
      # forward — those do shadow further-out names from this inner anon's
      # perspective.
      let inner_def = nil
      if inside_anon
        inner_def = set_union(defined, sorted_array_to_set(params))
      else
        inner_def = sorted_array_to_set(params)
      end
      if rest_param != nil
        set_add(inner_def, rest_param)
      end
      walk_writes(body, scope_vars, inner_def, writes, true)
      if node.defaults != nil
        for d in node.defaults
          if d != nil
            walk_writes_node(d, scope_vars, inner_def, writes, true)
          end
        end
      end
    when {tag: "fn_def"}
      # Named fns are global — skip
    when {tag: "if", cond: cond, then: thens, else: el}
      walk_writes_node(cond, scope_vars, defined, writes, inside_anon)
      walk_writes(thens, scope_vars, defined, writes, inside_anon)
      if el != nil
        walk_writes(el, scope_vars, defined, writes, inside_anon)
      end
    when {tag: "while", cond: cond, body: body}
      walk_writes_node(cond, scope_vars, defined, writes, inside_anon)
      walk_writes(body, scope_vars, defined, writes, inside_anon)
    when {tag: "match", target: target, target_var: target_var, whens: whens, else: el}
      walk_writes_node(target, scope_vars, defined, writes, inside_anon)
      let match_def = set_union(defined, {})
      if target_var != nil
        set_add(match_def, target_var)
      end
      for i = 0, len(whens)
        let w = whens[i]
        walk_writes_node(w.value, scope_vars, match_def, writes, inside_anon)
        let d = set_union(match_def, {})
        if w.bindings != nil
          for bi = 0, len(w.bindings)
            walk_writes_node(w.bindings[bi], scope_vars, d, writes, inside_anon)
            if is_node(w.bindings[bi], "let")
              set_add(d, w.bindings[bi].name)
            end
          end
        end
        walk_writes(w.body, scope_vars, d, writes, inside_anon)
      end
      if el != nil
        walk_writes(el, scope_vars, defined, writes, inside_anon)
      end
    when {tag: "receive_match", arms: rm_arms, after_ms: rm_after_ms, after_body: rm_after_body}
      let recv_def = set_union(defined, {})
      if node.recv_var != nil
        set_add(recv_def, node.recv_var)
      end
      for i = 0, len(rm_arms)
        let arm = rm_arms[i]
        walk_writes_node(arm.pattern.condition, scope_vars, recv_def, writes, inside_anon)
        let d = set_union(recv_def, {})
        if arm.pattern.bindings != nil
          for bi = 0, len(arm.pattern.bindings)
            walk_writes_node(arm.pattern.bindings[bi], scope_vars, d, writes, inside_anon)
            if is_node(arm.pattern.bindings[bi], "let")
              set_add(d, arm.pattern.bindings[bi].name)
            end
          end
        end
        walk_writes(arm.body, scope_vars, d, writes, inside_anon)
      end
      if rm_after_ms != nil
        walk_writes_node(rm_after_ms, scope_vars, recv_def, writes, inside_anon)
      end
      if rm_after_body != nil
        walk_writes(rm_after_body, scope_vars, recv_def, writes, inside_anon)
      end
    when {tag: "table", entries: entries}
      for i = 0, len(entries)
        walk_writes_node(entries[i].value, scope_vars, defined, writes, inside_anon)
      end
    when {tag: "array", elements: elements}
      for i = 0, len(elements)
        walk_writes_node(elements[i], scope_vars, defined, writes, inside_anon)
      end
    when {tag: "block", stmts: stmts}
      walk_writes(stmts, scope_vars, defined, writes, inside_anon)
    when {tag: "return", value: value}
      if value != nil
        walk_writes_node(value, scope_vars, defined, writes, inside_anon)
      end
    else
      # Generic recursion
      for nk, v in node
        if nk != "tag"
          if type(v) == "table"
            let vks = keys(v)
            if len(vks) > 0 and type(vks[0]) == "int"
              let vi = 0
              while vi < len(v)
                if type(v[vi]) == "table"
                  walk_writes_node(v[vi], scope_vars, defined, writes, inside_anon)
                end
                vi += 1
              end
            else
              walk_writes_node(v, scope_vars, defined, writes, inside_anon)
            end
          end
        end
      end
    end
  end

  walk_writes = fn(stmts, scope_vars, defined, writes, inside_anon)
    let sv = set_union(defined, {})
    for i = 0, len(stmts)
      walk_writes_node(stmts[i], scope_vars, sv, writes, inside_anon)
      # Only growing `defined` when walking inside an anon: there, lets are
      # locals that shadow scope_vars (outer captures). At the outer scope
      # itself, lets are *the binding sites* of scope_vars — assigns that
      # follow them target those same bindings and must count as writes.
      if inside_anon
        if is_node(stmts[i], "let")
          set_add(sv, stmts[i].name)
        end
        collect_block_lets(stmts[i], sv)
      end
    end
  end

  # Outer-fn perspective: which scope_vars are written by any anon_fn within?
  let find_capture_writes_in_scope = fn(body, scope_vars)
    let writes = {}
    walk_writes(body, scope_vars, {}, writes, false)
    writes
  end

  # Closure-body perspective: which captures does this closure body itself
  # (or any anon_fn nested within) write to? `defined` is the closure's own
  # local scope (params + body lets) — assigns to those don't count.
  let find_writes_in_closure_body = fn(body, captures_set, defined)
    let writes = {}
    walk_writes(body, captures_set, defined, writes, true)
    writes
  end

  # ─── Non-escaping closure detection ──
  #
  # Mark anon_fn nodes that appear as the immediate argument of a call to an
  # allowlisted callee (currently `pcall`). Such closures are invoked
  # synchronously and discarded — they cannot outlive the C frame holding
  # their captures, so the enclosing function need not box those captures.
  # Conservative: we only mark closures whose own body contains no nested
  # anon_fns, sidestepping the case where a nested escaping closure could
  # smuggle outer captures past the synchronous call.

  let non_escape_callees = {}
  set_add(non_escape_callees, "pcall")
  set_add(non_escape_callees, "sort")

  let contains_anon_fn = nil
  contains_anon_fn = fn(node)
    if node == nil
      return false
    end
    if type(node) != "table"
      return false
    end
    if node.tag == nil
      return false
    end
    if node.tag == "anon_fn"
      return true
    end
    for nk, v in node
      if nk != "tag" and type(v) == "table"
        let vks = keys(v)
        if len(vks) > 0 and type(vks[0]) == "int"
          let vi = 0
          while vi < len(v)
            if type(v[vi]) == "table"
              if contains_anon_fn(v[vi])
                return true
              end
            end
            vi += 1
          end
        else
          if contains_anon_fn(v)
            return true
          end
        end
      end
    end
    false
  end

  let body_has_anon_fn = fn(stmts)
    for s in stmts
      if contains_anon_fn(s)
        return true
      end
    end
    false
  end

  # True when `name` is bound anywhere under `node` (a let — lowered
  # for-loop vars and pattern bindings included — or a parameter). A
  # call to such a name may reach the user's binding instead of the
  # builtin, so mark_non_escaping must not trust it.
  let binds_name = nil
  binds_name = fn(node, name)
    if type(node) != "table"
      return false
    end
    if node.tag == "let" and node.name == name
      return true
    end
    if node.tag == "fn_def" or node.tag == "anon_fn"
      if node.rest_param == name
        return true
      end
      if node.params != nil
        for p in node.params
          if p == name
            return true
          end
        end
      end
    end
    for _, v in node
      if type(v) == "table" and binds_name(v, name)
        return true
      end
    end
    false
  end

  # Allowlisted callees a binding in the scope being marked shadows.
  let shadowed_non_escape = {}

  let mark_non_escaping = nil
  mark_non_escaping = fn(node)
    if node == nil
      return nil
    end
    if type(node) != "table"
      return nil
    end
    if node.tag == nil
      return nil
    end

    if node.tag == "call" and node.func != nil and is_node(node.func, "var") and set_contains(non_escape_callees, node.func.name) and not set_contains(shadowed_non_escape, node.func.name)
      if node.args != nil
        for a in node.args
          if is_node(a, "anon_fn") and not body_has_anon_fn(a.body)
            a.non_escaping = true
          end
        end
      end
    end

    for nk, v in node
      if nk != "tag" and type(v) == "table"
        let vks = keys(v)
        if len(vks) > 0 and type(vks[0]) == "int"
          let vi = 0
          while vi < len(v)
            if type(v[vi]) == "table"
              mark_non_escaping(v[vi])
            end
            vi += 1
          end
        else
          mark_non_escaping(v)
        end
      end
    end
  end

  # `scope` is the fn_def (or the top-level statement list) being marked.
  # Conservative: a builtin name bound anywhere in it disables the
  # allowlist entry for all of it.
  let mark_non_escaping_stmts = fn(stmts, scope)
    shadowed_non_escape = {}
    for callee, _ in non_escape_callees
      if binds_name(scope, callee)
        set_add(shadowed_non_escape, callee)
      end
    end
    for s in stmts
      mark_non_escaping(s)
    end
  end

  # ─── Compilation ──

  let compile_expr = nil

  # Compile a two-operand form left to right: the left operand (already
  # compiled) is evaluated before anything the right one runs.
  let operands = fn(left_r, right_node)
    let right_r = compile_expr(right_node)
    if right_r.setup != "" or not is_inert_expr(right_r.expr)
      left_r = pin_operand(left_r)
    end
    {left: left_r.expr, right: right_r.expr, setup: left_r.setup + right_r.setup}
  end

  # Make a list of compiled operands (call arguments, interpolation parts)
  # run left to right: an operand is evaluated into a temp when anything
  # after it runs code (a later operand's setup or call). The last one
  # never needs it. Returns the concatenated setup and the expressions.
  let left_to_right = fn(results)
    let later_runs = false
    let i = len(results) - 1
    while i >= 0
      let r = results[i]
      if later_runs
        r = pin_operand(r)
        results[i] = r
      end
      if r.setup != "" or not is_inert_expr(r.expr)
        later_runs = true
      end
      i -= 1
    end
    let b = buf_new()
    let exprs = []
    for r in results
      buf_push(b, r.setup)
      push(exprs, r.expr)
    end
    {setup: to_string(b), exprs: exprs}
  end
  let compile_stmt = nil
  let compile_stmt_return = nil
  let compile_stmts = nil
  let compile_stmts_tail = nil
  let compile_if = nil
  let compile_while = nil
  let compile_match = nil
  let compile_receive_match = nil
  let compile_call = nil
  let compile_binop = nil
  let compile_anon_fn = nil
  let compile_closure_fn = nil
  let compile_table = nil
  let compile_array = nil
  let compile_extern_fn = nil
  let compile_blocking_extern_fn = nil
  let compile_fn = nil
  let is_self_tail_call = nil
  let has_self_tail_call = nil
  let emit_tco_continue = nil
  let find_tail_call_sccs = nil
  let emit_scc_tail_call = nil
  let scc_wrapper_for = nil

  # ─── TCO (tail call optimization) ──

  is_self_tail_call = fn(fn_name, node)
    if node == nil
      return false
    end
    if type(node) != "table" or node.tag == nil
      return false
    end
    match node
    when {tag: "call", func: func}
      return is_node(func, "var") and func.name == fn_name
    when {tag: "return", value: value}
      if value != nil
        return is_self_tail_call(fn_name, value)
      end
      return false
    when {tag: "if", then: then_body, else: else_body}
      if has_self_tail_call(fn_name, then_body)
        return true
      end
      if else_body != nil
        return has_self_tail_call(fn_name, else_body)
      end
      return false
    when {tag: "match", whens: whens, else: else_body}
      for i = 0, len(whens)
        if has_self_tail_call(fn_name, whens[i].body)
          return true
        end
      end
      if else_body != nil
        return has_self_tail_call(fn_name, else_body)
      end
      return false
    when {tag: "receive_match", arms: arms, after_body: after_body}
      for i = 0, len(arms)
        if has_self_tail_call(fn_name, arms[i].body)
          return true
        end
      end
      if after_body != nil
        return has_self_tail_call(fn_name, after_body)
      end
      return false
    when {tag: "block", stmts: stmts}
      return has_self_tail_call(fn_name, stmts)
    end
    return false
  end

  has_self_tail_call = fn(fn_name, stmts)
    if len(stmts) == 0
      return false
    end
    is_self_tail_call(fn_name, stmts[-1])
  end

  # Whether compile_fn turns a named fn's self tail calls into a loop: it has
  # one, and no param, rest param or body-level let shadows the fn's name.
  # Default, rest and destructured params are all supported (rebind mode in
  # emit_tco_continue / compile_fn).
  let fn_def_is_tco = fn(fd)
    let scope_vars = sorted_array_to_set(fd.params)
    if fd.rest_param != nil
      set_add(scope_vars, fd.rest_param)
    end
    collect_top_let_names(fd.body, scope_vars)
    if set_contains(scope_vars, fd.name)
      return false
    end
    has_self_tail_call(fd.name, fd.body)
  end

  # ─── Leaf-function detection ──
  #
  # A function is a "leaf" iff its body invokes no other function: no `call`
  # AST node, no `receive_match` (which can yield to other coroutines mid-call
  # and re-enters scheduler bookkeeping). Builtins are *also* calls — every
  # builtin invocation parses as `call(var(name), args)` — so any use of
  # `print`, `len`, `error`, etc. disqualifies the fn as leaf. Restrictive on
  # purpose: it makes elision trivially sound w.r.t. stack-trace correctness
  # (no inner Gem fn pushes a frame whose attribution depends on us pushing
  # one first; no builtin reaches `gem_error` whose trace would otherwise
  # show our absent frame).
  #
  # Arithmetic, comparisons, table/array literals, var reads, dot access,
  # interp, control flow — none of these are calls. So small predicates and
  # accessors qualify; almost anything that touches `len()`, `print()`, etc.
  # does not.
  let node_has_calls = nil
  node_has_calls = fn(node)
    if node == nil
      return false
    end
    if type(node) != "table"
      return false
    end
    let tag = node.tag
    if tag == "call" or tag == "receive_match"
      return true
    end
    if tag == "anon_fn" or tag == "fn_def"
      # Nested fn definition — its body is a separate compilation unit, not
      # invoked by mere mention. Default-arg expressions DO run when the
      # nested fn is later called, but not when this body runs, so they
      # don't affect leaf-ness either. Don't descend.
      return false
    end
    # Generic descent into all subfields. Skip primitive scalars.
    for k, v in node
      if type(v) == "table"
        if node_has_calls(v)
          return true
        end
      end
    end
    false
  end
  let body_is_leaf = fn(body)
    for s in body
      if node_has_calls(s)
        return false
      end
    end
    true
  end

  # ─── Call graph ──
  #
  # `mark_process_tail` records, per caller (each fn_def, each closure body,
  # each spawn body, and the top-level program), its tail and non-tail
  # callees and the writes it makes. Consumers: mutual-TCO SCC detection
  # (tail edges) and the module-state note (note_spawn_global_writes). It
  # also tags loops and attaches liveness. (Historically it decided which
  # functions were "process-tail", i.e. allowed to reset the arena; region
  # resets made that unnecessary.)

  let spawn_callees = {}
  set_add(spawn_callees, "spawn")
  set_add(spawn_callees, "spawn_link")
  set_add(spawn_callees, "spawn_monitor")

  let mark_process_tail = fn(fn_defs, top_stmts)
    let caller_records = {}
    let name_to_fn = {}
    for fd in fn_defs
      name_to_fn[fd.name] = fd
    end

    # Module loads desugar at the top level into either:
    #   (a) selective: `let foo = _mod_mod_foo` (one let per imported name).
    #   (b) whole-module: `let mod = {fn_a: _mod_mod_fn_a, fn_b: …}`
    #       (frozen table, one entry per export).
    # Calls in the importing module then use `foo(…)` or `mod.fn_a(…)`,
    # neither of which lex as a direct call to `_mod_…_…`. Without
    # resolution those edges are dropped from the call graph and
    # `mark_process_tail` can't reason about them. Build two maps:
    #   alias_to_fn[name]            → fn_def name (case a)
    #   module_dot_to_fn[mod][field] → fn_def name (case b)
    let alias_to_fn = {}
    let module_dot_to_fn = {}
    for s in top_stmts
      if is_node(s, "let") and s.value != nil
        if is_node(s.value, "var")
          if name_to_fn[s.value.name] != nil
            alias_to_fn[s.name] = s.value.name
          end
        elif is_node(s.value, "table") and s.value.entries != nil
          let mod_map = {}
          let any = false
          for e in s.value.entries
            if e.value != nil and is_node(e.value, "var") and name_to_fn[e.value.name] != nil
              # Entry key may be either a raw string (when synthesized by
              # main.gem's `make_table_entry`) or a string AST node (when
              # parsed from user source).
              let key_str = nil
              if type(e.key) == "string"
                key_str = e.key
              elif e.key != nil and is_node(e.key, "string")
                key_str = e.key.value
              end
              if key_str != nil
                mod_map[key_str] = e.value.name
                any = true
              end
            end
          end
          if any
            module_dot_to_fn[s.name] = mod_map
          end
        end
      end
    end

    # Resolve a call-target var name to its fn_def name (or nil if not a
    # known fn). Handles direct fn-name calls and selective-load aliases.
    let resolve_callee = fn(name)
      if name_to_fn[name] != nil
        return name
      end
      let aliased = alias_to_fn[name]
      if aliased != nil
        return aliased
      end
      nil
    end

    # Resolve a `mod.field`-style callee (whole-module loads) to its
    # fn_def name, or nil if not a known module export.
    let resolve_dot_callee = fn(mod_name, field_name)
      let m = module_dot_to_fn[mod_name]
      if m == nil
        return nil
      end
      let f = m[field_name]
      if f == nil
        return nil
      end
      f
    end

    let anon_id_counter = 0
    let next_anon_id = fn()
      let id = "anon:" + to_string(anon_id_counter)
      anon_id_counter += 1
      id
    end

    let new_caller_record = fn(caller_id, is_seed)
      caller_records[caller_id] = {tail_callees: {}, non_tail_callees: {}, is_seed: is_seed, writes: []}
    end

    # Sites that write a variable binding (`x = ...`) or mutate the value a
    # variable holds (`x.f = ...`, `x[k] = ...`, `push(x, ...)`, ...), for
    # the module-state note (note_spawn_global_writes).
    # `via`: the builtin a `push(x, ...)`-style write calls, which a param
    # or local of the same name shadows (checked by the note).
    let record_write = fn(caller_id, name, node, via = nil)
      push(caller_records[caller_id].writes, {name: name, node: node, via: via})
    end

    # Lexical parent of each anon caller cid (i.e. the caller_id that
    # contained the `anon_fn` expression at AST construction time). Lets
    # the upward outer-reset BFS hop from a closure body to the fn that
    # built it — without this, all closure-mediated call chains terminate
    # at the anon and lose the connection to any PT context above.
    let anon_parent = {}

    # A `return` with a trivial constant (or no value) exits the enclosing
    # function without reading any locals. A call immediately followed by such
    # a return is therefore tail-effective: even though textually non-last,
    # the C frame holds no live state at the point the call's reset would fire.
    # This recognizes the common early-exit pattern `f(); return nil`.
    let is_trivial_return = fn(s)
      if not is_node(s, "return")
        return false
      end
      if s.value == nil
        return true
      end
      if is_node(s.value, "nil")
        return true
      end
      if is_node(s.value, "int")
        return true
      end
      if is_node(s.value, "float")
        return true
      end
      if is_node(s.value, "bool")
        return true
      end
      if is_node(s.value, "string")
        return true
      end
      false
    end

    let collect_calls = nil
    let collect_calls_in_body = nil

    collect_calls = fn(node, is_tail_pos, caller_id)
      if node == nil
        return nil
      end
      if type(node) != "table"
        return nil
      end
      if node.tag == nil
        return nil
      end

      if node.tag == "call"
        # Spawn-family with anon_fn arg[0]: that anon body is a fresh process root.
        if is_node(node.func, "var") and set_contains(spawn_callees, node.func.name)
          if node.args != nil and len(node.args) > 0 and is_node(node.args[0], "anon_fn")
            let aid = next_anon_id()
            new_caller_record(aid, true)
            anon_parent[aid] = caller_id
            # The callee may be a param or local named `spawn`, ...;
            # note_spawn_global_writes checks it against the caller's
            # locals before treating the body as a process.
            pt_anon_nodes[aid] = {fn: node.args[0], spawn: node, spawn_via: node.func.name}
            collect_calls_in_body(node.args[0].body, true, aid)
            if node.args[0].defaults != nil
              for d in node.args[0].defaults
                if d != nil
                  collect_calls(d, false, aid)
                end
              end
            end
            let i = 1
            while i < len(node.args)
              collect_calls(node.args[i], false, caller_id)
              i += 1
            end
            return nil
          end
        end

        if is_node(node.func, "var") and set_contains(mutating_builtins, node.func.name) and node.args != nil and len(node.args) > 0 and is_node(node.args[0], "var")
          record_write(caller_id, node.args[0].name, node, node.func.name)
        end

        # Regular call. Record edge if callee resolves to a known fn_def
        # name (directly, via a selective-load alias, or via a
        # whole-module dot access like `mod.fn(...)`).
        let resolved_callee = nil
        if is_node(node.func, "var")
          resolved_callee = resolve_callee(node.func.name)
        elif is_node(node.func, "dot") and node.func.object != nil and is_node(node.func.object, "var")
          resolved_callee = resolve_dot_callee(node.func.object.name, node.func.field)
        end
        if resolved_callee != nil
          if is_tail_pos
            set_add(caller_records[caller_id].tail_callees, resolved_callee)
          else
            set_add(caller_records[caller_id].non_tail_callees, resolved_callee)
          end
        else
          collect_calls(node.func, false, caller_id)
        end
        if node.args != nil
          for a in node.args
            collect_calls(a, false, caller_id)
          end
        end
        return nil
      end

      if node.tag == "anon_fn"
        # Closure outside any spawn context — its body is a non-seed caller.
        # Calls from it can never be tail-from-process_tail, so callees of this
        # body get demoted (correct: the closure's invocation site holds C state).
        let aid = next_anon_id()
        new_caller_record(aid, false)
        anon_parent[aid] = caller_id
        pt_anon_nodes[aid] = {fn: node, spawn: nil}
        collect_calls_in_body(node.body, true, aid)
        if node.defaults != nil
          for d in node.defaults
            if d != nil
              collect_calls(d, false, aid)
            end
          end
        end
        return nil
      end

      if node.tag == "if"
        collect_calls(node.cond, false, caller_id)
        collect_calls_in_body(node.then, is_tail_pos, caller_id)
        if node.else != nil
          collect_calls_in_body(node.else, is_tail_pos, caller_id)
        end
        return nil
      end

      if node.tag == "while"
        collect_calls(node.cond, false, caller_id)
        collect_calls_in_body(node.body, false, caller_id)
        return nil
      end

      if node.tag == "match"
        collect_calls(node.target, false, caller_id)
        for w in node.whens
          collect_calls_in_body(w.body, is_tail_pos, caller_id)
        end
        if node.else != nil
          collect_calls_in_body(node.else, is_tail_pos, caller_id)
        end
        return nil
      end

      if node.tag == "receive_match"
        for arm in node.arms
          collect_calls_in_body(arm.body, is_tail_pos, caller_id)
        end
        if node.after_body != nil
          collect_calls_in_body(node.after_body, is_tail_pos, caller_id)
        end
        return nil
      end

      if node.tag == "return"
        if node.value != nil
          collect_calls(node.value, true, caller_id)
        end
        return nil
      end

      if node.tag == "block"
        collect_calls_in_body(node.stmts, is_tail_pos, caller_id)
        return nil
      end

      if node.tag == "let" or node.tag == "assign"
        if node.tag == "assign"
          record_write(caller_id, node.name, node)
        end
        if node.value != nil
          collect_calls(node.value, false, caller_id)
        end
        return nil
      end

      if node.tag == "dot_assign"
        if is_node(node.object, "var")
          record_write(caller_id, node.object.name, node)
        end
        collect_calls(node.object, false, caller_id)
        collect_calls(node.value, false, caller_id)
        return nil
      end

      if node.tag == "index_assign"
        if is_node(node.object, "var")
          record_write(caller_id, node.object.name, node)
        end
        collect_calls(node.object, false, caller_id)
        collect_calls(node.key, false, caller_id)
        collect_calls(node.value, false, caller_id)
        return nil
      end

      if node.tag == "binop"
        collect_calls(node.left, false, caller_id)
        collect_calls(node.right, false, caller_id)
        return nil
      end

      if node.tag == "unop"
        collect_calls(node.expr, false, caller_id)
        return nil
      end

      if node.tag == "dot"
        collect_calls(node.object, false, caller_id)
        return nil
      end

      if node.tag == "index"
        collect_calls(node.object, false, caller_id)
        collect_calls(node.key, false, caller_id)
        return nil
      end

      if node.tag == "table"
        if node.entries != nil
          for e in node.entries
            collect_calls(e.key, false, caller_id)
            collect_calls(e.value, false, caller_id)
          end
        end
        return nil
      end

      if node.tag == "array"
        if node.elements != nil
          for el in node.elements
            collect_calls(el, false, caller_id)
          end
        end
        return nil
      end

      if node.tag == "interp"
        if node.parts != nil
          for p in node.parts
            collect_calls(p, false, caller_id)
          end
        end
        return nil
      end

      # Leaf nodes: int float string bool nil var break continue load export
      # extern_fn extern_include — no nested calls.
      nil
    end

    collect_calls_in_body = fn(stmts, is_tail_pos, caller_id)
      let n = len(stmts)
      let i = 0
      while i < n
        let stmt_is_tail = false
        if i == n - 1
          stmt_is_tail = is_tail_pos
        elif i + 1 < n and is_trivial_return(stmts[i + 1])
          stmt_is_tail = true
        end
        collect_calls(stmts[i], stmt_is_tail, caller_id)
        i += 1
      end
    end

    # Walk every fn_def body
    for fd in fn_defs
      let cid = "fn:" + fd.name
      new_caller_record(cid, false)
      collect_calls_in_body(fd.body, true, cid)
      if fd.defaults != nil
        for d in fd.defaults
          if d != nil
            collect_calls(d, false, cid)
          end
        end
      end
    end

    # Top-level program is a process root
    new_caller_record("<top>", true)
    collect_calls_in_body(top_stmts, true, "<top>")

    # Tag every `while` so compile_while emits the back-edge region reset
    # where liveness can root the live set.
    tag_process_tail_while_loops(fn_defs, top_stmts, source_name)

    # Attach per-loop liveness results to every PT-tagged while node, computed
    # with the loop's actual post-loop set. compile_while reads node.liveness_result
    # rather than recomputing on demand.
    for fd in fn_defs
      compute_live_for_pt_loops_in_stmts(fd.body)
    end
    compute_live_for_pt_loops_in_stmts(top_stmts)

    # ─── Mutual-tail-call SCC detection ───
    #
    # Direct self-recursion is TCO'd by `is_self_tail_call` + the `while(1)`
    # in compile_fn. Mutual cycles (X→tail Y, Y→tail X — possibly through 3+
    # functions) are not, so each round-trip eats a C frame and saturates the
    # 256 KB minicoro stack after ~175 frames. Find SCCs in the tail-edge
    # subgraph; if every member is viable, mark them so compile_fn emits a
    # `gem_sccbody_<name>` + thin trampoline-loop wrapper, and intra-SCC tail
    # calls become a TLB write + return rather than a real C call.
    find_tail_call_sccs(fn_defs, caller_records, name_to_fn)

    pt_caller_records = caller_records
    pt_anon_parent = anon_parent
    pt_name_to_fn = name_to_fn
  end

  # ─── Module state written from spawned processes (note) ──
  #
  # Module-level bindings are per-process (see is_global_ref): a write made
  # by a spawned process is visible only in that process. That is the
  # intended semantics, but easy to miss, so point at every write to module
  # state in code reachable from a `spawn` body: the body itself, named fns
  # it calls (transitively), and closures created in reachable code.
  # Code reachable only from main stays quiet. Runs after top_level_vars is
  # known; reuses mark_process_tail's call graph.
  let note_spawn_global_writes = fn()
    let records = pt_caller_records
    let children = {}
    for aid, parent in pt_anon_parent
      if children[parent] == nil
        children[parent] = []
      end
      push(children[parent], aid)
    end

    # Names local to a caller: its own params/lets plus, for a closure,
    # every enclosing scope's (closures capture them).
    let local_cache = {}
    let locals_of = nil
    locals_of = fn(cid)
      if local_cache[cid] != nil
        return local_cache[cid]
      end
      let s = {}
      if len(cid) >= 3 and substr(cid, 0, 3) == "fn:"
        let fd = pt_name_to_fn[substr(cid, 3, len(cid) - 3)]
        if fd != nil
          for p in fd.params
            set_add(s, p)
          end
          if fd.rest_param != nil
            set_add(s, fd.rest_param)
          end
          collect_shadow_lets_in_fn(fd.body, s)
        end
      elif pt_anon_nodes[cid] != nil
        let an = pt_anon_nodes[cid].fn
        for p in an.params
          set_add(s, p)
        end
        if an.rest_param != nil
          set_add(s, an.rest_param)
        end
        collect_shadow_lets_in_fn(an.body, s)
        let parent = pt_anon_parent[cid]
        if parent != nil and parent != "<top>"
          s = set_union(s, locals_of(parent))
        end
      end
      local_cache[cid] = s
      s
    end
    # cid -> the spawn node it is reachable from (first found). A call
    # through a param or local named `spawn` (the name the caller binds,
    # not the builtin) starts no process.
    let reached = {}
    let queue = []
    for aid, info in pt_anon_nodes
      if info.spawn != nil and not set_contains(locals_of(pt_anon_parent[aid]), info.spawn_via)
        reached[aid] = info.spawn
        push(queue, aid)
      end
    end
    let qi = 0
    while qi < len(queue)
      let cid = queue[qi]
      qi += 1
      let r = records[cid]
      if r == nil
        continue
      end
      let next = []
      for callee, _ in r.tail_callees
        push(next, "fn:" + callee)
      end
      for callee, _ in r.non_tail_callees
        push(next, "fn:" + callee)
      end
      if children[cid] != nil
        for c in children[cid]
          push(next, c)
        end
      end
      for n in next
        if reached[n] == nil
          reached[n] = reached[cid]
          push(queue, n)
        end
      end
    end
    let seen = {}
    for cid, spawn_node in reached
      let r = records[cid]
      if r == nil
        continue
      end
      for w in r.writes
        let locals = locals_of(cid)
        if set_contains(top_level_vars, w.name) and not set_contains(locals, w.name) and (w.via == nil or not set_contains(locals, w.via))
          let n = w.node
          let line_str = "?"
          if n.line != nil
            line_str = to_string(n.line)
          end
          let key = "{file_of(n)}:{line_str}:{w.name}"
          if seen[key] == nil
            seen[key] = true
            let sline = "?"
            if spawn_node.line != nil
              sline = to_string(spawn_node.line)
            end
            eprint("note: {rel_path(file_of(n))}:{line_str}: this changes module-level `{display_name(user_var_name(w.name))}` in code that runs in a spawned process (spawn at {rel_path(file_of(spawn_node))}:{sline}); each process has its own copy of module state, so the change is visible only in that process.\n")
          end
        end
      end
    end
  end

  # ─── Tail-edge SCC discovery (Tarjan) ───
  #
  # Operates only on fn_def→fn_def tail edges; non-tail edges and edges
  # through closures don't form a recursive cycle worth merging. Result is
  # populated into `scc_member_to_id` / `scc_id_to_members`.
  find_tail_call_sccs = fn(fn_defs, caller_records, name_to_fn)
    # Reset accumulated state from any prior run.
    for k in keys(scc_member_to_id)
      delete(scc_member_to_id, k)
    end
    for k in keys(scc_id_to_members)
      delete(scc_id_to_members, k)
    end
    for k in keys(scc_id_max_params)
      delete(scc_id_max_params, k)
    end
    scc_counter = 0

    let name_set = {}
    for fd in fn_defs
      set_add(name_set, fd.name)
    end

    # Adjacency: name → array of tail-callee names, restricted to known fn_defs.
    let tail_succs = {}
    for fd in fn_defs
      let cid = "fn:" + fd.name
      let r = caller_records[cid]
      let succs = []
      if r != nil
        for callee, _ in r.tail_callees
          if set_contains(name_set, callee)
            push(succs, callee)
          end
        end
      end
      tail_succs[fd.name] = succs
    end

    # Tarjan's SCC algorithm.
    let idx_counter = 0
    let indices = {}
    let lowlinks = {}
    let stack = []
    let on_stack = {}
    let raw_sccs = []

    let strongconnect = nil
    strongconnect = fn(v)
      indices[v] = idx_counter
      lowlinks[v] = idx_counter
      idx_counter += 1
      push(stack, v)
      set_add(on_stack, v)
      let succs = tail_succs[v]
      if succs != nil
        for w in succs
          if indices[w] == nil
            strongconnect(w)
            if lowlinks[w] < lowlinks[v]
              lowlinks[v] = lowlinks[w]
            end
          elif set_contains(on_stack, w)
            if indices[w] < lowlinks[v]
              lowlinks[v] = indices[w]
            end
          end
        end
      end
      if lowlinks[v] == indices[v]
        let comp = []
        while true
          let w = stack[-1]
          pop(stack)
          delete(on_stack, w)
          push(comp, w)
          if w == v
            break
          end
        end
        push(raw_sccs, comp)
      end
    end

    for fd in fn_defs
      if indices[fd.name] == nil
        strongconnect(fd.name)
      end
    end

    # Viability filter: every member must be merge-eligible. If any member
    # disqualifies, the whole SCC is left as separate fn_defs (stack cliff
    # remains for that SCC, but the broker case has none of these warts).
    for comp in raw_sccs
      if len(comp) < 2
        continue
      end
      let viable = true
      let why = ""
      for name in comp
        let fd = name_to_fn[name]
        if fd == nil
          viable = false
          why = "missing fn_def"
          break
        end
        if fd.rest_param != nil
          viable = false
          why = "{name} has a rest parameter"
          break
        end
        if fd.defaults != nil
          for d in fd.defaults
            if d != nil
              viable = false
              why = "{name} has default arguments"
              break
            end
          end
        end
        if not viable
          break
        end
        # Mirrors GEM_MAX_TAIL_ARGS in runtime/gem.h. Hardcoded here to keep
        # the compiler self-hosting without parsing C; bump both if needed.
        if len(fd.params) > 16
          viable = false
          why = "{name} has more than 16 parameters"
          break
        end
        # Mutated-captured params live in malloc-backed boxes that the body
        # creates per-iteration. Trampolining across two such boxes would
        # leak. Bail conservatively — none of the broker's writer/handle_*
        # fns box their params, so this matters only for an unusual closure
        # pattern across a tail cycle.
        let scope_vars = sorted_array_to_set(fd.params)
        let cap_writes = find_capture_writes_in_scope(fd.body, scope_vars)
        let any_boxed = false
        for p in fd.params
          if set_contains(cap_writes, p)
            any_boxed = true
            break
          end
        end
        if any_boxed
          viable = false
          why = "{name} has a parameter captured-and-mutated by an inner closure"
          break
        end
        # Direct-TCO already bails when the fn name is in its own body's
        # scope_vars (a `let foo = ...` shadowing). For SCC merging we keep
        # the same restriction so the wrapper's name stays callable.
        if set_contains(scope_vars, fd.name)
          viable = false
          why = "{name} shadows itself in its body"
          break
        end
      end
      if not viable
        # Conservative: skip silently for now. (Future: surface as a note
        # so users can refactor an SCC into mergeable shape.)
        continue
      end
      let sid = scc_counter
      scc_counter += 1
      # Stable sort: emit in source order. comp from Tarjan is in
      # post-order; sort by appearance in fn_defs for determinism.
      let comp_set = {}
      for name in comp
        set_add(comp_set, name)
      end
      let order = {}
      let i = 0
      for fd in fn_defs
        if set_contains(comp_set, fd.name)
          order[fd.name] = i
        end
        i += 1
      end
      let members = []
      for name in comp
        push(members, name)
      end
      # Insertion sort by `order[name]`.
      let n = len(members)
      let j = 1
      while j < n
        let cur = members[j]
        let cur_order = order[cur]
        let k = j - 1
        while k >= 0 and order[members[k]] > cur_order
          members[k + 1] = members[k]
          k -= 1
        end
        members[k + 1] = cur
        j += 1
      end
      scc_id_to_members[sid] = members
      let max_params = 0
      for name in members
        scc_member_to_id[name] = sid
        if len(name_to_fn[name].params) > max_params
          max_params = len(name_to_fn[name].params)
        end
      end
      scc_id_max_params[sid] = max_params
    end
  end

  emit_tco_continue = fn(call_node, indent)
    let p = pad_for(indent)
    let b = buf_new()
    let args = call_node.args
    let arg_temps = []
    for i = 0, len(args)
      let r = compile_expr(args[i])
      let t = tmp()
      buf_push(b, r.setup)
      buf_push(b, "{p}GemVal {t} = {r.expr};\n")
      push(arg_temps, t)
    end

    # Arena reset at the tail-call boundary (region reset against the mark
    # `_tco_mk` taken at function entry, see compile_fn).
    #
    # SOUNDNESS: every caller frame was suspended before `_tco_mk` was
    # taken, so it holds only values older than the mark, which the reset
    # never moves or frees. This frame's only live values here are the arg
    # temps: params are rebound below, body locals are dead at a tail call,
    # and closure envs / pinned boxes are reached through the args. Older
    # objects mutated since the mark, module slots, the mailbox and old
    # pinned boxes are fixed up by the runtime (gem_copy.c, "Region reset").
    #
    # Mutated-captured params (`tco_boxed`) live in malloc-backed pinned
    # boxes (gem_box_alloc). A real call gives every invocation its own box,
    # so a closure made in iteration k keeps seeing iteration k's binding;
    # the back-edge mirrors that by allocating a fresh box below instead of
    # overwriting the old one. The old box is therefore not a root: if a
    # closure in the args still references it, the env-walk marks it and
    # the sweep keeps it; otherwise the sweep frees it.
    let tco_roots = []
    for t in arg_temps
      push(tco_roots, "&{t}")
    end
    buf_push(b, emit_region_reset(p, "_tco_mk", tco_roots, []))

    if tco_rebind
      # Defaults and the rest table are built by the rebind block at the
      # loop's bottom, after the reset above, from the stored args — the
      # same code function entry runs, so omitted args evaluate their
      # defaults in parameter order against this call's new values.
      if len(arg_temps) > tco_argv_max
        tco_argv_max = len(arg_temps)
      end
      for i = 0, len(arg_temps)
        buf_push(b, "{p}_tco_argv[{i}] = {arg_temps[i]};\n")
      end
      buf_push(b, "{p}args = _tco_argv;\n")
      buf_push(b, "{p}argc = {len(arg_temps)};\n")
      buf_push(b, "{p}goto _tco_rebind;")
      return to_string(b)
    end

    for i = 0, len(tco_params)
      let mp = mangle(tco_params[i])
      let val = "GEM_NIL"
      if i < len(arg_temps)
        val = arg_temps[i]
      end
      if set_contains(tco_boxed, tco_params[i])
        buf_push(b, "{p}{mp} = gem_box_alloc();\n")
        buf_push(b, "{p}*{mp} = {val};\n")
      else
        buf_push(b, "{p}{mp} = {val};\n")
      end
    end
    buf_push(b, "{p}continue;")
    to_string(b)
  end

  # ─── SCC mutual-TCO trampoline emit ───
  #
  # Replaces what would be a real C call to a sibling SCC member at a
  # tail-position site. Compiles the args, writes them into the global
  # TLB, sets `gem_tail_fn = gem_sccbody_<target>`, pops the body's
  # frame (pushed at body entry, balanced here), and returns GEM_NIL.
  # The wrapper around the body sees the non-NULL marker and dispatches
  # the next body — collapsing the C-stack growth that would otherwise
  # accumulate per intra-SCC tail call.
  emit_scc_tail_call = fn(call_node, target_name, indent)
    let p = pad_for(indent)
    let b = buf_new()
    let args = call_node.args
    let arg_temps = []
    for i = 0, len(args)
      let r = compile_expr(args[i])
      let t = tmp()
      buf_push(b, r.setup)
      buf_push(b, "{p}GemVal {t} = {r.expr};\n")
      push(arg_temps, t)
    end
    for i = 0, len(arg_temps)
      buf_push(b, "{p}gem_tail_args[{i}] = {arg_temps[i]};\n")
    end
    buf_push(b, "{p}gem_tail_argc = {len(arg_temps)};\n")
    buf_push(b, "{p}gem_tail_env = NULL;\n")
    buf_push(b, "{p}gem_tail_fn = gem_sccbody_{target_name};\n")
    buf_push(b, pop_str(p))
    buf_push(b, "{p}return GEM_NIL;")
    to_string(b)
  end

  # ─── SCC wrapper emit ───
  #
  # Emits the trampoline wrapper as `gem_fn_<name>` for an SCC member.
  # The wrapper does not push a frame (the body pushes its own); on each
  # iteration it calls the next body via the TLB-set fn pointer. Between
  # iterations it arena-resets and yields, mirroring direct-TCO's per-
  # back-edge reset semantics.
  scc_wrapper_for = fn(node, sid)
    let name = node.name
    let b = buf_new()
    buf_push(b, "static GemVal gem_fn_{name}(void *_env, GemVal *args, int argc) \{\n")
    buf_push(b, "    GemFnPtr _next_fn = gem_sccbody_{name};\n")
    buf_push(b, "    void *_next_env = _env;\n")
    buf_push(b, "    GemVal *_next_args = args;\n")
    buf_push(b, "    int _next_argc = argc;\n")
    buf_push(b, "    GemVal _tail_args[GEM_MAX_TAIL_ARGS];\n")
    buf_push(b, "    GemVal _result;\n")
    buf_push(b, "    GemArenaMark _mk;\n")
    buf_push(b, "    gem_arena_mark(&_mk);\n")
    buf_push(b, "    while (1) \{\n")
    buf_push(b, "        _result = _next_fn(_next_env, _next_args, _next_argc);\n")
    buf_push(b, "        if (gem_tail_fn == NULL) break;\n")
    # The TLB is process-global and other processes use it while this one
    # is suspended (the reset and yield below, or any yield inside the next
    # body). Consume it here, before anything can switch processes: copy
    # the args into this wrapper's frame and clear gem_tail_fn, so the TLB
    # is only ever set between a body's tail-set and this read.
    buf_push(b, "        _next_fn = gem_tail_fn;\n")
    buf_push(b, "        gem_tail_fn = NULL;\n")
    buf_push(b, "        _next_env = gem_tail_env;\n")
    # Copy a fixed count (the SCC's largest arity) so the copy unrolls; a
    # call with fewer args leaves slots the next body never reads, and one
    # with more passes args no body reads, so argc is clamped to the count.
    let nargs = scc_id_max_params[sid]
    buf_push(b, "        _next_argc = gem_tail_argc < {nargs} ? gem_tail_argc : {nargs};\n")
    for i = 0, nargs
      buf_push(b, "        _tail_args[{i}] = gem_tail_args[{i}];\n")
    end
    buf_push(b, "        _next_args = _tail_args;\n")
    # SOUNDNESS: the mark is taken on entry, before the first body runs, so
    # the callers hold only older values; between bodies the previous body
    # has returned and the copied tail args are the only live values.
    buf_push(b, "        if (gem_arena_reset_due(&_mk)) \{\n")
    buf_push(b, "            GemVal *_roots[GEM_MAX_TAIL_ARGS];\n")
    buf_push(b, "            for (int _i = 0; _i < _next_argc; _i++) _roots[_i] = &_tail_args[_i];\n")
    buf_push(b, "            gem_arena_reset_region(&_mk, _roots, _next_argc, NULL, 0);\n")
    buf_push(b, "        }\n")
    buf_push(b, "        gem_yield_check();\n")
    buf_push(b, "    }\n")
    buf_push(b, "    return _result;\n")
    buf_push(b, "}")
    to_string(b)
  end

  # ─── append optimization helpers ──

  let decompose_concat = nil
  decompose_concat = fn(name, node)
    if not is_node(node, "binop") or node.op != "+"
      return nil
    end
    if is_node(node.left, "var") and node.left.name == name
      return [node.right]
    end
    let left_parts = decompose_concat(name, node.left)
    if left_parts != nil
      push(left_parts, node.right)
      return left_parts
    end
    nil
  end

  let expr_has_var = nil
  expr_has_var = fn(node, name)
    if node == nil
      return false
    end
    if type(node) != "table"
      return false
    end
    if node.tag == nil
      return false
    end
    if node.tag == "var"
      return node.name == name
    end
    if node.tag == "int" or node.tag == "float" or node.tag == "bool" or node.tag == "nil"
      return false
    end
    if node.tag == "string"
      return false
    end
    if node.tag == "interp"
      if node.parts != nil
        for p in node.parts
          if expr_has_var(p, name)
            return true
          end
        end
      end
      return false
    end
    if node.tag == "binop"
      return expr_has_var(node.left, name) or expr_has_var(node.right, name)
    end
    if node.tag == "unop"
      return expr_has_var(node.expr, name)
    end
    if node.tag == "call"
      if expr_has_var(node.func, name)
        return true
      end
      if node.args != nil
        for a in node.args
          if expr_has_var(a, name)
            return true
          end
        end
      end
      return false
    end
    if node.tag == "dot"
      return expr_has_var(node.object, name)
    end
    if node.tag == "index"
      return expr_has_var(node.object, name) or expr_has_var(node.key, name)
    end
    if node.tag == "table"
      if node.entries != nil
        for e in node.entries
          if expr_has_var(e.value, name)
            return true
          end
        end
      end
      return false
    end
    if node.tag == "array"
      if node.elements != nil
        for e in node.elements
          if expr_has_var(e, name)
            return true
          end
        end
      end
      return false
    end
    if node.tag == "anon_fn"
      return true
    end
    true
  end

  let stmts_have_non_append_ref = nil
  let stmt_has_non_append_ref = nil

  stmts_have_non_append_ref = fn(stmts, name)
    for s in stmts
      if stmt_has_non_append_ref(s, name)
        return true
      end
    end
    false
  end

  stmt_has_non_append_ref = fn(stmt, name)
    if stmt == nil
      return false
    end
    if type(stmt) != "table"
      return false
    end
    if stmt.tag == "assign"
      if stmt.name == name
        let parts = decompose_concat(name, stmt.value)
        if parts != nil
          for p in parts
            if expr_has_var(p, name)
              return true
            end
          end
          return false
        end
        return true
      end
      return expr_has_var(stmt.value, name)
    end
    if stmt.tag == "let"
      return expr_has_var(stmt.value, name)
    end
    if stmt.tag == "dot_assign"
      return expr_has_var(stmt.object, name) or expr_has_var(stmt.value, name)
    end
    if stmt.tag == "index_assign"
      return expr_has_var(stmt.object, name) or expr_has_var(stmt.key, name) or expr_has_var(stmt.value, name)
    end
    if stmt.tag == "if"
      if expr_has_var(stmt.cond, name)
        return true
      end
      if stmts_have_non_append_ref(stmt.then, name)
        return true
      end
      if stmt.else != nil
        return stmts_have_non_append_ref(stmt.else, name)
      end
      return false
    end
    if stmt.tag == "while"
      if expr_has_var(stmt.cond, name)
        return true
      end
      return stmts_have_non_append_ref(stmt.body, name)
    end
    if stmt.tag == "match"
      if expr_has_var(stmt.target, name)
        return true
      end
      if stmt.whens != nil
        for w in stmt.whens
          if w.value != nil
            if expr_has_var(w.value, name)
              return true
            end
          end
          if w.body != nil
            if stmts_have_non_append_ref(w.body, name)
              return true
            end
          end
        end
      end
      if stmt.else != nil
        return stmts_have_non_append_ref(stmt.else, name)
      end
      return false
    end
    if stmt.tag == "return"
      if stmt.value != nil
        return expr_has_var(stmt.value, name)
      end
      return false
    end
    if stmt.tag == "break" or stmt.tag == "continue" or stmt.tag == "fn_def"
      return false
    end
    if stmt.tag == "block"
      return stmts_have_non_append_ref(stmt.stmts, name)
    end
    if stmt.tag == "call"
      return expr_has_var(stmt, name)
    end
    if stmt.tag == "receive_match"
      return true
    end
    true
  end

  let scan_append_candidates = nil
  scan_append_candidates = fn(stmts, candidates)
    for s in stmts
      if is_node(s, "assign")
        let parts = decompose_concat(s.name, s.value)
        if parts != nil
          let safe = true
          for p in parts
            if expr_has_var(p, s.name)
              safe = false
            end
          end
          if safe
            set_add(candidates, s.name)
          end
        end
      elif is_node(s, "if")
        scan_append_candidates(s.then, candidates)
        if s.else != nil
          scan_append_candidates(s.else, candidates)
        end
      elif is_node(s, "match")
        if s.whens != nil
          for w in s.whens
            if w.body != nil
              scan_append_candidates(w.body, candidates)
            end
          end
        end
        if s.else != nil
          scan_append_candidates(s.else, candidates)
        end
      elif is_node(s, "block")
        scan_append_candidates(s.stmts, candidates)
      end
    end
  end

  let find_append_vars = fn(body)
    let candidates = {}
    scan_append_candidates(body, candidates)
    let eligible = {}
    for name, _ in candidates
      if not stmts_have_non_append_ref(body, name)
        set_add(eligible, name)
      end
    end
    eligible
  end

  # Bare `name = expr` requires `name` to resolve to a writable binding —
  # a local, a top-level var, or a captured/boxed name. Without this check,
  # `a = 3` (no prior `let`) emits `gem_v_a = ...` and bottoms out at a `cc`
  # error referencing the mangled name, which is opaque to the user.
  let codegen_error = fn(node, msg)
    eprint("\n[Compiler Bug]: {msg}\n  --> {loc_of(node)}\n  The compiler accepted source it does not know how to emit C for.\n  This is a bug in the compiler, not your code — please file an issue with a minimal repro.\n")
    exit(1)
  end

  let check_assign_target = fn(name, node)
    if set_contains(local_names, name) or set_contains(top_level_vars, name) or set_contains(boxed_vars, name)
      return nil
    end
    if has_key(builtin_fns, name) or set_contains(defined_fns, name)
      let shown = display_name(name)
      sink.report(source_of(node), file_of(node), node.line, node.col, len(shown), "cannot assign to function `{shown}`", nil)
    else
      sink.report(source_of(node), file_of(node), node.line, node.col, len(name), "undeclared identifier `{name}`", "use `let {name} = ...` to declare")
    end
  end

  # ─── compile_expr ──

  compile_expr = fn(node)
    match node
    when {tag: "int", value: value}
      return {expr: "gem_int({c_int_literal(value)})", setup: ""}
    when {tag: "float", value: value}
      return {expr: "gem_float({format_float(value)})", setup: ""}
    when {tag: "string", value: value}
      let escaped = escape_c_string(value)
      # Use _with_len so embedded NULs survive — len(value) reads slen.
      return {expr: "gem_string_with_len(\"{escaped}\", {len(value)})", setup: ""}
    when {tag: "interp", parts: parts}
      if len(parts) == 0
        return {expr: "gem_string(\"\")", setup: ""}
      end
      let results = []
      for part in parts
        push(results, compile_expr(part))
      end
      let ordered = left_to_right(results)
      let setup = ordered.setup
      let compiled = ordered.exprs
      let arr_tmp = tmp()
      let items = compiled[0]
      for i = 1, len(compiled)
        items = items + ", " + compiled[i]
      end
      setup = setup + "    GemVal {arr_tmp}[] = \{{items}};\n"
      return {expr: "gem_interp({len(compiled)}, {arr_tmp})", setup: setup}
    when {tag: "bool", value: value}
      if value
        return {expr: "gem_bool(1)", setup: ""}
      end
      return {expr: "gem_bool(0)", setup: ""}
    when {tag: "nil"}
      return {expr: "GEM_NIL", setup: ""}
    when {tag: "var", name: name}
      if not set_contains(local_names, name)
        if has_key(builtin_fns, name)
          return {expr: "gem_make_fn({builtin_fns[name]}, NULL)", setup: ""}
        elif set_contains(defined_fns, name)
          return {expr: "gem_make_fn(gem_fn_{name}, NULL)", setup: ""}
        elif not set_contains(top_level_vars, name)
          # Name resolves nowhere — undeclared identifier (typo or missing
          # let/load). Report and emit GEM_NIL so codegen continues; the
          # driver gates final emission on sink.has_any() so this never
          # reaches `cc`.
          sink.report(source_of(node), file_of(node), node.line, node.col, len(name), "undeclared identifier `{name}`", nil)
          return {expr: "GEM_NIL", setup: ""}
        end
      end
      if is_global_ref(name)
        return {expr: gmangle(name), setup: ""}
      end
      return {expr: var_lvalue(name), setup: ""}
    when {tag: "call"}
      return compile_call(node)
    when {tag: "binop"}
      return compile_binop(node)
    when {tag: "unop", expr: uexpr, op: op}
      let r = compile_expr(uexpr)
      if op == "-"
        return {expr: "gem_neg({r.expr})", setup: r.setup}
      elif op == "not"
        return {expr: "gem_not({r.expr})", setup: r.setup}
      end
      codegen_error(node, "unknown unary operator: {op}")
    when {tag: "anon_fn"}
      return compile_anon_fn(node)
    when {tag: "table"}
      return compile_table(node)
    when {tag: "array"}
      return compile_array(node)
    when {tag: "dot", object: object, field: field}
      # `m.x` on a module binding reads the module's own binding `x` (this
      # process's slot, live), not a copy held in the namespace table.
      if is_node(object, "var") and has_key(module_ns, object.name) and has_key(module_bindings, object.name) and is_global_ref(object.name)
        let target = module_ns[object.name][field]
        if target != nil and (set_contains(top_level_vars, target) or set_contains(defined_fns, target))
          return compile_expr({tag: "var", name: target, line: node.line, col: node.col, file: node.file})
        end
      end
      if is_node(object, "var") and has_key(module_bindings, object.name) and (in_top_level or not set_contains(local_names, object.name))
        let exports = module_bindings[object.name]
        let found = false
        for ename in exports
          if ename == field
            found = true
          end
        end
        if not found
          let loc_node = node
          if loc_node.line == nil and object.line != nil
            loc_node = object
          end
          let suggestion = find_closest_export(field, exports)
          let hint = nil
          if suggestion != nil
            hint = "did you mean `{suggestion}`?"
          end
          sink.report(source_of(loc_node), file_of(loc_node), loc_node.line, loc_node.col, len(field), "module `{display_name(object.name)}` has no export `{field}`", hint)
        end
      end
      let r = compile_expr(object)
      let t = tmp()
      ic_counter += 1
      let ic = ic_counter
      let escaped = escape_c_string(field)
      let setup = r.setup + "    GemVal {t} = {r.expr};\n    static GemICacheSlot _ic_{ic} = {ic_init};\n"
      return {expr: "gem_table_get_cached({t}, \"{escaped}\", &_ic_{ic})", setup: setup}
    when {tag: "index", object: object, key: key}
      let o = operands(compile_expr(object), key)
      return {expr: "gem_table_get({o.left}, {o.right})", setup: o.setup}
    end

    codegen_error(node, "unknown expression node: {node.tag}")
  end

  # ─── compile_table ──

  compile_table = fn(node)
    let entries = node.entries
    let t = tmp()
    let b = buf_new()
    buf_push(b, "    GemVal {t} = gem_table_new();\n")
    for entry in entries
      let val_r = compile_expr(entry.value)
      buf_push(b, val_r.setup)
      if entry.int_key != nil
        buf_push(b, "    gem_table_set({t}, gem_int({c_int_literal(entry.int_key)}), {val_r.expr});\n")
      else
        let escaped = escape_c_string(entry.key)
        let key_c = "gem_string(\"{escaped}\")"
        if len(str_replace(entry.key, "\0", "")) != len(entry.key)
          # gem_string stops at the first NUL.
          key_c = "gem_string_with_len(\"{escaped}\", {len(entry.key)})"
        end
        buf_push(b, "    gem_table_set({t}, {key_c}, {val_r.expr});\n")
      end
    end
    if node.frozen == true
      # Module namespace table: an ordinary per-process table whose own
      # entries cannot be changed.
      buf_push(b, "    gem_table_freeze({t});\n")
    end
    {expr: t, setup: to_string(b)}
  end

  # ─── compile_array ──

  compile_array = fn(node)
    let elements = node.elements
    let t = tmp()
    let b = buf_new()
    buf_push(b, "    GemVal {t} = gem_table_new();\n")
    for i = 0, len(elements)
      let elem_r = compile_expr(elements[i])
      buf_push(b, elem_r.setup)
      buf_push(b, "    gem_table_set({t}, gem_int({i}), {elem_r.expr});\n")
    end
    {expr: t, setup: to_string(b)}
  end

  # ─── compile_anon_fn ──

  compile_anon_fn = fn(node)
    let inner_defined = sorted_array_to_set(node.params)
    if node.rest_param != nil
      set_add(inner_defined, node.rest_param)
    end
    let free = collect_free_vars(node.body, inner_defined)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          collect_free_node(d, inner_defined, free)
        end
      end
    end
    # Module slots are read live through gem_cur_globals, never captured.
    # A free name the enclosing scope doesn't bind is undeclared (typo or
    # missing let/load): leave it uncaptured so the closure body reports it
    # (compile_expr's var case / check_assign_target), as in a named fn.
    let captures = []
    for cap in sort(keys(free))
      if not is_global_ref(cap) and set_contains(local_names, cap)
        push(captures, cap)
      end
    end

    if len(captures) == 0
      let result = compile_closure_fn(node, [])
      return {expr: "gem_make_fn({result.fn_name}, NULL)", setup: ""}
    end

    let result = compile_closure_fn(node, captures)

    let b = buf_new()
    let env_tmp = tmp()
    if node.non_escaping == true
      # Stack-allocate the env: the closure cannot outlive this C frame.
      buf_push(b, "    struct {result.struct_name} {env_tmp};\n")
      buf_push(b, "    {env_tmp}._num_captures = {len(captures)};\n")
      for cap in captures
        let mc = mangle(cap)
        let outer_is_box = set_contains(boxed_vars, cap)
        # Env field is always `GemVal *`. If outer holds a box ptr, copy it
        # (closure shares the box). Otherwise outer's local is an unboxed
        # `GemVal` — for a non-escaping closure we can take its address since
        # the closure cannot outlive the C frame.
        if outer_is_box
          buf_push(b, "    {env_tmp}.{mc} = {mc};\n")
        else
          buf_push(b, "    {env_tmp}.{mc} = &{mc};\n")
        end
      end
      return {expr: "gem_make_fn({result.fn_name}, &{env_tmp})", setup: to_string(b)}
    end
    buf_push(b, "    struct {result.struct_name} *{env_tmp} = gem_alloc(sizeof(struct {result.struct_name}));\n")
    buf_push(b, "    {env_tmp}->_num_captures = {len(captures)};\n")
    for cap in captures
      let mc = mangle(cap)
      let outer_is_box = set_contains(boxed_vars, cap)
      # Env field is always `GemVal *`. Outer-boxed → ptr copy. Outer-unboxed
      # (no closure mutates this name, so outer skipped boxing) → allocate a
      # fresh box snapshotting the current value, since this closure may
      # outlive the frame.
      if outer_is_box
        buf_push(b, "    {env_tmp}->{mc} = {mc};\n")
      else
        let box_tmp = tmp()
        buf_push(b, "    GemVal *{box_tmp} = gem_alloc(sizeof(GemVal));\n")
        buf_push(b, "    *{box_tmp} = {mc};\n")
        buf_push(b, "    {env_tmp}->{mc} = {box_tmp};\n")
      end
    end
    {expr: "gem_make_fn({result.fn_name}, {env_tmp})", setup: to_string(b)}
  end

  # ─── compile_args: compile an argument list into setup + array name ──
  # Returns {setup, arr_name, argc}. arr_name is nil when argc == 0.

  let compile_args = fn(args)
    let results = []
    for a in args
      push(results, compile_expr(a))
    end
    let argc = len(args)
    let ordered = left_to_right(results)
    let arg_exprs = ordered.exprs
    if argc == 0
      return {setup: ordered.setup, arr_name: nil, argc: 0}
    end
    let t = tmp()
    let arr = arg_exprs[0]
    for i = 1, argc
      arr = arr + ", " + arg_exprs[i]
    end
    {setup: ordered.setup + "    GemVal {t}[] = \{{arr}};\n", arr_name: t, argc: argc}
  end

  # Emit a direct call: fn_name(env, args, argc)
  let emit_direct_call = fn(fn_name, env, ca)
    if ca.argc == 0
      return {expr: "{fn_name}({env}, NULL, 0)", setup: ca.setup}
    end
    {expr: "{fn_name}({env}, {ca.arr_name}, {ca.argc})", setup: ca.setup}
  end

  # ─── compile_call ──

  compile_call = fn(node)
    let {func, args} = node

    # Method call: obj.len() → gem_len_val(obj)
    if func.tag == "dot" and func.field == "len" and len(args) == 0
      let obj_r = compile_expr(func.object)
      return {expr: "gem_len_val({obj_r.expr})", setup: obj_r.setup}
    end

    # Direct call optimization for known functions
    if func.tag == "var"
      let name = func.name

      if name == "error" and not set_contains(local_names, name)
        let line = node.line
        if line == nil
          line = 0
        end
        let escaped_file = escape_c_string(rel_path(file_of(node)))
        let ca = compile_args(args)
        if ca.argc == 0
          return {expr: "gem_error_at_fn(\"{escaped_file}\", {line}, NULL, 0)", setup: ca.setup}
        end
        return {expr: "gem_error_at_fn(\"{escaped_file}\", {line}, {ca.arr_name}, {ca.argc})", setup: ca.setup}
      elif has_key(builtin_fns, name) and not set_contains(local_names, name)
        return emit_direct_call(builtin_fns[name], "NULL", compile_args(args))
      elif set_contains(defined_fns, name) and not set_contains(local_names, name)
        return emit_direct_call("gem_fn_{name}", "NULL", compile_args(args))
      end
    end

    # General case: call through function value
    # The callee is evaluated before the arguments, and checked after them.
    let func_r = compile_expr(func)
    let ca = compile_args(args)
    let tmp_fn = tmp()
    let line = node.line
    if line == nil
      line = 0
    end
    let escaped_file = escape_c_string(rel_path(file_of(node)))
    let setup = func_r.setup + "    GemVal {tmp_fn} = {func_r.expr};\n" + ca.setup + "    gem_check_callable({tmp_fn}, \"{escaped_file}\", {line});\n"
    if ca.argc == 0
      return {expr: "{tmp_fn}.fn({tmp_fn}.env, NULL, 0)", setup: setup}
    end
    {expr: "{tmp_fn}.fn({tmp_fn}.env, {ca.arr_name}, {ca.argc})", setup: setup}
  end

  # ─── compile_binop ──

  compile_binop = fn(node)
    let op = node.op
    let lc_r = compile_expr(node.left)
    let lc = lc_r.expr
    let ls = lc_r.setup
    # `and` / `or` read the left value twice; it must be computed once.
    if op == "and" or op == "or"
      let pr = pin_operand(lc_r)
      lc = pr.expr
      ls = pr.setup
    end

    if op == "+"
      let o = operands(lc_r, node.right)
      return {expr: "gem_add({o.left}, {o.right})", setup: o.setup}
    elif op == "-"
      let o = operands(lc_r, node.right)
      return {expr: "gem_sub({o.left}, {o.right})", setup: o.setup}
    elif op == "*"
      let o = operands(lc_r, node.right)
      return {expr: "gem_mul({o.left}, {o.right})", setup: o.setup}
    elif op == "/"
      let o = operands(lc_r, node.right)
      return {expr: "gem_div({o.left}, {o.right})", setup: o.setup}
    elif op == "%"
      let o = operands(lc_r, node.right)
      return {expr: "gem_mod({o.left}, {o.right})", setup: o.setup}
    elif op == "in"
      let o = operands(lc_r, node.right)
      let t = tmp()
      let setup = o.setup + "    GemVal {t}[] = \{{o.right}, {o.left}};\n"
      return {expr: "gem_in_fn(NULL, {t}, 2)", setup: setup}
    elif op == "=="
      let o = operands(lc_r, node.right)
      return {expr: "gem_eq({o.left}, {o.right})", setup: o.setup}
    elif op == "!="
      let o = operands(lc_r, node.right)
      return {expr: "gem_neq({o.left}, {o.right})", setup: o.setup}
    elif op == "<"
      let o = operands(lc_r, node.right)
      return {expr: "gem_lt({o.left}, {o.right})", setup: o.setup}
    elif op == ">"
      let o = operands(lc_r, node.right)
      return {expr: "gem_gt({o.left}, {o.right})", setup: o.setup}
    elif op == "<="
      let o = operands(lc_r, node.right)
      return {expr: "gem_le({o.left}, {o.right})", setup: o.setup}
    elif op == ">="
      let o = operands(lc_r, node.right)
      return {expr: "gem_ge({o.left}, {o.right})", setup: o.setup}
    elif op == "and"
      let rc_r = compile_expr(node.right)
      let t = tmp()
      let b = buf_new()
      buf_push(b, ls)
      buf_push(b, "    GemVal {t};\n")
      buf_push(b, "    if (!gem_truthy({lc})) \{\n")
      buf_push(b, "        {t} = {lc};\n")
      buf_push(b, "    } else \{\n")
      if rc_r.setup != ""
        # Pushed as is: re-indenting would also rewrite spaces inside C
        # string literals.
        buf_push(b, rc_r.setup)
      end
      buf_push(b, "        {t} = {rc_r.expr};\n")
      buf_push(b, "    }\n")
      return {expr: t, setup: to_string(b)}
    elif op == "or"
      let rc_r = compile_expr(node.right)
      let t = tmp()
      let b = buf_new()
      buf_push(b, ls)
      buf_push(b, "    GemVal {t};\n")
      buf_push(b, "    if (gem_truthy({lc})) \{\n")
      buf_push(b, "        {t} = {lc};\n")
      buf_push(b, "    } else \{\n")
      if rc_r.setup != ""
        # Pushed as is: re-indenting would also rewrite spaces inside C
        # string literals.
        buf_push(b, rc_r.setup)
      end
      buf_push(b, "        {t} = {rc_r.expr};\n")
      buf_push(b, "    }\n")
      return {expr: t, setup: to_string(b)}
    end

    codegen_error(node, "unknown binary operator: {op}")
  end

  # ─── compile_stmts ──

  compile_stmts = fn(stmts, indent)
    let b = buf_new()
    for stmt in stmts
      buf_push(b, compile_stmt(stmt, indent))
      buf_push(b, "\n")
    end
    to_string(b)
  end

  compile_stmts_tail = fn(stmts, indent, return_pos)
    if not return_pos
      return compile_stmts(stmts, indent)
    end
    let b = buf_new()
    if len(stmts) > 0
      for i = 0, len(stmts) - 1
        buf_push(b, compile_stmt(stmts[i], indent))
        buf_push(b, "\n")
      end
      buf_push(b, compile_stmt_return(stmts[-1], indent))
      buf_push(b, "\n")
    else
      let p = pad_for(indent)
      buf_push(b, "{pop_str(p)}{p}return GEM_NIL;\n")
    end
    to_string(b)
  end

  # ─── compile_stmt ──

  compile_stmt = fn(node, indent)
    let p = pad_for(indent)
    let line_dir = ""
    if node.line != nil
      line_dir = "#line {node.line} \"{escape_c_string(rel_path(file_of(node)))}\"\n{setline_str(node.line, p)}"
    end

    match node
    when {tag: "let", name: name, value: value}
      # Track dynamic C scope: this let's local is in scope for any nested
      # process-tail loop's back-edge until its enclosing C `{}` closes.
      # Snapshot/restore at C-scope boundaries (compile_while body,
      # compile_if/match/receive_match arms, compile_stmt_return block) pops
      # arm-local additions when the scope closes.
      set_add(fn_scope_locals, name)
      let r = compile_expr(value)
      if in_top_level and has_key(module_bindings, name) and not (is_node(value, "table") and value.frozen == true)
        delete(module_bindings, name)
      end
      let mname = mangle(name)
      if in_top_level and set_contains(top_level_vars, name)
        # Module-level binding: this process's slot.
        return "{line_dir}{r.setup}{p}gem_global_set({gindex(name)}, {r.expr});"
      end
      if set_contains(boxed_vars, name)
        # Mutated-captured fn-local: pinned malloc'd box, registered in the
        # current process's pin-set so it survives arena reset. Sweep at
        # next reset frees it if no live root reaches the box.
        return "{line_dir}{r.setup}{p}GemVal *{mname} = gem_box_alloc();\n{p}*{mname} = {r.expr};"
      end
      return "{line_dir}{r.setup}{p}GemVal {mname} = {r.expr};"
    when {tag: "assign", name: name, value: value}
      check_assign_target(name, node)
      if set_contains(append_buf_vars, name)
        let parts = decompose_concat(name, value)
        if parts != nil
          let mname = var_lvalue(name)
          let b = buf_new()
          buf_push(b, line_dir)
          for part in parts
            let r = compile_expr(part)
            buf_push(b, r.setup)
            buf_push(b, "{p}gem_string_append(&{mname}, {r.expr});\n")
          end
          return to_string(b)
        end
      end
      let r = compile_expr(value)
      let refresh = ns_refresh(name, p)
      if refresh != ""
        return "{line_dir}{r.setup}{p}{var_store(name, r.expr)}\n{substr(refresh, 0, len(refresh) - 1)}"
      end
      return "{line_dir}{r.setup}{p}{var_store(name, r.expr)}"
    when {tag: "dot_assign", object: object, value: value, field: field}
      let o = left_to_right([compile_expr(object), compile_expr(value)])
      let escaped = escape_c_string(field)
      return "{line_dir}{o.setup}{p}gem_table_set({o.exprs[0]}, gem_string(\"{escaped}\"), {o.exprs[1]});"
    when {tag: "index_assign", object: object, key: key, value: value}
      let o = left_to_right([compile_expr(object), compile_expr(key), compile_expr(value)])
      return "{line_dir}{o.setup}{p}gem_table_set({o.exprs[0]}, {o.exprs[1]}, {o.exprs[2]});"
    when {tag: "if"}
      return "{line_dir}" + compile_if(node, indent, false)
    when {tag: "while"}
      return "{line_dir}" + compile_while(node, indent)
    when {tag: "match"}
      return "{line_dir}" + compile_match(node, indent, false)
    when {tag: "receive_match"}
      return "{line_dir}" + compile_receive_match(node, indent, false)
    when {tag: "break"}
      return p + "break;"
    when {tag: "continue"}
      return p + "continue;"
    when {tag: "return", value: value}
      if value != nil
        let r = compile_expr(value)
        let t = tmp()
        return "{line_dir}{r.setup}{p}GemVal {t} = {r.expr};\n{pop_str(p)}{p}return {t};"
      end
      return "{line_dir}{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "call"}
      let r = compile_expr(node)
      return "{line_dir}{r.setup}{p}(void)({r.expr});"
    when {tag: "fn_def"}
      return ""
    when {tag: "block", stmts: stmts}
      let b = buf_new()
      for stmt in stmts
        buf_push(b, compile_stmt(stmt, indent))
        buf_push(b, "\n")
      end
      return to_string(b)
    end

    let r = compile_expr(node)
    "{line_dir}{r.setup}{p}(void)({r.expr});"
  end

  # ─── compile_stmt_return ──

  compile_stmt_return = fn(node, indent)
    let p = pad_for(indent)
    let line_dir = ""
    if node.line != nil
      line_dir = "#line {node.line} \"{escape_c_string(rel_path(file_of(node)))}\"\n{setline_str(node.line, p)}"
    end

    if tco_fn_name != nil
      if is_node(node, "call") and is_node(node.func, "var") and node.func.name == tco_fn_name and not set_contains(local_names, tco_fn_name)
        return line_dir + emit_tco_continue(node, indent)
      end
      if is_node(node, "return") and node.value != nil and is_node(node.value, "call") and is_node(node.value.func, "var") and node.value.func.name == tco_fn_name and not set_contains(local_names, tco_fn_name)
        return line_dir + emit_tco_continue(node.value, indent)
      end
    end

    # Mutual-TCO: if we're inside an SCC member's body and this is a tail
    # call to a sibling member (not shadowed locally), trampoline it via
    # the global TLB instead of emitting a real C call. The wrapper around
    # gem_sccbody_<name> sees the marker and dispatches the next body.
    if current_scc_id != nil
      let scc_call_target = nil
      if is_node(node, "call") and is_node(node.func, "var")
        scc_call_target = node.func.name
      elif is_node(node, "return") and node.value != nil and is_node(node.value, "call") and is_node(node.value.func, "var")
        scc_call_target = node.value.func.name
      end
      if scc_call_target != nil and not set_contains(local_names, scc_call_target)
        let target_sid = scc_member_to_id[scc_call_target]
        let call_node = node
        if is_node(node, "return")
          call_node = node.value
        end
        # A call site passing more args than the TLB holds (GEM_MAX_TAIL_ARGS,
        # 16) stays a plain call: the members have at most 16 params, but
        # the extra args must still be evaluated and must not overrun the TLB.
        if target_sid == current_scc_id and scc_call_target != tco_fn_name and len(call_node.args) <= 16
          return line_dir + emit_scc_tail_call(call_node, scc_call_target, indent)
        end
      end
    end

    match node
    when {tag: "let", name: name, value: value}
      set_add(fn_scope_locals, name)
      let r = compile_expr(value)
      let mname = mangle(name)
      if in_top_level and set_contains(top_level_vars, name)
        return "{line_dir}{r.setup}{p}gem_global_set({gindex(name)}, {r.expr});\n{pop_str(p)}{p}return GEM_NIL;"
      end
      if set_contains(boxed_vars, name)
        return "{line_dir}{r.setup}{p}GemVal *{mname} = gem_box_alloc();\n{p}*{mname} = {r.expr};\n{pop_str(p)}{p}return GEM_NIL;"
      end
      return "{line_dir}{r.setup}{p}GemVal {mname} = {r.expr};\n{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "assign", name: name, value: value}
      check_assign_target(name, node)
      let r = compile_expr(value)
      let t = tmp()
      # An assignment is a statement: in tail position it yields nil, as a
      # field or index assignment does.
      return "{line_dir}{r.setup}{p}GemVal {t} = {r.expr};\n{p}{var_store(name, t)}\n{ns_refresh(name, p)}{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "return", value: value}
      if value != nil
        let r = compile_expr(value)
        let t = tmp()
        return "{line_dir}{r.setup}{p}GemVal {t} = {r.expr};\n{pop_str(p)}{p}return {t};"
      end
      return "{line_dir}{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "if"}
      return "{line_dir}" + compile_if(node, indent, true)
    when {tag: "while"}
      return "{line_dir}{compile_while(node, indent)}\n{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "match"}
      return "{line_dir}" + compile_match(node, indent, true)
    when {tag: "receive_match"}
      return "{line_dir}" + compile_receive_match(node, indent, true)
    when {tag: "block", stmts: stmts}
      let b = buf_new()
      buf_push(b, "{p}\{\n")
      let saved_block = set_union(fn_scope_locals, {})
      for i = 0, len(stmts) - 1
        buf_push(b, compile_stmt(stmts[i], indent + 1))
        buf_push(b, "\n")
      end
      if len(stmts) > 0
        buf_push(b, compile_stmt_return(stmts[-1], indent + 1))
        buf_push(b, "\n")
      end
      fn_scope_locals = saved_block
      buf_push(b, "{p}}")
      return to_string(b)
    when {tag: "dot_assign"}
      return "{compile_stmt(node, indent)}\n{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "index_assign"}
      return "{compile_stmt(node, indent)}\n{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "break"}
      return "{compile_stmt(node, indent)}\n{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "continue"}
      return "{compile_stmt(node, indent)}\n{pop_str(p)}{p}return GEM_NIL;"
    when {tag: "fn_def"}
      return "{compile_stmt(node, indent)}\n{pop_str(p)}{p}return GEM_NIL;"
    end

    let r = compile_expr(node)
    let t = tmp()
    "{line_dir}{r.setup}{p}GemVal {t} = {r.expr};\n{pop_str(p)}{p}return {t};"
  end

  # ─── compile_if ──

  compile_if = fn(node, indent, return_pos)
    let p = pad_for(indent)
    let cond_r = compile_expr(node.cond)
    let b = buf_new()
    buf_push(b, cond_r.setup)
    buf_push(b, "{p}if (gem_truthy({cond_r.expr})) \{\n")
    let saved_then = set_union(fn_scope_locals, {})
    buf_push(b, compile_stmts_tail(node.then, indent + 1, return_pos))
    fn_scope_locals = saved_then
    if node.else != nil
      buf_push(b, "{p}} else \{\n")
      let saved_else = set_union(fn_scope_locals, {})
      buf_push(b, compile_stmts_tail(node.else, indent + 1, return_pos))
      fn_scope_locals = saved_else
    elif return_pos
      buf_push(b, "{p}} else \{\n")
      buf_push(b, compile_stmts_tail([], indent + 1, true))
    end
    buf_push(b, "{p}}")
    to_string(b)
  end

  # ─── compile_while ──

  # Filter the live-at-back-edge set into reset roots, as C expressions of
  # type `GemVal *`: `&gem_v_<name>` for a C local, `gem_v_<name>` for a
  # capture of the enclosing closure (the env field already points at the
  # storage: a pinned box, a write-once arena box, or for a non-escaping
  # closure the outer frame's C local, which the closure may assign).
  # Pinned boxes of this frame go to `pinned_roots`. Dropped: builtins,
  # top-level fn refs and module slots (the runtime roots every slot).
  # Refuse when a name has no C local declaration at this loop's back-edge
  # (let in a nested if/match arm — `collect_top_let_names` does not descend
  # through those).
  let filter_live_for_rescue = fn(live_set)
    let roots = []
    let pinned_roots = []
    let lk = keys(live_set)
    for name in lk
      if is_global_ref(name)
        # module slot, rooted by the runtime
      elif set_contains(local_names, name)
        if set_contains(closure_captures, name)
          push(roots, mangle(name))
        elif set_contains(boxed_vars, name)
          # Mutated-captured local: malloc'd pinned box (gem_box_alloc).
          # Routed via pinned_roots[] so the runtime walks its contents.
          push(pinned_roots, mangle(name))
        elif not set_contains(fn_scope_locals, name)
          return {ok: false, reason: "live var `{name}` has no C local at this loop's back-edge (declared in a nested if/match arm?)"}
        else
          push(roots, "&{mangle(name)}")
        end
      elif set_contains(builtins, name)
        # builtin name resolves to a fn pointer; no rescue needed.
      elif set_contains(defined_fns, name)
        # top-level user fn; fn pointer, no rescue needed.
      else
        # Liveness is reporting a name that resolves nowhere — the source has
        # an undeclared identifier (typo or missing let/load). Skip it here so
        # compile_expr's var case surfaces the diagnostic with a line number.
      end
    end
    {ok: true, roots: roots, pinned_roots: pinned_roots}
  end

  let build_rescue_roots = fn(node)
    let do_rescue = false
    let rescue_roots = []
    let pinned_rescue_roots = []
    let refuse_reason = nil
    let lr = node.liveness_result
    if lr.ok
      let live = lr.live
      if len(stack_env_writes) > 0
        live = set_union(live, stack_env_writes)
      end
      let fr = filter_live_for_rescue(live)
      if fr.ok
        do_rescue = true
        rescue_roots = fr.roots
        pinned_rescue_roots = fr.pinned_roots
      else
        refuse_reason = fr.reason
      end
    else
      refuse_reason = lr.reason
    end
    # Only an infinite loop is worth a warning: a loop that terminates
    # frees its garbage at the next reset of an enclosing loop, or at
    # process exit.
    let infinite = is_node(node.cond, "bool") and node.cond.value == true
    if not do_rescue and infinite
      let line_str = "?"
      if node.line != nil
        line_str = to_string(node.line)
      end
      eprint("warning: {rel_path(file_of(node))}:{line_str}: cannot reset per-process arena at this loop's back-edge: {refuse_reason}. Memory will grow unbounded across iterations. This pattern is not yet supported in long-running loops — please file an issue with your case if it blocks you.\n")
    end
    {do_rescue: do_rescue, rescue_roots: rescue_roots, pinned_rescue_roots: pinned_rescue_roots}
  end

  # Emits `if (gem_arena_reset_due(&mark)) { ... reset ... }` for a loop
  # back-edge. `roots` are C expressions of type `GemVal *`.
  compile_while = fn(node, indent)
    let p = pad_for(indent)
    # Every loop whose live set liveness can root gets a region mark and a
    # back-edge reset; see emit_region_reset / gem_arena_reset_region.
    let is_pt_while = node.process_tail == true

    let do_rescue = false
    let rescue_roots = []
    let pinned_rescue_roots = []
    if is_pt_while
      let r = build_rescue_roots(node)
      do_rescue = r.do_rescue
      rescue_roots = r.rescue_roots
      pinned_rescue_roots = r.pinned_rescue_roots
    end

    let cond_r = compile_expr(node.cond)

    let eligible = find_append_vars(node.body)
    for name, _ in eligible
      if expr_has_var(node.cond, name)
        delete(eligible, name)
      end
      if set_contains(boxed_vars, name)
        delete(eligible, name)
      end
    end

    let saved_append = {}
    for k, v in append_buf_vars
      saved_append[k] = v
    end
    for name, _ in eligible
      set_add(append_buf_vars, name)
    end

    let b = buf_new()
    let mark = nil
    if do_rescue
      # SOUNDNESS: the mark is taken before the loop's first iteration, so
      # everything the enclosing frames hold predates it and is never moved
      # or freed by this loop's resets. At the back-edge the only values
      # allocated since the mark that this frame can still reach are the
      # live locals passed as roots (liveness.gem); older objects mutated
      # since the mark, module slots, the mailbox and pinned boxes are
      # handled by the runtime (gem_copy.c, "Region reset").
      mark_counter += 1
      mark = "_mk{mark_counter}"
      buf_push(b, "{p}GemArenaMark {mark};\n")
      buf_push(b, "{p}gem_arena_mark(&{mark});\n")
    end
    buf_push(b, "{p}while (1) \{\n")
    buf_push(b, "{p}    gem_yield_check();\n")
    if do_rescue
      buf_push(b, emit_region_reset("{p}    ", mark, rescue_roots, pinned_rescue_roots))
    end
    if cond_r.setup != ""
      buf_push(b, cond_r.setup)
    end
    buf_push(b, "{p}    if (!gem_truthy({cond_r.expr})) break;\n")
    let saved_while_scope = set_union(fn_scope_locals, {})
    buf_push(b, compile_stmts(node.body, indent + 1))
    fn_scope_locals = saved_while_scope
    buf_push(b, "{p}}")

    for name, _ in eligible
      let mname = var_lvalue(name)
      buf_push(b, "\n{p}{mname} = gem_string_finish({mname});")
      let refresh = ns_refresh(name, p)
      if refresh != ""
        buf_push(b, "\n" + substr(refresh, 0, len(refresh) - 1))
      end
    end

    append_buf_vars = saved_append
    to_string(b)
  end

  # ─── compile_match ──

  compile_match = fn(node, indent, return_pos)
    let p = pad_for(indent)
    let target_r = compile_expr(node.target)
    let t = nil
    if node.target_var != nil
      t = mangle(node.target_var)
    else
      t = tmp()
    end
    let b = buf_new()
    buf_push(b, target_r.setup)
    buf_push(b, "{p}GemVal {t} = {target_r.expr};\n")
    if len(node.whens) == 0
      if node.else != nil
        buf_push(b, compile_stmts_tail(node.else, indent, return_pos))
      elif return_pos
        buf_push(b, "{pop_str(p)}{p}return GEM_NIL;\n")
      end
      buf_push(b, "{p}(void){t};")
      return to_string(b)
    end
    for i = 0, len(node.whens)
      let w = node.whens[i]
      let val_r = compile_expr(w.value)
      if i == 0
        buf_push(b, val_r.setup)
        buf_push(b, "{p}if (gem_truthy({val_r.expr})) \{\n")
      else
        buf_push(b, "{p}} else \{\n")
        buf_push(b, val_r.setup)
        buf_push(b, "{p}if (gem_truthy({val_r.expr})) \{\n")
      end
      let saved_arm = set_union(fn_scope_locals, {})
      if w.bindings != nil
        for binding in w.bindings
          buf_push(b, compile_stmt(binding, indent + 1))
          buf_push(b, "\n")
        end
      end
      buf_push(b, compile_stmts_tail(w.body, indent + 1, return_pos))
      fn_scope_locals = saved_arm
    end
    if node.else != nil
      buf_push(b, "{p}} else \{\n")
      let saved_else = set_union(fn_scope_locals, {})
      buf_push(b, compile_stmts_tail(node.else, indent + 1, return_pos))
      fn_scope_locals = saved_else
    elif return_pos
      buf_push(b, "{p}} else \{\n")
      buf_push(b, compile_stmts_tail([], indent + 1, true))
    end
    buf_push(b, "{p}}")
    for i = 1, len(node.whens)
      buf_push(b, "\n{p}}")
    end
    to_string(b)
  end

  # ─── compile_receive_match ──

  compile_receive_match = fn(node, indent, return_pos)
    let p = pad_for(indent)
    let arms = node.arms
    let after_ms = node.after_ms
    let after_body = node.after_body

    let recv_tmp = mangle(node.recv_var)
    let matched_tmp = tmp()
    let prev_tmp = tmp()
    let cur_tmp = tmp()
    let deadline_tmp = tmp()
    let proc_tmp = tmp()

    let b = buf_new()

    buf_push(b, "{p}GemVal {recv_tmp} = GEM_NIL;\n")
    buf_push(b, "{p}int {matched_tmp} = -1;\n")

    if after_ms != nil
      let ms_r = compile_expr(after_ms)
      buf_push(b, ms_r.setup)
      buf_push(b, "{p}int64_t {deadline_tmp} = gem_after_deadline({ms_r.expr});\n")
    end

    buf_push(b, "{p}while (1) \{\n")
    let p2 = pad_for(indent + 1)

    buf_push(b, "{p2}GemProcess *{proc_tmp} = &gem_proc_table[gem_current_pid];\n")
    buf_push(b, "{p2}GemMsgNode *{prev_tmp} = NULL;\n")
    buf_push(b, "{p2}GemMsgNode *{cur_tmp} = {proc_tmp}->mailbox.head;\n")
    buf_push(b, "{p2}{matched_tmp} = -1;\n")
    # An `after`-only receive (no arms) takes no message: skip the scan
    # and just wait for the deadline, leaving the mailbox as it is.
    let scan_open = "{p2}while ({cur_tmp}) \{\n"
    if len(arms) == 0
      scan_open = "{p2}while (0) \{\n"
    end
    buf_push(b, scan_open)
    let p3 = pad_for(indent + 2)
    buf_push(b, "{p3}{recv_tmp} = {cur_tmp}->value;\n")

    for i = 0, len(arms)
      let arm = arms[i]
      let cond_r = compile_expr(arm.pattern.condition)
      if i == 0
        buf_push(b, cond_r.setup)
        buf_push(b, "{p3}if (gem_truthy({cond_r.expr})) \{\n")
      else
        buf_push(b, "{p3}} else \{\n")
        buf_push(b, cond_r.setup)
        buf_push(b, "{p3}if (gem_truthy({cond_r.expr})) \{\n")
      end
      buf_push(b, "{pad_for(indent + 3)}{matched_tmp} = {i};\n")
    end
    for i = 0, len(arms)
      buf_push(b, "{p3}}")
      if i < len(arms) - 1
        buf_push(b, "\n")
      end
    end
    buf_push(b, "\n")

    buf_push(b, "{p3}if ({matched_tmp} >= 0) \{\n")
    let p4 = pad_for(indent + 3)
    buf_push(b, "{p4}gem_mailbox_remove(&{proc_tmp}->mailbox, {prev_tmp}, {cur_tmp});\n")
    buf_push(b, "{p4}break;\n")
    buf_push(b, "{p3}}\n")

    buf_push(b, "{p3}{prev_tmp} = {cur_tmp};\n")
    buf_push(b, "{p3}{cur_tmp} = {cur_tmp}->next;\n")
    buf_push(b, "{p2}}\n")

    buf_push(b, "{p2}if ({matched_tmp} >= 0) break;\n")
    if after_ms != nil
      buf_push(b, "{p2}if (gem_now_ms() >= {deadline_tmp}) \{\n")
      buf_push(b, "{p2}    {matched_tmp} = -2;\n")
      buf_push(b, "{p2}    break;\n")
      buf_push(b, "{p2}}\n")
      buf_push(b, "{p2}gem_selective_yield({deadline_tmp});\n")
      buf_push(b, "{p2}if ({proc_tmp}->timed_out) \{\n")
      buf_push(b, "{p2}    {matched_tmp} = -2;\n")
      buf_push(b, "{p2}    break;\n")
      buf_push(b, "{p2}}\n")
    else
      buf_push(b, "{p2}gem_selective_yield(-1);\n")
    end

    buf_push(b, "{p}}\n")

    # Dispatch based on matched arm
    for i = 0, len(arms)
      let arm = arms[i]
      if i == 0
        buf_push(b, "{p}if ({matched_tmp} == {i}) \{\n")
      else
        buf_push(b, "{p}} else if ({matched_tmp} == {i}) \{\n")
      end
      let saved_arm = set_union(fn_scope_locals, {})
      if arm.pattern.bindings != nil
        for binding in arm.pattern.bindings
          buf_push(b, compile_stmt(binding, indent + 1))
          buf_push(b, "\n")
        end
      end
      buf_push(b, compile_stmts_tail(arm.body, indent + 1, return_pos))
      fn_scope_locals = saved_arm
    end

    # After clause. The scan loop only exits with an arm index or -2, so
    # the timeout branch is a plain `else`; that also lets the C compiler
    # see every path through a return-position receive return a value.
    if after_ms != nil
      # No arms: the timeout branch is the only one.
      if len(arms) == 0
        buf_push(b, "{p}\{\n")
      else
        buf_push(b, "{p}} else \{\n")
      end
      if after_body != nil
        let saved_after = set_union(fn_scope_locals, {})
        buf_push(b, compile_stmts_tail(after_body, indent + 1, return_pos))
        fn_scope_locals = saved_after
      elif return_pos
        buf_push(b, compile_stmts_tail([], indent + 1, true))
      end
    elif return_pos
      buf_push(b, "{p}} else \{\n")
      buf_push(b, compile_stmts_tail([], indent + 1, true))
    end

    buf_push(b, "{p}}")
    to_string(b)
  end

  # ─── compile_extern_fn ──

  # Helper: emit C forward declaration for an extern function
  let emit_extern_c_decl = fn(name, params, ret_type)
    let c_ret = "void"
    if ret_type == "Int"
      c_ret = "int64_t"
    elif ret_type == "Float"
      c_ret = "double"
    elif ret_type == "String"
      c_ret = "char*"
    elif ret_type == "Bool"
      c_ret = "int"
    elif ret_type == "Ptr"
      c_ret = "void*"
    elif ret_type == "Table"
      c_ret = "GemVal"
    elif ret_type == "Bytes"
      c_ret = "GemBytes"
    end

    let c_params = ""
    if len(params) == 0
      c_params = "void"
    else
      let first = true
      for i = 0, len(params)
        if not first
          c_params = c_params + ", "
        end
        first = false
        let pt = params[i]["type"]
        if pt == "Int"
          c_params = c_params + "int64_t"
        elif pt == "Float"
          c_params = c_params + "double"
        elif pt == "String"
          c_params = c_params + "const char*"
        elif pt == "Bool"
          c_params = c_params + "int"
        elif pt == "Ptr"
          c_params = c_params + "void*"
        elif pt == "Table"
          c_params = c_params + "GemVal"
        elif pt == "Bytes"
          c_params = c_params + "const uint8_t*, int64_t"
        else
          c_params = c_params + "GemVal"
        end
      end
    end

    push(extern_c_decls, "{c_ret} {name}({c_params});")
  end

  # Emit arity + per-argument type validation at the top of an extern wrapper.
  # Matches the diagnostic style of runtime builtins (see runtime/gem_builtins_*.c):
  # one snprintf'd error mentioning the arg index, declared type, and observed type.
  # Without this, a Gem-side mistake (wrong arity, wrong type) reads garbage out of
  # the GemVal union and passes it to C.
  let emit_extern_validation = fn(b, name, params)
    # Arity counts Gem arguments (a `Bytes` param is one Gem arg, two C args).
    # Too many raises like too few: an extern has no rest params to absorb them.
    let n = len(params)
    buf_push(b, "    if (argc != {n}) \{ char _eb[128]; snprintf(_eb, sizeof(_eb), \"{name}: expected {n} argument(s), got %d\", argc); gem_error(_eb); }\n")
    for i = 0, n
      let ptype = params[i]["type"]
      let val_tag = nil
      if ptype == "Int"
        val_tag = "VAL_INT"
      elif ptype == "Float"
        val_tag = "VAL_FLOAT"
      elif ptype == "String"
        val_tag = "VAL_STRING"
      elif ptype == "Bool"
        val_tag = "VAL_BOOL"
      elif ptype == "Ptr"
        val_tag = "VAL_INT"
      elif ptype == "Bytes"
        val_tag = "VAL_STRING"
      elif ptype == "Table"
        val_tag = "VAL_TABLE"
      end
      if val_tag != nil
        buf_push(b, "    if (args[{i}].type != {val_tag}) \{ char _eb[128]; snprintf(_eb, sizeof(_eb), \"{name}: arg {i} expected {ptype}, got %s\", gem_type_str(args[{i}])); gem_error(_eb); }\n")
      end
    end
  end

  compile_extern_fn = fn(node)
    let {name, params, ret_type} = node
    # The C function it calls: `name` is the Gem binding, which module
    # loading and builtin shadowing may have renamed (c_name keeps the
    # declared name, see rename_node in compiler/main.gem).
    let c_sym = name
    if node.c_name != nil
      c_sym = node.c_name
    end

    if node.blocking
      return compile_blocking_extern_fn(node)
    end

    let b = buf_new()
    buf_push(b, "static GemVal gem_fn_{name}(void *_env, GemVal *args, int argc) \{\n")
    emit_extern_validation(b, c_sym, params)

    let c_args = []
    for i = 0, len(params)
      let p = params[i]
      let ptype = p["type"]
      if ptype == "Int"
        buf_push(b, "    int64_t _p{i} = args[{i}].ival;\n")
        push(c_args, "_p{i}")
      elif ptype == "Float"
        buf_push(b, "    double _p{i} = args[{i}].fval;\n")
        push(c_args, "_p{i}")
      elif ptype == "String"
        buf_push(b, "    char* _p{i} = args[{i}].sval;\n")
        push(c_args, "_p{i}")
      elif ptype == "Bool"
        buf_push(b, "    int _p{i} = args[{i}].bval;\n")
        push(c_args, "_p{i}")
      elif ptype == "Ptr"
        buf_push(b, "    void* _p{i} = (void*)(intptr_t)args[{i}].ival;\n")
        push(c_args, "_p{i}")
      elif ptype == "Bytes"
        buf_push(b, "    const uint8_t* _p{i} = (const uint8_t*)args[{i}].sval;\n")
        buf_push(b, "    int64_t _p{i}_len = (int64_t)args[{i}].slen;\n")
        push(c_args, "_p{i}")
        push(c_args, "_p{i}_len")
      elif ptype == "Table"
        push(c_args, "args[{i}]")
      else
        push(c_args, "args[{i}]")
      end
    end

    # Build call arg list
    let call_args = ""
    for i = 0, len(c_args)
      if i > 0
        call_args = call_args + ", "
      end
      call_args = call_args + c_args[i]
    end

    let call_expr = "{c_sym}({call_args})"

    if ret_type == "Nil"
      buf_push(b, "    {call_expr};\n")
      buf_push(b, "    return GEM_NIL;\n")
    elif ret_type == "Table"
      buf_push(b, "    return {call_expr};\n")
    elif ret_type == "Int"
      buf_push(b, "    int64_t _ret = {call_expr};\n")
      buf_push(b, "    return gem_int(_ret);\n")
    elif ret_type == "Float"
      buf_push(b, "    double _ret = {call_expr};\n")
      buf_push(b, "    return gem_float(_ret);\n")
    elif ret_type == "String"
      buf_push(b, "    char* _ret = {call_expr};\n")
      buf_push(b, "    return _ret ? gem_string(_ret) : GEM_NIL;\n")
    elif ret_type == "Bool"
      buf_push(b, "    int _ret = {call_expr};\n")
      buf_push(b, "    return gem_bool(_ret);\n")
    elif ret_type == "Ptr"
      buf_push(b, "    void *_ret = {call_expr};\n")
      buf_push(b, "    return gem_int((int64_t)(intptr_t)_ret);\n")
    elif ret_type == "Bytes"
      buf_push(b, "    GemBytes _ret = {call_expr};\n")
      buf_push(b, "    return _ret.data ? gem_string_with_len((const char*)_ret.data, (int)_ret.len) : GEM_NIL;\n")
    else
      buf_push(b, "    {call_expr};\n")
      buf_push(b, "    return GEM_NIL;\n")
    end

    buf_push(b, "}")

    push(forward_decls, "static GemVal gem_fn_{name}(void *_env, GemVal *args, int argc);")
    emit_extern_c_decl(c_sym, params, ret_type)

    to_string(b)
  end

  # ─── compile_blocking_extern_fn ──
  # Emits: args struct, worker function, Gem wrapper with thread pool path

  compile_blocking_extern_fn = fn(node)
    let {name, params, ret_type} = node
    # The C function it calls: `name` is the Gem binding, which module
    # loading and builtin shadowing may have renamed (c_name keeps the
    # declared name, see rename_node in compiler/main.gem).
    let c_sym = name
    if node.c_name != nil
      c_sym = node.c_name
    end
    let b = buf_new()

    # 1. Args struct
    buf_push(b, "struct _blk_{name}_args \{\n")
    for i = 0, len(params)
      let ptype = params[i]["type"]
      if ptype == "Int"
        buf_push(b, "    int64_t _p{i};\n")
      elif ptype == "Float"
        buf_push(b, "    double _p{i};\n")
      elif ptype == "String"
        buf_push(b, "    char *_p{i};\n")
      elif ptype == "Bool"
        buf_push(b, "    int _p{i};\n")
      elif ptype == "Ptr"
        buf_push(b, "    void *_p{i};\n")
      elif ptype == "Bytes"
        buf_push(b, "    uint8_t *_p{i};\n")
        buf_push(b, "    int64_t _p{i}_len;\n")
      end
    end
    if ret_type == "Int"
      buf_push(b, "    int64_t _result;\n")
    elif ret_type == "Float"
      buf_push(b, "    double _result;\n")
    elif ret_type == "String"
      buf_push(b, "    char *_result;\n")
    elif ret_type == "Bool"
      buf_push(b, "    int _result;\n")
    elif ret_type == "Ptr"
      buf_push(b, "    void *_result;\n")
    elif ret_type == "Bytes"
      buf_push(b, "    GemBytes _result;\n")
    end
    buf_push(b, "};\n\n")

    # 2. Worker function (called on thread pool)
    buf_push(b, "static void _blk_{name}_worker(void *_a) \{\n")
    buf_push(b, "    struct _blk_{name}_args *a = (struct _blk_{name}_args *)_a;\n")

    let w_args = ""
    let w_first = true
    for i = 0, len(params)
      if not w_first
        w_args = w_args + ", "
      end
      w_first = false
      if params[i]["type"] == "Bytes"
        w_args = w_args + "a->_p{i}, a->_p{i}_len"
      else
        w_args = w_args + "a->_p{i}"
      end
    end
    let w_call = "{c_sym}({w_args})"

    if ret_type == "Nil"
      buf_push(b, "    {w_call};\n")
    else
      buf_push(b, "    a->_result = {w_call};\n")
    end
    buf_push(b, "}\n\n")

    # 3. Free callback, passed to gem_io_submit_extern, which owns the struct
    # from then on: frees the copied inputs, any malloc'd String/Bytes result
    # still in the struct, and the struct itself.
    buf_push(b, "static void _blk_{name}_free(void *_a) \{\n")
    buf_push(b, "    struct _blk_{name}_args *a = (struct _blk_{name}_args *)_a;\n")
    for i = 0, len(params)
      let pt = params[i]["type"]
      if pt == "String" or pt == "Bytes"
        buf_push(b, "    free(a->_p{i});\n")
      end
    end
    if ret_type == "String"
      buf_push(b, "    free(a->_result);\n")
    elif ret_type == "Bytes"
      buf_push(b, "    free((void *)a->_result.data);\n")
    end
    buf_push(b, "    free(a);\n")
    buf_push(b, "}\n\n")

    # 4. Gem wrapper function
    buf_push(b, "static GemVal gem_fn_{name}(void *_env, GemVal *args, int argc) \{\n")
    emit_extern_validation(b, c_sym, params)

    # Extract args from GemVal
    for i = 0, len(params)
      let ptype = params[i]["type"]
      if ptype == "Int"
        buf_push(b, "    int64_t _p{i} = args[{i}].ival;\n")
      elif ptype == "Float"
        buf_push(b, "    double _p{i} = args[{i}].fval;\n")
      elif ptype == "String"
        buf_push(b, "    char* _p{i} = args[{i}].sval;\n")
      elif ptype == "Bool"
        buf_push(b, "    int _p{i} = args[{i}].bval;\n")
      elif ptype == "Ptr"
        buf_push(b, "    void* _p{i} = (void*)(intptr_t)args[{i}].ival;\n")
      elif ptype == "Bytes"
        buf_push(b, "    const uint8_t* _p{i} = (const uint8_t*)args[{i}].sval;\n")
        buf_push(b, "    int64_t _p{i}_len = (int64_t)args[{i}].slen;\n")
      end
    end

    # Blocking path: submit to thread pool, yield, resume with result
    buf_push(b, "    if (gem_current_pid >= 0) \{\n")
    buf_push(b, "        struct _blk_{name}_args *_ba = (struct _blk_{name}_args *)calloc(1, sizeof(struct _blk_{name}_args));\n")

    # Copy String/Bytes args out of the arena (strdup / memcpy): the worker
    # may still read them after a killed requester's arena is destroyed
    for i = 0, len(params)
      let ptype = params[i]["type"]
      if ptype == "String"
        buf_push(b, "        _ba->_p{i} = strdup(_p{i});\n")
      elif ptype == "Bytes"
        buf_push(b, "        _ba->_p{i} = (uint8_t*)malloc((size_t)_p{i}_len);\n")
        buf_push(b, "        if (_p{i}_len > 0) memcpy(_ba->_p{i}, _p{i}, (size_t)_p{i}_len);\n")
        buf_push(b, "        _ba->_p{i}_len = _p{i}_len;\n")
      else
        buf_push(b, "        _ba->_p{i} = _p{i};\n")
      end
    end

    buf_push(b, "        GemIORequest *_req = gem_io_submit_extern(_blk_{name}_worker, _ba, _blk_{name}_free);\n")
    buf_push(b, "        if (!_req) gem_error(\"{c_sym}: I/O queue full\");\n")
    buf_push(b, "        GemProcess *_proc = &gem_proc_table[gem_current_pid];\n")
    buf_push(b, "        _proc->io_request = _req;\n")
    buf_push(b, "        gem_io_pool_yield();\n")
    buf_push(b, "        _proc->io_request = NULL;\n")

    # Copy the result out of the args struct, then release the request
    if ret_type == "String"
      buf_push(b, "        GemVal _gv = gem_string(_ba->_result ? _ba->_result : \"\");\n")
      buf_push(b, "        gem_io_release(_req);\n")
      buf_push(b, "        return _gv;\n")
    elif ret_type == "Bytes"
      buf_push(b, "        GemBytes _raw = _ba->_result;\n")
      buf_push(b, "        GemVal _gv = _raw.data ? gem_string_with_len((const char*)_raw.data, (int)_raw.len) : gem_string_with_len(\"\", 0);\n")
      buf_push(b, "        gem_io_release(_req);\n")
      buf_push(b, "        return _gv;\n")
    elif ret_type == "Nil"
      buf_push(b, "        gem_io_release(_req);\n")
      buf_push(b, "        return GEM_NIL;\n")
    else
      let c_type = "int64_t"
      let ret_val = "gem_int(_ret)"
      if ret_type == "Float"
        c_type = "double"
        ret_val = "gem_float(_ret)"
      elif ret_type == "Bool"
        c_type = "int"
        ret_val = "gem_bool(_ret)"
      elif ret_type == "Ptr"
        c_type = "void *"
        ret_val = "gem_int((int64_t)(intptr_t)_ret)"
      end
      buf_push(b, "        {c_type} _ret = _ba->_result;\n")
      buf_push(b, "        gem_io_release(_req);\n")
      buf_push(b, "        return {ret_val};\n")
    end
    buf_push(b, "    }\n")

    # Direct call path, for a call made outside any process. Results are
    # owned the same way as on the pool path.
    let d_args = ""
    let d_first = true
    for i = 0, len(params)
      if not d_first
        d_args = d_args + ", "
      end
      d_first = false
      if params[i]["type"] == "Bytes"
        d_args = d_args + "_p{i}, _p{i}_len"
      else
        d_args = d_args + "_p{i}"
      end
    end
    let d_call = "{c_sym}({d_args})"

    if ret_type == "Nil"
      buf_push(b, "    {d_call};\n")
      buf_push(b, "    return GEM_NIL;\n")
    elif ret_type == "Int"
      buf_push(b, "    int64_t _ret = {d_call};\n")
      buf_push(b, "    return gem_int(_ret);\n")
    elif ret_type == "Float"
      buf_push(b, "    double _ret = {d_call};\n")
      buf_push(b, "    return gem_float(_ret);\n")
    elif ret_type == "String"
      buf_push(b, "    char* _ret = {d_call};\n")
      buf_push(b, "    GemVal _gv = gem_string(_ret ? _ret : \"\");\n")
      buf_push(b, "    free(_ret);\n")
      buf_push(b, "    return _gv;\n")
    elif ret_type == "Bool"
      buf_push(b, "    int _ret = {d_call};\n")
      buf_push(b, "    return gem_bool(_ret);\n")
    elif ret_type == "Ptr"
      buf_push(b, "    void *_ret = {d_call};\n")
      buf_push(b, "    return gem_int((int64_t)(intptr_t)_ret);\n")
    elif ret_type == "Bytes"
      buf_push(b, "    GemBytes _ret = {d_call};\n")
      buf_push(b, "    GemVal _gv = _ret.data ? gem_string_with_len((const char*)_ret.data, (int)_ret.len) : gem_string_with_len(\"\", 0);\n")
      buf_push(b, "    if (_ret.data) free((void*)_ret.data);\n")
      buf_push(b, "    return _gv;\n")
    else
      buf_push(b, "    {d_call};\n")
      buf_push(b, "    return GEM_NIL;\n")
    end

    buf_push(b, "}")

    push(forward_decls, "static GemVal gem_fn_{name}(void *_env, GemVal *args, int argc);")
    emit_extern_c_decl(c_sym, params, ret_type)

    to_string(b)
  end

  # ─── emit_param_bindings: generate C code to bind params, rest, block ──

  # `rebind` = false: declare and bind at function entry.
  # `rebind` = true: re-assign the already-declared params from the current
  # `args`/`argc` (the TCO rebind block). Boxed params get a fresh box, so a
  # closure from an earlier iteration keeps its own binding, as with a real
  # call.
  let emit_param_bindings_impl = fn(node, params, cap_set, rebind)
    let b = buf_new()
    let defaults = node.defaults
    if defaults == nil
      defaults = []
    end
    let decl_box = "GemVal *"
    let decl_val = "GemVal "
    if rebind
      decl_box = ""
      decl_val = ""
    end
    # Defaults run before the body: a body let must not shadow a module
    # global (or anything else) they name. Only params and captures are
    # in scope.
    let saved_local_names = local_names
    let entry_scope = set_union(sorted_array_to_set(params), closure_captures)
    if node.rest_param != nil
      set_add(entry_scope, node.rest_param)
    end
    local_names = set_intersect(local_names, entry_scope)
    for i = 0, len(params)
      let mp = mangle(params[i])
      let has_def = i < len(defaults) and defaults[i] != nil
      if has_def
        let r = compile_expr(defaults[i])
        if set_contains(cap_set, params[i])
          buf_push(b, "    {decl_box}{mp} = gem_box_alloc();\n")
          buf_push(b, "    if (argc > {i}) \{ *{mp} = args[{i}]; } else \{\n")
          buf_push(b, r.setup)
          buf_push(b, "    *{mp} = {r.expr};\n    }\n")
        else
          if not rebind
            buf_push(b, "    GemVal {mp};\n")
          end
          buf_push(b, "    if (argc > {i}) \{ {mp} = args[{i}]; } else \{\n")
          buf_push(b, r.setup)
          buf_push(b, "    {mp} = {r.expr};\n    }\n")
        end
      else
        if set_contains(cap_set, params[i])
          buf_push(b, "    {decl_box}{mp} = gem_box_alloc();\n")
          buf_push(b, "    *{mp} = (argc > {i}) ? args[{i}] : GEM_NIL;\n")
        else
          buf_push(b, "    {decl_val}{mp} = (argc > {i}) ? args[{i}] : GEM_NIL;\n")
        end
      end
    end

    # Bind rest param: pack args[N .. argc-end_count-1] into an array
    if node.rest_param != nil
      let N = len(params)
      let mp_rest = mangle(node.rest_param)
      if set_contains(cap_set, node.rest_param)
        buf_push(b, "    {decl_box}{mp_rest} = gem_box_alloc();\n")
        buf_push(b, "    *{mp_rest} = gem_table_new();\n")
        buf_push(b, "    for (int _ri = {N}; _ri < argc; _ri++) gem_table_set(*{mp_rest}, gem_int(_ri - {N}), args[_ri]);\n")
      else
        buf_push(b, "    {decl_val}{mp_rest} = gem_table_new();\n")
        buf_push(b, "    for (int _ri = {N}; _ri < argc; _ri++) gem_table_set({mp_rest}, gem_int(_ri - {N}), args[_ri]);\n")
      end
    end
    local_names = saved_local_names
    to_string(b)
  end

  let emit_param_bindings = fn(node, params, cap_set)
    emit_param_bindings_impl(node, params, cap_set, false)
  end

  # ─── emit_fn_body: compile body stmts with implicit return ──

  let emit_fn_body = fn(body)
    let b = buf_new()
    if len(body) > 0
      for i = 0, len(body) - 1
        buf_push(b, compile_stmt(body[i], 1))
        buf_push(b, "\n")
      end
      buf_push(b, compile_stmt_return(body[-1], 1))
      buf_push(b, "\n")
    else
      let pf = pop_str("    ")
      buf_push(b, "{pf}    return GEM_NIL;\n")
    end
    to_string(b)
  end

  # ─── compile_fn ──

  compile_fn = fn(node)
    let {params, body, name} = node

    # Determine which variables are captured by nested closures
    let scope_vars = sorted_array_to_set(params)
    if node.rest_param != nil
      set_add(scope_vars, node.rest_param)
    end
    collect_top_let_names(body, scope_vars)

    # Build a separate set including lets nested in any control-flow arm,
    # used to suppress top-level-boxed deref when a shadowing local exists.
    let shadowed_locals = set_union(scope_vars, {})
    collect_shadow_lets_in_fn(body, shadowed_locals)

    let saved_boxed = boxed_vars
    let saved_top = in_top_level
    let saved_local = local_names
    let saved_fn_scope = fn_scope_locals
    let saved_in_leaf = in_leaf_fn
    local_names = shadowed_locals
    # Flow-sensitive: params now, each let as compile_stmt reaches it (so a
    # read of a module global before a same-named let still hits the slot).
    fn_scope_locals = sorted_array_to_set(params)
    if node.rest_param != nil
      set_add(fn_scope_locals, node.rest_param)
    end
    let saved_fn_closure_captures = closure_captures
    closure_captures = {}
    in_leaf_fn = body_is_leaf(body)

    let captured = find_captured_in_scope(body, scope_vars)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_captures_node(d, scope_vars, captured)
        end
      end
    end

    # Mutation-aware boxing: only captures that some nested anon_fn writes
    # need a heap box. Read-only captures (captured \ writes) live as plain
    # locals; closure envs receive them as `GemVal` value snapshots.
    # Writes are classified over every local of the body (nested-block lets
    # too): a closure that assigns a capture must share a box with the
    # outer frame, never write into its own snapshot box (arena reset
    # treats arena capture boxes as write-once).
    let cap_writes = find_capture_writes_in_scope(body, shadowed_locals)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_writes_node(d, scope_vars, {}, cap_writes, false)
        end
      end
    end
    boxed_vars = set_intersect(captured, cap_writes)
    in_top_level = false

    let has_defs = false
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          has_defs = true
          break
        end
      end
    end
    let use_tco = fn_def_is_tco(node)
    if use_tco
      tco_fn_name = name
      tco_params = params
      tco_boxed = boxed_vars
      tco_rebind = has_defs or node.rest_param != nil
      tco_argv_max = 0
    end

    # ─── SCC member detection ───
    # If `name` is in a viable mutual-TCO SCC, emit the body as
    # `gem_sccbody_<name>` and a thin trampoline wrapper as the
    # public `gem_fn_<name>`. Direct-self TCO inside the body still
    # works (faster than trampolining); only intra-SCC tail calls to
    # SIBLINGS go through the trampoline marker.
    let scc_id = scc_member_to_id[name]
    let saved_scc = current_scc_id
    let body_fn_name = "gem_fn_{name}"
    if scc_id != nil
      current_scc_id = scc_id
      body_fn_name = "gem_sccbody_{name}"
    end

    let b = buf_new()
    buf_push(b, "static GemVal {body_fn_name}(void *_env, GemVal *args, int argc) \{\n")

    if node.line != nil
      buf_push(b, "#line {node.line} \"{escape_c_string(rel_path(file_of(node)))}\"\n")
    end

    buf_push(b, emit_param_bindings(node, params, boxed_vars))

    let fn_line = 0
    if node.line != nil
      fn_line = node.line
    end
    if in_leaf_fn
      buf_push(b, leaf_entry_str(frame_name(name), rel_path(file_of(node)), fn_line, body))
    else
      buf_push(b, "    gem_push_frame(\"{escape_c_string(frame_name(name))}\", \"{escape_c_string(rel_path(file_of(node)))}\", {fn_line});\n")
    end

    if use_tco and tco_rebind
      # Rebind mode (default / rest params). The body runs in its own C
      # block so its locals are out of scope at `_tco_rebind`; a self tail
      # call stores its args in `_tco_argv` and jumps there, and the rebind
      # block binds params the way function entry does. The rebind code is
      # compiled before the body so it sees the entry scope state.
      let rebind_c = emit_param_bindings_impl(node, params, boxed_vars, true)
      let bb = buf_new()
      if len(body) > 0
        for i = 0, len(body) - 1
          buf_push(bb, compile_stmt(body[i], 3))
          buf_push(bb, "\n")
        end
        buf_push(bb, compile_stmt_return(body[-1], 3))
        buf_push(bb, "\n")
      else
        let pf3 = pop_str("            ")
        buf_push(bb, "{pf3}            return GEM_NIL;\n")
      end
      let argv_n = tco_argv_max
      if argv_n < 1
        argv_n = 1
      end
      buf_push(b, "    GemVal _tco_argv[{argv_n}];\n")
      buf_push(b, "    GemArenaMark _tco_mk;\n")
      buf_push(b, "    gem_arena_mark(&_tco_mk);\n")
      buf_push(b, "    while(1) \{\n")
      buf_push(b, "        gem_yield_check();\n")
      buf_push(b, "        \{\n")
      buf_push(b, to_string(bb))
      buf_push(b, "        \}\n")
      buf_push(b, "    _tco_rebind: ;\n")
      buf_push(b, rebind_c)
      buf_push(b, "    \}\n")
    elif use_tco
      buf_push(b, "    GemArenaMark _tco_mk;\n")
      buf_push(b, "    gem_arena_mark(&_tco_mk);\n")
      buf_push(b, "    while(1) \{\n")
      buf_push(b, "        gem_yield_check();\n")
      if len(body) > 0
        for i = 0, len(body) - 1
          buf_push(b, compile_stmt(body[i], 2))
          buf_push(b, "\n")
        end
        buf_push(b, compile_stmt_return(body[-1], 2))
        buf_push(b, "\n")
      else
        let pf2 = pop_str("        ")
        buf_push(b, "{pf2}        return GEM_NIL;\n")
      end
      buf_push(b, "    \}\n")
    else
      buf_push(b, emit_fn_body(body))
    end

    buf_push(b, "}")

    if use_tco
      tco_fn_name = nil
      tco_params = nil
      tco_boxed = nil
      tco_rebind = false
      tco_argv_max = 0
    end

    # ─── SCC trampoline wrapper ───
    # Public `gem_fn_<name>` calls `gem_sccbody_<name>` in a loop, redispatching
    # whenever the body exits via the mutual-TCO TLB marker. The body pushes/pops
    # its own frame, so traces attribute correctly to the currently-executing
    # member. Per-iteration arena reset mirrors the direct-TCO reset, gated the
    # same way (unconditional for process_tail SCCs, depth-2 fenced otherwise).
    if scc_id != nil
      buf_push(b, "\n\n")
      buf_push(b, scc_wrapper_for(node, scc_id))
      current_scc_id = saved_scc
    end

    boxed_vars = saved_boxed
    in_top_level = saved_top
    local_names = saved_local
    fn_scope_locals = saved_fn_scope
    closure_captures = saved_fn_closure_captures
    in_leaf_fn = saved_in_leaf
    to_string(b)
  end

  # ─── compile_closure_fn ──

  compile_closure_fn = fn(node, captures)
    let {params, body} = node
    let name = anon_name()

    # Find which vars inside THIS closure are captured by nested closures
    let inner_scope = sorted_array_to_set(params)
    if node.rest_param != nil
      set_add(inner_scope, node.rest_param)
    end
    collect_top_let_names(body, inner_scope)

    # Build a shadowing-locals set including lets nested in control-flow.
    let shadowed_locals = set_union(inner_scope, {})
    collect_shadow_lets_in_fn(body, shadowed_locals)

    let saved_boxed = boxed_vars
    let saved_top = in_top_level
    let saved_local = local_names
    let saved_fn_scope = fn_scope_locals
    let saved_closure_captures = closure_captures
    let saved_current_closure_struct_name = current_closure_struct_name
    let saved_current_closure_captures = current_closure_captures
    let saved_stack_env_writes = stack_env_writes
    let saved_in_leaf = in_leaf_fn
    # A tail call inside this closure is the closure's own tail call, not
    # the enclosing named fn's: suspend that fn's self-TCO and mutual-TCO
    # rewrites (they would emit `continue`/`goto`/a TLB return in a
    # different C function).
    let saved_tco_fn_name = tco_fn_name
    let saved_scc_id = current_scc_id
    tco_fn_name = nil
    current_scc_id = nil
    local_names = set_union(shadowed_locals, sorted_array_to_set(captures))
    fn_scope_locals = sorted_array_to_set(params)
    if node.rest_param != nil
      set_add(fn_scope_locals, node.rest_param)
    end
    in_leaf_fn = body_is_leaf(body)

    let inner_captured = find_captured_in_scope(body, inner_scope)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_captures_node(d, inner_scope, inner_captured)
        end
      end
    end

    # Mutation-aware boxing for vars in this closure's local scope captured
    # by nested anon_fns: only box those that those nested anons mutate.
    let inner_writes = find_capture_writes_in_scope(body, shadowed_locals)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_writes_node(d, inner_scope, {}, inner_writes, false)
        end
      end
    end
    let inner_boxed = set_intersect(inner_captured, inner_writes)

    # Env captures are always passed in by `GemVal *` so the runtime's
    # spawn deep-copy can walk them uniformly. The closure body therefore
    # treats every capture as boxed (reads/writes deref via boxed_vars).
    boxed_vars = set_union(inner_boxed, sorted_array_to_set(captures))
    in_top_level = false

    # Generate struct
    let struct_name = "_closure_{name}"
    let sb = buf_new()
    buf_push(sb, "struct {struct_name} \{\n")
    buf_push(sb, "    intptr_t _num_captures;\n")
    for cap in captures
      buf_push(sb, "    GemVal *{mangle(cap)};\n")
    end
    buf_push(sb, "};\n")
    let struct_def = to_string(sb)

    # Generate function
    let fb = buf_new()
    buf_push(fb, "static GemVal {name}(void *_env, GemVal *args, int argc) \{\n")
    if len(captures) > 0
      buf_push(fb, "    struct {struct_name} *_cls = (struct {struct_name} *)_env;\n")
      for cap in captures
        let mc = mangle(cap)
        buf_push(fb, "    GemVal *{mc} = _cls->{mc};\n")
      end
    end

    closure_captures = sorted_array_to_set(captures)
    current_closure_struct_name = struct_name
    current_closure_captures = captures
    stack_env_writes = {}
    if node.non_escaping == true and len(captures) > 0
      let own = sorted_array_to_set(params)
      if node.rest_param != nil
        set_add(own, node.rest_param)
      end
      stack_env_writes = find_writes_in_closure_body(body, closure_captures, own)
    end

    buf_push(fb, emit_param_bindings(node, params, inner_boxed))
    let anon_line = 0
    if node.line != nil
      anon_line = node.line
    end
    if in_leaf_fn
      buf_push(fb, leaf_entry_str("anonymous fn", rel_path(file_of(node)), anon_line, body))
    else
      buf_push(fb, "    gem_push_frame(\"anonymous fn\", \"{escape_c_string(rel_path(file_of(node)))}\", {anon_line});\n")
    end
    buf_push(fb, emit_fn_body(body))
    buf_push(fb, "}")

    boxed_vars = saved_boxed
    in_top_level = saved_top
    local_names = saved_local
    fn_scope_locals = saved_fn_scope
    closure_captures = saved_closure_captures
    current_closure_struct_name = saved_current_closure_struct_name
    current_closure_captures = saved_current_closure_captures
    stack_env_writes = saved_stack_env_writes
    in_leaf_fn = saved_in_leaf
    tco_fn_name = saved_tco_fn_name
    current_scc_id = saved_scc_id

    # Add struct + function to functions list
    push(functions, struct_def + to_string(fb))

    {fn_name: name, struct_name: struct_name, captures: captures}
  end

  # ─── compile (top-level) ──

  # `extern include "<path>"` lines. A relative path names a file next to
  # the .gem file containing the include (each loaded module relative to
  # its own file): when that file exists it is emitted by its absolute
  # path, since the C file is compiled from /tmp, and only once however
  # many files include it. Otherwise the path is
  # left to cc's search (system headers such as "string.h", and "gem.h" on
  # the runtime include path). A path that can only mean a file of the
  # user's (absolute, or starting with ./ or ../) and isn't there is a
  # compile error at the include. When `c_file` (the C file cc compiles)
  # is known, a `#line` before each header left to cc's search makes cc
  # report a missing one at the .gem line, and a `#line` after the block
  # points the rest of the output back at the C file.
  let emit_extern_includes = fn(ob, includes, c_file)
    let phys = 0
    let redirected = false
    let seen = {}
    for ei in includes
      let path = ei.path
      let line = ei.line
      if line == nil then line = 0 end
      let col = ei.col
      if col == nil then col = 0 end
      let span = len(path) + 2
      if path == "" or str_replace(path, "\"", "") != path or str_replace(path, "\n", "") != path
        sink.report(source_of(ei), file_of(ei), line, col, span, "invalid header path in extern include: \"{escape_c_string(path)}\"", nil)
        continue
      end
      let is_abs = substr(path, 0, 1) == "/"
      let candidate = path_join(dirname(file_of(ei)), path)
      if file_exists(candidate) and not is_dir(candidate)
        let full = path
        if not is_abs
          full = normalize_path(candidate)
        end
        # Two files including the same header get it once.
        if not has_key(seen, full)
          seen[full] = true
          buf_push(ob, "#include \"{full}\"\n")
          phys += 1
        end
      elif is_abs or substr(path, 0, 2) == "./" or substr(path, 0, 3) == "../"
        if is_abs
          sink.report(source_of(ei), file_of(ei), line, col, span, "header not found: {path}", nil)
        else
          sink.report(source_of(ei), file_of(ei), line, col, span, "header not found: {path} (looked in {dirname(rel_path(file_of(ei)))}/)", "a relative path is resolved against the directory of the .gem file that contains the extern include")
        end
      else
        if c_file != nil and line > 0
          buf_push(ob, "#line {line} \"{escape_c_string(rel_path(file_of(ei)))}\"\n")
          phys += 1
          redirected = true
        end
        buf_push(ob, "#include \"{path}\"\n")
        phys += 1
      end
    end
    if redirected
      buf_push(ob, "#line {phys + 2} \"{escape_c_string(c_file)}\"\n")
    end
  end

  let compile = fn(ast, c_file)
    # Separate different statement types
    let fn_defs = []
    let extern_fns_list = []
    let extern_includes = []
    let top_stmts = []

    for s in ast.stmts
      if s.tag == "fn_def"
        push(fn_defs, s)
      elif s.tag == "extern_fn"
        push(extern_fns_list, s)
      elif s.tag == "extern_include"
        push(extern_includes, s)
      elif s.tag == "export"
        # handled during load resolution
      else
        push(top_stmts, s)
      end
    end

    # Give every let that shadows a visible name (param, outer local,
    # module binding, named fn) its own fresh name, so it is a new variable,
    # and report uses of a block's lets after the block ended (see
    # scope_shadowing_lets).
    let extern_names = []
    for ef in extern_fns_list
      push(extern_names, ef.name)
    end
    let report_out_of_scope = fn(node, name, kind, decl)
      # `where`: " at line N" (or " at <file>:N" when the let is in another
      # file: the walk covers every loaded module's top-level code).
      let where = ""
      if decl != nil and decl.line != nil
        if file_of(decl) == file_of(node)
          where = " at line {decl.line}"
        else
          where = " at {rel_path(file_of(decl))}:{decl.line}"
        end
      end
      let at = ""
      if where != ""
        at = "{where},"
      end
      let hint = "`{name}` is declared{at} inside a block that has ended; declare it before that block (`let {name} = nil`) and assign it inside"
      if kind == "later"
        hint = "`{name}` is declared{at} after this use or in a block that does not contain it; a `let` is visible from its declaration to the end of its block"
      elif kind == "later_closure"
        hint = "a closure sees only variables declared before it is created, and the `let` of `{name}`{where} comes after; declare it first (`let {name} = nil`) and assign it afterwards (`{name} = ...`)"
      end
      sink.report(source_of(node), file_of(node), node.line, node.col, len(name), "undeclared identifier `{name}`", hint)
    end
    scope_shadowing_lets(fn_defs, top_stmts, builtin_fns, extern_names, report_out_of_scope)

    # Mark non-escaping closures (immediate-call-site args to allowlisted
    # callees like pcall/sort). Must run before any capture analysis below
    # — find_captured_in_scope reads the non_escaping flag.
    for fd in fn_defs
      mark_non_escaping_stmts(fd.body, fd)
    end
    mark_non_escaping_stmts(top_stmts, top_stmts)

    # Call graph (for mutual-TCO SCCs and the module-state note), loop
    # tagging and per-loop liveness.
    mark_process_tail(fn_defs, top_stmts)

    # Liveness-driven hoist: for PT-while nodes, lift arm-lets live at the
    # back-edge to the surrounding stmt list so they have a stable C local.
    # Must run AFTER mark_process_tail (which attaches `liveness_result`)
    # and before codegen reads the AST.
    for fd in fn_defs
      lift_captured_arm_lets_in_fn(fd)
    end
    lift_captured_arm_lets_top_stmts(top_stmts)

    # Register extern fns as defined (callable)
    for ef in extern_fns_list
      set_add(defined_fns, ef.name)
    end

    # Forward declarations for user-defined functions
    for fd in fn_defs
      set_add(defined_fns, fd.name)
      let decl = "static GemVal gem_fn_{fd.name}(void *_env, GemVal *args, int argc);"
      push(forward_decls, decl)
      # SCC members get an extra body decl so the wrapper and other SCC
      # members' marker emissions can reference the body directly.
      if scc_member_to_id[fd.name] != nil
        push(forward_decls, "static GemVal gem_sccbody_{fd.name}(void *_env, GemVal *args, int argc);")
      end
    end

    # Collect top-level variable names and compute which are captured.
    # Only captured-AND-mutated vars need a heap box at module load — pure
    # read-only captures live as plain `GemVal` globals, with closures
    # receiving value snapshots in their env.
    collect_top_let_names(top_stmts, top_level_vars)
    # A rescue placeholder that lift_captured_arm_lets put in the module's
    # statement list is main's own local, as in a fn body: it never names a
    # module binding (scope_shadowing_lets renamed every nested let of a
    # module name), and as a slot the block-scoped lets it stands in for
    # would compile to writes of that slot.
    for n in top_rescue_placeholders(top_stmts)
      delete(top_level_vars, n)
    end
    # Every `name = …` in the program, from mark_process_tail's call graph
    # (it visits every fn, closure and top-level statement).
    let assigned = {}
    for _, r in pt_caller_records
      for w in r.writes
        if is_node(w.node, "assign")
          set_add(assigned, w.name)
        end
      end
    end
    collect_module_namespaces(top_stmts, assigned, module_ns)
    for binding, fields in module_ns
      for field, target in fields
        if ns_targets[target] == nil
          ns_targets[target] = []
        end
        push(ns_targets[target], {binding: binding, field: field})
      end
    end
    note_spawn_global_writes()
    let top_captured = find_captured_in_scope(top_stmts, {})
    # Module-level bindings are slots, never captured. Main's other locals
    # (lets nested in top-level loops/ifs) box like a fn's locals.
    let main_locals = {}
    collect_shadow_lets_in_fn(top_stmts, main_locals)
    for k, _ in top_level_vars
      delete(main_locals, k)
    end
    let top_writes = find_capture_writes_in_scope(top_stmts, main_locals)
    let main_boxed = set_intersect(set_intersect(top_captured, top_writes), main_locals)

    # Emit extern fn wrappers
    for ef in extern_fns_list
      push(functions, compile_extern_fn(ef))
    end

    # Emit function definitions
    for fd in fn_defs
      push(functions, compile_fn(fd))
    end

    # Build main
    let saved_boxed = boxed_vars
    let saved_local = local_names
    let saved_fn_scope = fn_scope_locals
    boxed_vars = main_boxed
    in_top_level = true
    # local_names: over-approximation including arm-lets and nested-scope lets,
    # used as the outer guard in `filter_live_for_rescue`. Mirrors what
    # compile_fn does for user fns (shadow walk).
    local_names = {}
    for k, _ in top_level_vars
      set_add(local_names, k)
    end
    collect_shadow_lets_in_fn(top_stmts, local_names)
    # fn_scope_locals: precise dynamic set tracking C locals addressable at the
    # current point. Starts as top-level vars; compile_stmt adds lets; C-scope
    # introducers (compile_while body, compile_if/match/receive_match arms,
    # compile_stmt_return block) snapshot/restore around their bodies.
    fn_scope_locals = {}
    for k, _ in top_level_vars
      set_add(fn_scope_locals, k)
    end
    let main_body = compile_stmts(top_stmts, 1)
    in_top_level = false
    boxed_vars = saved_boxed
    local_names = saved_local
    fn_scope_locals = saved_fn_scope

    let has_main = false
    for fd in fn_defs
      if fd.name == "main"
        has_main = true
      end
    end

    let mb = buf_new()
    buf_push(mb, "static GemVal gem_user_main(void *_env, GemVal *_args, int _argc) \{\n")
    buf_push(mb, "    (void)_env; (void)_args; (void)_argc;\n")
    buf_push(mb, "    gem_push_frame(\"main\", \"{escape_c_string(rel_path(source_name))}\", 0);\n")
    if main_body != ""
      buf_push(mb, main_body)
    end
    if has_main
      buf_push(mb, "    GemVal _margs[1] = \{GEM_NIL};\n")
      buf_push(mb, "    gem_fn_main(NULL, _margs, 0);\n")
    end
    buf_push(mb, "    gem_pop_frame();\n    return GEM_NIL;\n}\n\n")
    buf_push(mb, "int main(int argc, char **argv) \{\n")
    buf_push(mb, "    gem_init(argc, argv);\n")
    buf_push(mb, "    gem_globals_init_lazy({len(keys(top_level_vars))});\n")
    buf_push(mb, "    gem_scheduler_init();\n")
    buf_push(mb, "    gem_run_main(gem_user_main, NULL);\n")
    buf_push(mb, "    return 0;\n}\n")
    let main_c = to_string(mb)

    # Assemble
    let ob = buf_new()
    emit_extern_includes(ob, extern_includes, c_file)
    buf_push(ob, "#include \"gem.h\"\n")

    # Extern C forward declarations (auto-generated from extern fn signatures)
    # Skip when extern include is present — the user manages declarations via headers
    if len(extern_includes) == 0
      for i = 0, len(extern_c_decls)
        buf_push(ob, extern_c_decls[i])
        buf_push(ob, "\n")
      end
    end

    # Forward declarations
    for i = 0, len(forward_decls)
      buf_push(ob, forward_decls[i])
      if i < len(forward_decls) - 1
        buf_push(ob, "\n")
      end
    end
    buf_push(ob, "\n")

    # Module-level bindings: one slot each in the running process's
    # gem_cur_globals array (see is_global_ref).
    let tlv_keys = sort(keys(top_level_vars))
    for i = 0, len(tlv_keys)
      buf_push(ob, "#define gem_gi_{tlv_keys[i]} {i}\n#define gem_g_{tlv_keys[i]} gem_global_get({i})\n")
    end
    buf_push(ob, "\n")

    # Functions
    for i = 0, len(functions)
      buf_push(ob, functions[i])
      if i < len(functions) - 1
        buf_push(ob, "\n\n")
      end
    end
    buf_push(ob, "\n\n")

    buf_push(ob, main_c)
    to_string(ob)
  end

  {compile: compile}
end

export make_codegen
