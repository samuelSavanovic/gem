# Lexer — hand-written scanner for Gem source code.
# Takes a source string, returns a flat array of token tables:
#   {type: "NUMBER", value: "42", line: 3, col: 1}

load "./errors" (make_error_sink)
load "./builtins" (BUILTIN_FNS)
#
# Token types: NUMBER, STRING, NAME, NEWLINE, EOF,
# INTERP_START / INTERP_TEXT / INTERP_END (an interpolated string's parts),
# keywords (fn, end, let, if, elif, else, then, while, for, in, return, break, continue,
#   do, match, when, after, and, or, not, true, false, nil, load, export, extern, blocking),
# operators (+, -, *, /, %, ==, !=, <=, >=, <, >, =, +=, -=, *=, /=, ->),
# punctuation ( ( ) [ ] { } . , : | ^ ... )

# ─── Character classification (range checks, no lookup tables) ──

fn is_digit(ch)
  ch >= "0" and ch <= "9"
end

fn is_alpha(ch)
  (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
end

fn is_alnum(ch)
  is_alpha(ch) or is_digit(ch)
end

# ─── Escape handling ─────────────────────────────────────────────
# mode: "dq" for double-quoted strings (handles \", \{, }, \0)
#       "sq" for single-quoted strings (handles \')
# Returns the replacement string, or nil for unknown escapes.

fn apply_escape(esc, mode)
  if esc == "n"
    return "\n"
  elif esc == "r"
    return chr(13)
  elif esc == "t"
    return "\t"
  elif esc == "\\"
    return "\\"
  elif esc == "0" and mode == "dq"
    return chr(0)
  elif esc == "\"" and mode == "dq"
    return "\""
  elif esc == "\{" and mode == "dq"
    return "\{"
  elif esc == "}" and mode == "dq"
    return "}"
  elif esc == "'" and mode == "sq"
    return "'"
  end
  nil
end

# ─── Triple-quoted closer pre-scan ───────────────────────────────
# A `"""` string's dedent prefix is the indentation (spaces and tabs) of
# its own closing `"""` line. The pre-scan must skip anything inside an interpolation,
# where a nested `"""` string has a closing line of its own. These helpers
# follow the lexer's rules just far enough to find where each string and
# interpolation ends; positions are byte offsets, and an unterminated
# string or interpolation is -1 (`tq_scan_body`: nil).

fn tq_is_triple(source, p, q)
  p + 2 < len(source) and source[p] == q and source[p + 1] == q and source[p + 2] == q
end

# Dedent one content line starting at p: skip the longest prefix of it that
# is also a prefix of `indent` (the closing line's whitespace), byte for
# byte. Returns the position after it.
fn tq_dedent(source, p, indent)
  let n = len(source)
  let k = 0
  while k < len(indent) and p < n and source[p] == indent[k]
    k += 1
    p += 1
  end
  p
end

# Past the opening `"""` / `'''` (at p): skip to the start of the body,
# i.e. past the newline that must follow (the lexer reports a missing one
# and goes on as if it were there).
fn tq_body_start(source, p)
  let n = len(source)
  while p < n and (source[p] == " " or source[p] == "\t")
    p += 1
  end
  if p < n and source[p] == "\n"
    p += 1
  end
  p
end

# Body of a triple-quoted string starting at p (after the opening line).
# Returns {pos: just past the closing delimiter, indent: the whitespace
# before it on its line, as a string}, or nil when unterminated. `interp` is true for `"""` (which interpolates).
fn tq_scan_body(source, p, q, interp)
  let n = len(source)
  let at_line_start = true
  while p < n
    if at_line_start
      at_line_start = false
      let ls = p
      while p < n and (source[p] == " " or source[p] == "\t")
        p += 1
      end
      if tq_is_triple(source, p, q)
        return {pos: p + 3, indent: substr(source, ls, p - ls)}
      end
      continue
    end
    let c = source[p]
    if c == "\n"
      at_line_start = true
      p += 1
    elif c == "\\"
      p += 2
    elif c == "\{" and interp
      p = tq_skip_interp(source, p + 1)
      if p < 0
        return nil
      end
    else
      p += 1
    end
  end
  nil
end

# Interpolation code starting at p (just past its `{`). Returns the
# position just past the matching `}`.
fn tq_skip_interp(source, p)
  let n = len(source)
  let depth = 0
  while p < n
    let c = source[p]
    if c == "}"
      if depth == 0
        return p + 1
      end
      depth -= 1
      p += 1
    elif c == "\{"
      depth += 1
      p += 1
    elif c == "#"
      while p < n and source[p] != "\n"
        p += 1
      end
    elif c == "\"" or c == "'"
      if tq_is_triple(source, p, c)
        let r = tq_scan_body(source, tq_body_start(source, p + 3), c, c == "\"")
        if r == nil
          return -1
        end
        p = r.pos
      else
        p = tq_skip_quoted(source, p + 1, c)
        if p < 0
          return -1
        end
      end
    else
      p += 1
    end
  end
  -1
end

# A one-quote string body starting at p (just past its opening quote q).
# Returns the position just past the closing quote.
fn tq_skip_quoted(source, p, q)
  let n = len(source)
  while p < n
    let c = source[p]
    if c == q
      return p + 1
    elif c == "\\"
      p += 2
    elif c == "\{" and q == "\""
      p = tq_skip_interp(source, p + 1)
      if p < 0
        return -1
      end
    else
      p += 1
    end
  end
  -1
end

# ─── Tokenizer ───────────────────────────────────────────────────

fn build_keyword_set()
  let t = {}
  t.fn = true
  t.end = true
  t.let = true
  t.if = true
  t.elif = true
  t.else = true
  t.while = true
  t.return = true
  t.break = true
  t.continue = true
  t.do = true
  t.match = true
  t.when = true
  t.and = true
  t.or = true
  t.not = true
  t.true = true
  t.false = true
  t.nil = true
  t.load = true
  t.export = true
  t.extern = true
  t.blocking = true
  t.for = true
  t.in = true
  t.after = true
  t.then = true
  t
end

# Names starting with `__` belong to the compiler: the temporaries and
# renames it introduces (`__d<N>`, `__val_<N>`, `__sh<N>_<name>`,
# `__mod_<mangle>_<name>`, ...) and the internal builtins its desugarings
# call (`__has_key`, `__for_items`, `__table_key_at`, ...). Reporting every
# other `__` name in source keeps those from ever meeting a user's binding.
# A name followed by `:` passes (a table key, or an extern fn param, which
# binds nothing in Gem), as does one after `.` (a field name) and a call of
# an internal builtin (std calls `__is_array_n`).
fn check_reserved_names(tokens, source, file, sink)
  for i = 0, len(tokens)
    let t = tokens[i]
    if t.type != "NAME" or len(t.value) < 2 or substr(t.value, 0, 2) != "__"
      continue
    end
    let prev = if i > 0 then tokens[i - 1].type else "" end
    let next = if i + 1 < len(tokens) then tokens[i + 1].type else "" end
    if prev == "." or next == ":"
      continue
    end
    if has_key(BUILTIN_FNS, t.value) and next == "(" and prev != "fn"
      continue
    end
    let stem = t.value
    while len(stem) > 0 and stem[0] == "_"
      stem = substr(stem, 1, len(stem) - 1)
    end
    sink.report(source, file, t.line, t.col, len(t.value), "`{t.value}`: names starting with `__` are reserved for the compiler", "rename it, e.g. `_{stem}`")
  end
end

# A CRLF line ending reads as LF (in string literals too), so files
# saved with Windows line endings lex. A lone CR is left alone.
fn normalize_newlines(source)
  str_replace(source, "\r\n", "\n")
end

fn tokenize(source, file, sink)
  if sink == nil
    sink = make_error_sink()
  end
  source = normalize_newlines(source)
  let kw = build_keyword_set()
  let tokens = []
  let pos = 0
  let line = 1
  let line_start = 0
  let length = len(source)
  let interp_depth = 0
  let interp_brace = {}
  let CR = chr(13)
  let NUL = chr(0)
  # Per open interpolation (indexed like interp_brace): whether the string
  # it sits in is triple-quoted, and that string's dedent width. A stack,
  # not one flag, so a string nested inside an interpolation expression
  # resumes as its own kind.
  let interp_triple = {}
  let interp_indent = {}
  let interp_open = {}
  # interp_quote[d]: the opening quote of the string interpolation d is in.
  let interp_quote = {}
  let triple_dq_indent = ""
  let tstart = 0

  while pos < length
    let ch = source[pos]
    tstart = pos

    # Skip whitespace (spaces/tabs, NOT newlines)
    if ch == " " or ch == "\t"
      pos += 1
      continue
    end

    # Skip comments (# to end of line)
    if ch == "#"
      while pos < length and source[pos] != "\n"
        pos += 1
      end
      continue
    end

    # Newlines and semicolons — collapse consecutive
    if ch == "\n" or ch == ";"
      let should_add = len(tokens) == 0 or tokens[-1].type != "NEWLINE"
      if should_add
        push(tokens, {type: "NEWLINE", value: "\n", line: line, col: tstart - line_start + 1})
      end
      if ch == "\n"
        line += 1
        line_start = pos + 1
      end
      pos += 1
      # Skip additional newlines, semicolons, whitespace, comments
      while pos < length
        let c2 = source[pos]
        if c2 == "\n"
          line += 1
          line_start = pos + 1
          pos += 1
        elif c2 == ";" or c2 == " " or c2 == "\t"
          pos += 1
        elif c2 == "#"
          while pos < length and source[pos] != "\n"
            pos += 1
          end
        else
          break
        end
      end
      continue
    end

    # Numbers
    if is_digit(ch)
      let val = ""
      while pos < length and is_digit(source[pos])
        val = val + source[pos]
        pos += 1
      end
      let has_dot = pos < length and source[pos] == "."
      if has_dot and pos + 1 < length and source[pos + 1] == "."
        # `0..n`: Gem has no `..` operator. Report it once and skip the
        # dots, so the number stays an int.
        sink.report(source, file, line, pos - line_start + 1, 2, "'..' is not an operator", "Gem uses '+' for string concatenation; a range loop is `for i = start, stop` (stop excluded)")
        push(tokens, {type: "NUMBER", value: val, line: line, col: tstart - line_start + 1})
        pos += 2
        continue
      end
      if has_dot
        val = val + "."
        pos += 1
        while pos < length and is_digit(source[pos])
          val = val + source[pos]
          pos += 1
        end
      end
      push(tokens, {type: "NUMBER", value: val, line: line, col: tstart - line_start + 1})
      continue
    end

    # Strings
    if ch == "\""
      let q_pos = {line: line, col: tstart - line_start + 1}
      pos += 1

      # Triple-quoted double string: """..."""  (with interpolation)
      if pos + 1 < length and source[pos] == "\"" and source[pos + 1] == "\""
        pos += 2
        # Skip optional whitespace on the opening line, then require a newline
        while pos < length and (source[pos] == " " or source[pos] == "\t")
          pos += 1
        end
        if pos >= length
          sink.report(source, file, line, pos - line_start + 1, 1, "triple-quoted string must be followed by a newline", nil)
          push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
          return tokens
        elif source[pos] != "\n"
          sink.report(source, file, line, pos - line_start + 1, 1, "triple-quoted string must be followed by a newline", nil)
          # Recover: continue scan as if the newline were present.
        else
          line += 1
          line_start = pos + 1
          pos += 1
        end

        # Pre-scan: find the indentation of the closing """ (skipping
        # interpolations, which may hold """ strings of their own)
        let tq_close = tq_scan_body(source, pos, "\"", true)
        if tq_close == nil
          # A broken interpolation: take the first closing line, so the
          # error is reported where the interpolation goes wrong.
          tq_close = tq_scan_body(source, pos, "\"", false)
        end
        if tq_close == nil
          sink.report(source, file, q_pos.line, q_pos.col, 3, "unterminated triple-quoted string", "this string is never closed")
          push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
          return tokens
        end
        triple_dq_indent = tq_close.indent

        # Real scan: collect content with dedent and interpolation
        let val = buf_new()
        let hit_interp = false
        let tq_als = true

        while pos < length
          if tq_als
            tq_als = false
            pos = tq_dedent(source, pos, triple_dq_indent)
            # Check for closing """
            if pos + 2 < length and source[pos] == "\"" and source[pos + 1] == "\"" and source[pos + 2] == "\""
              pos += 3
              # Strip the trailing newline that precedes the closing delimiter
              if len(val) > 0 and substr(val, len(val) - 1, 1) == "\n"
                val = substr(val, 0, len(val) - 1)
              end
              break
            end
          end

          let tqc = source[pos]
          if tqc == "\n"
            buf_push(val, "\n")
            line += 1
            line_start = pos + 1
            pos += 1
            tq_als = true
            continue
          end
          if tqc == "\\"
            pos += 1
            if pos >= length
              sink.report(source, file, line, pos - line_start + 1, 1, "unterminated string escape", nil)
              push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
              return tokens
            end
            let tqe = source[pos]
            let esc_result = apply_escape(tqe, "dq")
            if esc_result != nil
              buf_push(val, esc_result)
            else
              buf_push(val, "\\" + tqe)
            end
            pos += 1
            continue
          end
          if tqc == "\{"
            push(tokens, {type: "INTERP_START", value: "", line: line, col: tstart - line_start + 1})
            push(tokens, {type: "INTERP_TEXT", value: to_string(val), line: line, col: tstart - line_start + 1})
            val = buf_new()
            pos += 1
            interp_brace[interp_depth] = 0
            interp_open[interp_depth] = {line: line, col: pos - line_start}
            interp_quote[interp_depth] = q_pos
            interp_triple[interp_depth] = true
            interp_indent[interp_depth] = triple_dq_indent
            interp_depth += 1
            hit_interp = true
            break
          end
          buf_push(val, tqc)
          pos += 1
        end

        if not hit_interp
          push(tokens, {type: "STRING", value: to_string(val), line: line, col: tstart - line_start + 1})
        end
        continue
      end

      # Regular double-quoted string. A raw newline in it counts as a line;
      # its tokens keep the position of the opening quote.
      let s_line = line
      let s_col = tstart - line_start + 1
      let val = buf_new()
      let hit_interp = false
      while pos < length and source[pos] != "\""
        if source[pos] == "\\"
          pos += 1
          if pos >= length
            sink.report(source, file, line, pos - line_start + 1, 1, "unterminated string escape", nil)
            push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
            return tokens
          end
          let esc = source[pos]
          if esc == "\n"
            line += 1
            line_start = pos + 1
          end
          let esc_result = apply_escape(esc, "dq")
          if esc_result != nil
            buf_push(val, esc_result)
          else
            buf_push(val, "\\" + esc)
          end
          pos += 1
          continue
        end
        if source[pos] == "\{"
          push(tokens, {type: "INTERP_START", value: "", line: s_line, col: s_col})
          push(tokens, {type: "INTERP_TEXT", value: to_string(val), line: s_line, col: s_col})
          val = buf_new()
          pos += 1
          interp_brace[interp_depth] = 0
          interp_open[interp_depth] = {line: line, col: pos - line_start}
          interp_quote[interp_depth] = q_pos
          interp_triple[interp_depth] = false
          interp_depth += 1
          hit_interp = true
          break
        end
        if source[pos] == "\n"
          line += 1
          line_start = pos + 1
        end
        buf_push(val, source[pos])
        pos += 1
      end
      if not hit_interp
        if pos >= length
          sink.report(source, file, s_line, s_col, 1, "unterminated string", "this string is never closed")
          push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
          return tokens
        end
        pos += 1
        push(tokens, {type: "STRING", value: to_string(val), line: s_line, col: s_col})
      end
      continue
    end

    # Single-quoted strings (no interpolation)
    if ch == "'"
      let sq_pos = {line: line, col: tstart - line_start + 1}
      pos += 1

      # Triple-quoted single string: '''...'''  (no interpolation)
      if pos + 1 < length and source[pos] == "'" and source[pos + 1] == "'"
        pos += 2
        # Skip optional whitespace on the opening line, then require a newline
        while pos < length and (source[pos] == " " or source[pos] == "\t")
          pos += 1
        end
        if pos >= length
          sink.report(source, file, line, pos - line_start + 1, 1, "triple-quoted string must be followed by a newline", nil)
          push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
          return tokens
        elif source[pos] != "\n"
          sink.report(source, file, line, pos - line_start + 1, 1, "triple-quoted string must be followed by a newline", nil)
          # Recover: continue scan as if the newline were present.
        else
          line += 1
          line_start = pos + 1
          pos += 1
        end

        # Pre-scan: find the indentation of the closing '''
        let sq_scan = pos
        let sq_bi = ""
        let sq_found = false
        while sq_scan < length and not sq_found
          let sq_ls = sq_scan
          while sq_scan < length and (source[sq_scan] == " " or source[sq_scan] == "\t")
            sq_scan += 1
          end
          if sq_scan + 2 < length and source[sq_scan] == "'" and source[sq_scan + 1] == "'" and source[sq_scan + 2] == "'"
            sq_bi = substr(source, sq_ls, sq_scan - sq_ls)
            sq_found = true
          else
            while sq_scan < length and source[sq_scan] != "\n"
              sq_scan += 1
            end
            if sq_scan < length
              sq_scan += 1
            end
          end
        end
        if not sq_found
          sink.report(source, file, sq_pos.line, sq_pos.col, 3, "unterminated triple-quoted string", "this string is never closed")
          push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
          return tokens
        end

        # Real scan: collect content with dedent (no interpolation)
        let val = buf_new()
        let sq_als = true

        while pos < length
          if sq_als
            sq_als = false
            pos = tq_dedent(source, pos, sq_bi)
            # Check for closing '''
            if pos + 2 < length and source[pos] == "'" and source[pos + 1] == "'" and source[pos + 2] == "'"
              pos += 3
              # Strip the trailing newline that precedes the closing delimiter
              if len(val) > 0 and substr(val, len(val) - 1, 1) == "\n"
                val = substr(val, 0, len(val) - 1)
              end
              break
            end
          end

          let sqc = source[pos]
          if sqc == "\n"
            buf_push(val, "\n")
            line += 1
            line_start = pos + 1
            pos += 1
            sq_als = true
            continue
          end
          if sqc == "\\"
            pos += 1
            if pos >= length
              sink.report(source, file, line, pos - line_start + 1, 1, "unterminated string escape", nil)
              push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
              return tokens
            end
            let sqe = source[pos]
            let esc_result = apply_escape(sqe, "sq")
            if esc_result != nil
              buf_push(val, esc_result)
            else
              buf_push(val, "\\" + sqe)
            end
            pos += 1
            continue
          end
          buf_push(val, sqc)
          pos += 1
        end

        push(tokens, {type: "STRING", value: to_string(val), line: line, col: tstart - line_start + 1})
        continue
      end

      # Regular single-quoted string. A raw newline in it counts as a line;
      # its token keeps the position of the opening quote.
      let s_line = line
      let s_col = tstart - line_start + 1
      let val = buf_new()
      while pos < length and source[pos] != "'"
        if source[pos] == "\\"
          pos += 1
          if pos >= length
            sink.report(source, file, line, pos - line_start + 1, 1, "unterminated string escape", nil)
            push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
            return tokens
          end
          let esc = source[pos]
          if esc == "\n"
            line += 1
            line_start = pos + 1
          end
          let esc_result = apply_escape(esc, "sq")
          if esc_result != nil
            buf_push(val, esc_result)
          else
            buf_push(val, "\\" + esc)
          end
          pos += 1
          continue
        end
        if source[pos] == "\n"
          line += 1
          line_start = pos + 1
        end
        buf_push(val, source[pos])
        pos += 1
      end
      if pos >= length
        sink.report(source, file, s_line, s_col, 1, "unterminated string", "this string is never closed")
        push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
        return tokens
      end
      pos += 1
      push(tokens, {type: "STRING", value: to_string(val), line: s_line, col: s_col})
      continue
    end

    # Names and keywords
    if is_alpha(ch)
      let val = ""
      while pos < length and is_alnum(source[pos])
        val = val + source[pos]
        pos += 1
      end
      if val in kw
        push(tokens, {type: val, value: val, line: line, col: tstart - line_start + 1})
      else
        push(tokens, {type: "NAME", value: val, line: line, col: tstart - line_start + 1})
      end
      continue
    end

    # Multi-char operators (check before single-char)
    let next = if pos + 1 < length then source[pos + 1] else "" end

    if ch == "=" and next == "="
      push(tokens, {type: "==", value: "==", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "!" and next == "="
      push(tokens, {type: "!=", value: "!=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "<" and next == "="
      push(tokens, {type: "<=", value: "<=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == ">" and next == "="
      push(tokens, {type: ">=", value: ">=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "+" and next == "="
      push(tokens, {type: "+=", value: "+=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "-" and next == "="
      push(tokens, {type: "-=", value: "-=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "*" and next == "="
      push(tokens, {type: "*=", value: "*=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "/" and next == "="
      push(tokens, {type: "/=", value: "/=", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end
    if ch == "-" and next == ">"
      push(tokens, {type: "->", value: "->", line: line, col: tstart - line_start + 1})
      pos += 2
      continue
    end

    # Single-char operators and punctuation
    if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%"
      push(tokens, {type: ch, value: ch, line: line, col: tstart - line_start + 1})
      pos += 1
      continue
    end
    if ch == "<" or ch == ">" or ch == "="
      push(tokens, {type: ch, value: ch, line: line, col: tstart - line_start + 1})
      pos += 1
      continue
    end
    # Interpolation brace tracking
    if interp_depth > 0 and ch == "\{"
      let idx = interp_depth - 1
      interp_brace[idx] = interp_brace[idx] + 1
      push(tokens, {type: "\{", value: "\{", line: line, col: tstart - line_start + 1})
      pos += 1
      continue
    end
    if interp_depth > 0 and ch == "}"
      let idx = interp_depth - 1
      if interp_brace[idx] > 0
        interp_brace[idx] = interp_brace[idx] - 1
        push(tokens, {type: "}", value: "}", line: line, col: tstart - line_start + 1})
        pos += 1
        continue
      end
      # Close interpolation expression, resume string scanning
      interp_depth -= 1
      pos += 1

      # Resume inside a triple-double-quoted string
      if interp_triple[interp_depth]
        triple_dq_indent = interp_indent[interp_depth]
        let val = buf_new()
        let hit_interp = false
        let closed = false
        let tqr_als = false

        while pos < length
          if tqr_als
            tqr_als = false
            pos = tq_dedent(source, pos, triple_dq_indent)
            # Check for closing """
            if pos + 2 < length and source[pos] == "\"" and source[pos + 1] == "\"" and source[pos + 2] == "\""
              pos += 3
              if len(val) > 0 and substr(val, len(val) - 1, 1) == "\n"
                val = substr(val, 0, len(val) - 1)
              end
              closed = true
              break
            end
            if pos >= length
              break
            end
          end

          let tqrc = source[pos]
          if tqrc == "\n"
            buf_push(val, "\n")
            line += 1
            line_start = pos + 1
            pos += 1
            tqr_als = true
            continue
          end
          if tqrc == "\\"
            pos += 1
            if pos >= length
              sink.report(source, file, line, pos - line_start + 1, 1, "unterminated string escape", nil)
              push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
              return tokens
            end
            let tqre = source[pos]
            let esc_result = apply_escape(tqre, "dq")
            if esc_result != nil
              buf_push(val, esc_result)
            else
              buf_push(val, "\\" + tqre)
            end
            pos += 1
            continue
          end
          if tqrc == "\{"
            push(tokens, {type: "INTERP_TEXT", value: to_string(val), line: line, col: tstart - line_start + 1})
            val = buf_new()
            pos += 1
            interp_brace[interp_depth] = 0
            interp_open[interp_depth] = {line: line, col: pos - line_start}
            interp_triple[interp_depth] = true
            interp_indent[interp_depth] = triple_dq_indent
            interp_depth += 1
            hit_interp = true
            break
          end
          buf_push(val, tqrc)
          pos += 1
        end

        if not hit_interp
          if not closed
            if interp_depth > 0
              let op = interp_open[0]
              sink.report(source, file, op.line, op.col, 1, "unterminated triple-quoted string interpolation", "the string is never closed after the interpolation this '\{' opens; write '\\\{' for a literal brace")
            else
              let q = interp_quote[0]
              sink.report(source, file, q.line, q.col, 3, "unterminated triple-quoted string", "this string is never closed")
            end
            push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
            return tokens
          end
          push(tokens, {type: "INTERP_TEXT", value: to_string(val), line: line, col: tstart - line_start + 1})
          push(tokens, {type: "INTERP_END", value: "", line: line, col: tstart - line_start + 1})
        end
        continue
      end

      # Resume inside a regular double-quoted string
      let val = buf_new()
      let hit_interp = false
      while pos < length and source[pos] != "\""
        if source[pos] == "\\"
          pos += 1
          if pos >= length
            sink.report(source, file, line, pos - line_start + 1, 1, "unterminated string escape", nil)
            push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
            return tokens
          end
          let esc = source[pos]
          if esc == "\n"
            line += 1
            line_start = pos + 1
          end
          let esc_result = apply_escape(esc, "dq")
          if esc_result != nil
            buf_push(val, esc_result)
          else
            buf_push(val, "\\" + esc)
          end
          pos += 1
          continue
        end
        if source[pos] == "\{"
          # Another interpolation expression
          push(tokens, {type: "INTERP_TEXT", value: to_string(val), line: line, col: tstart - line_start + 1})
          val = buf_new()
          pos += 1
          interp_brace[interp_depth] = 0
          interp_open[interp_depth] = {line: line, col: pos - line_start}
          interp_triple[interp_depth] = false
          interp_depth += 1
          hit_interp = true
          break
        end
        if source[pos] == "\n"
          line += 1
          line_start = pos + 1
        end
        buf_push(val, source[pos])
        pos += 1
      end
      if not hit_interp
        if pos >= length
          # The string never closes. When an outer interpolation is still
          # open, its `{` is usually a brace meant literally, which swallowed
          # the rest of the file: report it. Otherwise report the string.
          if interp_depth > 0
            let op = interp_open[0]
            sink.report(source, file, op.line, op.col, 1, "unterminated string interpolation", "the string is never closed after the interpolation this '\{' opens; write '\\\{' for a literal brace")
          else
            let q = interp_quote[0]
            sink.report(source, file, q.line, q.col, 1, "unterminated string", "this string is never closed")
          end
          push(tokens, {type: "EOF", value: "", line: line, col: pos - line_start + 1})
          return tokens
        end
        push(tokens, {type: "INTERP_TEXT", value: to_string(val), line: line, col: tstart - line_start + 1})
        push(tokens, {type: "INTERP_END", value: "", line: line, col: tstart - line_start + 1})
        pos += 1
      end
      continue
    end

    if ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "\{" or ch == "}"
      push(tokens, {type: ch, value: ch, line: line, col: tstart - line_start + 1})
      pos += 1
      continue
    end
    if ch == "." and pos + 1 < length and source[pos + 1] == "." and pos + 2 < length and source[pos + 2] == "."
      push(tokens, {type: "...", value: "...", line: line, col: tstart - line_start + 1})
      pos += 3
      continue
    end
    if ch == "." or ch == "," or ch == ":" or ch == "|" or ch == "^"
      push(tokens, {type: ch, value: ch, line: line, col: tstart - line_start + 1})
      pos += 1
      continue
    end

    sink.report(source, file, line, pos - line_start + 1, 1, "unexpected character: '{ch}'", nil)
    pos += 1
  end

  if interp_depth > 0
    let op = interp_open[interp_depth - 1]
    sink.report(source, file, op.line, op.col, 1, "unterminated string interpolation", "this '\{' is never closed by '}'")
  end
  push(tokens, {type: "EOF", value: "", line: line, col: tstart - line_start + 1})
  tokens
end

export tokenize, build_keyword_set, normalize_newlines, check_reserved_names
