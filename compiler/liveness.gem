# Liveness for `while` loops: what's live at the back-edge is the root set for the reset there.
# A missed live var silently corrupts memory, so when in doubt it's live.
# Anything a closure in the body captures is live across the back-edge, except closures passed straight to
# spawn: spawn copies their captures into the child, so they only need to live until the call.

load "./cgutil" (is_node, set_union, each_child, any_child, arm_stmts, walk_scoped, walk_scoped_fn, walk_scoped_node)

fn lset_remove(s, val)
  if s[val] == true
    delete(s, val)
  end
end

fn lset_union_into(dst, src)
  for k, _ in src
    dst[k] = true
  end
end

fn lset_eq(a, b)
  for k, _ in a
    if b[k] != true
      return false
    end
  end
  for k, _ in b
    if a[k] != true
      return false
    end
  end
  true
end

# names a fn literal reads or assigns that neither it nor `defined` binds
fn closure_free(node, defined)
  let free = {}
  let note = fn(name, bound)
    if bound[name] != true
      free[name] = true
    end
  end
  walk_scoped_fn(node, defined, {read: note, write: note, closure: fn(c, bound) true end})
  free
end

fn _has_break_here(node)
  if type(node) != "table"
    return false
  end
  if node.tag == "break"
    return true
  end
  # breaks in nested loops and fns aren't ours
  if node.tag == "while" or node.tag == "anon_fn" or node.tag == "fn_def"
    return false
  end
  any_child(node, _has_break_here)
end

fn liveness_loop_has_break(while_node)
  _has_break_here(while_node.body)
end

# adds the names an expression reads to `into`; a closure reads its free vars

fn _uses_expr(node, into)
  if node == nil
    return nil
  end
  if type(node) != "table" or node.tag == nil
    return nil
  end

  match node
  when {tag: "var", name: name}
    into[name] = true
  when {tag: "int"}
    return nil
  when {tag: "float"}
    return nil
  when {tag: "string"}
    return nil
  when {tag: "bool"}
    return nil
  when {tag: "nil"}
    return nil
  when {tag: "binop", left: l, right: r}
    _uses_expr(l, into)
    _uses_expr(r, into)
  when {tag: "unop", expr: e}
    _uses_expr(e, into)
  when {tag: "dot", object: o}
    _uses_expr(o, into)
  when {tag: "index", object: o, key: k}
    _uses_expr(o, into)
    _uses_expr(k, into)
  when {tag: "call", func: func, args: args}
    _uses_expr(func, into)
    for a in args
      _uses_expr(a, into)
    end
  when {tag: "table", entries: entries}
    for e in entries
      _uses_expr(e.value, into)
    end
  when {tag: "array", elements: elements}
    for e in elements
      _uses_expr(e, into)
    end
  when {tag: "interp", parts: parts}
    for p in parts
      _uses_expr(p, into)
    end
  when {tag: "anon_fn"}
    lset_union_into(into, closure_free(node, {}))
  else
    each_child(node, fn(c) _uses_expr(c, into) end)
  end
end

fn _transfer_stmts(stmts, live_out, ctx)
  let live = set_union(live_out, {})
  let i = len(stmts) - 1
  while i >= 0
    live = _transfer_stmt(stmts[i], live, ctx)
    i -= 1
  end
  live
end

# live_in of a nested while, by fixpoint
fn _fixpoint_inner_loop(while_node, live_after)
  let live_top = set_union(live_after, {})
  let prev = nil
  let iter = 0
  while iter < 64
    let ctx = {brk: live_after, cont: live_top}
    let live_in_body = _transfer_stmts(while_node.body, live_top, ctx)
    # the condition can end the loop before the first iteration too
    let new_top = set_union(live_after, {})
    _uses_expr(while_node.cond, new_top)
    lset_union_into(new_top, live_in_body)
    if prev != nil and lset_eq(new_top, prev)
      return new_top
    end
    prev = set_union(new_top, {})
    live_top = new_top
    iter += 1
  end
  live_top
end

fn _transfer_stmt(s, live_out, ctx)
  if s == nil
    return live_out
  end
  if type(s) != "table" or s.tag == nil
    return live_out
  end

  match s
  when {tag: "let", name: name, value: value}
    let live_in = set_union(live_out, {})
    lset_remove(live_in, name)
    _uses_expr(value, live_in)
    return live_in
  when {tag: "assign", name: name, value: value}
    let live_in = set_union(live_out, {})
    lset_remove(live_in, name)
    _uses_expr(value, live_in)
    return live_in
  when {tag: "dot_assign", object: object, value: value}
    let live_in = set_union(live_out, {})
    _uses_expr(object, live_in)
    _uses_expr(value, live_in)
    return live_in
  when {tag: "index_assign", object: object, key: key, value: value}
    let live_in = set_union(live_out, {})
    _uses_expr(object, live_in)
    _uses_expr(key, live_in)
    _uses_expr(value, live_in)
    return live_in
  when {tag: "if", cond: cond, then: thens, else: el}
    let live_then = _transfer_stmts(thens, live_out, ctx)
    let live_else = if el != nil then _transfer_stmts(el, live_out, ctx) else set_union(live_out, {}) end
    let live_in = set_union(live_then, {})
    lset_union_into(live_in, live_else)
    _uses_expr(cond, live_in)
    return live_in
  when {tag: "while"}
    return _fixpoint_inner_loop(s, live_out)
  when {tag: "match", target: target, target_var: target_var, whens: whens, else: el}
    let merged = {}
    if el != nil
      let live_else = _transfer_stmts(el, live_out, ctx)
      lset_union_into(merged, live_else)
    else
      lset_union_into(merged, live_out)
    end
    for w in whens
      let live_arm = _transfer_stmts(arm_stmts(w.bindings, w.body), live_out, ctx)
      _uses_expr(w.value, live_arm)
      lset_union_into(merged, live_arm)
    end
    if target_var != nil
      lset_remove(merged, target_var)
    end
    _uses_expr(target, merged)
    return merged
  when {tag: "receive_match", arms: arms, after_ms: after_ms, after_body: after_body}
    let merged = {}
    if after_body != nil
      let live_after = _transfer_stmts(after_body, live_out, ctx)
      if after_ms != nil
        _uses_expr(after_ms, live_after)
      end
      lset_union_into(merged, live_after)
    end
    if len(arms) == 0
      lset_union_into(merged, live_out)
      return merged
    end
    for arm in arms
      let live_arm = _transfer_stmts(arm_stmts(arm.bindings, arm.body), live_out, ctx)
      if arm.value != nil
        _uses_expr(arm.value, live_arm)
      end
      lset_union_into(merged, live_arm)
    end
    if s.recv_var != nil
      lset_remove(merged, s.recv_var)
    end
    return merged
  when {tag: "block", stmts: stmts}
    return _transfer_stmts(stmts, live_out, ctx)
  when {tag: "return", value: value}
    let live_in = {}
    if value != nil
      _uses_expr(value, live_in)
    end
    return live_in
  when {tag: "break"}
    # control continues after the loop
    return set_union(ctx.brk, {})
  when {tag: "continue"}
    return set_union(ctx.cont, {})
  when {tag: "fn_def"}
    return set_union(live_out, {})
  when {tag: "call"}
    let live_in = set_union(live_out, {})
    _uses_expr(s, live_in)
    return live_in
  else
    let live_in = set_union(live_out, {})
    _uses_expr(s, live_in)
    return live_in
  end
end

# Live set at while_node's back-edge: {ok: true, live} or {ok: false, reason}. Includes live_after_loop
# unless the loop is `while true` with no break.
fn compute_loop_live_at_backedge(while_node, live_after_loop)
  let body_defined = {}
  let closure_caps = {}
  collect_closure_captures_in_stmts(while_node.body, body_defined, closure_caps)

  let cond_is_true = is_node(while_node.cond, "bool") and while_node.cond.value == true
  let has_break = liveness_loop_has_break(while_node)
  let post_reachable = has_break or not cond_is_true

  let live_top = {}
  lset_union_into(live_top, closure_caps)
  if post_reachable
    lset_union_into(live_top, live_after_loop)
  end

  let prev = nil
  let iter = 0
  while iter < 64
    let ctx = {brk: live_after_loop, cont: live_top}
    let live_in_body = _transfer_stmts(while_node.body, live_top, ctx)
    let new_top = set_union(live_in_body, {})
    _uses_expr(while_node.cond, new_top)
    lset_union_into(new_top, closure_caps)
    if post_reachable
      lset_union_into(new_top, live_after_loop)
    end
    if prev != nil and lset_eq(new_top, prev)
      return {ok: true, live: new_top}
    end
    prev = set_union(new_top, {})
    live_top = new_top
    iter += 1
  end
  {ok: false, reason: "liveness fixpoint did not converge"}
end

# free vars of every closure in the body, minus the lets defined before it. spawn(fn ... end) copies its
# closure's captures into the child at the call, so that closure (and those nested in it) doesn't count.
fn collect_closure_captures_in_stmts(stmts, defined, caps)
  let v = {read: fn(name, bound) nil end, write: fn(name, bound) nil end}
  v.closure = fn(node, bound)
    lset_union_into(caps, closure_free(node, bound))
    false
  end
  v.node = fn(node, bound)
    if not liveness_is_spawn_with_closure(node)
      return false
    end
    walk_scoped_node(node.func, bound, v)
    for i = 1, len(node.args)
      walk_scoped_node(node.args[i], bound, v)
    end
    true
  end
  walk_scoped(stmts, defined, v)
end

fn is_spawn_callee_name(name)
  name == "spawn" or name == "spawn_link" or name == "spawn_monitor"
end

fn liveness_is_spawn_with_closure(node)
  if not is_node(node, "call")
    return false
  end
  if not is_node(node.func, "var")
    return false
  end
  if not is_spawn_callee_name(node.func.name)
    return false
  end
  if node.args == nil or len(node.args) == 0
    return false
  end
  is_node(node.args[0], "anon_fn")
end

# Walks a fn body or the top level backward and sets `liveness_result` on every `process_tail` while,
# for compile_while. A loop gets the live set after it, so reads after the loop are rooted; arms get the
# enclosing statement's live_out, a loop body the back-edge set, a closure body the empty set.

fn _attach_stmts(stmts, live_out, ctx)
  let live = set_union(live_out, {})
  let i = len(stmts) - 1
  while i >= 0
    live = _attach_node(stmts[i], live, ctx)
    i -= 1
  end
  live
end

# every closure body in an expression, each as its own scope (statements: _attach_node; fn_defs: codegen)
fn _scan_anons(node)
  if node == nil
    return nil
  end
  if type(node) != "table" or node.tag == nil
    return nil
  end
  if node.tag == "anon_fn"
    _attach_stmts(node.body, {}, nil)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          _scan_anons(d)
        end
      end
    end
    return nil
  end
  if node.tag == "fn_def"
    return nil
  end
  each_child(node, _scan_anons)
end

fn _attach_node(s, live_out, ctx)
  if s == nil
    return live_out
  end
  if type(s) != "table" or s.tag == nil
    return live_out
  end

  if s.tag == "while"
    let r = compute_loop_live_at_backedge(s, live_out)
    if s.process_tail == true
      s.liveness_result = r
    end
    let body_live_after = if r.ok then r.live else set_union(live_out, {}) end
    _attach_stmts(s.body, body_live_after, {brk: live_out, cont: body_live_after})
    _scan_anons(s.cond)
    if r.ok
      return set_union(r.live, {})
    end
    return _transfer_stmt(s, live_out, ctx)
  end

  if s.tag == "if"
    if s.then != nil
      _attach_stmts(s.then, live_out, ctx)
    end
    if s.else != nil
      _attach_stmts(s.else, live_out, ctx)
    end
    _scan_anons(s.cond)
    return _transfer_stmt(s, live_out, ctx)
  end

  if s.tag == "match"
    _scan_anons(s.target)
    if s.whens != nil
      for w in s.whens
        _attach_stmts(w.body, live_out, ctx)
        _scan_anons(w.value)
        if w.bindings != nil
          for b in w.bindings
            _scan_anons(b)
          end
        end
      end
    end
    if s.else != nil
      _attach_stmts(s.else, live_out, ctx)
    end
    return _transfer_stmt(s, live_out, ctx)
  end

  if s.tag == "receive_match"
    if s.arms != nil
      for arm in s.arms
        _attach_stmts(arm.body, live_out, ctx)
        if arm.value != nil
          _scan_anons(arm.value)
        end
        if arm.bindings != nil
          for b in arm.bindings
            _scan_anons(b)
          end
        end
      end
    end
    if s.after_ms != nil
      _scan_anons(s.after_ms)
    end
    if s.after_body != nil
      _attach_stmts(s.after_body, live_out, ctx)
    end
    return _transfer_stmt(s, live_out, ctx)
  end

  if s.tag == "block"
    return _attach_stmts(s.stmts, live_out, ctx)
  end

  _scan_anons(s)
  return _transfer_stmt(s, live_out, ctx)
end

fn compute_live_for_pt_loops_in_stmts(stmts)
  _attach_stmts(stmts, {}, nil)
end

export compute_live_for_pt_loops_in_stmts, is_spawn_callee_name
