# compiler/loader.gem — load-path resolution shared between the compiler
# driver and the LSP. Pulled out of compiler/main.gem so lsp/symbols.gem
# can resolve `load` nodes to absolute file paths without forking.
#
# resolve_load_path: three forms — "std/X" (stdlib), "./X"/"../X"
# (relative to the loading file), bare "X" (relative to project_root if
# found, else base_dir). Always appends ".gem" if absent.
#
# load_target_problem says why a resolved path can't be loaded (missing,
# or a directory), as {msg, hint}, or nil when the file exists.
#
# find_project_root walks up from start_dir (made absolute first) looking
# for gem.toml; returns the normalized absolute root or nil.
# compute_stdlib_root prefers $GEM_STDLIB, then a project-vendored std/,
# then the install root.

load "std/string"

# normalize_path (realpath) leaves a path that doesn't exist as typed
# (`././mods/nope.gem`). Normalize its longest existing prefix instead, so
# a missing module's path is shown, and keyed, like a present one's.
fn normalize_load_path(p)
  if file_exists(p) or is_dir(p)
    return normalize_path(p)
  end
  let d = dirname(p)
  if d == p or d == "" or len(d) >= len(p)
    return p
  end
  path_join(normalize_load_path(d), substr(p, len(d) + 1, len(p) - len(d) - 1))
end

fn resolve_load_path(raw_path, base_dir, project_root, stdlib_root)
  let path = raw_path
  if not string.ends_with(path, ".gem")
    path = path + ".gem"
  end

  if string.starts_with(raw_path, "std/")
    if stdlib_root == nil
      error("gem: cannot resolve load \"" + raw_path + "\": stdlib root not found (set $GEM_STDLIB)")
    end
    return normalize_load_path(path_join(stdlib_root, path))
  end

  if string.starts_with(raw_path, "./") or string.starts_with(raw_path, "../")
    return normalize_load_path(path_join(base_dir, path))
  end

  let root = project_root
  if root == nil
    root = base_dir
  end
  return normalize_load_path(path_join(root, path))
end

# Why the file a `load` resolved to can't be loaded as a module: {msg,
# hint} for a compile error at the `load`, or nil when it is a file.
# Paths in the message go through `show_path` (make_show_path). Shared by
# the compiler's resolve_loads and the LSP's diagnostics.
fn load_target_problem(raw_path, full_path, show_path)
  if is_dir(full_path)
    return {msg: "cannot load `{raw_path}`: {show_path(full_path)} is a directory", hint: "load a module file inside it"}
  end
  if file_exists(full_path)
    return nil
  end
  let msg = "cannot find module `{raw_path}` (no file {show_path(full_path)})"
  let hint = nil
  if string.ends_with(full_path, ".gem")
    let bare = substr(full_path, 0, len(full_path) - 4)
    if is_dir(bare)
      hint = "{show_path(bare)} is a directory; load a module inside it, e.g. `load \"{raw_path}/<name>\"`"
    end
  end
  {msg: msg, hint: hint}
end

fn find_project_root(start_dir)
  let dir = start_dir
  if dir == "" then dir = "." end
  # Absolute first (normalize_path resolves against the cwd), so a
  # relative start such as "." (entry `gem main.gem`) can walk up.
  dir = normalize_path(dir)
  while true
    if file_exists(path_join(dir, "gem.toml"))
      return dir
    end
    let parent = dirname(dir)
    if parent == dir or parent == ""
      return nil
    end
    dir = parent
  end
end

fn compute_stdlib_root(install_root, project_root)
  let env_root = getenv("GEM_STDLIB")
  if env_root != nil and env_root != ""
    return env_root
  end
  if project_root != nil and is_dir(path_join(project_root, "std"))
    return project_root
  end
  if is_dir(path_join(install_root, "std"))
    return install_root
  end
  install_root
end

# The path shown for a source file in compile errors, notes, `#line`
# directives and stack-frame records. With a gem.toml it is relative to
# the project root, which keeps bootstrap/stage0.c reproducible across
# machines. Without one, loads resolve against the entry file's
# directory, so a file under it is shown below the entry's directory as
# the user typed it (`gem prog.gem` shows `mods/m.gem`, `gem /abs/prog.gem`
# shows `/abs/mods/m.gem`). Files outside the root keep their path.
fn make_show_path(entry_path, project_root)
  let root = project_root
  let prefix = nil
  if root == nil and entry_path != nil
    root = normalize_path(dirname(entry_path))
    let d = dirname(entry_path)
    if d != "." and d != ""
      prefix = d
    end
  end
  let cache = {}
  fn(p)
    if root == nil or p == nil
      return p
    end
    if has_key(cache, p)
      return cache[p]
    end
    let shown = p
    let full = normalize_path(p)
    let rlen = len(root)
    if len(full) > rlen and substr(full, 0, rlen) == root and full[rlen] == "/"
      shown = substr(full, rlen + 1, len(full) - rlen - 1)
      if prefix != nil
        shown = path_join(prefix, shown)
      end
    end
    cache[p] = shown
    shown
  end
end

export resolve_load_path, load_target_problem, find_project_root, compute_stdlib_root, make_show_path
