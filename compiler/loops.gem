# Loop preparation for the back-edge arena reset (compile_while in
# codegen.gem): the arm-let hoist that gives every live value a C local at
# the back-edge, and the tagging of the loops that get a reset.

load "./liveness" (is_spawn_callee_name)
load "./cgutil" (set_add, set_contains, set_union, is_node)

# ─── Liveness-driven arm-let hoist ────────────────────────────────
#
# Lifts `let X = expr` declarations inside if/match/receive arms of a
# PT-while body to fn-top placeholders, rewriting the per-arm decl to an
# assign. Required so X has an addressable C local enclosing the back-edge
# rescue check (`&gem_v_X`) when X is live across that edge but declared
# in only one arm.

fn hoist_has_let(node, name)
  if node == nil
    return false
  end
  if type(node) != "table"
    return false
  end
  let nks = keys(node)
  if len(nks) > 0 and type(nks[0]) == "int"
    for child in node
      if type(child) == "table"
        if hoist_has_let(child, name)
          return true
        end
      end
    end
    return false
  end
  if node.tag == nil
    return false
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    return false
  end
  if node.tag == "let" and node.name == name
    return true
  end
  for k, v in node
    if k != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        for child in v
          if type(child) == "table"
            if hoist_has_let(child, name)
              return true
            end
          end
        end
      else
        if hoist_has_let(v, name)
          return true
        end
      end
    end
  end
  false
end

let captured_arm_lets_node = nil
let captured_arm_lets_stmts = nil

# `scope` accumulates names known to be addressable above this stmt list:
# enclosing fn params, lets in any ancestor block. We refuse to hoist a name
# already in `scope` (would shadow the outer binding and silently change
# semantics). `block_lets` is built up as we walk this stmt list — names
# declared via `let` to its left of the current position.
captured_arm_lets_stmts = fn(stmts, scope)
  if stmts == nil
    return nil
  end
  let block_lets = {}
  for s in stmts
    if is_node(s, "let") and s.name != nil
      set_add(block_lets, s.name)
    end
  end

  let i = 0
  while i < len(stmts)
    let s = stmts[i]
    let merged = set_union(scope, block_lets)
    captured_arm_lets_node(s, merged)

    if is_node(s, "while") and s.process_tail == true and s.liveness_result != nil and s.liveness_result.ok == true
      let live = s.liveness_result.live
      let to_hoist = []
      for n, _ in live
        if not set_contains(merged, n)
          if hoist_has_let(s.body, n)
            push(to_hoist, n)
          end
        end
      end
      if len(to_hoist) > 0
        # Insert `let X = nil` placeholders before the while. We deliberately
        # do NOT rewrite the inner arm-lets to assigns: the per-iter `let`
        # remains a fresh block-scoped shadow, the closure captures from
        # that shadow (fresh box per iter, dies with the arm), and the
        # placeholder exists only to satisfy `filter_live_for_rescue`'s
        # fn-scope addressability check. The placeholder always holds nil,
        # so the rescue copies a no-op and the inner shadow's box (per-iter
        # arena) dies cleanly with the arena reset.
        for n in to_hoist
          insert(stmts, i, {tag: "let", name: n, value: {tag: "nil"}, line: s.line, rescue_placeholder: true})
          set_add(block_lets, n)
          i += 1
        end
      end
    end
    i += 1
  end
end

captured_arm_lets_node = fn(node, scope)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    let inner_scope = {}
    if node.params != nil
      for p in node.params
        set_add(inner_scope, p)
      end
    end
    if node.rest_param != nil
      set_add(inner_scope, node.rest_param)
    end
    captured_arm_lets_stmts(node.body, inner_scope)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          captured_arm_lets_node(d, scope)
        end
      end
    end
    return nil
  end
  if node.tag == "if"
    captured_arm_lets_node(node.cond, scope)
    captured_arm_lets_stmts(node.then, scope)
    if node.elifs != nil
      for ei in node.elifs
        captured_arm_lets_stmts(ei.body, scope)
      end
    end
    captured_arm_lets_stmts(node.else, scope)
    return nil
  end
  if node.tag == "while"
    captured_arm_lets_node(node.cond, scope)
    captured_arm_lets_stmts(node.body, scope)
    return nil
  end
  if node.tag == "for" or node.tag == "for_kv" or node.tag == "for_range"
    let body_scope = set_union(scope, {})
    if node.var != nil
      set_add(body_scope, node.var)
    end
    if node.kvar != nil
      set_add(body_scope, node.kvar)
    end
    if node.vvar != nil
      set_add(body_scope, node.vvar)
    end
    if node.name != nil and (node.tag == "for" or node.tag == "for_range")
      set_add(body_scope, node.name)
    end
    for k, v in node
      if k != "tag" and k != "body" and type(v) == "table"
        captured_arm_lets_node(v, scope)
      end
    end
    captured_arm_lets_stmts(node.body, body_scope)
    return nil
  end
  if node.tag == "match"
    captured_arm_lets_node(node.target, scope)
    if node.whens != nil
      for w in node.whens
        let arm_scope = set_union(scope, {})
        if w.bindings != nil
          for b in w.bindings
            if type(b) == "table" and b.tag == "var" and b.name != nil
              set_add(arm_scope, b.name)
            end
          end
        end
        captured_arm_lets_stmts(w.body, arm_scope)
      end
    end
    captured_arm_lets_stmts(node.else, scope)
    return nil
  end
  if node.tag == "receive_match"
    if node.arms != nil
      for a in node.arms
        let arm_scope = set_union(scope, {})
        if a.pattern != nil and a.pattern.bindings != nil
          for b in a.pattern.bindings
            if type(b) == "table" and b.tag == "var" and b.name != nil
              set_add(arm_scope, b.name)
            end
          end
        end
        captured_arm_lets_stmts(a.body, arm_scope)
      end
    end
    if node.after_body != nil
      captured_arm_lets_stmts(node.after_body, scope)
    end
    return nil
  end
  if node.tag == "block"
    captured_arm_lets_stmts(node.stmts, scope)
    return nil
  end
  for k, v in node
    if k != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        for child in v
          if type(child) == "table"
            captured_arm_lets_node(child, scope)
          end
        end
      else
        captured_arm_lets_node(v, scope)
      end
    end
  end
  nil
end

fn lift_captured_arm_lets_in_fn(fn_node)
  let scope = {}
  if fn_node.params != nil
    for p in fn_node.params
      set_add(scope, p)
    end
  end
  if fn_node.rest_param != nil
    set_add(scope, fn_node.rest_param)
  end
  captured_arm_lets_stmts(fn_node.body, scope)
  if fn_node.defaults != nil
    for d in fn_node.defaults
      if d != nil
        captured_arm_lets_node(d, scope)
      end
    end
  end
end

fn lift_captured_arm_lets_top_stmts(stmts)
  captured_arm_lets_stmts(stmts, {})
end

# Names of the rescue placeholders above that landed at module scope: in
# the top-level statement list, or directly in a top-level `block` (the
# header of a lowered `for`), the positions collect_top_let_names treats
# as module bindings.
fn top_rescue_placeholders(stmts)
  let out = []
  for s in stmts
    if is_node(s, "let") and s.rescue_placeholder == true
      push(out, s.name)
    elif is_node(s, "block")
      for c in s.stmts
        if is_node(c, "let") and c.rescue_placeholder == true
          push(out, c.name)
        end
      end
    end
  end
  out
end

# ─── Loop tagging for the back-edge arena reset ─────────────────
#
# Walks every fn_def body, closure body and the top-level program, tagging
# each `while` node (including lowered `for` loops) with
# `process_tail = true` directly on the AST node. The codegen
# (`compile_while`) emits a region mark + back-edge reset for every tagged
# loop whose live set liveness can root. (The name is historical: resets
# used to be limited to loops reachable from a process root by tail calls
# only. Region resets are sound in any call context, see compile_while.)

let walk_for_tagging_node = nil
let walk_for_tagging_stmts = nil

walk_for_tagging_stmts = fn(stmts, is_pt, source_name)
  if stmts == nil
    return nil
  end
  for s in stmts
    walk_for_tagging_node(s, is_pt, source_name)
  end
end

walk_for_tagging_node = fn(node, is_pt, source_name)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end
  if node.tag == "fn_def"
    # Top-level fn_defs are walked separately by tag_process_tail_while_loops;
    # parser disallows nested fn_def. Skip.
    return nil
  end
  if node.tag == "anon_fn"
    # Region resets are sound in any context (see compile_while), so every
    # closure body is tagged too.
    walk_for_tagging_stmts(node.body, is_pt, source_name)
    if node.defaults != nil
      for d in node.defaults
        if d != nil
          walk_for_tagging_node(d, is_pt, source_name)
        end
      end
    end
    return nil
  end
  if node.tag == "while" and is_pt
    node.process_tail = true
    walk_for_tagging_stmts(node.body, is_pt, source_name)
    return nil
  end
  if node.tag == "call" and is_node(node.func, "var") and is_spawn_callee_name(node.func.name)
    if node.args != nil and len(node.args) > 0 and is_node(node.args[0], "anon_fn")
      let anon = node.args[0]
      walk_for_tagging_stmts(anon.body, true, source_name)
      if anon.defaults != nil
        for d in anon.defaults
          if d != nil
            walk_for_tagging_node(d, is_pt, source_name)
          end
        end
      end
      let i = 1
      while i < len(node.args)
        walk_for_tagging_node(node.args[i], is_pt, source_name)
        i += 1
      end
      return nil
    end
    # Fall through to generic recursion so nested spawns inside the args still
    # get walked (e.g. `spawn(make_loop(spawn(fn() … end)))`).
  end
  # Generic recursion over child nodes/arrays.
  for k, v in node
    if k != "tag" and type(v) == "table"
      let vks = keys(v)
      if len(vks) > 0 and type(vks[0]) == "int"
        let vi = 0
        while vi < len(v)
          if type(v[vi]) == "table"
            walk_for_tagging_node(v[vi], is_pt, source_name)
          end
          vi += 1
        end
      else
        walk_for_tagging_node(v, is_pt, source_name)
      end
    end
  end
  nil
end

let tag_process_tail_while_loops = nil
tag_process_tail_while_loops = fn(fn_defs, top_stmts, source_name)
  # Every loop is a reset candidate: a region reset frees only memory
  # allocated after the loop started, so it is sound whatever the call
  # context (see compile_while). `process_tail` now just means "emit the
  # back-edge reset if liveness can root the live set".
  for fd in fn_defs
    walk_for_tagging_stmts(fd.body, true, source_name)
  end
  # Top-level statements run in `gem_main_pid` and are PT-tagged uniformly with fn bodies.
  walk_for_tagging_stmts(top_stmts, true, source_name)
end

export lift_captured_arm_lets_in_fn, lift_captured_arm_lets_top_stmts, top_rescue_placeholders, tag_process_tail_while_loops
