# Compiler driver: parse, load modules, lower, emit C, cc, then run or write the binary (through the run-mode
# cache). Dispatches `gem lsp`.

load "std/string"
load "./parser" (parse_source)
load "./codegen" (make_codegen)
load "./lower" (lower, tag_file)
load "./fold" (fold_constants)
load "./errors" (make_error_sink, print_all_errors)
load "./loader" (find_project_root, find_install_root, compute_stdlib_root, make_show_path, normalize_load_path)
load "./lexer" (normalize_newlines)
load "./modules" (resolve_loads, build_global_display, find_export_node, checked_exports, collect_module_top_names, module_name_from_path, shadow_entry_builtins)
load "./warnings" (print_file_warnings)
load "./cache" (cache_slot, runtime_file_hashes)
load "./cli" (usage_error, parse_args, basename_no_ext, project_command_args)
load "../lsp/main" (run_lsp)

let install_root = find_install_root()

fn shell_quote(s)
  "'" + str_replace(s, "'", "'\\''") + "'"
end

# runtime helpers, not builtins, so an older compiler can build this; each compile gets its own work dir
extern fn gem_temp_dir() -> String
extern fn gem_rmdir(path: String) -> Int
extern fn gem_file_hash(path: String) -> String
extern fn gem_mkdirs(path: String) -> Int
extern fn gem_temp_dir_in(parent: String) -> String
extern fn gem_link(from: String, to: String) -> Int
extern fn gem_run_program(path: String, args: Bytes, replace: Int) -> Int

let argc = len(argv())
if argc < 2
  usage_error("no source file given")
end

if argv()[1] == "lsp"
  run_lsp()
  exit(0)
end

let cli = parse_args(project_command_args(argv()))

if cli.src_path == nil
  usage_error("no source file given")
end

let src_path = cli.src_path
if is_dir(src_path)
  eprint("gem: '" + src_path + "' is a directory, not a source file")
  exit(1)
end
if not file_exists(src_path)
  eprint("gem: cannot open '" + src_path + "'")
  exit(1)
end
let source = normalize_newlines(read_file(src_path))

let sink = make_error_sink()

let ast = parse_source(source, src_path, sink)
tag_file(ast, src_path)
let base_dir = dirname(src_path)
let project_root = find_project_root(base_dir)
if project_root != nil
  project_root = normalize_path(project_root)
end
let stdlib_root = compute_stdlib_root(install_root, project_root)
let show_path = make_show_path(src_path, project_root)
let loaded = {}
let module_bindings = {}
let sources_by_file = {}
sources_by_file[src_path] = source
# the entry file is on the load stack too: loading it back is a cycle
loaded[normalize_path(src_path)] = {exported: nil, loading: true, parent: nil}

# a failed parse may not have well-formed `load` nodes, so stop here
let resolved_ast = nil
if not sink.has_any()
  print_file_warnings(ast, src_path, show_path, sink)
  resolved_ast = resolve_loads(ast, base_dir, project_root, stdlib_root, loaded, module_bindings, sources_by_file, sink, show_path, {prefixes: {}, symbols: {}})
  let entry_export = find_export_node(resolved_ast.stmts)
  if entry_export != nil
    checked_exports(entry_export, collect_module_top_names(resolved_ast.stmts), module_name_from_path(src_path), src_path, false, sources_by_file, sink, {})
  end
end

if sink.has_any()
  print_all_errors(sink, show_path)
  exit(1)
end

shadow_entry_builtins(resolved_ast.stmts, module_bindings)
resolved_ast = lower(resolved_ast)

fold_constants(resolved_ast)

let cg = make_codegen(src_path, module_bindings, show_path, sources_by_file, sink, build_global_display(loaded), normalize_load_path(path_join(stdlib_root, "std")))
# codegen's `#line` directives name c_file, so it's picked before compiling
let work_dir = nil
let c_file = nil
if not cli.check and not cli.emit_c
  work_dir = gem_temp_dir()
  if work_dir == nil
    eprint("gem: cannot create a work directory under $TMPDIR (or /tmp)\n")
    exit(1)
  end
  c_file = work_dir + "/" + basename_no_ext(src_path) + ".c"
end
let c_code = cg.compile(resolved_ast, c_file)

# codegen reports errors too (undeclared names and such)
if sink.has_any()
  print_all_errors(sink, show_path)
  exit(1)
end

if cli.check
  exit(0)
end

if cli.emit_c
  print(c_code)
else
  let base = basename_no_ext(src_path)
  let tmp_c = c_file

  let out_name = cli.out_name
  if out_name == nil
    if cli.run
      out_name = work_dir + "/" + base
    else
      out_name = "./" + base
    end
  end

  let runtime_dir = path_join(install_root, "runtime")

  # GEM_RUNTIME=debug|asan: the program gets that runtime's flags too, so gem.h's inline code checks its asserts
  let runtime_kind = getenv("GEM_RUNTIME")
  let runtime_lib = path_join(install_root, "build/libgem_runtime.a")
  # run mode: -O0 compiles several times faster, and the result is cached
  let c_flags = if cli.run then " -std=gnu11 -O0 -pthread" else " -std=gnu11 -O2 -pthread" end
  if runtime_kind == "debug" or runtime_kind == "asan"
    runtime_lib = path_join(install_root, "build/" + runtime_kind + "/libgem_runtime.a")
    if not file_exists(runtime_lib)
      eprint("gem: GEM_RUNTIME=" + runtime_kind + " needs " + runtime_lib + ": run 'make " + runtime_kind + "' first")
      exit(2)
    end
    c_flags = " -std=gnu11 -O1 -g -fno-omit-frame-pointer -DGEM_DEBUG -pthread"
    if runtime_kind == "asan"
      c_flags = c_flags + " -fsanitize=address,undefined -fno-sanitize-recover=undefined"
    end
  elif runtime_kind != nil and runtime_kind != "" and runtime_kind != "release"
    usage_error("GEM_RUNTIME must be release, debug or asan, not '" + runtime_kind + "'")
  end
  let q_rt = shell_quote(runtime_dir)
  # -I before the runtime's own; -L/-l after the runtime lib, which may need them. CFLAGS/LDFLAGS go unquoted.
  let cc = getenv("CC")
  if cc == nil or cc == ""
    cc = "cc"
  end
  let env_cflags = getenv("CFLAGS")
  let env_ldflags = getenv("LDFLAGS")
  let inc_flags = ""
  let lib_flags = ""
  for f in cli.cc_flags
    if substr(f, 0, 2) == "-I"
      inc_flags = inc_flags + " " + shell_quote(f)
    else
      lib_flags = lib_flags + " " + shell_quote(f)
    end
  end
  if env_ldflags != nil and env_ldflags != ""
    lib_flags = " " + env_ldflags + lib_flags
  end
  # OpenSSL only for programs that reference gem_tls_connect_fn (runtime/tls_config.sh writes build/tls_libs)
  let tls_libs_file = path_join(install_root, "build/tls_libs")
  if find(c_code, "gem_tls_connect_fn") >= 0 and file_exists(tls_libs_file)
    let tls_libs = string.trim(read_file(tls_libs_file))
    if tls_libs != ""
      lib_flags = lib_flags + " " + tls_libs
    end
  end
  if env_cflags != nil and env_cflags != ""
    c_flags = c_flags + " " + env_cflags
  end
  let have_runtime_lib = file_exists(runtime_lib)

  # on a cc failure: exit with its status and leave the C file for reading
  let build = fn(out, run_dir)
    write_file(tmp_c, c_code)
    let q_out = shell_quote(out)
    let q_c = shell_quote(tmp_c)
    let cc_cmd = if have_runtime_lib
      cc + " -o " + q_out + " " + q_c + inc_flags + " -I " + q_rt + c_flags + " " + shell_quote(runtime_lib) + lib_flags + " -lm"
    else
      cc + " -o " + q_out + " " + q_c + " " + q_rt + "/gem_*.c " + q_rt + "/sqlite3.c" + inc_flags + " -I " + q_rt + c_flags + lib_flags + " -lm"
    end
    let cc_ret = exec(cc_cmd)
    if cc_ret != 0
      if run_dir != nil
        if file_exists(out)
          remove_file(out)
        end
        gem_rmdir(run_dir)
      end
      # not error(): cc already printed its diagnostics, a trace is just noise
      eprint("gem: compilation failed (cc exited with " + to_string(cc_ret) + "); the C is in " + tmp_c + "\n")
      exit(cc_ret)
    end
    remove_file(tmp_c)
  end

  if not cli.run
    build(out_name, nil)
    gem_rmdir(work_dir)
    exit(0)
  end

  # A cached binary replaces this process (execve), so status and signals are the program's own; otherwise
  # it runs as a child and we pass its status on. Either way it inherits our fds (`<(cmd)` paths work).
  let run_args = build_string do |add|
    for a in cli.run_args
      add(a, chr(0))
    end
  end

  # if another run empties the cache under us, rebuild; after two misses run outside the cache
  let runtime_hash = if have_runtime_lib then gem_file_hash(runtime_lib) else "" end
  let slot = cache_slot(c_code, tmp_c, [cc, inc_flags, c_flags, lib_flags, runtime_lib, runtime_hash, runtime_file_hashes(runtime_dir, not have_runtime_lib)], base)
  let vanished = 0
  while slot != nil
    if file_exists(slot.bin)
      gem_rmdir(work_dir)
      gem_run_program(slot.bin, run_args, 1)
      if file_exists(slot.bin)
        eprint("gem: cannot run " + slot.bin)
        exit(1)
      end
      # entry gone: new work dir, and fix the path the C names itself by
      vanished += 1
      work_dir = gem_temp_dir()
      if work_dir == nil
        eprint("gem: cannot create a work directory under $TMPDIR (or /tmp)\n")
        exit(1)
      end
      let new_c = work_dir + "/" + base + ".c"
      c_code = str_replace(c_code, tmp_c, new_c)
      tmp_c = new_c
      out_name = work_dir + "/" + base
      if vanished >= 2
        break
      end
    end
    let run_dir = gem_temp_dir_in(slot.staging)
    if run_dir == nil
      break
    end
    let run_bin = path_join(run_dir, base)
    build(run_bin, run_dir)
    # another run may have linked the same key meanwhile
    gem_mkdirs(dirname(slot.bin))
    if gem_link(run_bin, slot.bin) == 1 or file_exists(slot.bin)
      remove_file(run_bin)
      gem_rmdir(run_dir)
    else
      let run_ret = gem_run_program(run_bin, run_args, 0)
      remove_file(run_bin)
      gem_rmdir(run_dir)
      gem_rmdir(work_dir)
      if run_ret < 0
        eprint("gem: cannot run " + run_bin)
        run_ret = 1
      end
      exit(run_ret)
    end
  end

  build(out_name, nil)
  let run_ret = gem_run_program(out_name, run_args, 0)
  remove_file(out_name)
  gem_rmdir(work_dir)
  if run_ret < 0
    eprint("gem: cannot run " + out_name)
    run_ret = 1
  end
  exit(run_ret)
end
