# Parser — recursive descent parser for Gem.
# Takes a token array from the lexer, returns an AST using constructors from ast.gem.
# Produces the EXACT same AST shape as the bootstrap compiler.

load "./ast" (make_program, make_int, make_float, make_string, make_bool, make_nil_node, make_var, make_binop, make_unop, make_call, make_dot, make_index, make_anon_fn, make_table, make_table_entry, make_array, make_interp, make_let, make_assign, make_dot_assign, make_index_assign, make_fn_def, make_if, make_while, make_match, make_when, make_for_in, make_for_range, make_match_arm, make_pat_table, make_pat_table_entry, make_pat_array, make_pat_literal, make_pat_name, make_pat_pin, make_pat_error, make_receive_match, make_return, make_break, make_continue, make_export, make_extern_fn, make_extern_param, make_extern_include, make_error_expr, make_error_stmt)
load "./lexer" (tokenize, normalize_newlines)
load "./errors" (make_error_sink)

# The deepest nesting the parser accepts (see `nest` in make_parser). Per
# level, the parser recurses deepest: on macOS arm64, about 800 nested
# parentheses overflow the compiler's stack.
let MAX_NEST = 500
# The deepest AST it builds: nesting plus the links of operator and postfix
# chains (`a + b + c` is a binop inside a binop, `t.a.b` a field read of a
# field read). The passes after the parser, and the C compiler on the
# nested C expressions codegen emits, recurse once per level: clang
# crashes on about 1,900 nested index reads.
let MAX_DEPTH = 1000

# Words that can't name the C function an `extern fn` calls: C's keywords
# that aren't also Gem keywords, and the type names the generated
# prototypes use.
let C_RESERVED = {}
for w in ["auto", "case", "char", "const", "default", "double", "enum", "float", "goto", "inline", "int", "long", "register", "restrict", "short", "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "asm", "typeof", "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary", "_Noreturn", "_Static_assert", "_Thread_local", "bool", "int64_t", "uint8_t", "GemVal", "GemBytes"]
  C_RESERVED[w] = true
end

# ─── Number conversion helpers ───────────────────────────────────

extern fn atof(s: String) -> Float

fn digit_val(ch)
  match ch
  when "0"
    0
  when "1"
    1
  when "2"
    2
  when "3"
    3
  when "4"
    4
  when "5"
    5
  when "6"
    6
  when "7"
    7
  when "8"
    8
  when "9"
    9
  else
    error("not a digit: {ch}")
  end
end

fn str_to_int(s)
  let result = 0
  for i = 0, len(s)
    result = result * 10 + digit_val(s[i])
  end
  result
end

# Where a decimal integer literal's digits fall against the int64 range:
# "ok" (at most 9223372036854775807), "min" (exactly 9223372036854775808,
# which only `-` may take, giving INT64_MIN) or "over".
fn int_literal_range(s)
  let start = 0
  while start < len(s) - 1 and s[start] == "0"
    start += 1
  end
  let digits = len(s) - start
  if digits < 19 then return "ok" end
  if digits > 19 then return "over" end
  let d = substr(s, start, 19)
  if d <= "9223372036854775807" then return "ok" end
  if d == "9223372036854775808" then return "min" end
  "over"
end

fn int64_min()
  0 - 9223372036854775807 - 1
end

fn contains_dot(s)
  for i = 0, len(s)
    if s[i] == "."
      return true
    end
  end
  false
end

# ─── Helpers ─────────────────────────────────────────────────────

fn parse_source(source, file, sink)
  if sink == nil
    sink = make_error_sink()
  end
  let errors_before = sink.count()
  source = normalize_newlines(source)
  let tokens = tokenize(source, file, sink)
  # If the lexer reported errors for this file, skip the parser entirely —
  # the token stream past an unterminated string is meaningless and parser
  # cascades would just spam the user with derivative diagnostics. The sink
  # is shared across loaded files, so compare against the count on entry.
  if sink.count() > errors_before or sink.suppressed()
    return make_program([])
  end
  let p = make_parser(tokens, source, file, sink)
  p.parse()
end

# Pattern names split into the ones the pattern binds and the `^` pins.
fn collect_pattern_names(pat, bound, pins)
  if pat == nil
    return nil
  end
  if pat.tag == "pat_name"
    bound[pat.name] = true
  elif pat.tag == "pat_pin"
    push(pins, pat.var)
  elif pat.tag == "pat_table"
    for e in pat.entries
      if e.value == nil
        bound[e.key] = true
      else
        collect_pattern_names(e.value, bound, pins)
      end
    end
  elif pat.tag == "pat_array"
    for el in pat.elements
      collect_pattern_names(el, bound, pins)
    end
  end
end

# ─── Parser constructor ─────────────────────────────────────────

fn make_parser(tokens, source, file, sink)
  if sink == nil
    sink = make_error_sink()
  end
  let pos = 0
  let gensym_counter = 0
  # One destructured binding `name = value` with an optional default that
  # fires when the key is missing from `obj_name` (a field name, or an
  # index for an array pattern), like a positional default fires only for
  # an argument left out: an explicit nil stays nil. The value is read
  # first (so a non-table still raises as without a default), and only a
  # nil read checks for the key. The default is evaluated into a temp
  # before `let name`, so a default reading `name` sees the binding it
  # shadows (as any `let` initializer does), and only when it is needed.
  let push_destructured = fn(stmts, name, obj_name, key, value, dflt, line)
    if dflt == nil
      push(stmts, make_let(name, value, line))
      return nil
    end
    gensym_counter += 1
    let tmp = "_d{gensym_counter}v"
    push(stmts, make_let(tmp, value, line))
    let missing = make_binop("and",
      make_binop("==", make_var(tmp), make_nil_node()),
      make_unop("not", make_call(make_var("__has_key"), [make_var(obj_name), key], line)),
      line)
    push(stmts, make_if(missing, [make_assign(tmp, dflt, line)], [], line))
    push(stmts, make_let(name, make_var(tmp), line))
  end
  let fn_depth = 0
  # Levels of statements, expressions, unary operators and patterns open
  # around the token being parsed, and the operator- and postfix-chain links
  # among them. A program nested past MAX_NEST, or deeper than MAX_DEPTH
  # counting the links, is reported as a compile error.
  let nest = 0
  let links = 0
  let nest_overflow = false
  # Names the pattern being parsed binds so far, and how many patterns deep
  # the parser is (0 outside one).
  let pat_bound = {}
  let pat_level = 0
  # Nesting of the statement being parsed: 1 for a statement directly in
  # the file's top-level code, more inside any block (if/while/for/match/
  # receive arms, fn and do bodies). Named fns and externs live only at 1.
  let stmt_depth = 0
  # > 0 while parsing an if / while / for header. No trailing block is
  # taken there, so `x do` / `f() do` is reported as a stray Lua/Ruby-style
  # `do` instead of parsed as a block call.
  let header_depth = 0
  # Loops enclosing the current statement, counted up to the innermost
  # function boundary, and the kind of that boundary: nil (top level or a
  # named fn), "fn" (anonymous fn), "do" (do block), "spawn" (`spawn do`).
  # A closure is a separate C function, so `break` / `continue` can't reach
  # a loop outside it; parse_stmt reports them when loop_depth is 0.
  let loop_depth = 0
  let closure_kind = nil
  # Position of the statement parse() is parsing at the file's top level,
  # so parse_stmt can tell a module-scope `let` / `fn` / `extern fn` from a
  # nested one.
  let top_stmt_pos = -1
  # Module-scope names declared so far: name -> {kind, line}. Each name has
  # one module-level definition: a `fn`, an `extern fn` or `let`s (a second
  # `let` rebinds the slot). Any other pair is reported at the second one.
  let top_names = {}

  # ── Token access ──

  let peek = fn()
    tokens[pos]
  end

  # Past the end it gives the EOF token, as `peek` does at the end.
  let peek_at = fn(n)
    if pos + n >= len(tokens)
      return tokens[-1]
    end
    tokens[pos + n]
  end

  let advance = fn()
    let t = tokens[pos]
    pos += 1
    t
  end

  let at_end = fn()
    tokens[pos].type == "EOF"
  end

  # Report a parser error at the given location. Once the nesting limit
  # was hit, the parse that follows is a recovery: its errors are skipped.
  let report = fn(line, col, span, msg, hint)
    if nest_overflow
      return nil
    end
    sink.report(source, file, line, col, span, msg, hint)
  end

  # Reports the first nesting overflow, at the token that went over.
  let report_nest = fn(msg, hint)
    if not nest_overflow
      let t = tokens[pos]
      report(t.line, t.col, 1, msg, hint)
      nest_overflow = true
    end
  end

  # Opens one level of nesting; false (and nothing opened) past a limit.
  let enter_nest = fn()
    if nest >= MAX_NEST
      report_nest("nested too deeply: more than {MAX_NEST} levels", "split the code with `let` or a helper fn")
      return false
    end
    if nest + links >= MAX_DEPTH
      report_nest("expression too deep: more than {MAX_DEPTH} levels", "each operator of a chain like `a + b + c` adds a level; split it with `let`")
      return false
    end
    nest += 1
    true
  end

  # Opens one link of an operator chain; false (and nothing opened) past
  # MAX_DEPTH.
  let enter_link = fn()
    if nest + links >= MAX_DEPTH
      report_nest("expression too deep: more than {MAX_DEPTH} levels", "each operator of a chain like `a + b + c` adds a level; split it with `let`")
      return false
    end
    links += 1
    true
  end

  # Records a name the current pattern binds; a second binding of it is an
  # error, since it reads like an equality test and would bind the last
  # match. `_` may repeat.
  let bind_pattern_name = fn(tok)
    if tok.value != "_" and has_key(pat_bound, tok.value)
      report(tok.line, tok.col, len(tok.value), "'{tok.value}' is bound twice in this pattern", "a repeated name doesn't compare the values; pin it with `^{tok.value}` against an earlier binding, or compare in the body")
    end
    pat_bound[tok.value] = true
  end

  # A module-scope binding of `tok`'s name (kind "let", "load", "fn" or
  # "extern fn"), clashing with an earlier one unless both are lets or
  # loads (the bindings a `load` makes are lets). `span` overrides the
  # underline width.
  let note_top_name = fn(tok, kind, span = nil)
    if tok.synthetic == true or type(tok.value) != "string"
      return nil
    end
    let name = tok.value
    let prev = top_names[name]
    if prev == nil
      top_names[name] = {kind: kind, line: tok.line}
      return nil
    end
    let rebindable = {let: true, load: true}
    if rebindable[prev.kind] and rebindable[kind]
      return nil
    end
    let article = "a"
    if prev.kind == "extern fn"
      article = "an"
    end
    if span == nil
      span = len(name)
    end
    report(tok.line, tok.col, span, "`{name}` is already defined at line {prev.line} ({article} `{prev.kind}`)", "pick another name; a module-level name has one definition (only a `let` can be repeated, and it rebinds the name)")
  end

  # NUMBER token `t` holds an integer literal that doesn't fit in an int.
  let report_int_range = fn(t)
    report(t.line, t.col, len(t.value), "integer literal out of range (max 9223372036854775807)", "ints are 64-bit signed: -9223372036854775808 to 9223372036854775807")
  end

  # An int key in a table literal or table pattern: when the tokens at the
  # cursor are `NUMBER :` with an integer NUMBER, consumes them up to the
  # `:` and returns the key's value, read like any int literal (decimal,
  # leading zeros ignored, range-checked: an out-of-range key is reported
  # and reads as 0). `- NUMBER :` is reported: a negative int indexes from
  # the end and is never a key. A float key is reported too (and reads as
  # 0). Otherwise consumes nothing and returns nil.
  let parse_int_key = fn()
    let negative = peek().type == "-"
    let off = 0
    if negative then off = 1 end
    let nt = peek_at(off)
    if nt.type != "NUMBER" or peek_at(off + 1).type != ":"
      return nil
    end
    if contains_dot(nt.value)
      let first = advance()
      let text = nt.value
      if negative
        advance()
        text = "-" + text
      end
      report(first.line, first.col, nt.col + len(nt.value) - first.col, "a float can't be a table key in a literal or pattern", "set it with an index: `t[{text}] = v`, or key the entry with a string")
      return 0
    end
    let first = advance()
    if negative
      advance()
      report(first.line, first.col, nt.col + len(nt.value) - first.col, "a negative int can't be a table key", "a negative int indexes from the end of an array (`t[-1]` is the last element); key the entry with a string")
      return 0
    end
    if int_literal_range(nt.value) != "ok"
      report_int_range(nt)
      return 0
    end
    str_to_int(nt.value)
  end

  # Table (or table pattern) entry `entry` gets the int key `n`: its `key`
  # is the decimal text and `int_key` the int, which codegen and the
  # pattern lowering use. A key written as a string stays a string.
  let set_int_key = fn(entry, n)
    entry.key = to_string(n)
    entry.int_key = n
    entry
  end

  # Enter a function body (kind as for closure_kind); returns the state
  # leave_fn_body restores.
  let enter_fn_body = fn(kind)
    let saved = {depth: loop_depth, kind: closure_kind}
    loop_depth = 0
    closure_kind = kind
    saved
  end

  let leave_fn_body = fn(saved)
    loop_depth = saved.depth
    closure_kind = saved.kind
  end

  # `break` / `continue` token `t` outside any loop of its function body.
  let report_loop_exit = fn(t)
    let kw = "`{t.type}`"
    if closure_kind == "do"
      report(t.line, t.col, len(t.type), "{kw} inside a `do` block; use a `for` loop", "a `do` block is a closure, so {kw} can't reach a loop in the caller; `return` leaves the block")
    elif closure_kind == "spawn"
      report(t.line, t.col, len(t.type), "{kw} inside a `spawn do` block, outside any loop", "a process body is not a loop; `return` ends the process")
    elif closure_kind == "fn"
      report(t.line, t.col, len(t.type), "{kw} inside a `fn` closure, outside any loop", "a closure is a separate function, so {kw} can't reach a loop outside it; `return` leaves the closure")
    else
      report(t.line, t.col, len(t.type), "{kw} outside a loop", nil)
    end
  end

  # `expect` is non-fatal: on mismatch it reports and returns a synthetic
  # token of the expected type *without consuming*. Loops that depend on
  # advancement past a missing terminator must also use the per-loop
  # progress guard (see parse_body / parse_fn_body / each `while peek...`).
  let expect = fn(tp)
    let t = tokens[pos]
    if t.type != tp
      report(t.line, t.col, len(t.value), "expected '{tp}' but got '{t.type}'", nil)
      return {type: tp, value: tp, line: t.line, col: t.col, synthetic: true}
    end
    pos += 1
    t
  end

  # Parse the type name of an extern parameter (`is_ret` false) or return
  # (`is_ret` true) and report it if it is not a marshalable extern type.
  let expect_extern_type = fn(is_ret, is_blocking)
    let t = expect("NAME")
    let ty = t.value
    if t.synthetic == true
      return ty
    end
    let known = ty == "Int" or ty == "Float" or ty == "String" or ty == "Bool" or ty == "Ptr" or ty == "Bytes" or ty == "Table"
    if is_ret and ty == "Nil"
      known = true
    end
    if not known
      let allowed = "Int, Float, String, Bool, Ptr, Bytes, Table"
      if is_ret
        allowed = allowed + ", Nil"
      end
      report(t.line, t.col, len(ty), "unknown extern type '{ty}'", "expected one of {allowed}")
    elif is_blocking and ty == "Table" and is_ret
      report(t.line, t.col, len(ty), "extern blocking fn cannot return a Table", "the C function runs on a worker thread, which cannot allocate in the calling process's memory; return Bytes or Ptr instead")
    elif is_blocking and ty == "Table"
      report(t.line, t.col, len(ty), "extern blocking fn cannot take a Table", "a Table points into the calling process's memory, which is freed if the process is killed mid-call; pass its fields as separate arguments")
    end
    ty
  end

  # Force-advance one token if the loop body produced no progress this
  # iteration. Used inside every `while peek().type != X` to guarantee
  # forward motion even when expect() returns a synthetic and leaves the
  # offending token in the stream.
  let force_progress = fn(last_pos)
    if pos == last_pos and tokens[pos].type != "EOF"
      pos += 1
    end
  end

  let skip_nl = fn()
    while tokens[pos].type == "NEWLINE"
      pos += 1
    end
  end

  # ── Forward declarations for mutual recursion ──

  let parse_expr = nil
  # An expression statement: an assignment or a value (parse_expr rejects
  # an assignment).
  let parse_stmt_expr = nil
  let parse_stmt = nil
  let parse_unary = nil
  let parse_not = nil
  let parse_pattern = nil

  # In a destructuring pattern (`let {..} =`, a `{..}` fn param), after the
  # field name: `{key: name}` is renaming, which only match/receive patterns
  # have. Report it at the field and skip the rest of the entry.
  # A destructuring pattern's field is a name: it is both the key read
  # and the variable bound. Report anything else (a string, a number, a
  # keyword).
  let check_destructure_field = fn(field_tok)
    if field_tok.type != "NAME"
      let v = field_tok.value
      if v == "" or v == "\n"
        v = field_tok.type
      elif field_tok.type == "STRING"
        v = "\"" + v + "\""
      end
      report(field_tok.line, field_tok.col, len(field_tok.value), "expected a field name in a destructuring pattern, got `{v}`", "each field binds a variable of the same name: `let \{a, b\} = t`")
    end
  end

  let reject_destructure_rename = fn(field_tok, example)
    if peek().type != ":"
      return nil
    end
    let f = field_tok.value
    report(field_tok.line, field_tok.col, len(f), "destructuring can't rename `{f}`: write `{example}` and use `{f}`", nil)
    advance()
    let depth = 0
    while not at_end()
      let tp = peek().type
      if depth == 0 and (tp == "," or tp == "}" or tp == ")")
        break
      end
      if tp == "\{" or tp == "[" or tp == "("
        depth += 1
      elif tp == "}" or tp == "]" or tp == ")"
        depth -= 1
      end
      advance()
    end
  end

  # ── Parameter list ──
  # Returns {params, rest_param, defaults, prelude}.
  # params: param names before the rest param (or all params if no rest).
  # rest_param: the name after "...", or nil.
  # defaults: array parallel to params — each entry is an AST expr or nil.
  # prelude: array of statements desugared from destructuring params, to be
  #          prepended to the function body by the caller.

  let parse_params = fn()
    let params = []
    let rest_param = nil
    let defaults = []
    let prelude = []
    let has_default = false
    # Every name the list binds, plain, destructured or rest.
    let bound = {}
    let bind = fn(tok)
      if has_key(bound, tok.value)
        report(tok.line, tok.col, len(tok.value), "duplicate parameter '{tok.value}'", nil)
      end
      bound[tok.value] = true
    end

    while peek().type == "NAME" or peek().type == "..." or peek().type == "\{"
      if peek().type == "..."
        advance()
        let rest_tok = expect("NAME")
        rest_param = rest_tok.value
        if not rest_tok.synthetic
          bind(rest_tok)
        end
        break
      end

      # Destructuring param: {name [= expr], ...} [= outer_default]
      if peek().type == "\{"
        let dline = peek().line
        let dcol = peek().col
        advance()
        skip_nl()
        let dnames = []
        let ddflts = []
        while peek().type != "}" and not at_end()
          let _lp = pos
          let field_tok = peek()
          advance()
          push(dnames, field_tok.value)
          bind(field_tok)
          check_destructure_field(field_tok)
          reject_destructure_rename(field_tok, "\{" + field_tok.value + "\}")
          skip_nl()
          if peek().type == "="
            advance()
            skip_nl()
            push(ddflts, parse_expr())
          else
            push(ddflts, nil)
          end
          skip_nl()
          if peek().type == ","
            advance()
            skip_nl()
          end
          force_progress(_lp)
        end
        expect("}")

        gensym_counter += 1
        let pname = "_pdestr{gensym_counter}"
        push(params, pname)

        if peek().type == "="
          advance()
          let outer_default = parse_expr()
          # Use the existing param-default machinery for missing-arg case,
          # then *also* coerce explicit nil to the same default at body start.
          push(defaults, outer_default)
          has_default = true
          push(prelude, make_if(
            make_binop("==", make_var(pname), make_nil_node()),
            [make_assign(pname, outer_default, dline)],
            [],
            dline
          ))
        else
          if has_default
            report(dline, dcol, 1, "required parameter after optional parameter", nil)
          end
          push(defaults, nil)
        end

        # Bind each named field as a local. Per-field defaults fire only
        # when the key is missing (an explicit nil stays nil).
        for di = 0, len(dnames)
          push_destructured(prelude, dnames[di], pname, make_string(dnames[di]), make_dot(make_var(pname), dnames[di]), ddflts[di], dline)
        end

        # The prelude is part of the body, so it reruns on every iteration of
        # a TCO'd self tail call; an outer `= <default>` goes through the
        # regular param-default path, which TCO also handles.

        if peek().type != ","
          break
        end
        advance()
        skip_nl()
        continue
      end

      let name_tok = advance()
      push(params, name_tok.value)
      bind(name_tok)
      if peek().type == "="
        advance()
        push(defaults, parse_expr())
        has_default = true
      else
        if has_default
          report(name_tok.line, name_tok.col, len(name_tok.value), "required parameter after optional parameter", nil)
        end
        push(defaults, nil)
      end
      if peek().type != ","
        break
      end
      advance()
    end

    {params: params, rest_param: rest_param, defaults: defaults, prelude: prelude}
  end

  # Prepend a destructure-param prelude (binding lets/ifs) to a function body.
  let with_prelude = fn(prelude, body)
    if len(prelude) == 0
      return body
    end
    let full = []
    for s in prelude
      push(full, s)
    end
    for s in body
      push(full, s)
    end
    full
  end

  # ── Body parsers ──
  # parse_body: for if/while/when/else bodies
  # Terminates at: end, else, when, EOF

  let parse_body = fn()
    let stmts = []
    skip_nl()
    while peek().type != "end" and peek().type != "elif" and peek().type != "else" and peek().type != "when" and peek().type != "after" and peek().type != "then" and not at_end()
      let _lp = pos
      push(stmts, parse_stmt())
      skip_nl()
      force_progress(_lp)
    end
    stmts
  end

  # parse_fn_body: for fn_def, anon_fn, do blocks
  # Terminates at: end, EOF

  let parse_fn_body = fn()
    let saved_header_depth = header_depth
    header_depth = 0
    let stmts = []
    skip_nl()
    while peek().type != "end" and not at_end()
      let _lp = pos
      push(stmts, parse_stmt())
      skip_nl()
      force_progress(_lp)
    end
    header_depth = saved_header_depth
    stmts
  end

  # ── Expression parsing (precedence climbing) ──

  # atom: literals, variables, parenthesized exprs, anon fn, table, array
  let parse_atom = fn()
    let t = peek()

    # Number
    if t.type == "NUMBER"
      advance()
      if contains_dot(t.value)
        return make_float(atof(t.value))
      end
      if int_literal_range(t.value) != "ok"
        report_int_range(t)
        return make_int(0)
      end
      return make_int(str_to_int(t.value))
    end

    # String
    if t.type == "STRING"
      advance()
      return make_string(t.value)
    end

    # String interpolation
    if t.type == "INTERP_START"
      advance()
      # The lexer emits INTERP_START, then text and expression tokens
      # alternating, each text segment an INTERP_TEXT token (possibly
      # empty): INTERP_TEXT expr INTERP_TEXT ... INTERP_TEXT INTERP_END.
      # Text segments have their own token type so an expression that
      # starts with a string literal (`"{"a" in t}"`) parses as one.
      let parts = []
      let want_text = true
      skip_nl()
      while peek().type != "INTERP_END" and not at_end()
        let _lp = pos
        let it = peek()
        if it.type == "INTERP_TEXT"
          if not want_text
            # Two text segments in a row: an empty `{}`.
            report(it.line, it.col, 1, "empty string interpolation", "put an expression between '\{' and '}', or write '\\\{' for a literal brace")
          end
          advance()
          if len(it.value) > 0
            push(parts, make_string(it.value))
          end
          want_text = false
        else
          push(parts, parse_expr())
          skip_nl()
          let nt = peek()
          if nt.type != "INTERP_TEXT" and nt.type != "INTERP_END" and nt.type != "EOF"
            report(nt.line, nt.col, len(nt.value), "unexpected '{nt.type}' in string interpolation", "expected '}' to close the interpolation")
            while peek().type != "INTERP_TEXT" and peek().type != "INTERP_END" and not at_end()
              advance()
            end
          end
          want_text = true
        end
        skip_nl()
        force_progress(_lp)
      end
      expect("INTERP_END")
      return make_interp(parts)
    end

    # Booleans
    if t.type == "true"
      advance()
      return make_bool(true)
    end
    if t.type == "false"
      advance()
      return make_bool(false)
    end

    # Nil
    if t.type == "nil"
      advance()
      return make_nil_node()
    end

    # Anonymous function: fn(params) body end
    if t.type == "fn"
      advance()
      expect("(")
      let pr = parse_params()
      expect(")")
      fn_depth += 1
      let saved_loops = enter_fn_body("fn")
      let body = parse_fn_body()
      leave_fn_body(saved_loops)
      fn_depth -= 1
      expect("end")
      return make_anon_fn(pr.params, pr.rest_param, with_prelude(pr.prelude, body), pr.defaults, t.line)
    end

    # Table literal: {key: val, ...}
    # Keys can be names, keywords (else, end, when, match, etc.), strings
    # or non-negative ints.
    if t.type == "\{"
      advance()
      skip_nl()
      let entries = []
      while peek().type != "}" and not at_end()
        let _lp = pos
        let key_tok = peek()
        let int_key = parse_int_key()
        if int_key == nil
          if key_tok.type == "NAME"
            advance()
          elif not at_end() and peek_at(1).type == ":"
            # Keyword (or string) in key position — allow it
            advance()
          else
            report(key_tok.line, key_tok.col, len(key_tok.value), "expected '}' or table key but got '{key_tok.type}'", nil)
            force_progress(_lp)
            continue
          end
        end
        expect(":")
        let val = parse_expr()
        let entry = make_table_entry(key_tok.value, val)
        if int_key != nil then set_int_key(entry, int_key) end
        push(entries, entry)
        skip_nl()
        if peek().type == ","
          advance()
          skip_nl()
        end
        force_progress(_lp)
      end
      expect("}")
      return make_table(entries)
    end

    # Array literal: [expr, ...]
    if t.type == "["
      advance()
      skip_nl()
      let elements = []
      while peek().type != "]" and not at_end()
        let _lp = pos
        push(elements, parse_expr())
        skip_nl()
        if peek().type == ","
          advance()
          skip_nl()
        end
        force_progress(_lp)
      end
      expect("]")
      return make_array(elements)
    end

    # Parenthesized expression
    if t.type == "("
      advance()
      let e = parse_expr()
      expect(")")
      return e
    end

    # pcall expression: pcall <expr> desugars to pcall(fn() <expr> end)
    if t.type == "NAME" and t.value == "pcall" and peek_at(1).type != "(" and peek_at(1).type != "do"
      advance()
      let expr = parse_stmt_expr()
      return make_call(make_var("pcall"), [make_anon_fn([], nil, [expr], [], t.line)], t.line)
    end

    # Variable
    if t.type == "NAME"
      advance()
      return make_var(t.value, t.line, t.col)
    end

    # P5: garbage in expression position. Report, consume the offending
    # token so the surrounding loop makes progress, return an error stub.
    # The '}' closing an interpolation (the INTERP_TEXT/INTERP_END after
    # it) is left for the interpolation loop to consume.
    if t.type == "INTERP_TEXT" or t.type == "INTERP_END"
      report(t.line, t.col, 1, "expected expression before '}' in string interpolation", nil)
      return make_error_expr(t.line, t.col)
    end
    report(t.line, t.col, len(t.value), "unexpected token '{t.type}' (expected expression)", nil)
    if not at_end()
      advance()
    end
    make_error_expr(t.line, t.col)
  end

  # Optional `|params|` at the start of a block.
  let parse_block_params = fn()
    let r = {params: [], rest_param: nil, defaults: [], prelude: []}
    if peek().type == "|"
      advance()
      r = parse_params()
      expect("|")
    end
    r
  end

  # `do [|params|] body end` → anonymous fn
  # `is_spawn`: the block is the body of `spawn do ... end`.
  let parse_do_block = fn(is_spawn = false)
    let do_line = peek().line
    expect("do")
    let bp = parse_block_params()
    fn_depth += 1
    let kind = "do"
    if is_spawn
      kind = "spawn"
    end
    let saved_loops = enter_fn_body(kind)
    let body = parse_fn_body()
    leave_fn_body(saved_loops)
    fn_depth -= 1
    expect("end")
    make_anon_fn(bp.params, bp.rest_param, with_prelude(bp.prelude, body), bp.defaults, do_line)
  end

  # `{ [|params|] expr }` → anonymous fn
  let parse_brace_block = fn()
    let brace_line = peek().line
    expect("\{")
    let bp = parse_block_params()
    let bexpr = parse_stmt_expr()
    if peek().type == "}"
      advance()
    else
      expect("}")
      # Recovery: drop the rest of the block up to its `}` on this line,
      # so the tokens after a bad body don't end the enclosing statement
      # (a `for` body would end early, and a `break` in it later be
      # reported as outside a loop).
      let depth = 0
      while not at_end() and peek().type != "NEWLINE"
        let bt = advance().type
        if bt == "\{"
          depth += 1
        elif bt == "}"
          if depth == 0
            break
          end
          depth -= 1
        end
      end
    end
    make_anon_fn(bp.params, bp.rest_param, with_prelude(bp.prelude, [bexpr]), bp.defaults, brace_line)
  end

  let report_header_block = fn(tok)
    report(tok.line, tok.col, 1, "a trailing block can't be used in an if / while / for header", "assign the call's result to a variable before the header")
  end

  let is_assign_node = fn(e)
    type(e) == "table" and (e.tag == "assign" or e.tag == "dot_assign" or e.tag == "index_assign")
  end

  # Report an assignment where a value is expected, at its `=`.
  let report_assign_as_value = fn(e, msg)
    let span = 1
    if e.eq_len != nil
      span = e.eq_len
    end
    report(e.eq_line, e.eq_col, span, msg, nil)
  end

  # An expression in an if / while / for header. A `do` after it is
  # reported and skipped: these headers take no `do`.
  let parse_header_expr = fn(keyword)
    header_depth += 1
    let e = parse_stmt_expr()
    header_depth -= 1
    if peek().type == "do" and peek_at(1).type == "|"
      # `f() do |x| ... end`: a block with params, not a stray `do`.
      report_header_block(peek())
      parse_do_block()
    elif peek().type == "do"
      let d = peek()
      report(d.line, d.col, 2, "'{keyword}' does not take 'do'", "start the body on the next line")
      advance()
    end
    if keyword == "for" and is_assign_node(e)
      report_assign_as_value(e, "an assignment is a statement, not a value; use '==' to compare")
    end
    e
  end

  # call: atom followed by postfix ops (calls, dot, index)
  let parse_call = fn()
    let node = parse_atom()

    # Each postfix (call, field, index) nests the node in another, so each
    # loop turn opens a chain link.
    let opened = 0
    while enter_link()
      opened += 1
      # Block call without parens: `f do ... end`, `m.f { |x| ... }`. The
      # block is the only argument. A brace block needs `|params|` here so
      # it can't be mistaken for a table literal.
      if node.tag == "var" or node.tag == "dot"
        let call_line = peek().line
        if peek().type == "do" and header_depth == 0
          let is_spawn = node.tag == "var" and node.name == "spawn"
          node = make_call(node, [parse_do_block(is_spawn)], call_line)
          continue
        end
        if peek().type == "\{" and peek_at(1).type == "|"
          if header_depth > 0
            report_header_block(peek())
          end
          node = make_call(node, [parse_brace_block()], call_line)
          continue
        end
      end

      # Function call: node(args) [trailing_block]
      if peek().type == "("
        let call_line = peek().line
        advance()
        skip_nl()
        let args = []
        if peek().type != ")"
          push(args, parse_expr())
          while peek().type == ","
            advance()
            skip_nl()
            push(args, parse_expr())
          end
        end
        skip_nl()
        expect(")")

        # Trailing do block (must be on same line — no NEWLINE between ) and do)
        if peek().type == "do" and header_depth == 0
          push(args, parse_do_block(node.tag == "var" and node.name == "spawn"))
        else
          # Trailing brace block: {|params| expr} or {expr}
          # Distinguish from table literal by lookahead
          if peek().type == "\{"
            let is_block = false
            if peek_at(1).type == "|"
              is_block = true
            elif peek_at(1).type == "}" or (peek_at(1).type == "NAME" and peek_at(2).type == ":")
              is_block = false
            else
              is_block = true
            end
            if is_block
              let brace_tok = peek()
              if header_depth > 0
                report_header_block(brace_tok)
              end
              push(args, parse_brace_block())
            end
          end
        end

        node = make_call(node, args, call_line)
        continue
      end

      # Dot access: node.field (field can be a name or keyword)
      if peek().type == "."
        let dot_tok = tokens[pos]
        advance()
        let field_tok = peek()
        # Field name must be a NAME or an alphabetic keyword (e.g. obj.match,
        # from.ref). Reject punctuation/operator tokens — most importantly the
        # second '.' in '..', which would otherwise parse as `obj.<.>` and
        # fail at runtime ("field access on non-table").
        let c0 = ""
        if len(field_tok.type) > 0
          c0 = field_tok.type[0]
        end
        let is_keyword_tok = c0 >= "a" and c0 <= "z"
        if field_tok.type != "NAME" and not is_keyword_tok
          if field_tok.type == "."
            report(dot_tok.line, dot_tok.col, 2, "'..' is not an operator", "Gem uses '+' for both arithmetic and string concatenation")
          else
            report(field_tok.line, field_tok.col, len(field_tok.value), "expected field name after '.', got '{field_tok.type}'", nil)
          end
          if field_tok.type != "EOF"
            advance()
          end
          node = make_dot(node, "", field_tok.line)
          continue
        end
        advance()
        node = make_dot(node, field_tok.value, field_tok.line)
        node.col = field_tok.col
        continue
      end

      # Index access: node[key]
      if peek().type == "["
        let index_line = advance().line
        let key = parse_expr()
        expect("]")
        node = make_index(node, key, index_line)
        continue
      end

      break
    end
    links -= opened

    node
  end

  # unary: -expr | call
  parse_unary = fn()
    if peek().type == "-"
      # `-9223372036854775808` is INT64_MIN: the one literal whose digits
      # don't fit unless negated. Not when a postfix follows (`-N.x` is
      # `-(N.x)`); then the bare literal reports out of range.
      let nt = peek_at(1)
      if nt.type == "NUMBER" and not contains_dot(nt.value) and int_literal_range(nt.value) == "min"
        let follow = peek_at(2).type
        if follow != "(" and follow != "." and follow != "["
          advance()
          advance()
          return make_int(int64_min())
        end
      end
      if not enter_nest()
        return make_error_expr(peek().line, peek().col)
      end
      let minus_line = advance().line
      let operand = parse_unary()
      nest -= 1
      return make_unop("-", operand, minus_line)
    end
    parse_call()
  end

  # mul: unary (* | / | % unary)*
  let parse_mul = fn()
    let start_line = peek().line
    let left = parse_unary()
    let opened = 0
    while (peek().type == "*" or peek().type == "/" or peek().type == "%") and enter_link()
      opened += 1
      let op = advance().type
      let right = parse_unary()
      left = make_binop(op, left, right, start_line)
    end
    links -= opened
    left
  end

  # add: mul (+ | - mul)*
  let parse_add = fn()
    let start_line = peek().line
    let left = parse_mul()
    let opened = 0
    while (peek().type == "+" or peek().type == "-") and enter_link()
      opened += 1
      let op = advance().type
      let right = parse_mul()
      left = make_binop(op, left, right, start_line)
    end
    links -= opened
    left
  end

  # compare: add (comp_op add)*
  let parse_compare = fn()
    let start_line = peek().line
    let left = parse_add()
    let opened = 0
    while (peek().type == "==" or peek().type == "!=" or peek().type == "<" or peek().type == ">" or peek().type == "<=" or peek().type == ">=" or peek().type == "in") and enter_link()
      opened += 1
      let op = advance().type
      let right = parse_add()
      left = make_binop(op, left, right, start_line)
    end
    links -= opened
    left
  end

  # not: "not" not | compare
  parse_not = fn()
    if peek().type == "not"
      if not enter_nest()
        return make_error_expr(peek().line, peek().col)
      end
      let not_line = advance().line
      let operand = parse_not()
      nest -= 1
      return make_unop("not", operand, not_line)
    end
    parse_compare()
  end

  # and: not ("and" not)*
  let parse_and = fn()
    let start_line = peek().line
    let left = parse_not()
    let opened = 0
    while peek().type == "and" and enter_link()
      opened += 1
      advance()
      let right = parse_not()
      left = make_binop("and", left, right, start_line)
    end
    links -= opened
    left
  end

  # or: and ("or" and)*
  let parse_or = fn()
    let start_line = peek().line
    let left = parse_and()
    let opened = 0
    while peek().type == "or" and enter_link()
      opened += 1
      advance()
      let right = parse_and()
      left = make_binop("or", left, right, start_line)
    end
    links -= opened
    left
  end

  # assign: lhs = expr | lhs op= expr | or_expr
  let parse_assign_fn = fn()
    let start_line = peek().line
    let lhs = parse_or()

    # Simple assignment: var = expr, obj.field = expr, obj[key] = expr
    if peek().type == "="
      let eq_tok = advance()
      let value = parse_expr()
      let a = nil
      if lhs.tag == "var"
        a = make_assign(lhs.name, value, start_line)
        a.col = lhs.col
      elif lhs.tag == "dot"
        a = make_dot_assign(lhs.object, lhs.field, value, start_line)
      elif lhs.tag == "index"
        a = make_index_assign(lhs.object, lhs.key, value, start_line)
      end
      if a != nil
        a.eq_line = eq_tok.line
        a.eq_col = eq_tok.col
        return a
      end
      report(start_line, 1, 1, "invalid assignment target (expected variable, field, or index)", nil)
      return make_error_stmt(start_line, 1)
    end

    # Compound assignment: var += expr, etc. (desugars to assign + binop)
    if peek().type == "+=" or peek().type == "-=" or peek().type == "*=" or peek().type == "/="
      let op_tok = advance()
      let base_op = op_tok.value[0]
      let value = parse_expr()
      if lhs.tag != "var"
        report(op_tok.line, op_tok.col, len(op_tok.value), "compound assignment requires variable target", nil)
        return make_error_stmt(op_tok.line, op_tok.col)
      end
      # The assignment and the read of the target share the target's
      # position, so a diagnostic about the name is reported once.
      let a = make_assign(lhs.name, make_binop(base_op, make_var(lhs.name, lhs.line, lhs.col), value), start_line)
      a.col = lhs.col
      a.eq_line = op_tok.line
      a.eq_col = op_tok.col
      a.eq_len = len(op_tok.value)
      return a
    end

    lhs
  end

  # Wire up forward declaration. An assignment is a statement: only an
  # expression statement (and a block body, which is one) may be one.
  # Everywhere else a value is expected, so `f(a = 1)` is reported.
  parse_stmt_expr = parse_assign_fn
  parse_expr = fn()
    let t = peek()
    if not enter_nest()
      return make_error_expr(t.line, t.col)
    end
    let e = parse_assign_fn()
    nest -= 1
    if is_assign_node(e)
      report_assign_as_value(e, "an assignment is a statement, not a value; use '==' to compare")
      return make_error_expr(e.eq_line, e.eq_col)
    end
    e
  end

  # ── Pattern parsing (for match destructuring) ──

  # parse_pattern returns a structural pattern node (pat_table /
  # pat_array / pat_literal / pat_name / pat_pin, or pat_error after a
  # reported parse error). compiler/lower.gem turns
  # the pattern into the concrete condition expression + bindings
  # for the match target. Keeping the structural form in the AST
  # lets future tooling (formatters, refactors, completion inside
  # `when` arms) read what the user wrote.
  let parse_pattern_fn = fn()
    let t = peek()

    # Table pattern: {key: pattern, ...} or {key} (shorthand bind)
    if t.type == "\{"
      advance()
      skip_nl()
      let entries = []
      while peek().type != "}" and not at_end()
        let _lp = pos
        let key_tok = peek()
        let int_key = parse_int_key()
        if int_key == nil
          if key_tok.type == "NAME"
            advance()
          elif peek_at(1).type == ":"
            # keyword (or string) as key
            advance()
          else
            report(key_tok.line, key_tok.col, len(key_tok.value), "expected key name in table pattern", nil)
            force_progress(_lp)
            continue
          end
        end
        let key_name = key_tok.value
        let sub_pat = nil
        if peek().type == ":"
          advance()
          skip_nl()
          sub_pat = parse_pattern()
        end
        if sub_pat == nil
          bind_pattern_name(key_tok)
        end
        let entry = make_pat_table_entry(key_name, sub_pat)
        if int_key != nil then set_int_key(entry, int_key) end
        push(entries, entry)
        skip_nl()
        if peek().type == ","
          advance()
          skip_nl()
        end
        force_progress(_lp)
      end
      expect("}")
      return make_pat_table(entries)
    end

    # Array pattern: [pattern, ...]
    if t.type == "["
      advance()
      skip_nl()
      let elements = []
      while peek().type != "]" and not at_end()
        let _lp = pos
        push(elements, parse_pattern())
        skip_nl()
        if peek().type == ","
          advance()
          skip_nl()
        end
        force_progress(_lp)
      end
      expect("]")
      return make_pat_array(elements)
    end

    # Literal patterns: number (optionally negative), string, bool, nil —
    # equality match
    if t.type == "NUMBER" or (t.type == "-" and peek_at(1).type == "NUMBER")
      let negative = t.type == "-"
      if negative
        advance()
      end
      let nt = peek()
      advance()
      let lit = nil
      if contains_dot(nt.value)
        let f = atof(nt.value)
        if negative then f = 0.0 - f end
        lit = make_float(f)
      else
        let range = int_literal_range(nt.value)
        if range == "min" and negative
          lit = make_int(int64_min())
        elif range != "ok"
          report_int_range(nt)
          lit = make_int(0)
        else
          let n = str_to_int(nt.value)
          if negative then n = 0 - n end
          lit = make_int(n)
        end
      end
      return make_pat_literal(lit)
    end
    if t.type == "STRING"
      advance()
      return make_pat_literal(make_string(t.value))
    end
    if t.type == "true"
      advance()
      return make_pat_literal(make_bool(true))
    end
    if t.type == "false"
      advance()
      return make_pat_literal(make_bool(false))
    end
    if t.type == "nil"
      advance()
      return make_pat_literal(make_nil_node())
    end

    # Pin pattern: ^name — equality with an existing variable
    if t.type == "^"
      advance()
      let nt = peek()
      if nt.type != "NAME"
        report(nt.line, nt.col, len(nt.value), "expected variable name after '^' but got '{nt.type}'", nil)
        let nty = nt.type
        if not at_end() and nty != "NEWLINE" and nty != "}" and nty != "]" and nty != ","
          advance()
        end
        return make_pat_error()
      end
      advance()
      let pin_next = peek()
      if pin_next.type == "." or pin_next.type == "[" or pin_next.type == "("
        report(pin_next.line, pin_next.col, len(pin_next.value), "'^' pins a plain variable name", "bind the expression to a local variable first, then pin that variable")
        while not at_end() and peek().type != "NEWLINE" and peek().type != "}" and peek().type != "]" and peek().type != ","
          advance()
        end
        return make_pat_error()
      end
      return make_pat_pin(nt.value, nt.line, nt.col)
    end

    # Name pattern: variable binding (catch-all)
    if t.type == "NAME"
      advance()
      bind_pattern_name(t)
      return make_pat_name(t.value)
    end

    # Garbage in pattern position. Report, consume the bad token, and
    # return a placeholder pattern that never matches.
    report(t.line, t.col, len(t.value), "expected pattern but got '{t.type}'", nil)
    if not at_end()
      advance()
    end
    make_pat_error()
  end

  parse_pattern = fn()
    if not enter_nest()
      return make_pat_error()
    end
    if pat_level == 0
      pat_bound = {}
    end
    pat_level += 1
    let p = parse_pattern_fn()
    pat_level -= 1
    nest -= 1
    p
  end


  # A `when` arm pattern. A pin may not name a variable the same pattern
  # binds: the pin compares against the value from before the pattern.
  let parse_arm_pattern = fn()
    let pat = parse_pattern()
    let bound = {}
    let pins = []
    collect_pattern_names(pat, bound, pins)
    for v in pins
      if has_key(bound, v.name)
        report(v.line, v.col, len(v.name), "`^{v.name}` pins `{v.name}`, which this same pattern binds", "a pin compares against a variable bound before the pattern; rename the binding")
      end
    end
    pat
  end

  # True when a token of type `tp` ends a `when` arm's head: `then`
  # (one-line arm) or the start of the next line / arm / clause.
  let ends_arm_head = fn(tp)
    tp == "then" or tp == "NEWLINE" or tp == "EOF" or tp == "end" or tp == "else" or tp == "when" or tp == "after"
  end

  # The body of a `when` arm. `then` starts a body on the same line, like
  # `if <cond> then`; without it the body starts on the next line. Anything
  # else on the pattern's line is an error.
  let parse_arm_body = fn()
    let nt = peek()
    if nt.type == "then"
      advance()
    elif not ends_arm_head(nt.type)
      report(nt.line, nt.col, len(to_string(nt.value)), "expected `then` or a newline after the `when` pattern", "write `when <pattern> then <body>` for a one-line arm")
    end
    parse_body()
  end

  # One `when` arm of a `match` or `receive` (the `when` already consumed).
  # Destructuring pattern ({, [, ^) or bare-name catch-all → pattern arm.
  # Anything else → expression arm (equality with the match target).
  let parse_when_arm = fn()
    let pt = peek().type
    if pt == "\{" or pt == "[" or pt == "^"
      let pat = parse_arm_pattern()
      return make_match_arm(pat, nil, parse_arm_body())
    end
    if pt == "NAME" and ends_arm_head(peek_at(1).type)
      let pat = parse_arm_pattern()
      return make_match_arm(pat, nil, parse_arm_body())
    end
    let wval = parse_expr()
    if wval.tag == "var" and not ends_arm_head(peek().type)
      # `when x foo`: report the missing `then` once, and keep `x` a
      # binding so its uses in the body don't also report as undeclared.
      return make_match_arm(make_pat_name(wval.name), nil, parse_arm_body())
    end
    make_match_arm(nil, wval, parse_arm_body())
  end

  # ── Statement parsing ──

  let parse_stmt_fn = fn()
    let t = peek()

    # let declaration
    if t.type == "let"
      let line = t.line
      let at_top = pos == top_stmt_pos
      advance()

      # Table destructuring: let {a, b [= default], c} = expr
      if peek().type == "\{"
        advance()
        let names = []
        let dflts = []
        pat_bound = {}
        skip_nl()
        while peek().type != "}" and not at_end()
          let _lp = pos
          let field_tok = peek()
          # The field name: check_destructure_field reports anything but a
          # NAME
          advance()
          push(names, field_tok.value)
          bind_pattern_name(field_tok)
          check_destructure_field(field_tok)
          reject_destructure_rename(field_tok, "let \{" + field_tok.value + "\} = ...")
          if at_top
            note_top_name(field_tok, "let")
          end
          skip_nl()
          if peek().type == "="
            advance()
            skip_nl()
            push(dflts, parse_expr())
          else
            push(dflts, nil)
          end
          skip_nl()
          if peek().type == ","
            advance()
            skip_nl()
          end
          force_progress(_lp)
        end
        expect("}")
        expect("=")
        let rhs = parse_expr()
        gensym_counter += 1
        let tmp = "_d{gensym_counter}"
        let stmts = [make_let(tmp, rhs, line)]
        for di = 0, len(names)
          push_destructured(stmts, names[di], tmp, make_string(names[di]), make_dot(make_var(tmp), names[di]), dflts[di], line)
        end
        return {tag: "block", stmts: stmts}
      end

      # Array destructuring: let [a, b [= default], c] = expr
      if peek().type == "["
        advance()
        let names = []
        let dflts = []
        pat_bound = {}
        skip_nl()
        while peek().type != "]" and not at_end()
          let _lp = pos
          let name_tok = expect("NAME")
          push(names, name_tok.value)
          if not name_tok.synthetic
            bind_pattern_name(name_tok)
          end
          if at_top
            note_top_name(name_tok, "let")
          end
          skip_nl()
          if peek().type == "="
            advance()
            skip_nl()
            push(dflts, parse_expr())
          else
            push(dflts, nil)
          end
          skip_nl()
          if peek().type == ","
            advance()
            skip_nl()
          end
          force_progress(_lp)
        end
        expect("]")
        expect("=")
        let rhs = parse_expr()
        gensym_counter += 1
        let tmp = "_d{gensym_counter}"
        let stmts = [make_let(tmp, rhs, line)]
        for di = 0, len(names)
          push_destructured(stmts, names[di], tmp, make_int(di), make_index(make_var(tmp), make_int(di)), dflts[di], line)
        end
        return {tag: "block", stmts: stmts}
      end

      let name_tok = expect("NAME")
      let name = name_tok.value
      if at_top
        note_top_name(name_tok, "let")
      end
      expect("=")
      let value = parse_expr()
      return make_let(name, value, line)
    end

    # fn definition: fn NAME(params) body end
    if t.type == "fn" and peek_at(1).type == "NAME"
      let line = t.line
      let at_top = pos == top_stmt_pos
      advance()
      let name_tok = expect("NAME")
      let name = name_tok.value
      if at_top
        note_top_name(name_tok, "fn")
      end
      if fn_depth > 0
        report(line, t.col, len(name) + 3, "named fn inside function body is not supported", "use: let {name} = fn(...) ... end")
      elif stmt_depth > 1
        report(line, t.col, len(name) + 3, "named fn inside a block is not supported", "define it at the top level, or use: let {name} = fn(...) ... end")
      end
      expect("(")
      let pr = parse_params()
      expect(")")
      fn_depth += 1
      let saved_loops = enter_fn_body(nil)
      let body = parse_fn_body()
      leave_fn_body(saved_loops)
      fn_depth -= 1
      expect("end")
      return make_fn_def(name, pr.params, pr.rest_param, with_prelude(pr.prelude, body), line, pr.defaults)
    end

    # if / elif statement
    if t.type == "if" or t.type == "elif"
      let line = t.line
      advance()
      let cond = parse_header_expr(t.value)
      if is_assign_node(cond)
        report_assign_as_value(cond, "assignment is not allowed in condition; use '==' for comparison")
      end
      if peek().type == "then"
        advance()
      end
      let then_body = parse_body()
      let else_body = nil
      if peek().type == "elif"
        # Desugar: elif becomes nested if in else branch
        else_body = [parse_stmt()]
      elif peek().type == "else"
        advance()
        if peek().type == "if"
          let err_tok = peek()
          report(err_tok.line, err_tok.col, 2, "use 'elif' instead of 'else if'", "Gem uses 'elif' for chained conditions")
        end
        else_body = parse_body()
      end
      # Only consume "end" for the outermost if (elif branches don't have their own end)
      if t.type == "if"
        expect("end")
      end
      return make_if(cond, then_body, else_body, line)
    end

    # while statement
    if t.type == "while"
      let line = t.line
      advance()
      let cond = parse_header_expr("while")
      if is_assign_node(cond)
        report_assign_as_value(cond, "assignment is not allowed in condition; use '==' for comparison")
      end
      loop_depth += 1
      let wbody = parse_body()
      loop_depth -= 1
      expect("end")
      return make_while(cond, wbody, line)
    end

    # for..in / for..= statement
    # Emits structural for_in / for_range nodes; compiler/lower.gem
    # rewrites them into block-of-while before codegen.
    if t.type == "for"
      let line = t.line
      advance()
      let var_name = expect("NAME").value

      if peek().type == "," and peek_at(1).type == "NAME"
        # for k, v in table ... end
        advance()  # consume ","
        let val_tok = expect("NAME")
        let val_name = val_tok.value
        if val_name == var_name and val_name != "_"
          report(val_tok.line, val_tok.col, len(val_name), "'{val_name}' is bound twice in this loop", "name the key and the value differently")
        end
        expect("in")
        let tbl_expr = parse_header_expr("for")
        loop_depth += 1
        let fbody = parse_body()
        loop_depth -= 1
        expect("end")
        return make_for_in(var_name, val_name, tbl_expr, fbody, line)
      elif peek().type == "in"
        # for x in items ... end
        advance()
        let items_expr = parse_header_expr("for")
        loop_depth += 1
        let fbody = parse_body()
        loop_depth -= 1
        expect("end")
        return make_for_in(var_name, nil, items_expr, fbody, line)
      elif peek().type == "="
        # for i = start, end ... end
        advance()
        let start_expr = parse_header_expr("for")
        expect(",")
        let end_expr = parse_header_expr("for")
        loop_depth += 1
        let fbody = parse_body()
        loop_depth -= 1
        expect("end")
        return make_for_range(var_name, start_expr, end_expr, fbody, line)
      else
        let bad = peek()
        report(bad.line, bad.col, len(bad.value), "expected 'in' or '=' after for variable", nil)
        # Sync to the matching `end` so the surrounding body resumes.
        while not at_end() and peek().type != "end"
          advance()
        end
        if peek().type == "end"
          advance()
        end
        return make_error_stmt(line, 1)
      end
    end

    # match statement
    # Each arm is a structural match_arm; compiler/lower.gem rewrites
    # the patterns into when_clauses with concrete condition/bindings,
    # and assigns the gensym match-target name.
    if t.type == "match"
      let line = t.line
      advance()
      let target = parse_expr()
      skip_nl()
      let arms = []
      while peek().type == "when"
        advance()
        push(arms, parse_when_arm())
        skip_nl()
      end
      let else_body = nil
      if peek().type == "else"
        advance()
        else_body = parse_body()
      end
      expect("end")
      # target_var (gensym name) is filled in by lower(); leave nil here
      # so the parser stays gensym-free.
      return make_match(target, arms, else_body, line, nil)
    end

    # return statement
    if t.type == "return"
      let line = t.line
      advance()
      let value = nil
      if peek().type != "NEWLINE" and peek().type != "EOF" and peek().type != "end" and peek().type != "elif" and peek().type != "else" and peek().type != "when"
        value = parse_expr()
      end
      return make_return(value, line)
    end

    # break
    if t.type == "break"
      advance()
      if loop_depth == 0
        report_loop_exit(t)
      end
      return make_break()
    end

    # continue
    if t.type == "continue"
      advance()
      if loop_depth == 0
        report_loop_exit(t)
      end
      return make_continue()
    end

    # load "path" [as name | (name, ...)]
    if t.type == "load"
      if stmt_depth > 1
        report(t.line, t.col, 4, "`load` must be at the top level", "move it out of the enclosing block or function")
      end
      let at_top = pos == top_stmt_pos
      advance()
      let path_tok = expect("STRING")
      let path = path_tok.value
      let alias_name = nil
      let selective = nil
      let selective_pos = nil
      if peek().type == "NAME" and peek().value == "as"
        advance()
        let alias_tok = expect("NAME")
        alias_name = alias_tok.value
        if at_top
          note_top_name(alias_tok, "load")
        end
      elif peek().type == "("
        advance()
        # selective_pos[i]: where selective[i] is written, for errors
        # about a name the module doesn't export.
        let nt = expect("NAME")
        selective = [nt.value]
        selective_pos = [{line: nt.line, col: nt.col}]
        if at_top
          note_top_name(nt, "load")
        end
        while peek().type == ","
          advance()
          nt = expect("NAME")
          push(selective, nt.value)
          push(selective_pos, {line: nt.line, col: nt.col})
          if at_top
            note_top_name(nt, "load")
          end
        end
        expect(")")
      elif at_top and path_tok.synthetic != true
        # The namespace binding is named after the file's base name.
        let start = 0
        for i = 0, len(path)
          if ord(path, i) == 47
            start = i + 1
          end
        end
        let base = substr(path, start, len(path) - start)
        if len(base) > 4 and substr(base, len(base) - 4, 4) == ".gem"
          base = substr(base, 0, len(base) - 4)
        end
        note_top_name({type: "NAME", value: base, line: path_tok.line, col: path_tok.col}, "load", len(path) + 2)
      end
      return {tag: "load", path: path, alias: alias_name, selective: selective, selective_pos: selective_pos, line: t.line, col: t.col}
    end

    # export name, name, ...
    if t.type == "export"
      if stmt_depth > 1
        report(t.line, t.col, 6, "`export` must be at the top level", "move it out of the enclosing block or function")
      end
      advance()
      # name_pos[i]: where names[i] is written, for errors about a name
      # the module doesn't define.
      let nt = expect("NAME")
      let names = [nt.value]
      let name_pos = [{line: nt.line, col: nt.col}]
      while peek().type == ","
        advance()
        skip_nl()
        nt = expect("NAME")
        push(names, nt.value)
        push(name_pos, {line: nt.line, col: nt.col})
      end
      let node = make_export(names)
      node.name_pos = name_pos
      node.line = t.line
      node.col = t.col
      return node
    end

    # extern fn / extern blocking fn / extern include
    if t.type == "extern"
      if stmt_depth > 1
        report(t.line, t.col, 6, "extern declaration must be at the top level", "move it out of the enclosing block or function")
      end
      let at_top = pos == top_stmt_pos
      advance()
      let is_blocking = false
      if peek().type == "blocking"
        is_blocking = true
        advance()
      end
      if peek().type == "fn"
        advance()
        let name_tok = expect("NAME")
        let name = name_tok.value
        if at_top
          note_top_name(name_tok, "extern fn")
        end
        if has_key(C_RESERVED, name)
          report(name_tok.line, name_tok.col, len(name), "`{name}` is reserved in C and can't name an extern fn", "an extern fn is the C function of the same name")
        end
        expect("(")
        let eparams = []
        if peek().type != ")"
          let pname = expect("NAME").value
          expect(":")
          let ptype = expect_extern_type(false, is_blocking)
          push(eparams, make_extern_param(pname, ptype))
          while peek().type == ","
            advance()
            let pn2 = expect("NAME").value
            expect(":")
            let pt2 = expect_extern_type(false, is_blocking)
            push(eparams, make_extern_param(pn2, pt2))
          end
        end
        expect(")")
        let ret_type = "Nil"
        if peek().type == "->"
          advance()
          ret_type = expect_extern_type(true, is_blocking)
        end
        return make_extern_fn(name, eparams, ret_type, is_blocking, name_tok.line, name_tok.col)
      elif not is_blocking and peek().type == "NAME" and peek().value == "include"
        advance()
        let path_tok = expect("STRING")
        let inc = make_extern_include(path_tok.value)
        inc.line = path_tok.line
        inc.col = path_tok.col
        return inc
      else
        let bad = peek()
        report(bad.line, bad.col, len(bad.value), "expected 'fn' after 'extern blocking'", nil)
        return make_error_stmt(bad.line, bad.col)
      end
    end

    # receive block: receive [when ...] [after ...] end
    if t.type == "NAME" and t.value == "receive"
      let rla = 1
      while peek_at(rla).type == "NEWLINE"
        rla += 1
      end
      let rnext = peek_at(rla).type
      if rnext == "end"
        # `receive` straight followed by `end`: a receive with nothing to
        # wait for, not a bare reference to the `receive` builtin.
        report(t.line, t.col, len(t.value), "a `receive` block needs at least one `when` arm or an `after` clause", "add `after <ms>` to wait, or `when <pattern>` arms to take a message")
        advance()
        # Take the `end` as this receive's when it is indented like it;
        # one further out most likely closes an enclosing block.
        if peek_at(rla - 1).col >= t.col
          skip_nl()
          advance()
        end
        return make_error_stmt(t.line, t.col)
      end
      if rnext == "when" or rnext == "after"
        let rline = t.line
        advance()
        skip_nl()
        let rarms = []
        while peek().type == "when"
          advance()
          push(rarms, parse_when_arm())
          skip_nl()
        end
        let rafter_ms = nil
        let rafter_body = nil
        if peek().type == "after"
          advance()
          rafter_ms = parse_expr()
          # `after <ms> then <body>` mirrors one-line `when` arms; a
          # same-line body without `then` stays accepted here.
          if peek().type == "then"
            advance()
          end
          rafter_body = parse_body()
        end
        expect("end")
        # recv_var (gensym name) is filled in by lower(); structural
        # arms here use the same match_arm shape as `match` statements.
        return make_receive_match(rarms, rafter_ms, rafter_body, rline, nil)
      end
    end

    # Default: expression statement. Operator, index, call and fn nodes
    # carry their line, literals don't; give a lineless statement its first
    # token's line so codegen emits a line update for it.
    let e = parse_assign_fn()
    if type(e) == "table" and e.line == nil
      e.line = t.line
    end
    e
  end

  # Wire up forward declaration
  parse_stmt = fn()
    let t = peek()
    if not enter_nest()
      return make_error_stmt(t.line, t.col)
    end
    stmt_depth += 1
    let s = parse_stmt_fn()
    stmt_depth -= 1
    nest -= 1
    s
  end

  # ── Top-level parse ──

  let parse = fn()
    let stmts = []
    skip_nl()
    while not at_end()
      let _lp = pos
      top_stmt_pos = pos
      push(stmts, parse_stmt())
      skip_nl()
      # Top-level watchdog: if parse_stmt didn't advance, force one token
      # forward so a single bad token can't spin the parser forever.
      force_progress(_lp)
    end
    make_program(stmts)
  end

  {parse: parse}
end

export parse_source, collect_pattern_names
