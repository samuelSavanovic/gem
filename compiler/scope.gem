# Scope passes codegen runs on the post-lower AST before any name-keyed
# analysis: shadowing-let renaming and strict block scope
# (`scope_shadowing_lets`), module namespace resolution
# (`collect_module_namespaces`), and the let-name collectors codegen uses
# to tell module slots from locals.

load "./cgutil" (set_add, set_contains, is_node)

# The scope entry of a param whose default is being walked when the param
# isn't bound yet: the default's own param and the ones after it.
let PENDING_PARAM = "\0pending param"


fn collect_block_lets(stmt, result)
  if is_node(stmt, "block")
    for j = 0, len(stmt.stmts)
      if is_node(stmt.stmts[j], "let")
        set_add(result, stmt.stmts[j].name)
      end
    end
  end
end

fn collect_top_let_names(stmts, result)
  for i = 0, len(stmts)
    let s = stmts[i]
    if is_node(s, "let")
      set_add(result, s.name)
    end
    collect_block_lets(s, result)
  end
end

# ─── Shadowing lets ──────────────────────────────────────────────
#
# A `let` always makes a new variable. When its name is already visible
# (a parameter, an earlier `let` in this or an enclosing block, a captured
# local, a module-level binding, a named or extern fn, a builtin) the new
# variable shadows the old one: its initializer still reads the old one,
# closures created before it keep the old one, and a shadow made in a
# nested block ends with that block. Codegen, liveness, capture and boxing analysis are all keyed
# by name, and C does not allow `GemVal gem_v_n = gem_v_n - 1` (a
# redefinition in the same C block; in a nested block the initializer reads
# the new, uninitialized variable). So this pass alpha-renames every
# shadowing let (and the references and assignments it scopes) to a fresh
# `_sh<N>_<name>`. After it no let reuses a name visible at that point, and
# every later pass sees distinct variables. A parameter named like a named
# or extern fn is renamed the same way (`shadow_param_name`).
#
# The one exception is a `let` in the module's own statement list (or
# directly in a top-level `block`, the shape of a lowered `for` header, a
# destructuring `let`, or a `let` / assignment whose value is an `if`,
# `match` or `receive`): that is a module-level binding, a per-process slot
# keyed by name (`top_level_vars`), which named fns and closures read live.
# A second module-level `let` of a name rebinds that same slot. A `let`
# nested in a top-level `if` / `while` / `for` body / `match` or `receive`
# arm is block-scoped, like a `let` in a fn body, and is renamed when it
# reuses a module-level name, so it never writes the slot and a closure
# created in the block captures the block's binding.
#
# Scoping is strict: a `let` (or a `for` variable or pattern binding) is
# visible from its declaration to the end of its block and nowhere else.
# The pass also reports every use (read or assignment) of a name after the
# block that declared it ended, or before its `let` (outside closures),
# unless an outer binding of the name is visible there
# (`shadow_check_use`). Without the check such a use would
# reach C as an undeclared or stale `gem_v_<name>` (codegen's local set
# is fn-wide).
#
# Runs on the post-lower AST, before any analysis keyed on names (capture,
# liveness, process-tail tagging).
#
# `env` maps every name visible in the current scope (params, lets) to the
# name it compiles to (itself, or its fresh `_sh<N>_` name). `mode` is
# "module" (module-scope statement list: lets are slots), "block" (nested
# top-level scope) or "fn" (inside a fn or closure body). Module-level
# bindings and named fns count as visible everywhere outside module scope
# (`ctx.globals`, `ctx.fns`), wherever they are declared; extern fns and
# builtins everywhere. `ctx.ended` maps a name some ended block declared to
# its declaration site, plus the `if` / `match` / `receive` whose branch the
# block was (`block_kw`, nil for any other block); reset per named fn.

fn copy_scope_env(env)
  let r = {}
  for k, v in env
    r[k] = v
  end
  r
end

let shadow_node = nil
let shadow_stmt = nil
let shadow_stmts = nil
let shadow_children = nil

# Where a `let` is declared, for the out-of-scope hint: {line, file}.
# Pattern bindings come from lowering without a line of their own (nil).
# The file matters because one scope walk covers the top-level code of
# every loaded module.
fn shadow_decl_site(let_node)
  let line = let_node.line
  if line == 0
    line = nil
  end
  {line: line, file: let_node.file}
end

fn shadow_bind(let_node, env, mode, ctx)
  let name = let_node.name
  if name == nil
    return nil
  end
  if mode != "module" and (has_key(env, name) or set_contains(ctx.globals, name) or set_contains(ctx.fns, name) or set_contains(ctx.externs, name) or has_key(ctx.builtins, name))
    ctx.n = ctx.n + 1
    let fresh = "_sh{ctx.n}_{name}"
    let_node.name = fresh
    env[name] = fresh
  else
    env[name] = name
  end
  ctx.lines[env[name]] = shadow_decl_site(let_node)
end

# A block whose scope was `inner` ends; `outer` is the enclosing scope.
# Every name it declared (or re-declared as a shadow) goes out of scope:
# remember where it was declared, and `block_kw` (the keyword of the
# `if` / `match` / `receive` the block is a branch of, or nil), for the
# error at a later use.
fn shadow_end_scope(inner, outer, ctx, block_kw = nil)
  for k, v in inner
    if not has_key(outer, k) or outer[k] != v
      let d = ctx.lines[v]
      ctx.ended[k] = if d != nil then {line: d.line, file: d.file, block_kw: block_kw} end
    end
  end
end

# A use (read or assignment) of `name` where no binding of it is visible.
# A name a block declared is visible only to the end of that block, so a
# use after it is an error. Names that never were declared are left to
# codegen's undeclared-identifier check (same message, deduplicated by
# the sink).
#
# The same holds for a use before the declaration when it is not inside a
# block of the declaration's scope, e.g. a `while` condition reading a
# `let` of the loop body (`ctx.later`: every let of the body being walked,
# the current named fn, closure or top-level code, outside nested
# closures). A closure's use of a let of an enclosing body (`ctx.outer_later`:
# a closure calling itself through the let it initializes, or reading a let
# made after it) is reported too, as "later_closure": the closure's env is
# built when it is created, before the let exists.
fn shadow_check_use(node, name, env, ctx)
  if has_key(env, name)
    if env[name] == PENDING_PARAM
      ctx.report(node, name, "param_later", nil)
    end
    return nil
  end
  if set_contains(ctx.globals, name) or set_contains(ctx.fns, name) or set_contains(ctx.externs, name) or has_key(ctx.builtins, name)
    return nil
  end
  if has_key(ctx.ended, name)
    ctx.report(node, name, "ended", ctx.ended[name])
  elif has_key(ctx.later, name)
    ctx.report(node, name, "later", ctx.later[name])
  elif has_key(ctx.outer_later, name)
    ctx.report(node, name, "later_closure", ctx.outer_later[name])
  end
end

# Every name a `let` (incl. `for` variables and pattern bindings) declares
# in `node`, outside nested fns and closures, with its first line (nil
# when unknown).
let shadow_collect_lets = nil
shadow_collect_lets = fn(node, out)
  if node == nil or type(node) != "table"
    return nil
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    return nil
  end
  if node.tag == "let" and node.name != nil and not has_key(out, node.name)
    out[node.name] = shadow_decl_site(node)
  end
  for k, v in node
    if k != "tag" and type(v) == "table"
      shadow_collect_lets(v, out)
    end
  end
end

# A named fn (or the top-level code): its own scope-tracking state.
fn shadow_named_fn(node, ctx)
  let saved = {ended: ctx.ended, later: ctx.later, outer_later: ctx.outer_later, depth: ctx.closure_depth}
  ctx.ended = {}
  ctx.later = {}
  ctx.outer_later = {}
  shadow_collect_lets(node.body, ctx.later)
  ctx.closure_depth = 0
  shadow_fn(node, {}, ctx)
  ctx.ended = saved.ended
  ctx.later = saved.later
  ctx.outer_later = saved.outer_later
  ctx.closure_depth = saved.depth
end

fn shadow_child_mode(mode)
  if mode == "module"
    return "block"
  end
  mode
end

# A param named like a named or extern fn: codegen resolves such a name
# to the fn wherever it is not a local of the fn being compiled (a closure
# capturing the param, a `do` block), so the param gets a fresh name.
fn shadow_param_name(p, ctx)
  if set_contains(ctx.fns, p) or set_contains(ctx.externs, p)
    ctx.n = ctx.n + 1
    return "_sh{ctx.n}_{p}"
  end
  p
end

# A fn or closure: its params are new C params, visible in the body
# (hiding any outer binding of the same name). A param keeps its name,
# except one named like a named or extern fn (`shadow_param_name`). A
# param's default sees only the params before it; naming its own param or
# a later one is reported (in C that param's local is not yet set, or not
# yet declared).
fn shadow_fn(node, env, ctx)
  let inner = copy_scope_env(env)
  let originals = []
  if node.params != nil
    originals = node.params
    let params = []
    for p in node.params
      let c = shadow_param_name(p, ctx)
      inner[p] = c
      push(params, c)
    end
    node.params = params
  end
  let rest_original = node.rest_param
  if node.rest_param != nil
    let c = shadow_param_name(node.rest_param, ctx)
    inner[node.rest_param] = c
    node.rest_param = c
  end
  if node.defaults != nil
    for i = 0, len(node.defaults)
      let d = node.defaults[i]
      if d != nil
        let at = copy_scope_env(inner)
        for j = i, len(originals)
          at[originals[j]] = PENDING_PARAM
        end
        if rest_original != nil
          at[rest_original] = PENDING_PARAM
        end
        shadow_node(d, at, "fn", ctx)
      end
    end
  end
  shadow_stmts(node.body, inner, "fn", ctx)
end

# `block_kw`: the keyword of the `if` / `match` / `receive` the list is a
# branch of, or nil.
shadow_stmts = fn(stmts, env, mode, ctx, block_kw = nil)
  if stmts == nil
    return nil
  end
  let scope = copy_scope_env(env)
  for s in stmts
    shadow_stmt(s, scope, mode, ctx)
  end
  shadow_end_scope(scope, env, ctx, block_kw)
end

# A statement in a list whose scope is `env` (mutated: lets bind into it).
# `block` is transparent: its lets belong to the enclosing list's scope.
shadow_stmt = fn(s, env, mode, ctx)
  if is_node(s, "let")
    shadow_node(s.value, env, mode, ctx)
    shadow_bind(s, env, mode, ctx)
  elif is_node(s, "block")
    for c in s.stmts
      shadow_stmt(c, env, mode, ctx)
    end
  else
    shadow_node(s, env, mode, ctx)
  end
end

# Arm bindings (`when` / `receive` patterns) are lets scoped to the arm.
# `block_kw` is "match" or "receive".
fn shadow_arm(cond, bindings, body, env, mode, ctx, block_kw)
  let arm = copy_scope_env(env)
  let cm = shadow_child_mode(mode)
  shadow_node(cond, arm, mode, ctx)
  if bindings != nil
    for b in bindings
      if is_node(b, "let")
        shadow_node(b.value, arm, mode, ctx)
        shadow_bind(b, arm, cm, ctx)
      end
    end
  end
  shadow_stmts(body, arm, cm, ctx, block_kw)
  shadow_end_scope(arm, env, ctx, block_kw)
end

shadow_node = fn(node, env, mode, ctx)
  if node == nil or type(node) != "table" or node.tag == nil
    return nil
  end
  let tag = node.tag
  let cm = shadow_child_mode(mode)
  if tag == "var"
    shadow_check_use(node, node.name, env, ctx)
    if has_key(env, node.name) and env[node.name] != PENDING_PARAM
      node.name = env[node.name]
    end
  elif tag == "assign"
    shadow_node(node.value, env, mode, ctx)
    shadow_check_use(node, node.name, env, ctx)
    if has_key(env, node.name) and env[node.name] != PENDING_PARAM
      node.name = env[node.name]
    end
  elif tag == "let" or tag == "block"
    # Only reachable as a statement; route through the list walker.
    shadow_stmt(node, env, mode, ctx)
  elif tag == "fn_def"
    # Named fns are module-level and never see block locals.
    shadow_named_fn(node, ctx)
  elif tag == "anon_fn"
    # The closure body's own lets are its `later`; the enclosing bodies'
    # lets become `outer_later`.
    let saved_later = ctx.later
    let saved_outer = ctx.outer_later
    let outer = copy_scope_env(saved_outer)
    for k, v in saved_later
      outer[k] = v
    end
    ctx.outer_later = outer
    ctx.later = {}
    shadow_collect_lets(node.body, ctx.later)
    ctx.closure_depth = ctx.closure_depth + 1
    shadow_fn(node, env, ctx)
    ctx.closure_depth = ctx.closure_depth - 1
    ctx.later = saved_later
    ctx.outer_later = saved_outer
  elif tag == "if"
    shadow_node(node.cond, env, mode, ctx)
    shadow_stmts(node.then, env, cm, ctx, "if")
    if node.elifs != nil
      for ei in node.elifs
        shadow_node(ei.cond, env, mode, ctx)
        shadow_stmts(ei.body, env, cm, ctx, "if")
      end
    end
    shadow_stmts(node.else, env, cm, ctx, "if")
  elif tag == "while"
    shadow_node(node.cond, env, mode, ctx)
    shadow_stmts(node.body, env, cm, ctx)
  elif tag == "match"
    shadow_node(node.target, env, mode, ctx)
    if node.whens != nil
      for w in node.whens
        shadow_arm(w.value, w.bindings, w.body, env, mode, ctx, "match")
      end
    end
    shadow_stmts(node.else, env, cm, ctx, "match")
  elif tag == "receive_match"
    if node.arms != nil
      for a in node.arms
        let cond = nil
        let bindings = nil
        if a.pattern != nil
          cond = a.pattern.condition
          bindings = a.pattern.bindings
        end
        shadow_arm(cond, bindings, a.body, env, mode, ctx, "receive")
      end
    end
    shadow_node(node.after_ms, env, mode, ctx)
    shadow_stmts(node.after_body, env, cm, ctx, "receive")
  else
    for k, v in node
      if k != "tag" and type(v) == "table"
        shadow_children(v, env, mode, ctx)
      end
    end
  end
  nil
end

# Expression children: a node, or a tagless container (arg list, table
# entries `{key, value}`) holding nodes.
shadow_children = fn(v, env, mode, ctx)
  if v.tag != nil
    shadow_node(v, env, mode, ctx)
    return nil
  end
  for _, c in v
    if type(c) == "table"
      shadow_children(c, env, mode, ctx)
    end
  end
end

# `builtins` and `externs` are names that resolve without a binding;
# `report(node, name, kind, decl)` reports a use of a name whose
# declaration is not visible there: kind "ended" (its block ended), "later"
# (its `let` comes after the use, in the same block or one that does not
# contain the use), "later_closure" (the same, from inside a closure) or
# "param_later" (a parameter default reading a later parameter). `decl` is
# the declaration's {line, file}, and for "ended" also `block_kw`; it is
# nil for "param_later".
fn scope_shadowing_lets(fn_defs, top_stmts, builtins, externs, report)
  let globals = {}
  collect_top_let_names(top_stmts, globals)
  let fns = {}
  for fd in fn_defs
    set_add(fns, fd.name)
  end
  let ctx = {globals: globals, fns: fns, builtins: builtins, n: 0,
             externs: {}, lines: {}, ended: {}, later: {}, outer_later: {}, closure_depth: 0,
             report: report}
  for e in externs
    set_add(ctx.externs, e)
  end
  for s in top_stmts
    shadow_collect_lets(s, ctx.later)
  end
  let env = {}
  for s in top_stmts
    shadow_stmt(s, env, "module", ctx)
  end
  for fd in fn_defs
    shadow_named_fn(fd, ctx)
  end
end

# Whole-module load bindings (`let m = <frozen namespace table>`, from
# resolve_loads in main.gem) whose name is never rebound or assigned:
# out[m] = {export: "_mod_<mod>_<export>"}. Codegen compiles `m.export`
# straight to that binding, so it is the module's own value in the
# running process.
# `assigned`: names assigned (`name = …`) anywhere in the program.
fn collect_module_namespaces(top_stmts, assigned, out)
  let rebound = assigned
  for s in top_stmts
    if is_node(s, "let")
      if is_node(s.value, "table") and s.value.frozen == true
        let fields = {}
        for e in s.value.entries
          if type(e.key) == "string" and is_node(e.value, "var")
            fields[e.key] = e.value.name
          end
        end
        let prev = out[s.name]
        if prev != nil
          # The same module loaded again under the same name is fine; a
          # different one is a rebinding.
          let same = len(keys(prev)) == len(keys(fields))
          for k, v in fields
            if prev[k] != v
              same = false
            end
          end
          if not same
            set_add(rebound, s.name)
          end
        end
        out[s.name] = fields
      else
        set_add(rebound, s.name)
      end
    end
  end
  # A let directly in a top-level block (a lowered `for` header, a
  # destructuring let, or a let / assignment whose value is an `if`,
  # `match` or `receive`) also writes a module slot.
  for s in top_stmts
    if is_node(s, "block")
      for b in s.stmts
        if is_node(b, "let")
          set_add(rebound, b.name)
        end
      end
    end
  end
  for name, _ in rebound
    delete(out, name)
  end
end

# Collects all let-bound names anywhere in this fn body (descending through
# control flow), but not into nested anon_fn or fn_def. Used by compile_fn
# to over-approximate the set of locally-shadowed names — anything in here
# must not be confused with a top-level boxed global of the same name.
let collect_shadow_lets_in_node = nil
let collect_shadow_lets_in_stmts = nil

collect_shadow_lets_in_stmts = fn(stmts, result)
  if stmts == nil
    return nil
  end
  for i = 0, len(stmts)
    collect_shadow_lets_in_node(stmts[i], result)
  end
end

collect_shadow_lets_in_node = fn(node, result)
  if node == nil
    return nil
  end
  if type(node) != "table"
    return nil
  end
  if node.tag == nil
    return nil
  end
  if node.tag == "anon_fn" or node.tag == "fn_def"
    return nil
  end
  if node.tag == "let"
    set_add(result, node.name)
    return nil
  end
  if node.tag == "block"
    collect_shadow_lets_in_stmts(node.stmts, result)
    return nil
  end
  if node.tag == "if"
    collect_shadow_lets_in_stmts(node.then, result)
    if node.elifs != nil
      for ei in node.elifs
        collect_shadow_lets_in_stmts(ei.body, result)
      end
    end
    collect_shadow_lets_in_stmts(node.else, result)
    return nil
  end
  if node.tag == "while"
    collect_shadow_lets_in_stmts(node.body, result)
    return nil
  end
  if node.tag == "for" or node.tag == "for_kv" or node.tag == "for_range"
    if node.var != nil
      set_add(result, node.var)
    end
    if node.kvar != nil
      set_add(result, node.kvar)
    end
    if node.vvar != nil
      set_add(result, node.vvar)
    end
    if node.name != nil and (node.tag == "for" or node.tag == "for_range")
      set_add(result, node.name)
    end
    collect_shadow_lets_in_stmts(node.body, result)
    return nil
  end
  if node.tag == "match"
    if node.target_var != nil
      set_add(result, node.target_var)
    end
    if node.whens != nil
      for w in node.whens
        if w.bindings != nil
          for b in w.bindings
            if type(b) == "table" and b.name != nil and (b.tag == "let" or b.tag == "var")
              set_add(result, b.name)
            end
          end
        end
        collect_shadow_lets_in_stmts(w.body, result)
      end
    end
    collect_shadow_lets_in_stmts(node.else, result)
    return nil
  end
  if node.tag == "receive_match"
    if node.recv_var != nil
      set_add(result, node.recv_var)
    end
    if node.arms != nil
      for a in node.arms
        if a.pattern != nil and a.pattern.bindings != nil
          for b in a.pattern.bindings
            if type(b) == "table" and b.name != nil and (b.tag == "let" or b.tag == "var")
              set_add(result, b.name)
            end
          end
        end
        collect_shadow_lets_in_stmts(a.body, result)
      end
    end
    if node.after_body != nil
      collect_shadow_lets_in_stmts(node.after_body, result)
    end
    return nil
  end
  nil
end

let collect_shadow_lets_in_fn = nil
collect_shadow_lets_in_fn = fn(stmts, result)
  collect_shadow_lets_in_stmts(stmts, result)
end

export collect_block_lets, collect_top_let_names, scope_shadowing_lets, collect_module_namespaces, collect_shadow_lets_in_fn
