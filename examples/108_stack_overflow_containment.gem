# a stack overflow in a spawned process is an ordinary failure: it dies with "stack overflow in <fn>",
# monitors and links see that, and every other process keeps running

extern include "support/native_recursion.h"
extern fn gem_example_native_recurse(n: Int) -> Int

let main = self()

fn depth(n)
  if n == 0 then return 0 end
  1 + depth(n - 1)
end

fn down_reason(pid)
  receive
  when {tag: "DOWN", pid: ^pid, reason: r}
    r
  end
end

let p1 = spawn do
  depth(100000000)
end
monitor(p1)
print("test1: {down_reason(p1)}")

let workers = []
for i = 0, 3
  push(workers, spawn do
    let m = receive()
    send(main, "worker {i} got {m}")
  end)
end
let p2 = spawn do
  depth(100000000)
end
monitor(p2)
print("test2: {down_reason(p2)}")
for w in workers
  send(w, "ping")
end
let replies = []
for i = 0, 3
  push(replies, receive())
end
print("test2: {sort(replies)}")

process_flag("trap_exit", true)
let p3 = spawn_link() do
  depth(100000000)
end
receive
when {tag: "EXIT", pid: ^p3, reason: r}
  print("test3: EXIT {r}")
end
process_flag("trap_exit", false)

let p4 = spawn do
  let inner = spawn_link() do
    depth(100000000)
  end
  receive()
end
monitor(p4)
print("test3: linked {down_reason(p4)}")

let reasons = {}
for i = 0, 20
  let p = spawn do
    depth(100000000)
  end
  monitor(p)
  let r = down_reason(p)
  reasons[r] = (reasons[r] or 0) + 1
end
print("test4: {reasons}")

# a recursive C helper hits the guard page; the reason names the Gem fn that made the call
let p5 = spawn do
  gem_example_native_recurse(100000000)
end
monitor(p5)
print("test5: {down_reason(p5)}")
let p6 = spawn do
  let shallow = gem_example_native_recurse(10)
  send(main, shallow)
  gem_example_native_recurse(100000000)
end
monitor(p6)
print("test5: shallow call returned {receive()}")
print("test5: again {down_reason(p6)}")

let p7 = spawn do
  send(main, depth(10000))
end
print("test6: {receive()}")
