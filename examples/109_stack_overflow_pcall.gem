# a stack overflow in Gem code is an ordinary error pcall catches. Spawned processes get main's
# stack depth, so deep-but-finite recursion works in either.
load "std/json"

let main = self()

fn depth(n)
  if n == 0 then return 0 end
  1 + depth(n - 1)
end

fn is_even(n)
  if n == 0 then return true end
  not is_odd(n - 1)
end
fn is_odd(n)
  if n == 0 then return false end
  not is_even(n - 1)
end

spawn do
  send(main, depth(20000))
end
print("test1: spawned depth {receive()}")
print("test1: main depth {depth(20000)}")

# the process carries on, and can overflow and recover again
spawn do
  let r = pcall depth(100000000)
  send(main, "test2: ok={r.ok} error={r.error}")
  send(main, "test2: still running, depth {depth(1000)}")
  let r2 = pcall depth(100000000)
  send(main, "test2: again ok={r2.ok} error={r2.error}")
end
print(receive())
print(receive())
print(receive())

spawn do
  let r = pcall is_even(100000001)
  # which of the two runs out of stack depends on frame sizes, so on how the program was built
  let in_pair = r.error == "stack overflow in is_even" or r.error == "stack overflow in is_odd"
  send(main, "test3: mutual recursion overflowed {in_pair}")
end
print(receive())
let walker = {count: 0}
walker.walk = fn(n)
  walker.count = walker.count + 1
  walker.walk(n + 1) + 1
end
let r3 = pcall walker.walk(0)
print("test3: closure ok={r3.ok} error={r3.error} deep={walker.count > 10000}")

let r4 = pcall depth(100000000)
print("test4: main ok={r4.ok} error={r4.error}")

fn nested(d)
  build_string do |add|
    for i = 0, d
      add("[")
    end
    for i = 0, d
      add("]")
    end
  end
end
for d in [63, 1000, 1001]
  let pid = spawn do
    let r = pcall json.parse(nested(d))
    send(main, "test5: depth {d} ok={r.ok} error={r.error}")
  end
  print(receive())
end

fn handle(req)
  let r = pcall depth(req)
  if r.ok then
    "200 {r.value}"
  else
    "500 {r.error}"
  end
end
let server = spawn do
  while true
    let m = receive()
    send(m.from, handle(m.n))
  end
end
for n in [10, 100000000, 20, 100000000, 30]
  send(server, {from: main, n: n})
  print("test6: {receive()}")
end
