# self-TCO for fns whose params closures capture, read-only (plain locals) or mutated (boxes).
# Each closure keeps its own iteration's binding, as with a real call.

fn sum_via_closure(n, acc)
  let f = fn() n end
  if n == 0 then return acc end
  sum_via_closure(n - 1, acc + f())
end
print(sum_via_closure(100000, 0))

fn collect_readers(n, acc)
  push(acc, fn() n end)
  if n == 0 then return acc end
  collect_readers(n - 1, acc)
end
let readers = collect_readers(3, [])
let seen = []
for r in readers
  push(seen, r())
end
print(seen)

# captured and mutated: every iteration gets its own box
fn collect_counters(n, fns)
  let inc = fn() n = n + 100 end
  let get = fn() n end
  push(fns, {inc: inc, get: get})
  if n == 0 then return fns end
  collect_counters(n - 1, fns)
end
let counters = collect_counters(3, [])
for c in counters
  c.inc()
end
counters[0].inc()
let vals = []
for c in counters
  push(vals, c.get())
end
print(vals)

# a mutation in the body is visible to that iteration's tail-call args
fn bump_loop(n, steps)
  let bump = fn() n = n - 1 end
  bump()
  if n <= 0 then return steps end
  bump_loop(n, steps + 1)
end
print(bump_loop(10, 0))

# one read-only and one mutated capture, deep enough to reset at the back-edge
fn deep(n, total, last)
  let get_n = fn() n end
  let add = fn(x) total = total + x end
  add(get_n() % 7)
  let s = "s" + to_string(n)
  if n == 0 then return [total, last()] end
  if n % 250000 == 0
    last = get_n
  end
  deep(n - 1, total + len(s) - len(s), last)
end
print(deep(1000000, 0, nil))

let me = self()
spawn do
  let parent = me
  send(parent, deep(1000000, 0, nil))
end
print(receive())

# zero-arg tail call: the params take their defaults
fn zero(a = nil, b = nil)
  let f = fn() [a, b] end
  if a == nil then return f() end
  zero()
end
print(zero(1, 2))
