# module bindings are per-process: a child starts with a copy of its parent's and its writes stay put
load "std/log"
load "std/json"
load "std/string"

let counter = 0
let names = []
let config = {mode: "main"}
let shared_row = {id: 1}
let pair = [shared_row, shared_row]

fn bump(name)
  counter += 1
  push(names, name)
end

# closures read a module binding's live value, even when some other named fn changes it
let get_counter = fn() counter end
let get_mode = fn() config.mode end
bump("a")
print("main after bump:", counter, get_counter(), names)

# the child starts from a copy of main's state at spawn time
let me = self()
spawn do
  bump("b")
  config.mode = "child"
  config = {mode: "replaced"}
  send(me, {counter: counter, closure: get_counter(), names: names, mode: get_mode()})
end
print("child saw:", receive())

print("main still:", counter, get_counter(), names, config.mode, get_mode())

# aliasing within a process survives the copy
spawn do
  pair[0].id = 99
  send(me, {same: pair[0] == pair[1], second: pair[1].id, top: shared_row.id})
end
print("aliasing:", receive())

# main's writes before a spawn reach that child, later ones don't
counter = 10
let late = spawn do
  receive
  when "go"
    send(me, {counter: counter})
  end
end
counter = 20
send(late, "go")
print("spawned at 10, main moved to 20:", receive(), counter)

# std modules work in children, and the log level set in main before the spawn applies
log.set_level("error")
spawn do
  log.info("this info line must not appear")
  let doc = json.encode({ok: true, n: 3})
  send(me, {doc: doc, parts: string.split("a,b,c", ",")})
end
print("std in child:", receive())
log.set_level("info")

# each child bumps its own counter
let results = []
for i = 0, 3
  spawn do
    bump("c{i}")
    bump("d{i}")
    send(me, counter)
  end
  push(results, receive())
end
print("children:", results, "main:", counter, len(names))

# a module binding read before a same-named local is declared still reads the module slot
let level = "module"
fn shadow_later()
  let before = level
  let level = "local"
  [before, level]
end
print("shadow:", shadow_later(), level)
