# Long-running loops stay at bounded memory wherever they are called from,
# and reset work stays proportional to allocation (no quadratic cliffs once
# live data passes 1 MB). Each section allocates far more than the memory
# bound checked at the end.

# Peak RSS of this process (Linux: VmHWM of /proc/<pid>/status; the shell
# that `exec` starts is our child). Elsewhere the check is skipped.
fn peak_ok(limit_kb)
  let cmd = "f=/proc/$PPID/status; [ ! -r $f ] || [ $(awk '/VmHWM/\{print $2}' $f) -lt {limit_kb} ]"
  exec(cmd) == 0
end

fn row_for(i)
  {name: "row-{i}", tags: ["a{i}", "b{i}"], n: i}
end

# A server-shaped loop: `while true` that allocates per iteration.
fn serve(limit)
  let total = 0
  while true
    let row = row_for(total)
    total += len(row.tags)
    if total >= limit then return total end
  end
end

# The same loop as self-recursion with no arguments.
let zero_count = 0
fn serve0()
  zero_count += 1
  let row = row_for(zero_count)
  if zero_count == 400000 then return row.name end
  serve0()
end

let me = self()

# 1. Called in tail position from a spawn body.
spawn do
  send(me, serve(800000))
end
print("tail spawn", receive())

# 2. Called from a non-tail position, with work after it.
spawn do
  let r = serve(800000)
  send(me, "non-tail spawn {r} cleanup")
end
print(receive())

# 3. Three frames deep, inside pcall.
fn wrap(limit)
  let r = serve(limit)
  [r]
end
fn wrap2(limit)
  let r = wrap(limit)
  r
end
let p = pcall(fn() wrap2(800000) end)
print("pcall depth 3", p.ok, p.value)

# 4. Zero-arg self tail call.
print("zero-arg", serve0())

# 5. A receive loop with no arguments fed 100k messages.
fn sink()
  let msg = receive()
  if msg == "stop" then return 1 end
  let s = "abcdefghijklmnopqrstuvwxyz" + to_string(msg)
  let t = [s, s, s, s]
  sink()
end
let p5 = spawn do
  sink()
  send(me, "sink done")
end
for i = 0, 100000
  send(p5, i)
  if i % 1000 == 0 then sleep(0) end
end
send(p5, "stop")
print(receive())

# 6. Top-level loops with > 1 MB live data: near-linear time.
let t0 = time_ms()
let rows = []
for i = 0, 30000
  push(rows, {id: i, name: "user{i}", email: "u{i}@example.com"})
end
let s = ""
for i = 0, 300000
  s = s + "0123456789"
end
let b = buf_new()
for i = 0, 300000
  buf_push(b, "0123456789")
end
let elapsed = time_ms() - t0
print("top-level builds", len(rows), len(s), len(to_string(b)), elapsed < 5000)

# 7. A gen_server-style loop holding a 5000-entry state.
fn store(state, served)
  receive
  when {tag: "put", i: i, from: from}
    state["k{i % 5000}"] = {name: "upd-{i}", n: i}
    send(from, len(state["k{i % 5000}"].name))
    store(state, served + 1)
  when {tag: "stop", from: from}
    send(from, served)
  end
end
let srv = spawn do
  let st = {}
  for i = 0, 5000
    st["k{i}"] = {name: "item-{i}", n: i}
  end
  store(st, 0)
end
let t1 = time_ms()
let acc = 0
for i = 0, 2000
  send(srv, {tag: "put", i: i, from: me})
  acc += receive()
end
send(srv, {tag: "stop", from: me})
print("store", acc, receive(), time_ms() - t1 < 5000)

# 8. A backlog of large messages drained by a resetting loop.
let body = "x"
while len(body) < 100000
  body = body + body
end
let drain = spawn do
  let n = 0
  let bytes = 0
  while n < 100
    receive
    when {body: m}
      bytes += len(m)
      n += 1
    end
  end
  send(me, bytes)
end
for i = 0, 100
  send(drain, {body: body})
end
print("backlog drained", receive())

print("peak memory bounded", peak_ok(98304))
