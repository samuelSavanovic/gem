let fruits = ["apple", "banana", "cherry"]
for fruit in fruits
  print(fruit)
end

for i = 0, 5
  print(i)
end

for i = 0, 3
  for j = 0, 3
    if i == j
      print(i * 10 + j)
    end
  end
end

let nums = [1, 2, 3, 4, 5]
for n in nums
  if n == 3
    break
  end
  print(n)
end

for n in nums
  if n == 3
    continue
  end
  print(n)
end

for i = 0, 6
  if i == 3
    continue
  end
  print(i)
end

let empty = []
for x in empty
  print("should not print")
end
print("after empty")

for i = 5, 3
  print("should not print")
end
print("after empty range")

let letters = ["a", "b", "c", "d"]
let idx = 0
for letter in letters
  print(to_string(idx) + ":" + letter)
  idx += 1
end

let matrix = [[1, 2], [3, 4], [5, 6]]
for row in matrix
  for val in row
    if val == 3
      continue
    end
    print(val)
  end
end
