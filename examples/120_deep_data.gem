# a 400k-deep list survives everything the runtime copies or frees: resets with it live, `send`,
# a send_after timer's malloc'd copy (freed on fire or cancel) and capture by a spawned closure.
#
# 400k is well past where a recursive copy (30k-100k levels) or free (~265k) would blow an 8 MB
# stack. The captured list (200k) only goes through the spawn copy.

# one level per iteration plus garbage, so the loop resets many times with the list live
fn grow(n)
  let l = nil
  let i = 0
  while i < n
    l = [i, l]
    let junk = "garbage-{i}"
    i += 1
  end
  l
end

# iterative walk: [depth, sum of the values]
fn walk(l)
  let depth = 0
  let sum = 0
  while l != nil
    depth += 1
    sum += l[0]
    l = l[1]
  end
  [depth, sum]
end

let N = 400000
let me = self()

let walker = spawn do
  while true
    receive
    when {list: l, from: from}
      send(from, {walked: walk(l)})
    when "stop"
      return nil
    end
  end
end

# main builds it (resetting with it live) and sends it
let deep = grow(N)
print("main built", walk(deep))
send(walker, {list: deep, from: me})
print("walker got", receive().walked)

# through a timer: send_after's malloc'd copy, freed on fire and on cancel
send_after(walker, {list: deep, from: me}, 0)
print("walker got via timer", receive().walked)
let timer = send_after(walker, {list: deep, from: me}, 60000)
print("timer cancelled", cancel_timer(timer))
deep = nil

# a child builds its own, keeps it live across a second resetting loop, then sends it on
spawn do
  let mine = grow(N)
  let extra = 0
  for i = 0, 300000
    let junk = {i: i, s: "x{i}"}
    extra += len(junk.s)
  end
  send(walker, {list: mine, from: me})
  send(me, {child_extra: extra})
end
let replies = []
for i = 0, 2
  receive
  when {walked: w}
    push(replies, "walked {w}")
  when {child_extra: e}
    push(replies, "child extra {e}")
  end
end
print(sort(replies))

# a spawned closure capturing a deep list
let shallower = grow(200000)
spawn do
  send(me, {captured: walk(shallower)})
end
print("captured", receive().captured)

send(walker, "stop")
