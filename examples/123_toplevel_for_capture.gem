# a loop variable, a `let` in an if/while body or a pattern binding reusing a top-level name gets its
# own binding, which closures made in the block capture (one per iteration); the module binding stays

let y = "main-y"
let a = "main-a"
load "./modules/toplevel_shadow" (shadow_report)

let x = 1
let fs = []
for x in [10, 20]
  push(fs, fn() x end)
end
print("1: {fs[0]()} {fs[1]()} x={x}")

let i = 100
let rs = []
for i = 0, 3
  push(rs, fn() i end)
end
print("2: {rs[0]()} {rs[1]()} {rs[2]()} i={i}")

let k = "K"
let v = "V"
let kvs = []
for k, v in {p: 1, q: 2}
  push(kvs, fn() "{k}={v}" end)
end
print("3: {kvs[0]()} {kvs[1]()} k={k} v={v}")

let ns = []
for x in [1, 2]
  for x in [x * 10, x * 100]
    push(ns, fn() x end)
  end
  push(ns, fn() x end)
end
print("4: {ns[0]()} {ns[1]()} {ns[2]()} {ns[3]()} {ns[4]()} {ns[5]()} x={x}")

let gs = []
for p in [1, 2]
  for q in [p * 10, p * 100]
    push(gs, fn() q end)
  end
end
print("5: {gs[0]()} {gs[1]()} {gs[2]()} {gs[3]()}")

# a let in an if body reading the outer binding (a let of the outer name there would be a compile error)
let z = 1
if true
  let z2 = z + 41
  z2 += 1
  push(fs, fn() z2 end)
end
z = 3
print("6: {fs[2]()} z={z}")

if true
  x = 5
  let x2 = 6
  x2 = 7
end
print("7: x={x}")

let w = "g"
if false
  let wa = "a"
elif true
  let wb = "b"
  push(fs, fn() wb end)
else
  let wc = "c"
end
let n = 0
while n < 2
  let wl = "loop {n}"
  n += 1
end
print("8: {fs[3]()} w={w}")

# captured and mutated loop variable: one box per iteration
let cs = []
for i = 0, 2
  push(cs, fn()
    i += 1
    i
  end)
end
let c1 = cs[0]()
let c2 = cs[0]()
let c3 = cs[1]()
print("9: {c1} {c2} {c3} i={i}")

# match and receive bindings are scoped to their arm
let name = "outer"
match {name: "inner"}
when {name: inner}
  push(fs, fn() inner end)
end
send(self(), {name: "msg"})
receive
when {name: got_name}
  push(fs, fn() got_name end)
end
print("10: {fs[4]()} {fs[5]()} name={name}")

# named fns read the module binding, not a block shadow
fn get_x() x end
for x in [99]
  print("11: get_x={get_x()} x={x}")
end

for x in [3]
  let dbl = fn(x) x * 2 end
  let eight = fn()
    let x = 8
    x
  end
  print("12: {dbl(4)} {eight()} {x}")
end

let me = self()
for x in [41, 42]
  spawn do send(me, x) end
end
let got = sort([receive(), receive()])
print("13: {got[0]} {got[1]} x={x}")

# a long-running loop whose body makes block locals next to top-level names
let msg = "global"
let total = 0
let keep = []
let m = 0
while true
  let it_msg = "iter {m}"
  if m % 2 == 0
    let doubled = m * 2
    push(keep, fn() "{it_msg}:{doubled}" end)
  end
  total += 1
  m += 1
  if m == 4 then break end
end
print("14: {keep[0]()} {keep[1]()} msg={msg} total={total}")

# a loaded module's block lets shadow its own names, not this file's x, y, z or a
print("15: {shadow_report()} x={x} y={y} z={z} a={a}")
