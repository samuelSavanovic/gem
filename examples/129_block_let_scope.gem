# a `let` is visible from its declaration to the end of its block. Using it after the block is
# a compile error (tests/broken/block_let_*.gem); these are the valid shapes around it.

fn declare_before(c)
  let x = nil
  if c then x = 2 else x = 3 end
  x
end
print(declare_before(true), declare_before(false))

# a let in every branch is visible only inside its branch
fn outer_wins(c)
  let x = 1
  if c then let x2 = 2 else let x3 = 3 end
  x
end
print(outer_wins(true), outer_wins(false))

# sibling blocks may each declare the same name; a later outer let is a new variable
fn siblings()
  let out = []
  if true then let a = 1; push(out, a) end
  if true then let a = 2; push(out, a) end
  let a = 3
  push(out, a)
  out
end
print(siblings())

# a block let named like a builtin or a named fn hides it only inside the block
fn hides_builtin()
  if true
    let len = 99
    print(len)
  end
  len([1, 2, 3])
end
print(hides_builtin())

fn hides_fn()
  if true
    let siblings = "local"
    print(siblings)
  end
  siblings()
end
print(hides_fn())

# a let in a loop branch is fresh per iteration: closures keep their own value
fn per_iteration()
  let fs = []
  for i in [1, 2, 3]
    if i % 2 == 0
      let v = i * 10
      push(fs, fn() v end)
    else
      let v = i * 100
      push(fs, fn() v end)
    end
  end
  let out = []
  for f in fs
    push(out, f())
  end
  out
end
print(per_iteration())

fn carried()
  let i = 0
  let last = nil
  while i < 3
    if i == 0 then last = "first" end
    if i == 2 then print(last) end
    i = i + 1
  end
end
carried()

fn arms(v)
  let r = nil
  match v
  when {a}
    let doubled = a * 2
    r = doubled
  else
    let doubled = -1
    r = doubled
  end
  r
end
print(arms({a: 21}), arms(5))

fn closure_in_block()
  let get = nil
  if true
    let secret = "kept"
    get = fn() secret end
  end
  get()
end
print(closure_in_block())

# top level: a let nested in a block is block-scoped; one directly in the file is module-level
let m = 7
if true
  let m8 = 8
  let only_here = m8 + 1
  print(m8, only_here)
end
print(m)

let total = 0
for k in [1, 2, 3]
  let sq = k * k
  total += sq
end
let k = "after"
print(total, k)

let {p, q} = {p: 1, q: 2}
fn read_module()
  p + q
end
print(read_module())

let me = self()
let pid = spawn do
  receive
  when {n: n}
    let doubled = n * 2
    send(me, doubled)
  end
end
send(pid, {n: 21})
print(receive())
