print("fell through")

let a = 2
let b = 3
if a == 1
  print("a1")
elif a == 2
  if b == 1
    print("b1")
  elif b == 3
    print("b3")
  else
    print("bother")
  end
else
  print("aother")
end

fn classify(n)
  if n < 0
    "negative"
  elif n == 0
    "zero"
  elif n < 10
    "small"
  else
    "big"
  end
end

print(classify(-5))
print(classify(0))
print(classify(7))
print(classify(100))
