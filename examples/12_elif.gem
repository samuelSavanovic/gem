let x = 2
if x == 1
  print("one")
elif x == 2
  print("two")
elif x == 3
  print("three")
else
  print("other")
end

let y = 99
if y == 1
  print("a")
elif y == 2
  print("b")
elif y == 3
  print("c")
else
  print("d")
end

let z = 5
