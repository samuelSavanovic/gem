# A spawned process that dies from an uncaught runtime error prints a crash
# report to stderr (like Erlang's error logger): the main process's error
# format, with a header naming the process by pid and registered name.
# Normal exits, kills, linked exit signals and errors caught by pcall stay
# silent, and monitors/links/trap_exit see the same exit reasons as before.

let main = self()

fn inner(x)
  error("boom {x}")
end

fn worker(x)
  inner(x)
end

fn depth(n)
  if n == 0 then return 0 end
  1 + depth(n - 1)
end

# ─── Test 1: error() in a nested call; a monitor sees the message ───
let p1 = spawn(fn() worker(1) end)
monitor(p1)
let d1 = receive()
print("test1: {d1.tag} {d1.reason}")

# ─── Test 2: runtime type error and nil field access ───
let p2 = spawn(fn()
  let x = nil
  print(x + 1)
end)
monitor(p2)
print("test2: {receive().reason}")
let p2b = spawn(fn()
  let t = nil
  print(t.field)
end)
monitor(p2b)
print("test2: {receive().reason}")

# ─── Test 3: a registered process is reported with its name ───
let p3 = spawn(fn()
  let m = receive()
  worker(m)
end)
register("logger", p3)
monitor(p3)
send("logger", 3)
print("test3: {receive().reason}")

# ─── Test 4: silent exits ───
let p4a = spawn(fn()
  let r = pcall worker(4)
  send(main, "caught {r.error}")
end)
print("test4: {receive()}")
let p4b = spawn(fn() receive() end)
monitor(p4b)
kill(p4b, "shutdown")
print("test4: killed {receive().reason}")
let p4c = spawn(fn() 42 end)
monitor(p4c)
print("test4: normal {receive().reason}")
let p4d = spawn(fn() kill(self(), "done") end)
monitor(p4d)
print("test4: self-kill {receive().reason}")

# ─── Test 5: links. Only the crashing process is reported, not the
# linked process it takes down; a trapping parent gets the reason ───
let p5 = spawn(fn()
  spawn_link(fn() worker(5) end)
  receive()
end)
monitor(p5)
print("test5: linked {receive().reason}")
spawn(fn()
  process_flag("trap_exit", true)
  spawn_link(fn() worker(6) end)
  let m = receive()
  send(main, "{m.tag} {m.reason}")
end)
print("test5: trapped {receive()}")

# ─── Test 6: stack overflow in a spawned process ───
let p6 = spawn(fn() depth(100000000) end)
monitor(p6)
print("test6: {receive().reason}")
print("done")
