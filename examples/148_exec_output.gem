# exec's command inherits stdout/stderr (no capture), in main and in a spawned process, and exec
# returns the exit status. Output redirected inside the command can be read back from the file.

print("main before")
print("main status", exec("echo hi from main"))
print("main status", exec("exit 3"))

let main = self()
spawn do
  print("child before")
  print("child status", exec("echo hi from child; exit 2"))
  send(main, "done")
end
receive()

let out = "/tmp/gem_148_out_{epoch_ms()}_{random(1000000)}"
exec("printf captured > {out}")
print("read back:", read_file(out))
remove_file(out)
