# A relative `extern include` path names a file next to the .gem file that
# contains it, in a loaded module too (each against its own directory).
# Headers that aren't there, such as "string.h", are left to the C
# compiler's search, so system headers still work by name.
load "./modules/extern_include_mod"

extern include "support/ei_helpers.h"
extern include "string.h"
extern fn ei_scale(x: Int) -> Int
extern fn strlen(s: String) -> Int

print("entry header:", ei_scale(4))
print("module header:", extern_include_mod.scaled(4))
print("system header:", strlen("gem"))
