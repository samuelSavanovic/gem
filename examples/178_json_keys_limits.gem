# std/json: how tables map to arrays and objects, integers past 64 bits,
# nesting limits (parse and encode), and prefixed error messages.
load "std/json"

fn show(label, r)
  if r.ok
    print("{label}: ok {r.value}")
  else
    print("{label}: error {r.error}")
  end
end

# ─── Arrays vs objects ───
print("=== keys ===")
let ids = {}
ids[42] = "x"
print(json.encode(ids))
let mixed = ["z"]
mixed.name = "n"
print(json.encode(mixed))
let rec = {name: "a"}
rec[7] = "seven"
print(json.encode(rec))
print(json.encode([10, 20, 30]))
print(json.encode([]))
print(json.encode([[], [1], {a: []}]))
# keys 0 .. n-1 in any order are still an array, written in index order
let shuffled = ["a", "b", "c"]
delete(shuffled, 0)
print(json.encode(shuffled))
shuffled[0] = "A"
print(json.encode(shuffled))
let fk = {}
fk[1.5] = "f"
show("float key", pcall json.encode(fk))
let bk = {}
bk[true] = 1
show("bool key", pcall json.encode({inner: bk}))
let sparse = {}
sparse[0] = "zero"
sparse[2] = "two"
let back = json.parse(json.encode(sparse))
print("sparse round trip: {back["0"]} {back["2"]} {has_key(back, "1")}")

# ─── Numbers ───
print("=== numbers ===")
for text in ["12345678901234567890", "-12345678901234567890", "9223372036854775807",
             "-9223372036854775808", "9223372036854775808", "1000000000000000000",
             "[1, 123456789012345678901234567890, -3]"]
  let v = json.parse(text)
  print("{text} -> {v} ({type(v)})")
end

# ─── Strings ───
print("=== strings ===")
print(json.encode("plain"))
print(json.encode(""))
print(json.encode("\"quoted\""))
print(json.encode("a\tb\nc\\d"))
print(json.encode("ctl{chr(1)}{chr(31)}{chr(0)}end"))
print(json.encode("caf{chr(195)}{chr(169)}"))
print(json.parse('"a\\u00e9b\\n\\"c\\""'))
print(json.parse('"x\\uD83D\\uDE00y"') == "x{chr(240)}{chr(159)}{chr(152)}{chr(128)}y")
let tricky = "start\"mid\\\n{chr(127)}end"
print(json.parse(json.encode(tricky)) == tricky)

# ─── Nesting limits ───
print("=== depth ===")
fn nested(open, inner, close, d)
  build_string do |add|
    for i = 0, d
      add(open)
    end
    add(inner)
    for i = 0, d
      add(close)
    end
  end
end
fn deep_array(d)
  let t = 0
  for i = 0, d
    t = [t]
  end
  t
end
show("parse 1000 arrays", pcall len(json.parse(nested("[", "", "]", 1000))))
show("parse 1001 arrays", pcall json.parse(nested("[", "", "]", 1001)))
show("parse 1000 objects", pcall len(json.parse(nested('{"a":', "1", "}", 1000))))
show("parse 1001 objects", pcall json.parse(nested('{"a":', "1", "}", 1001)))
show("parse 100000 arrays", pcall json.parse(nested("[", "", "]", 100000)))
show("encode 1000", pcall len(json.encode(deep_array(1000))))
show("encode 1001", pcall json.encode(deep_array(1001)))
let cyclic = {name: "loop"}
cyclic.self = cyclic
show("encode cyclic", pcall json.encode(cyclic))
let main = self()
spawn do
  let p = pcall json.parse(nested("[", "", "]", 1000))
  let e = pcall json.encode(deep_array(1000))
  let bad = pcall json.parse(nested("[", "", "]", 5000))
  send(main, "spawned: parse {p.ok} encode {e.ok} too deep {bad.error}")
end
print(receive())

# ─── Errors ───
print("=== errors ===")
for text in ["", "  ", "nul", "[1, 2,]", '{"a" 1}', '{"a": 1,}', "[1 2]", '"abc',
             '"bad \\x escape"', '"\\u12G4"', "01", "-", "1.", "1e", '{"a": 1} extra',
             "\"tab\there\"", "[1] [2]", '{1: 2}']
  show("parse {json.encode(text)}", pcall json.parse(text))
end
show("parse non-string", pcall json.parse(42))
show("encode fn", pcall json.encode({f: fn() 1 end}))
show("encode ref", pcall json.encode([make_ref()]))
