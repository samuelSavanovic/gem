# `s = s + x` in an append-only loop builds s in place; whatever s holds, the result is what `+` gives

fn append_all(s, xs)
  let i = 0
  while i < len(xs)
    s = s + xs[i]
    i += 1
  end
  s
end

print(append_all("pre", ["a", "b", "c"]))
print(append_all("", []))
print(append_all(10, [1, 2, 3]))

# a caller's buffer isn't a string: `+` raises and the buffer is untouched
let b = buf_new()
buf_push(b, "pre")
let r = pcall append_all(b, ["a", "b"])
print(r.ok, r.error, to_string(b))

let same = append_all(b, [])
print(type(same), to_string(same))

# a string, then a non-string: the same error as outside a loop
let r2 = pcall append_all("x", ["y", 1])
print(r2.ok, r2.error)

fn grid(n)
  let s = ""
  for i = 0, n
    s = s + "["
    for j = 0, n
      s = s + "{i}{j}"
    end
    s = s + "]"
  end
  s
end
print(grid(3))

fn rows(n)
  let s = "rows:"
  for i = 0, n
    for j = 0, 2
      s = s + " " + to_string(i * 2 + j)
    end
  end
  s
end
print(rows(3))

# a module-level variable is a string to every fn the loop calls
let LOG = ""
fn peek()
  type(LOG)
end
fn log_all(xs)
  let seen = []
  for x in xs
    LOG = LOG + x
    push(seen, peek())
  end
  seen
end
print(log_all(["a", "b"]), LOG)
