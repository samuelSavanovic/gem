let t = {x: 10, y: 20, z: 30}
let {x, y, z} = t
print("{x} {y} {z}")

let arr = [100, 200, 300]
let [a, b, c] = arr
print("{a} {b} {c}")

# RHS evaluated once
let counter = 0
let make_table = fn()
  counter += 1
  {val: counter}
end
let {val} = make_table()
print("val={val} counter={counter}")

let [p, q, r] = [1]
print("{p} {q} {r}")

let {name, age} = {name: "gem"}
print("{name} {age}")

fn test_in_fn()
  let {a, b} = {a: 1, b: 2}
  print("{a} {b}")
end
test_in_fn()

for i = 0, 3
  let [v] = [i * 10]
  print("v={v}")
end

let {} = {a: 1}
let [] = [1, 2]
print("empty ok")

let {solo} = {solo: 42}
let [only] = [99]
print("{solo} {only}")

let call_count = 0
fn make_result()
  call_count += 1
  {ok: true, value: 42}
end
let {ok, value} = make_result()
print("ok={ok} value={value} calls={call_count}")

if true
  let {inner} = {inner: "yes"}
  print("inner={inner}")
end

fn three_things()
  [10, 20, 30]
end
let [first, second, third] = three_things()
print("{first} {second} {third}")
