# `let x = ...x...` in a loop body declares a new `x` each iteration,
# computed from the outer one, which never changes. Hiding a variable of
# an enclosing block of the same fn is a compile error
# (tests/broken/let_hides_outer.gem); hiding a module-level variable from
# inside a fn is allowed, and the compiler warns when the code after the
# loop reads the outer `x` and nothing in the loop assigns it
# (tests/notes/211_shadowed_accumulator.expected).

let total = 0
let out = ""
let count = 0

fn summed()
  for x in [1, 2, 3]
    let total = total + x
  end
  print("total", total)
end
summed()

fn joined(words)
  for w in words
    if w != ""
      let out = out + w
    end
  end
  out
end
print("joined", joined(["a", "b"]))

fn counted(items)
  match items
  when [_, _]
    for i = 0, 2
      let count = count + 1
    end
  else
    nil
  end
  count
end
print("counted", counted([1, 2]))

# No warning: the loop variable, an earlier let of the body, an assignment
# in the loop, a let inside a closure, or no read after the loop.
fn quiet(lines, path)
  let n = 0
  let k = 0
  let m = 0
  let acc = ""
  let line = "outer"
  for line in lines
    let line = line + "!"
    let p = path + "/" + line
    let k2 = 1
    let k2 = k2 + 1
    m += 1
    let f = fn() let acc = acc + "y" end
    print(p, k2)
  end
  print(n, m - 1, acc, line, k)
end
quiet(["a"], "p")
