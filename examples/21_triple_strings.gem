let name = "world"
let s1 = """
  hello
  {name}
  """
print(s1)

let s2 = '''
  line one
  line two
  '''
print(s2)

# Dedent: extra indentation in content is preserved
let s3 = """
  base
    indented
  base
  """
print(s3)

let s4 = '''
  {not interpolated}
  '''
print(s4)

# Escape sequences in """
let s5 = """
  tab:\there
  quote:"fine"
  """
print(s5)

let s6 = """
  it's fine
  """
print(s6)

let s7 = '''
  say "hello"
  '''
print(s7)

let a = 3
let b = 4
let s8 = """
  sum: {a + b}
  """
print(s8)

let s9 = """
  """
print("empty: '{s9}'")

let x = "X"
let y = "Y"
let s10 = """
  {x} and {y}
  """
print(s10)
