# std/base64, std/hex, std/crypto (SHA-256, HMAC, constant-time equal), std/utf8, std/csv.
# SHA-256 digests are FIPS 180-4 vectors; the second HMAC is RFC 4231 test
# case 6, the first matches `openssl dgst -sha256 -hmac key`.
load "std/base64"
load "std/hex"
load "std/crypto"
load "std/utf8"
load "std/csv"
print(base64.encode("hello"), base64.encode(""), base64.encode("a"), base64.encode("ab"), base64.encode("abc"))
print(base64.decode("aGVsbG8="), base64.decode("aGVsbG8"), base64.decode("aGk="), base64.decode("a*b"), base64.decode("a"), base64.decode("aGk=x"), base64.decode(" aG\nk= "))
print(base64.encode_url(chr(251) + chr(255)), base64.decode("-_8") == chr(251) + chr(255))
let all = build_string do |add| for i = 0, 256 add(chr(i)) end end
print(base64.decode(base64.encode(all)) == all, hex.decode(hex.encode(all)) == all, base64.decode(base64.encode_url(all)) == all)
print(hex.encode("hi\n"), hex.decode("4A4b"), hex.decode("abc"), hex.decode("zz"))
print(crypto.sha256_hex(""), crypto.sha256_hex("abc"))
print(crypto.sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
let million = build_string do |add| for i = 0, 1000000 add("a") end end
print(crypto.sha256_hex(million))
print(crypto.hmac_sha256_hex("key", "The quick brown fox jumps over the lazy dog"))
print(crypto.hmac_sha256_hex(build_string do |add| for i = 0, 131 add(chr(170)) end end, "Test Using Larger Than Block-Size Key - Hash Key First"))
print(len(crypto.sha256("x")), crypto.equal("abc", "abc"), crypto.equal("abc", "abd"), crypto.equal("abc", "ab"))
print(utf8.len("héllo"), len("héllo"), utf8.chars("añb"), utf8.codepoints("é€😀"), utf8.char(8364), utf8.char([104, 105]))
print(utf8.sub("héllo", 1, 3), utf8.sub("añbc", -2), utf8.sub("abc", 5), utf8.sub("abc", 1, 0), utf8.sub("añ", 1))
print(utf8.upper("straße ÿ ſ àéî ωμέγα ς ϊ привет ёж ǆ"), utf8.lower("ÀÉÎ ΩΜΈΓΑ ПРИВЕТ ЁЖ Ÿ ĀĂ Ĺ"))
print(utf8.upper("ı ſ İ"), utf8.lower("İ ı ſ I"))
print(utf8.valid("é"), utf8.valid(chr(233)), utf8.valid(chr(237) + chr(160) + chr(128)), utf8.codepoints("a" + chr(255) + "b"), utf8.len(chr(255) + chr(254)))
print(utf8.reverse("añb€"), pcall(fn() utf8.char(55296) end).error, pcall(fn() utf8.len(3) end).error)
print(csv.parse("name,age\nann,31\n"))
print(csv.parse("name,age\r\nann,31\r\nbob,"))
print(csv.parse("name,age\nann,31\n\nbob,40\n", {header: true}))
print(csv.parse(""), csv.parse("\n"), csv.parse("a"), csv.parse("a,"), csv.parse(",,"))
print(csv.parse("\"a,b\",\"say \"\"hi\"\"\",\"line\nbreak\"\nx,\"\"\n"))
print(csv.parse("\"q\""), csv.parse("a\tb\n1\t2", {sep: "\t"}))
print(pcall(fn() csv.parse("a\nb\"c\n") end).error)
print(pcall(fn() csv.parse("\"a\"x\n") end).error)
print(pcall(fn() csv.parse("x\n\"a\nb") end).error)
print(pcall(fn() csv.parse("a\n1,2\n", {header: true}) end).error)
print(pcall(fn() csv.parse("a,b\n\"x\ny\",1\n\"p\nq\nr\",2,3\n", {header: true}) end).error)
print(pcall(fn() csv.parse("a", {sep: ",,"}) end).error)
let text = csv.encode([["a", "b,c"], [1, nil], ["say \"hi\"", " pad", "x\ny"]])
print(text)
print(csv.parse(text))
print(csv.encode([{n: "a", v: 1}, {n: "b"}], {columns: ["n", "v"]}))
print(csv.encode_row(["a", 2.5, true], {sep: ";"}))
