# two patterns that warn (tests/notes/238_*.expected): right in some programs, a bug in most

fn risky(x) error("boom {x}") end
fn make_handler(n)
  fn() n * 2 end
end

# `pcall(f(x))` runs f(x) first and catches errors of the fn it returns
print(pcall(make_handler(3)))
let outer = pcall do
  pcall(risky(1))
end
print(outer.ok, outer.error)
print((pcall risky(2)).error)
print((pcall(fn() risky(3) end)).error)
let h = make_handler(5)
print(pcall(h).value)

# a fn with a `receive` calling itself other than last keeps each frame until it returns; fine if bounded
fn sum_next(n)
  if n == 0
    return 0
  end
  receive
  when {tag: "num", v: v} then v + sum_next(n - 1)
  end
end

for i = 1, 4
  send(self(), {tag: "num", v: i * 10})
end
print(sum_next(3))

fn countdown(n)
  if n == 0
    return "done"
  end
  receive
  when {tag: "tick"}
    if n > 5 then return countdown(0) end
    match n
    when 1 then countdown(0)
    else countdown(n - 1)
    end
  when {tag: "spawn"}
    spawn do countdown(0) end
    countdown(n)
  end
end
for i = 0, 3
  send(self(), {tag: "tick"})
end
print(countdown(3))
