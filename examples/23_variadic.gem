fn sum(...nums)
  let total = 0
  for n in nums
    total = total + n
  end
  total
end

print(sum(1, 2, 3))
print(sum(10, 20))
print(sum(42))

# zero extra args: an empty array

fn first_or_nil(...args)
  if len(args) == 0
    return "empty"
  end
  args[0]
end

print(first_or_nil())
print(first_or_nil("x"))

fn log(level, ...msgs)
  for msg in msgs
    print("{level}: {msg}")
  end
end

log("INFO", "server started", "port 8080")

log("WARN")                 # msgs is empty

fn count_args(...args)
  len(args)
end

print(count_args())
print(count_args(1, 2, 3))

fn wrap(prefix, ...items)
  let result = []
  for item in items
    push(result, "{prefix}:{item}")
  end
  result
end

let wrapped = wrap("x", "a", "b", "c")
print(wrapped[0])
print(wrapped[1])
print(wrapped[2])

# the do block goes into the rest array

fn apply_all(...fns)
  for f in fns
    f()
  end
end

apply_all(
  fn() print("hello") end,
  fn() print("world") end
)

let make_adder = fn(...addends)
  fn(x)
    let total = x
    for a in addends
      total = total + a
    end
    total
  end
end

let add_10_20 = make_adder(10, 20)
print(add_10_20(5))

# called through a variable it still packs: the callee does the packing

let my_sum = sum
print(my_sum(4, 5, 6))
