# string literals holding C trigraph sequences keep their bytes
let all = ["??=", "??/", "??'", "??(", "??)", "??!", "??<", "??>", "??-"]
for s in all
  print(s, len(s))
end
print("a???>b", len("a???>b"))
let t = {"k??>": 1}
print(t["k??>"], "x{1}??!")
let lo = 1.0
let hi = 0.0
for i = 0, 100000
  let r = random()
  if r < lo then lo = r end
  if r > hi then hi = r end
end
print(lo >= 0.0, hi < 1.0)
