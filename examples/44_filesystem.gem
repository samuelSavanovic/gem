# the full path depends on the machine
print(type(normalize_path("compiler/main.gem")))

let tmpdir = "/tmp/gem_44_fs_{epoch_ms()}_{random(1000000)}"
mkdir(tmpdir)
write_file(tmpdir + "/only.txt", "data")

let files = list_dir(tmpdir)
let found = false
for f in files
  if f == "only.txt"
    found = true
  end
end
print(found)

print(remove_file(tmpdir + "/only.txt"))
print(file_exists(tmpdir + "/only.txt"))
exec("rmdir {tmpdir}")

let r1 = pcall dirname(42)
print(r1.ok)

let r2 = pcall file_exists(nil)
print(r2.ok)
