# a spawned loop reads module binding `prefix` across many resets; a dangling one shows in `last`

let main_pid = self()
let prefix = "tick-"

let worker = spawn(fn()
  let n = 0
  while true
    let msg = receive()
    match msg
    when {tag: "go"}
      let payload = prefix + to_string(n)
      let junk = [payload, payload, payload, payload, payload]
      n = n + 1
    when {tag: "stop"}
      send(main_pid, {tag: "result", count: n, last: prefix + to_string(n - 1)})
      return
    end
  end
end)

let total = 10000
for i = 0, total
  send(worker, {tag: "go"})
end
send(worker, {tag: "stop"})

let r = receive()
print("count: " + to_string(r.count))
print("last: " + r.last)
