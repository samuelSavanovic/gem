# three nested closures each mutate their own capture across the loop's resets

let main_pid = self()

let w = spawn(fn()
  let a = 0
  let b = 0
  let c = 0
  let inner = fn() c = c + 1 end
  let middle = fn() b = b + 1; inner() end
  let outer = fn() a = a + 1; middle() end

  while true
    let msg = receive()
    if msg == "stop"
      send(main_pid, {tag: "result", a: a, b: b, c: c})
      return
    end
    outer()
    let junk = {pad: "x" + to_string(a), arr: [1,2,3,4,5,6,7,8]}
  end
end)

let n = 5000
for i = 0, n
  send(w, "tick")
end
send(w, "stop")
let r = receive()
print("a: " + to_string(r.a))
print("b: " + to_string(r.b))
print("c: " + to_string(r.c))
