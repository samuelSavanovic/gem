# a closure kept in captured-and-mutated `outer_fn` mutates captured `inner`,
# so `inner`'s box is reachable two ways at every reset

let main_pid = self()

let w = spawn(fn()
  let inner = 0
  let outer_fn = nil
  outer_fn = fn() inner = inner + 1 end

  while true
    let msg = receive()
    if msg == "stop"
      send(main_pid, {tag: "result", inner: inner})
      return
    end
    outer_fn()
    let junk = {pad: "x" + to_string(inner), arr: [1,2,3,4,5,6,7,8]}
  end
end)

let n = 5000
for i = 0, n
  send(w, "tick")
end
send(w, "stop")
let r = receive()
print("inner: " + to_string(r.inner))
