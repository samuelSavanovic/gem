# Item 8 stress: spawn target is the *return value* of a call, not a literal
# `fn() … end`. This used to warn (the closure's `while true` could not be
# tagged for the back-edge arena reset); every loop now resets, wherever
# its closure ends up running, so it compiles silently. The loop exits
# after one message here.

fn make_loop(reply_to)
  fn()
    while true
      let msg = receive()
      if msg == "stop"
        send(reply_to, "done")
        return
      end
    end
  end
end

let me = self()
let w = spawn(make_loop(me))
send(w, "stop")
print(receive())
