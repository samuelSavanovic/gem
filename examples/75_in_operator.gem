# `x in t` is has_key(t, x) on every table: a record's keys, a set's
# members, an array's indexes. To look for a value in an array, use
# table.contains.
load "std/table"

# record: key check
let tbl = {name: "gem", version: 1}
print("name" in tbl)        # true
print("version" in tbl)     # true
print("missing" in tbl)     # false

# int-keyed set: member check, by key (not a scan of the values)
let seen = {}
seen[42] = true
seen[7] = true
print(42 in seen)           # true
print(8 in seen)            # false
print(true in seen)         # false: true is a value, not a key

# array: its keys are its indexes
let arr = [10, 20, 30]
print(0 in arr)             # true
print(2 in arr)             # true
print(3 in arr)             # false
print(20 in arr)            # false: 20 is a value
print(table.contains(arr, 20))   # true
print(table.contains(arr, 99))   # false

# empty tables
print(1 in [])              # false
print("a" in {})            # false

# nil, float and bool keys
let odd = {}
odd[1.5] = "f"
odd[false] = "b"
print(1.5 in odd, false in odd, nil in odd)   # true true false

# the right operand must be a table
fn is_in(x, t) x in t end
let r = pcall is_in("a", "abc")
print(r.ok, r.error)
