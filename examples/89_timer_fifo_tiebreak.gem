# same-deadline timers fire in insertion order

spawn(fn()
  let me = self()
  let n = 100

  # all share the 50 ms delay; the deadline may jitter by 1 ms across iterations, but within one ms
  # bucket the order must hold
  for i = 0, n
    send_after(me, i, 50)
  end

  let in_order = true
  let prev = -1
  for i = 0, n
    let m = receive()
    if m != prev + 1 then in_order = false end
    prev = m
  end

  print("count={prev + 1} in_order={in_order}")
end)
