# extern fn wrappers check argument count and types and raise instead of handing C garbage

extern include "string.h"
extern fn strlen(s: String) -> Int

# the wrong count is a compile error in a direct call; through a value it raises
let strlen_v = strlen
let r1 = pcall strlen_v()
print("missing:", r1.ok, r1.error)

let r2 = pcall strlen(42)
print("wrong type:", r2.ok, r2.error)

let r3 = strlen("hello")
print("ok:", r3)
