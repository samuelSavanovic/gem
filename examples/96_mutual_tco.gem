# mutual tail calls run at constant stack depth; these depths would overflow 8 MB without it

fn is_even(n)
  if n == 0
    return true
  end
  is_odd(n - 1)
end

fn is_odd(n)
  if n == 0
    return false
  end
  is_even(n - 1)
end

print(is_even(1000000))
print(is_odd(1000001))

# broker-shaped 3-cycle: a loop node, a dispatcher and a handler that loops back
fn loop_node(n)
  if n == 0
    return "ok"
  end
  dispatch(n - 1, n)
end

fn dispatch(n, tag)
  if tag % 2 == 0
    handle_even(n)
  else
    handle_odd(n)
  end
end

fn handle_even(n)
  loop_node(n)
end

fn handle_odd(n)
  loop_node(n)
end

print(loop_node(1000000))

# a cycle member that also tail-calls itself
fn pingA(n, acc)
  if n == 0
    return acc
  end
  if n % 2 == 0
    pingA(n - 1, acc + 1)
  else
    pingB(n, acc)
  end
end

fn pingB(n, acc)
  if n == 0
    return acc
  end
  pingA(n - 1, acc + 1)
end

print(pingA(10000, 0))
