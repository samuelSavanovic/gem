# Pin patterns: `^name` matches when the value equals the current value of
# `name`, instead of binding a new variable.
load "./modules/pin_sentinel"

# ─── Test 1: replies arriving out of order ───
let me = self()
let a = make_ref()
let b = make_ref()
send(me, {tag: "reply", ref: b, value: "B"})
send(me, {tag: "reply", ref: a, value: "A"})
receive
when {tag: "reply", ref: ^a, value: v}
  print("test1: a -> {v}")
end
receive
when {tag: "reply", ref: ^b, value: v}
  print("test1: b -> {v}")
end

# ─── Test 2: pin in match — top level, array, table, mismatch ───
let x = 5
match 5
when ^x
  print("test2: top-level pin")
end
match [1, 5]
when [1, ^x]
  print("test2: array pin")
end
match {k: 6}
when {k: ^x}
  print("test2: wrong")
else
  print("test2: mismatch falls through")
end

# ─── Test 3: nil pin ───
let n = nil
match nil
when ^n
  print("test3: nil pin")
end

# ─── Test 4: pin with after 0 — no match leaves mailbox intact ───
let c = make_ref()
send(me, {ref: a})
receive
when {ref: ^c}
  print("test4: wrong")
after 0
  print("test4: no match, mailbox_len={process_info(me).mailbox_len}")
end
let _drained = receive()

# ─── Test 5: pinned module-level variable ───
print("test5: {pin_sentinel.classify("S")}, {pin_sentinel.classify({k: "S"})}, {pin_sentinel.classify("x")}")

# ─── Test 6: pin captured by a spawned closure ───
let parent = self()
let want = make_ref()
let other = make_ref()
spawn(fn()
  let child = self()
  send(child, {ref: other, v: 1})
  send(child, {ref: want, v: 2})
  receive
  when {ref: ^want, v: v}
    send(parent, "test6: child got {v}")
  end
end)
print(receive())

# ─── Test 7: pinned parameter in a tail-recursive receive loop ───
fn collect(expected, count, acc)
  if count == 0
    return acc
  end
  receive
  when {ref: ^expected, v: v}
    collect(expected, count - 1, acc + v)
  end
end
fn take_noise(noise)
  receive
  when {ref: ^noise, v: v}
    v
  after 0
    nil
  end
end
let r = make_ref()
let noise = make_ref()
for i = 0, 3
  send(me, {ref: noise, v: 100})
  send(me, {ref: r, v: i})
end
let left = 0
print("test7: sum={collect(r, 3, 0)}")
while true
  let got = take_noise(noise)
  if got == nil then break end
  left += got
end
print("test7: noise left={left}")

# ─── Test 8: pin inside a long-running while-true loop ───
let worker = spawn(fn()
  let tag = make_ref()
  let done = 0
  while true
    send(self(), {tag: tag, s: "x" + to_string(done)})
    receive
    when {tag: ^tag, s: got}
      done += 1
    end
    if done == 20000
      send(parent, "test8: loop done {done}")
    end
  end
end)
print(receive())
kill(worker, "stop")
