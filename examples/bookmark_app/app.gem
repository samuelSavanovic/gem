# Bookmark manager: an HTMX CRUD app on std/http and std/sqlite.
#
#   cd examples/bookmark_app && ../../build/gem app.gem
#
# then open http://localhost:8080. The routes live in bookmarks.gem;
# test.gem runs them against an in-memory database.

load "std/http"
load "std/log"
load "./bookmarks"

let PORT = 8080

fn main()
  let db = bookmarks.open_db("bookmarks.db")
  log.info("bookmark manager listening on http://localhost:{PORT}")
  http.serve(bookmarks.routes(db, "./static"), {port: PORT})
end
