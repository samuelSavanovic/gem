-- string errors
string.split: s must be a string, got nil
string.split: delim must be a string, got nil
string.index_of: needle must be a string, got int
string.index_of: start must be an int, got string
string.contains: s must be a string, got nil
string.join: arr must be an array, got nil
string.join: delim must be a string, got nil
string.trim: s must be a string, got int
string.starts_with: prefix must be a string, got nil
string.ends_with: s must be a string, got nil
string.upper: s must be a string, got nil
string.lower: s must be a string, got table
string.repeat: n must be an int, got float
