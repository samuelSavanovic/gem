## The files a search reads, in the order grep reports them.
##
##   walk.files(["src", "notes.txt"], true)
##   # [{path: "src/a.gem", in_dir: true}, ..., {path: "notes.txt", in_dir: false}]
##
## An entry with an `error` can't be searched, and carries the reason. `path` "-" is stdin.
## Directory entries come in byte order of their names.

load "std/string"

extern include "fs.h"
extern fn fs_is_symlink(path: String) -> Bool

# the `<reason>` in a read_file / list_dir error ending `'<path>': <reason>`; the whole message if none
fn error_reason(message)
  let at = -1
  let next = find(message, "': ")
  while next >= 0
    at = next
    next = find(message, "': ", next + 1)
  end
  if at < 0
    return message
  end
  substr(message, at + 3)
end

# "" is the working directory when no operand names it; its files get no "./"
fn join(dir, name)
  if dir == ""
    return name
  end
  if string.ends_with(dir, "/")
    return dir + name
  end
  "{dir}/{name}"
end

# like grep -r, follows no symlink it finds on the way, only the ones named on the command line
fn walk_dir(dir, out)
  let listing = if dir == "" then "." else dir end
  let r = pcall list_dir(listing)
  if not r.ok
    push(out, {path: listing, error: error_reason(r.error)})
    return nil
  end
  let names = r.value
  sort(names)
  for name in names
    let path = join(dir, name)
    if fs_is_symlink(path)
      continue
    end
    if is_dir(path)
      walk_dir(path, out)
    else
      push(out, {path: path, in_dir: true})
    end
  end
end

fn trim_slashes(path)
  while len(path) > 1 and string.ends_with(path, "/")
    path = substr(path, 0, len(path) - 1)
  end
  path
end

## `operands` with each directory expanded when `recursive`. No operands means stdin, or with
## `recursive` the working directory.
fn files(operands, recursive)
  let out = []
  if len(operands) == 0
    if recursive
      walk_dir("", out)
    else
      push(out, {path: "-", in_dir: false})
    end
    return out
  end
  for path in operands
    if path != "-" and is_dir(path)
      if recursive
        walk_dir(trim_slashes(path), out)
      else
        push(out, {path: path, error: "Is a directory"})
      end
    else
      push(out, {path: path, in_dir: false})
    end
  end
  out
end

export files, error_reason
