## device — the canned text of the fake device: a cheap ARMv7 IoT box
## running BusyBox. Line ends are "\n"; the session turns them into CR LF.

let HOSTNAME = "localhost"

let BANNER = "\n"

let MOTD = """

BusyBox v1.24.1 (2017-01-04 16:39:08 CST) built-in shell (ash)
Enter 'help' for a list of built-in commands.


"""

let PROMPT = "# "

let UNAME = {
  s: "Linux", n: HOSTNAME, r: "3.10.14", v: "#1 SMP PREEMPT Tue Jan 9 11:03:47 CST 2018",
  m: "armv7l", o: "GNU/Linux"
}

let FILES = {}

FILES["/proc/cpuinfo"] = """
processor	: 0
model name	: ARMv7 Processor rev 5 (v7l)
BogoMIPS	: 48.00
Features	: half thumb fastmult vfp edsp neon vfpv3 tls vfpv4 idiva idivt vfpd32 lpae evtstrm
CPU implementer	: 0x41
CPU architecture: 7
CPU variant	: 0x0
CPU part	: 0xc07
CPU revision	: 5

Hardware	: Generic DT based system
Revision	: 0000
Serial		: 0000000000000000

"""

FILES["/proc/mounts"] = """
rootfs / rootfs rw 0 0
/dev/root / squashfs ro,relatime 0 0
proc /proc proc rw,relatime 0 0
sysfs /sys sysfs rw,relatime 0 0
tmpfs /tmp tmpfs rw,relatime 0 0
tmpfs /var tmpfs rw,relatime 0 0
/dev/mtdblock5 /mnt/mtd jffs2 rw,relatime 0 0

"""

FILES["/proc/version"] = "Linux version 3.10.14 (root@build) (gcc version 4.9.4 (Buildroot 2016.11)) #1 SMP PREEMPT Tue Jan 9 11:03:47 CST 2018\n"

FILES["/etc/passwd"] = """
root:x:0:0:root:/root:/bin/sh
daemon:x:1:1:daemon:/usr/sbin:/bin/false
nobody:x:65534:65534:nobody:/nonexistent:/bin/false

"""

let HEX_DIGITS = "0123456789abcdef"

# The bytes `hex` spells, two lowercase digits a byte; spaces and line
# ends are skipped.
fn unhex(hex)
  let out = buf_new()
  let i = 0
  while i < len(hex)
    if hex[i] == " " or hex[i] == "\n"
      i += 1
    else
      buf_push(out, chr(find(HEX_DIGITS, hex[i], 0) * 16 + find(HEX_DIGITS, hex[i + 1], 0)))
      i += 2
    end
  end
  to_string(out)
end

# The start of the BusyBox binary that `/bin/busybox`, `/bin/sh`,
# `/bin/echo` and `/proc/self/exe` hold: the ELF header and program
# headers of a 32-bit little-endian ARM (EABI5) executable (EXIDX, two
# LOADs, GNU_STACK). No byte is "\n", which the session turns into CR LF,
# or "\r", which a telnet client can take for a line end.
let BUSYBOX_ELF = unhex("""
7f454c46 01010100 00000000 00000000 0200 2800 01000000 308f0000 34000000 f4c50c00 00020005
3400 2000 0400 2800 1b00 1a00
01000070 243a0c00 24ba0c00 24ba0c00 c8080000 c8080000 04000000 04000000
01000000 00000000 00800000 00800000 ec420c00 ec420c00 05000000 00800000
01000000 044f0c00 044f0e00 044f0e00 081d0000 445b0000 06000000 00800000
51e57464 00000000 00000000 00000000 00000000 00000000 06000000 10000000
""")

for path in ["/bin/busybox", "/bin/sh", "/bin/echo", "/proc/self/exe"]
  FILES[path] = BUSYBOX_ELF
end

let PS = """
  PID USER       VSZ STAT COMMAND
    1 root      1536 S    init
    2 root         0 SW   [kthreadd]
    3 root         0 SW   [ksoftirqd/0]
  412 root      1532 S    /sbin/syslogd -n
  418 root      1532 S    /sbin/klogd -n
  503 root      2104 S    /usr/sbin/telnetd -F
  517 root      9844 S    /usr/bin/ipcam -d
  611 root      1540 S    -sh
  640 root      1536 R    ps

"""

let LS_ROOT = "bin   dev   etc   home  lib   mnt   proc  root  sbin  sys   tmp   usr   var\n"

## Applets that run and print nothing.
let SILENT = {
  enable: true, system: true, shell: true, sh: true, linuxshell: true, su: true,
  cd: true, chmod: true, rm: true, mkdir: true, cp: true, mv: true, touch: true,
  kill: true, killall: true, sleep: true, export: true, ulimit: true
}
SILENT["true"] = true
SILENT[":"] = true

## Commands that read their input and pass it on in a pipeline.
let FILTERS = {grep: true, head: true, tail: true, sort: true, uniq: true, cut: true, tr: true, awk: true, sed: true}

let BUSYBOX_USAGE = """
BusyBox v1.24.1 (2017-01-04 16:39:08 CST) multi-call binary.
BusyBox is copyrighted by many authors between 1998-2015.
Licensed under GPLv2. See source distribution for detailed
copyright notices.

Usage: busybox [function [arguments]...]

"""

let PING_USAGE = """
BusyBox v1.24.1 (2017-01-04 16:39:08 CST) multi-call binary.

Usage: ping [OPTIONS] HOST

Send ICMP ECHO_REQUEST packets to network hosts

	-4,-6		Force IP or IPv6 name resolution
	-c CNT		Send only CNT pings
	-s SIZE		Send SIZE data bytes in packets (default:56)
	-t TTL		Set TTL
	-I IFACE/IP	Use interface or IP address as source
	-W SEC		Seconds to wait for the first response (default:10)
			(after all -c CNT packets are sent)
	-w SEC		Seconds until ping exits (default:infinite)
			(can exit earlier with -c CNT)
	-q		Quiet, only display output at start
			and when finished

"""

let ID = "uid=0(root) gid=0(root)\n"

export HOSTNAME, BANNER, MOTD, PROMPT, UNAME, FILES, BUSYBOX_ELF, PS, LS_ROOT, SILENT, FILTERS,
  BUSYBOX_USAGE, PING_USAGE, ID
