let UNAME = {
  s: "Linux", n: HOSTNAME, r: "3.10.14", v: "#1 SMP PREEMPT Tue Jan 9 11:03:47 CST 2018",
  m: "armv7l", o: "GNU/Linux"
}

let FILES = {}

FILES["/proc/cpuinfo"] = """
processor	: 0
model name	: ARMv7 Processor rev 5 (v7l)
