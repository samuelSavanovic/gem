# A telnet honeypot: a fake BusyBox device that records what clients try.
# See README.md and PLAN.md.
#
#   honeypot [--port 2323] [--bind 127.0.0.1] [--data honeypot_data] [--keep-weeks 8] [--log]

load "./server"

fn usage()
  eprint("usage: honeypot [--port N] [--bind ADDRESS] [--data DIR] [--keep-weeks N] [--log]")
  exit(2)
end

fn int_arg(value)
  let r = pcall to_int(value)
  if not r.ok or r.value < 1 then usage() end
  r.value
end

fn main()
  let args = argv()
  let port = 2323
  let host = "127.0.0.1"
  let opts = {}
  let i = 1
  while i < len(args)
    if args[i] == "--log"
      opts.log = true
      i += 1
      continue
    end
    if i + 1 >= len(args)
      usage()
    end
    let value = args[i + 1]
    if args[i] == "--port"
      port = int_arg(value)
    elif args[i] == "--bind"
      host = value
    elif args[i] == "--data"
      opts.data = value
    elif args[i] == "--keep-weeks"
      opts.keep_weeks = int_arg(value)
    else
      usage()
    end
    i += 2
  end
  let listener = tcp_listen(host, port)
  server.start(listener, opts)
  eprint("honeypot listening on {host}:{port}")
end
