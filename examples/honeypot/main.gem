# telnet honeypot: a fake BusyBox device that records what clients try; `honeypot --help` for the options

load "std/args"
load "./server"

let SPEC = {
  name: "honeypot",
  max_args: 0,
  options: {
    port: {default: 2323, help: "port to listen on"},
    bind: {default: "127.0.0.1", value: "ADDRESS", help: "address to listen on"},
    data: {value: "DIR", help: "where the weekly databases go (default: honeypot_data)"},
    keep_weeks: {type: "int", value: "N", help: "weeks of databases to keep"},
    log: {type: "flag", help: "also print each event on stdout"},
    commit: {value: "ID", help: "names the build in each metrics row"},
    max_sessions: {type: "int", value: "N", help: "sessions at once"},
    max_per_ip: {type: "int", value: "N", help: "sessions per client address"},
    max_session_ms: {type: "int", value: "MS", help: "longest session"},
    max_bytes: {type: "int", value: "N", help: "most bytes a client may send"},
    max_logins: {type: "int", value: "N", help: "failed logins before the session ends"},
    max_commands: {type: "int", value: "N", help: "command lines per session"},
    max_backlog: {type: "int", value: "N", help: "messages the recorder holds before it drops events"},
    idle_ms: {type: "int", value: "MS", help: "a silent client is disconnected after this"},
    accept_on: {type: "int", value: "N", help: "which login attempt succeeds"},
    metrics_ms: {type: "int", value: "MS", help: "how often metrics are sampled"}
  }
}

fn main()
  let opts = args.parse(SPEC)
  let cfg = {}
  for name, v in opts
    if v == nil or name == "args" or name == "port" or name == "bind"
      continue
    end
    if type(v) == "int" and v < 1
      eprint("honeypot: --{str_replace(name, "_", "-")} must be 1 or more, got {v}")
      exit(2)
    end
    cfg[name] = v
  end
  let listener = tcp_listen(opts.bind, opts.port)
  server.start(listener, cfg)
  eprint("honeypot listening on {opts.bind}:{opts.port}")
end
