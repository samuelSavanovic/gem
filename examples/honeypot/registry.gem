## registry — starts a session per accepted connection and records the
## ones that crash.

load "./session"
load "./recorder"

# Holds each socket from the moment it is taken from the mailbox to its
# session's start: a crash here closes it, and the session's claim takes
# it over. Sockets still in the mailbox are the acceptor's (see
# server.start_front).
fn accepted(state, sock, peer)
  claim(sock)
  let cfg = state.cfg
  let r = pcall spawn_monitor(fn() session.run(sock, peer, cfg) end)
  if r.ok
    state.live[r.value.pid] = peer.ip
  else
    tcp_close(sock)
    recorder.emit(cfg.events, {kind: "cap", cap: "spawn_failed", ip: peer.ip, detail: r.error})
  end
end

fn down(state, pid, reason)
  if not has_key(state.live, pid)
    return nil
  end
  delete(state.live, pid)
  if reason != "normal"
    recorder.emit(state.cfg.events, {kind: "crash", session: pid, reason: reason})
  end
end

fn loop(state)
  while true
    receive
    when {tag: "accepted", sock: sock, peer: peer}
      accepted(state, sock, peer)
    when {tag: "DOWN", pid: pid, reason: reason}
      down(state, pid, reason)
    when other
      nil
    end
  end
end

## Starts the registry under the registered `name` with the server's
## config `cfg`, and returns its pid. It takes `{tag: "accepted", sock,
## peer}` messages.
fn start(name, cfg)
  let pid = spawn do
    loop({live: {}, cfg: cfg})
  end
  register(name, pid)
  pid
end

export start
