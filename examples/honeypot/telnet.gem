## Server side of telnet's in-band commands (RFC 854/855): strips them from the input as it arrives
## and answers option requests.

let IAC = 255
let DONT = 254
let DO = 253
let WONT = 252
let WILL = 251
let SB = 250
let SE = 240

let ECHO = 1
let SGA = 3

let IAC_BYTE = chr(IAC)

## Sent on connect; WILL ECHO + WILL SGA puts a telnet client in character-at-a-time mode.
let OFFER = chr(IAC) + chr(WILL) + chr(ECHO) + chr(IAC) + chr(WILL) + chr(SGA)

## A subnegotiation over `max_subneg` bytes is abandoned (what follows is data again) and `feed`
## reports a `subneg_too_long` event.
fn new(max_subneg = 1024)
  {
    state: "data", cmd: 0, sb_len: 0, max_subneg: max_subneg,
    answered: {}, echo: false
  }
end

## True between the client's DO ECHO and DONT ECHO, while the server has to echo what it types.
fn echoing(t)
  t.echo
end

# one answer per (command, option), so two sides refusing each other can't loop and an IAC flood
# gets a few bytes per option
fn answer(t, reply, cmd, opt)
  let key = cmd * 256 + opt
  if has_key(t.answered, key)
    return nil
  end
  t.answered[key] = true
  buf_push(reply, chr(IAC) + chr(cmd) + chr(opt))
end

# a DO for ECHO or SGA accepts what OFFER promised, no answer needed
fn negotiate(t, reply, cmd, opt)
  if cmd == DO
    if opt == ECHO
      t.echo = true
    elif opt != SGA
      answer(t, reply, WONT, opt)
    end
  elif cmd == DONT
    if opt == ECHO
      t.echo = false
    end
    if opt == ECHO or opt == SGA
      answer(t, reply, WONT, opt)
    end
  elif cmd == WILL
    answer(t, reply, if opt == SGA then DO else DONT end, opt)
  end
end

fn command(t, data, b)
  if b == IAC
    buf_push(data, IAC_BYTE)
    t.state = "data"
  elif b >= WILL and b <= DONT
    t.cmd = b
    t.state = "opt"
  elif b == SB
    t.sb_len = 0
    t.state = "sb"
  else
    t.state = "data"
  end
end

# subnegotiation contents are skipped: we never ask for an option that has any
fn subneg(t, b, events)
  if t.state == "sb_iac"
    if b == SE
      t.state = "data"
      return nil
    end
    t.state = "sb"
  elif b == IAC
    t.state = "sb_iac"
    return nil
  end
  t.sb_len = t.sb_len + 1
  if t.sb_len > t.max_subneg
    push(events, {kind: "cap", cap: "subneg_too_long"})
    t.state = "data"
  end
end

## Returns `data` (commands removed, IAC IAC -> one 255 byte), `reply` to send back, and `events`
## (caps hit). A command split across chunks is finished by the next `feed`.
##
##   telnet.feed(t, "ro" + chr(255))     # data "ro"
##   telnet.feed(t, chr(255) + "ot")     # data chr(255) + "ot"
fn feed(t, chunk)
  let events = []
  let n = len(chunk)
  if t.state == "data" and find(chunk, IAC_BYTE, 0) < 0
    return {data: chunk, reply: "", events: events}
  end
  let data = buf_new()
  let reply = buf_new()
  let i = 0
  while i < n
    if t.state == "data"
      let at = find(chunk, IAC_BYTE, i)
      if at < 0
        buf_push(data, substr(chunk, i, n - i))
        break
      end
      if at > i
        buf_push(data, substr(chunk, i, at - i))
      end
      t.state = "iac"
      i = at + 1
      continue
    end
    let b = ord(chunk, i)
    if t.state == "iac"
      command(t, data, b)
    elif t.state == "opt"
      negotiate(t, reply, t.cmd, b)
      t.state = "data"
    else
      subneg(t, b, events)
    end
    i += 1
  end
  {data: to_string(data), reply: to_string(reply), events: events}
end

## Doubles every 255 byte, as telnet requires for data.
fn escape(s)
  str_replace(s, IAC_BYTE, IAC_BYTE + IAC_BYTE)
end

export OFFER, new, echoing, feed, escape
