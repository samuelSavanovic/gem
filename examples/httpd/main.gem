# a small public website on std/http that records everything its clients do; `httpd --help` for the options

load "std/args"
load "./server"

let SPEC = {
  name: "httpd",
  max_args: 0,
  options: {
    port: {default: 8080, help: "port to listen on"},
    bind: {default: "127.0.0.1", value: "ADDRESS", help: "address to listen on"},
    static: {default: "static", value: "DIR", help: "the files under /static/"},
    data: {value: "DIR", help: "where the weekly databases go (default: httpd_data)"},
    keep_weeks: {type: "int", value: "N", help: "weeks of databases to keep"},
    log: {type: "flag", help: "also print each event on stdout"},
    commit: {value: "ID", help: "names the build in each metrics row"},
    max_connections: {type: "int", value: "N", help: "connections at once"},
    max_per_ip: {type: "int", value: "N", help: "connections per client address"},
    max_body: {type: "int", value: "BYTES", help: "largest request body"},
    idle_ms: {type: "int", value: "MS", help: "an idle connection is closed after this"},
    request_ms: {type: "int", value: "MS", help: "longest time to read a request"},
    write_ms: {type: "int", value: "MS", help: "a client that doesn't read is dropped after this"},
    max_backlog: {type: "int", value: "N", help: "messages the recorder holds before it drops events"},
    metrics_ms: {type: "int", value: "MS", help: "how often metrics are sampled"}
  }
}

fn main()
  let opts = args.parse(SPEC)
  let cfg = {host: opts.bind}
  for name, v in opts
    if v == nil or name == "args" or name == "bind"
      continue
    end
    if type(v) == "int" and v < 1
      eprint("httpd: --{str_replace(name, "_", "-")} must be 1 or more, got {v}")
      exit(2)
    end
    cfg[name] = v
  end
  if not is_dir(cfg.static)
    eprint("httpd: {cfg.static} is not a directory (--static DIR)")
    exit(2)
  end
  server.start(cfg)
  eprint("httpd listening on {cfg.host}:{cfg.port}")
end
