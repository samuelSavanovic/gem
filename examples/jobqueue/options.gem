## jobqueue's command line: `{ok: true, value: opts}`, `{ok: true, value: {help: text}}` or `{ok: false, error: msg}`.

load "std/args"

let SPEC = {
  name: "jobqueue",
  about: "Runs a job queue on a supervised worker pool under seeded fault injection.",
  max_args: 0,
  options: {
    jobs: {default: 10000, value: "N", help: "jobs to run"},
    workers: {default: 16, value: "W", help: "most workers at once"},
    seed: {default: 1, value: "S", help: "seed of the workload and the fault schedule"},
    crash: {default: 0.0, value: "P", help: "chance an attempt raises"},
    hang: {default: 0.0, value: "P", help: "chance an attempt never finishes"},
    slow: {default: 0.0, value: "P", help: "chance an attempt first sleeps --slow-ms"},
    kill: {default: 0.0, value: "P", help: "chance an attempt kills its worker"},
    slow_ms: {default: 20, value: "MS", help: "how long a slow attempt sleeps"},
    retries: {default: 3, value: "R", help: "retries per job before it is dead-lettered"},
    deadline: {default: 100, value: "MS", help: "per-attempt deadline, 0 for none"},
    backoff: {default: 10, value: "MS", help: "first retry delay, doubled per retry"},
    backoff_max: {default: 1000, value: "MS", help: "longest retry delay"},
    idle: {default: 200, value: "MS", help: "a worker idle that long exits"},
    max_restarts: {default: 1000, value: "N", help: "worker restarts allowed per --restart-window"},
    restart_window: {default: 1000, value: "MS", help: "the window --max-restarts counts in"},
    storm: {default: 0, value: "N", help: "kill N workers per burst, 0 for no storm"},
    storm_every: {default: 100, value: "MS", help: "time between bursts"},
    storm_bursts: {default: 10, value: "K", help: "bursts"},
    timeout: {default: 120000, value: "MS", help: "give up on the run after MS"}
  }
}

# option -> its key in opts, where the two differ
let KEYS = {
  workers: "pool", deadline: "deadline_ms", backoff: "backoff_ms", backoff_max: "backoff_max_ms",
  idle: "idle_ms", restart_window: "restart_window_ms", storm_every: "storm_every_ms",
  timeout: "timeout_ms"
}
let AT_LEAST_ONE = ["workers", "backoff", "backoff_max", "idle", "restart_window", "storm_every", "timeout"]
let CHANCES = ["crash", "hang", "slow", "kill"]

fn fail(msg)
  {ok: false, error: msg}
end

fn parse(list)
  let r = args.try_parse(SPEC, list)
  if not r.ok
    return r
  end
  let raw = r.value
  if raw.help != nil
    return {ok: true, value: {help: raw.help}}
  end
  let opts = {}
  for name, _ in SPEC.options
    let v = raw[name]
    let flag = "--{str_replace(name, "_", "-")}"
    let least = if name in AT_LEAST_ONE then 1 else 0 end
    if name in CHANCES
      if v > 1.0 or v < 0.0
        return fail("{flag} expects a probability from 0 to 1, got {v}")
      end
    elif v < least
      return fail("{flag} must be {least} or more, got {v}")
    end
    opts[if has_key(KEYS, name) then KEYS[name] else name end] = v
  end
  if opts.crash + opts.hang + opts.slow + opts.kill > 1.0
    return fail("--crash, --hang, --slow and --kill add up to more than 1")
  end
  {ok: true, value: opts}
end

fn defaults()
  parse([]).value
end

export parse, defaults
