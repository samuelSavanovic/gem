## The lines of a log file, or of stdin for "-". Lines come without their LF or CRLF; `n` counts from 1.
## Raises `read_file: ...` for an unreadable file.

load "std/string"

fn without_cr(line)
  let n = len(line)
  if n > 0 and ord(line, n - 1) == 13
    return substr(line, 0, n - 1)
  end
  line
end

fn each_line(name, f)
  if name == "-"
    each_stdin_line(f)
  else
    each_file_line(name, f)
  end
end

fn each_stdin_line(f)
  let n = 0
  while true
    let line = input()
    if line == nil
      break
    end
    n += 1
    f(line, n)
  end
end

fn each_file_line(path, f)
  let data = read_file(path)
  let size = len(data)
  let start = 0
  let n = 0
  while start < size
    let nl = string.index_of(data, "\n", start)
    if nl < 0
      nl = size
    end
    n += 1
    f(without_cr(substr(data, start, nl - start)), n)
    start = nl + 1
  end
end

export each_line
