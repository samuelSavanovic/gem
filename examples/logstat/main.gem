# logstat: summarizes web server access logs. `logstat --help` for usage.

load "std/args"
load "std/io"
load "lib/clf"
load "lib/report"
load "lib/stats"

let MAX_REPORTED = 5

let SPEC = {
  name: "logstat",
  usage: "[options] [file ...]",
  about: "Summarizes access logs (Common or Combined Log Format). Reads stdin when no file is given, or for a file named -.",
  options: {
    by: {default: "path", choices: stats.FIELDS, value: "FIELD", help: "group by"},
    sort: {default: "requests", choices: stats.METRICS, value: "METRIC", help: "order groups by"},
    top: {default: 10, value: "N", help: "show the first N groups, 0 for all"},
    json: {type: "flag", help: "print JSON instead of a table"},
    quiet: {type: "flag", help: "don't report malformed lines on stderr"}
  }
}

fn display_name(name)
  if name == "-" then "stdin" else name end
end

fn main()
  let opts = args.parse(SPEC)
  if opts.top < 0
    eprint("logstat: --top must be 0 or more, got {opts.top}")
    exit(2)
  end

  let s = stats.new(opts.by)
  let files = if len(opts.args) == 0 then ["-"] else opts.args end
  for name in files
    let n = 0
    let r = pcall do
      io.lines(name) do |line|
        n += 1
        let req = clf.parse(line)
        if req == nil
          stats.malformed(s)
          if not opts.quiet and s.malformed <= MAX_REPORTED
            eprint("logstat: {display_name(name)}:{n}: malformed line")
          end
        else
          stats.add(s, req)
        end
      end
    end
    if not r.ok
      eprint("logstat: {r.error}")
      exit(1)
    end
  end
  if not opts.quiet and s.malformed > MAX_REPORTED
    eprint("logstat: {s.malformed - MAX_REPORTED} more malformed lines")
  end

  let rows = stats.top(s, opts.sort, opts.top)
  if opts.json
    print(report.to_json(s, rows, opts.sort))
  else
    write_stdout(report.text(s, rows, opts.sort))
  end
end
