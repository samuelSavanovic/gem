// Classes: method calls, field access, inheritance and super, on a
// particle simulation in a box.
//   lox methods.lox [steps]     (default 2000)

var steps = arg(0) or 2000;

class Vec {
  init(x, y) {
    this.x = x;
    this.y = y;
  }
  add(o) { return Vec(this.x + o.x, this.y + o.y); }
  scale(k) { return Vec(this.x * k, this.y * k); }
  dot(o) { return this.x * o.x + this.y * o.y; }
}

class Body {
  init(pos, vel) {
    this.pos = pos;
    this.vel = vel;
    this.bounces = 0;
  }
  mass() { return 1; }
  step(size) {
    this.pos = this.pos.add(this.vel);
    if (this.pos.x < 0 or this.pos.x > size) {
      this.vel = Vec(-this.vel.x, this.vel.y);
      this.bounces = this.bounces + 1;
    }
    if (this.pos.y < 0 or this.pos.y > size) {
      this.vel = Vec(this.vel.x, -this.vel.y);
      this.bounces = this.bounces + 1;
    }
  }
  energy() { return this.mass() * this.vel.dot(this.vel) / 2; }
}

class Heavy < Body {
  init(pos, vel, mass) {
    super.init(pos, vel);
    this.m = mass;
  }
  mass() { return this.m; }
  step(size) {
    super.step(size);
    this.vel = this.vel.scale(0.999);
  }
}

var size = 100;
var bodies = nil;
var count = 0;

class Node {
  init(body, next) {
    this.body = body;
    this.next = next;
  }
}

for (var i = 0; i < 40; i = i + 1) {
  var pos = Vec(5 + i * 2, 95 - i * 2);
  var vel = Vec(1.5 - i * 0.075, 0.25 + i * 0.05);
  var body;
  if (i < 30) body = Body(pos, vel);
  else body = Heavy(pos, vel, 1 + i - 30);
  bodies = Node(body, bodies);
  count = count + 1;
}

for (var s = 0; s < steps; s = s + 1) {
  for (var node = bodies; node != nil; node = node.next) node.body.step(size);
}

var energy = 0;
var bounces = 0;
for (var node = bodies; node != nil; node = node.next) {
  energy = energy + node.body.energy();
  bounces = bounces + node.body.bounces;
}
print str(count) + " bodies, " + str(steps) + " steps";
print "bounces: " + str(bounces);
print "energy: " + str(energy);
