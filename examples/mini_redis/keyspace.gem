## keyspace — the database and the data commands: strings, lists,
## hashes, sets, expiry. Pure functions over a db table; the store process
## owns the one db.
##
##   let db = keyspace.new()
##   keyspace.execute(db, ["SET", "k", "v"], time_ms())    # resp.OK
##   keyspace.execute(db, ["GET", "k"], time_ms())         # "v"

load "std/string"
load "./resp"
load "./deque"
load "./rset"

let WRONGTYPE = resp.err("WRONGTYPE Operation against a key holding the wrong kind of value")
let NOT_INT = resp.err("ERR value is not an integer or out of range")
let SYNTAX = resp.err("ERR syntax error")
let INT_MAX = 9223372036854775807
let INT_MIN = -9223372036854775807 - 1

# The active expiry cycle, as Redis runs it: sample this many keys that
# have a deadline, and go again while more than a quarter were expired.
let EXPIRE_SAMPLE = 20
let EXPIRE_BUDGET_MS = 25

# A string value is a Gem string; the other types are tables with a kind.

## Returns an empty database.
fn new()
  {data: {}, deadlines: {}, expiring: rset.new()}
end

fn kind_of(v)
  if type(v) == "string" then return "string" end
  v.kind
end

fn remove_key(db, key)
  delete(db.data, key)
  if has_key(db.deadlines, key)
    delete(db.deadlines, key)
    rset.remove(db.expiring, key)
  end
end

fn set_deadline(db, key, at)
  db.deadlines[key] = at
  rset.add(db.expiring, key)
end

fn clear_deadline(db, key)
  if has_key(db.deadlines, key)
    delete(db.deadlines, key)
    rset.remove(db.expiring, key)
  end
end

# The value at `key`, or nil when it is missing or has expired (an expired
# key is removed on the way, as Redis does on access).
fn lookup(db, key, now)
  let at = db.deadlines[key]
  if at != nil and at <= now
    remove_key(db, key)
    return nil
  end
  db.data[key]
end

## Removes expired keys, sampling as Redis's active expiry cycle does.
## Returns how many it removed.
fn expire_cycle(db, now)
  let removed = 0
  let stop_at = time_ms() + EXPIRE_BUDGET_MS
  while rset.size(db.expiring) > 0
    let sampled = 0
    let expired = 0
    while sampled < EXPIRE_SAMPLE and rset.size(db.expiring) > 0
      let key = rset.pick(db.expiring)
      if db.deadlines[key] <= now
        remove_key(db, key)
        expired += 1
      end
      sampled += 1
    end
    removed += expired
    if expired * 4 <= sampled or time_ms() >= stop_at
      break
    end
  end
  removed
end

## Returns the number of keys, those expired but not yet removed included
## (as Redis's DBSIZE).
fn size(db)
  len(db.data)
end

# ─── Strings ───────────────────────────────────────────────────

fn get_string(db, key, now)
  let v = lookup(db, key, now)
  if v != nil and type(v) != "string"
    return WRONGTYPE
  end
  v
end

fn cmd_get(db, args, now)
  get_string(db, args[1], now)
end

# SET key value [NX|XX] [EX s|PX ms|KEEPTTL]
fn cmd_set(db, args, now)
  let key = args[1]
  let nx = false
  let xx = false
  let keep_ttl = false
  let at = nil
  let i = 3
  let n = len(args)
  while i < n
    let opt = string.upper(args[i])
    if opt == "NX" and not xx
      nx = true
    elif opt == "XX" and not nx
      xx = true
    elif opt == "KEEPTTL" and at == nil
      keep_ttl = true
    elif (opt == "EX" or opt == "PX") and at == nil and not keep_ttl and i + 1 < n
      i += 1
      let amount = resp.parse_int(args[i])
      if amount == nil
        return NOT_INT
      end
      if amount <= 0
        return resp.err("ERR invalid expire time in 'set' command")
      end
      if opt == "EX"
        amount = amount * 1000
      end
      at = now + amount
    else
      return SYNTAX
    end
    i += 1
  end
  let exists = lookup(db, key, now) != nil
  if (nx and exists) or (xx and not exists)
    return nil
  end
  db.data[key] = args[2]
  if at != nil
    set_deadline(db, key, at)
  elif not keep_ttl
    clear_deadline(db, key)
  end
  resp.OK
end

fn cmd_mget(db, args, now)
  let out = []
  for i = 1, len(args)
    let v = lookup(db, args[i], now)
    if type(v) != "string"
      v = nil
    end
    push(out, v)
  end
  out
end

fn cmd_mset(db, args, now)
  if len(args) % 2 == 0
    return arity_error("mset")
  end
  let i = 1
  while i < len(args)
    db.data[args[i]] = args[i + 1]
    clear_deadline(db, args[i])
    i += 2
  end
  resp.OK
end

fn incr_by(db, key, by, now)
  let v = get_string(db, key, now)
  if type(v) == "table"
    return v
  end
  let n = 0
  if v != nil
    n = resp.parse_int(v)
    if n == nil
      return NOT_INT
    end
  end
  if (by > 0 and n > INT_MAX - by) or (by < 0 and n < INT_MIN - by)
    return resp.err("ERR increment or decrement would overflow")
  end
  n = n + by
  db.data[key] = "{n}"
  n
end

fn cmd_incr(db, args, now)
  incr_by(db, args[1], 1, now)
end

fn cmd_decr(db, args, now)
  incr_by(db, args[1], -1, now)
end

fn cmd_incrby(db, args, now)
  let by = resp.parse_int(args[2])
  if by == nil then return NOT_INT end
  incr_by(db, args[1], by, now)
end

fn cmd_decrby(db, args, now)
  let by = resp.parse_int(args[2])
  if by == nil or by == INT_MIN then return NOT_INT end
  incr_by(db, args[1], -by, now)
end

fn cmd_append(db, args, now)
  let key = args[1]
  let v = get_string(db, key, now)
  if type(v) == "table"
    return v
  end
  if v == nil
    v = ""
  end
  let s = v + args[2]
  db.data[key] = s
  len(s)
end

fn cmd_strlen(db, args, now)
  let v = get_string(db, args[1], now)
  if type(v) == "table" then return v end
  if v == nil then return 0 end
  len(v)
end

# ─── Keys ──────────────────────────────────────────────────────

fn cmd_del(db, args, now)
  let n = 0
  for i = 1, len(args)
    if lookup(db, args[i], now) != nil
      remove_key(db, args[i])
      n += 1
    end
  end
  n
end

fn cmd_exists(db, args, now)
  let n = 0
  for i = 1, len(args)
    if lookup(db, args[i], now) != nil
      n += 1
    end
  end
  n
end

fn cmd_type(db, args, now)
  let v = lookup(db, args[1], now)
  if v == nil
    return {status: "none"}
  end
  {status: kind_of(v)}
end

fn expire_in(db, key, ms, now)
  if lookup(db, key, now) == nil
    return 0
  end
  if ms <= 0
    remove_key(db, key)
  else
    set_deadline(db, key, now + ms)
  end
  1
end

fn cmd_expire(db, args, now)
  let s = resp.parse_int(args[2])
  if s == nil then return NOT_INT end
  expire_in(db, args[1], s * 1000, now)
end

fn cmd_pexpire(db, args, now)
  let ms = resp.parse_int(args[2])
  if ms == nil then return NOT_INT end
  expire_in(db, args[1], ms, now)
end

fn ttl_ms(db, key, now)
  if lookup(db, key, now) == nil
    return -2
  end
  let at = db.deadlines[key]
  if at == nil
    return -1
  end
  at - now
end

fn cmd_ttl(db, args, now)
  let ms = ttl_ms(db, args[1], now)
  if ms < 0 then return ms end
  (ms + 500) / 1000
end

fn cmd_pttl(db, args, now)
  ttl_ms(db, args[1], now)
end

fn cmd_persist(db, args, now)
  let key = args[1]
  if lookup(db, key, now) == nil or not has_key(db.deadlines, key)
    return 0
  end
  clear_deadline(db, key)
  1
end

fn cmd_keys(db, args, now)
  let pattern = args[1]
  let out = []
  for key in keys(db.data)
    if glob_match(pattern, 0, key, 0) and lookup(db, key, now) != nil
      push(out, key)
    end
  end
  out
end

fn cmd_dbsize(db, args, now)
  size(db)
end

fn cmd_flushdb(db, args, now)
  if len(args) > 2 or (len(args) == 2 and string.upper(args[1]) != "SYNC" and string.upper(args[1]) != "ASYNC")
    return SYNTAX
  end
  db.data = {}
  db.deadlines = {}
  db.expiring = rset.new()
  resp.OK
end

## Returns true when `s` from `si` on matches glob `p` from `pi` on: `*`,
## `?`, `[abc]`, `[^a-z]` and `\x`, as Redis's KEYS.
fn glob_match(p, pi, s, si)
  let pn = len(p)
  let sn = len(s)
  while pi < pn
    let c = ord(p, pi)
    if c == 42
      while pi + 1 < pn and ord(p, pi + 1) == 42
        pi += 1
      end
      if pi + 1 == pn
        return true
      end
      for k = si, sn + 1
        if glob_match(p, pi + 1, s, k)
          return true
        end
      end
      return false
    end
    if si >= sn
      return false
    end
    if c == 63
      pi += 1
    elif c == 91
      let r = match_class(p, pi + 1, ord(s, si))
      if r == nil then return false end
      pi = r
    else
      if c == 92 and pi + 1 < pn
        pi += 1
        c = ord(p, pi)
      end
      if c != ord(s, si) then return false end
      pi += 1
    end
    si += 1
  end
  si == sn
end

# Matches byte `b` against the class starting at `pi` (just after `[`).
# Returns the position after the closing `]`, or nil when `b` is not in it.
fn match_class(p, pi, b)
  let pn = len(p)
  let negate = pi < pn and ord(p, pi) == 94
  if negate
    pi += 1
  end
  let found = false
  while pi < pn and ord(p, pi) != 93
    let c = ord(p, pi)
    if c == 92 and pi + 1 < pn
      pi += 1
      if ord(p, pi) == b then found = true end
    elif pi + 2 < pn and ord(p, pi + 1) == 45 and ord(p, pi + 2) != 93
      let lo = c
      let hi = ord(p, pi + 2)
      if lo > hi
        let t = lo
        lo = hi
        hi = t
      end
      if b >= lo and b <= hi then found = true end
      pi += 2
    elif c == b
      found = true
    end
    pi += 1
  end
  if found == negate
    return nil
  end
  pi + 1
end

# ─── Lists ─────────────────────────────────────────────────────

# The list at `key`: nil when missing, WRONGTYPE for another type, or the
# deque, made when `create`.
fn get_list(db, key, now, create)
  let v = lookup(db, key, now)
  if v == nil
    if not create then return nil end
    v = {kind: "list", items: deque.new()}
    db.data[key] = v
    return v
  end
  if type(v) == "string" or v.kind != "list"
    return WRONGTYPE
  end
  v
end

fn cmd_lpush(db, args, now)
  let l = get_list(db, args[1], now, true)
  if l.error != nil then return l end
  for i = 2, len(args)
    deque.push_front(l.items, args[i])
  end
  deque.size(l.items)
end

fn cmd_rpush(db, args, now)
  let l = get_list(db, args[1], now, true)
  if l.error != nil then return l end
  for i = 2, len(args)
    deque.push_back(l.items, args[i])
  end
  deque.size(l.items)
end

# LPOP/RPOP key [count]
fn pop_list(db, args, now, front)
  let count = if len(args) == 3
    let c = resp.parse_int(args[2])
    if c == nil or c < 0
      return resp.err("ERR value is out of range, must be positive")
    end
    c
  elif len(args) > 3
    return SYNTAX
  end
  let l = get_list(db, args[1], now, false)
  if l == nil
    return nil
  end
  if l.error != nil then return l end
  let out = []
  let n = if count != nil then count else 1 end
  while len(out) < n and deque.size(l.items) > 0
    if front
      push(out, deque.pop_front(l.items))
    else
      push(out, deque.pop_back(l.items))
    end
  end
  if deque.size(l.items) == 0
    remove_key(db, args[1])
  end
  if count == nil
    return out[0]
  end
  out
end

fn cmd_lpop(db, args, now)
  pop_list(db, args, now, true)
end

fn cmd_rpop(db, args, now)
  pop_list(db, args, now, false)
end

fn cmd_llen(db, args, now)
  let l = get_list(db, args[1], now, false)
  if l == nil then return 0 end
  if l.error != nil then return l end
  deque.size(l.items)
end

fn cmd_lrange(db, args, now)
  let start = resp.parse_int(args[2])
  let stop = resp.parse_int(args[3])
  if start == nil or stop == nil then return NOT_INT end
  let l = get_list(db, args[1], now, false)
  if l == nil then return [] end
  if l.error != nil then return l end
  let n = deque.size(l.items)
  if start < 0 then start = start + n end
  if stop < 0 then stop = stop + n end
  if start < 0 then start = 0 end
  if stop >= n then stop = n - 1 end
  let out = []
  let i = start
  while i <= stop
    push(out, deque.at(l.items, i))
    i += 1
  end
  out
end

fn cmd_lindex(db, args, now)
  let i = resp.parse_int(args[2])
  if i == nil then return NOT_INT end
  let l = get_list(db, args[1], now, false)
  if l == nil then return nil end
  if l.error != nil then return l end
  let n = deque.size(l.items)
  if i < 0 then i = i + n end
  if i < 0 or i >= n then return nil end
  deque.at(l.items, i)
end

# ─── Hashes ────────────────────────────────────────────────────

fn get_hash(db, key, now, create)
  let v = lookup(db, key, now)
  if v == nil
    if not create then return nil end
    v = {kind: "hash", fields: {}}
    db.data[key] = v
    return v
  end
  if type(v) == "string" or v.kind != "hash"
    return WRONGTYPE
  end
  v
end

fn cmd_hset(db, args, now)
  if len(args) % 2 != 0
    return arity_error("hset")
  end
  let h = get_hash(db, args[1], now, true)
  if h.error != nil then return h end
  let added = 0
  let i = 2
  while i < len(args)
    if not has_key(h.fields, args[i])
      added += 1
    end
    h.fields[args[i]] = args[i + 1]
    i += 2
  end
  added
end

fn cmd_hget(db, args, now)
  let h = get_hash(db, args[1], now, false)
  if h == nil then return nil end
  if h.error != nil then return h end
  h.fields[args[2]]
end

fn cmd_hdel(db, args, now)
  let h = get_hash(db, args[1], now, false)
  if h == nil then return 0 end
  if h.error != nil then return h end
  let n = 0
  for i = 2, len(args)
    if has_key(h.fields, args[i])
      delete(h.fields, args[i])
      n += 1
    end
  end
  if len(h.fields) == 0
    remove_key(db, args[1])
  end
  n
end

fn cmd_hgetall(db, args, now)
  let h = get_hash(db, args[1], now, false)
  if h == nil then return [] end
  if h.error != nil then return h end
  let out = []
  for f, v in h.fields
    push(out, f)
    push(out, v)
  end
  out
end

fn cmd_hlen(db, args, now)
  let h = get_hash(db, args[1], now, false)
  if h == nil then return 0 end
  if h.error != nil then return h end
  len(h.fields)
end

fn cmd_hexists(db, args, now)
  let h = get_hash(db, args[1], now, false)
  if h == nil then return 0 end
  if h.error != nil then return h end
  if has_key(h.fields, args[2]) then return 1 end
  0
end

# ─── Sets ──────────────────────────────────────────────────────

fn get_set(db, key, now, create)
  let v = lookup(db, key, now)
  if v == nil
    if not create then return nil end
    v = {kind: "set", members: rset.new()}
    db.data[key] = v
    return v
  end
  if type(v) == "string" or v.kind != "set"
    return WRONGTYPE
  end
  v
end

fn cmd_sadd(db, args, now)
  let s = get_set(db, args[1], now, true)
  if s.error != nil then return s end
  let n = 0
  for i = 2, len(args)
    if rset.add(s.members, args[i])
      n += 1
    end
  end
  n
end

fn cmd_srem(db, args, now)
  let s = get_set(db, args[1], now, false)
  if s == nil then return 0 end
  if s.error != nil then return s end
  let n = 0
  for i = 2, len(args)
    if rset.remove(s.members, args[i])
      n += 1
    end
  end
  if rset.size(s.members) == 0
    remove_key(db, args[1])
  end
  n
end

fn cmd_sismember(db, args, now)
  let s = get_set(db, args[1], now, false)
  if s == nil then return 0 end
  if s.error != nil then return s end
  if rset.has(s.members, args[2]) then return 1 end
  0
end

fn cmd_smembers(db, args, now)
  let s = get_set(db, args[1], now, false)
  if s == nil then return [] end
  if s.error != nil then return s end
  rset.members(s.members)
end

fn cmd_scard(db, args, now)
  let s = get_set(db, args[1], now, false)
  if s == nil then return 0 end
  if s.error != nil then return s end
  rset.size(s.members)
end

fn cmd_spop(db, args, now)
  let s = get_set(db, args[1], now, false)
  if s == nil then return nil end
  if s.error != nil then return s end
  let m = rset.pick(s.members)
  rset.remove(s.members, m)
  if rset.size(s.members) == 0
    remove_key(db, args[1])
  end
  m
end

# ─── Dispatch ──────────────────────────────────────────────────

# name → {arity, run}. Arity as in Redis's command table: n means exactly
# n words (the name included), -n at least n.
let COMMANDS = {
  get: {arity: 2, run: cmd_get},
  set: {arity: -3, run: cmd_set},
  mget: {arity: -2, run: cmd_mget},
  mset: {arity: -3, run: cmd_mset},
  incr: {arity: 2, run: cmd_incr},
  decr: {arity: 2, run: cmd_decr},
  incrby: {arity: 3, run: cmd_incrby},
  decrby: {arity: 3, run: cmd_decrby},
  append: {arity: 3, run: cmd_append},
  strlen: {arity: 2, run: cmd_strlen},
  del: {arity: -2, run: cmd_del},
  exists: {arity: -2, run: cmd_exists},
  type: {arity: 2, run: cmd_type},
  expire: {arity: 3, run: cmd_expire},
  pexpire: {arity: 3, run: cmd_pexpire},
  ttl: {arity: 2, run: cmd_ttl},
  pttl: {arity: 2, run: cmd_pttl},
  persist: {arity: 2, run: cmd_persist},
  keys: {arity: 2, run: cmd_keys},
  dbsize: {arity: 1, run: cmd_dbsize},
  flushdb: {arity: -1, run: cmd_flushdb},
  flushall: {arity: -1, run: cmd_flushdb},
  lpush: {arity: -3, run: cmd_lpush},
  rpush: {arity: -3, run: cmd_rpush},
  lpop: {arity: -2, run: cmd_lpop},
  rpop: {arity: -2, run: cmd_rpop},
  llen: {arity: 2, run: cmd_llen},
  lrange: {arity: 4, run: cmd_lrange},
  lindex: {arity: 3, run: cmd_lindex},
  hset: {arity: -4, run: cmd_hset},
  hget: {arity: 3, run: cmd_hget},
  hdel: {arity: -3, run: cmd_hdel},
  hgetall: {arity: 2, run: cmd_hgetall},
  hlen: {arity: 2, run: cmd_hlen},
  hexists: {arity: 3, run: cmd_hexists},
  sadd: {arity: -3, run: cmd_sadd},
  srem: {arity: -3, run: cmd_srem},
  sismember: {arity: 3, run: cmd_sismember},
  smembers: {arity: 2, run: cmd_smembers},
  scard: {arity: 2, run: cmd_scard},
  spop: {arity: 2, run: cmd_spop}
}

# Clients send command names in either case; most send all caps.
for name in keys(COMMANDS)
  COMMANDS[string.upper(name)] = COMMANDS[name]
end

fn arity_error(name)
  resp.err("ERR wrong number of arguments for '{name}' command")
end

## Returns the command named `name` (any case) as `{arity, run}`, or nil.
fn find_command(name)
  let c = COMMANDS[name]
  if c == nil
    c = COMMANDS[string.lower(name)]
  end
  c
end

## Returns the error reply for a command Redis doesn't know: `name` and the
## first arguments of `args`, quoted as Redis quotes them.
fn unknown_command(args)
  let shown = build_string do |add|
    for i = 1, len(args)
      if i > 16 then break end
      add("'", substr(args[i], 0, 128), "' ")
    end
  end
  resp.err("ERR unknown command '{substr(args[0], 0, 128)}', with args beginning with: {shown}")
end

## Runs command `args` (its name first) on `db` at monotonic time `now`
## (ms) and returns the reply, for `resp.encode`. An unknown command or a
## wrong argument count gets the error reply Redis gives.
fn execute(db, args, now)
  let c = find_command(args[0])
  if c == nil
    return unknown_command(args)
  end
  let n = len(args)
  if (c.arity > 0 and n != c.arity) or (c.arity < 0 and n < -c.arity)
    return arity_error(string.lower(args[0]))
  end
  c.run(db, args, now)
end

export new, size, expire_cycle, execute, find_command, glob_match
