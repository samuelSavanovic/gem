# a Redis-compatible in-memory server; `mini_redis --help` for the options

load "std/args"
load "./server"

fn main()
  let opts = args.parse({
    name: "mini_redis",
    max_args: 0,
    options: {
      port: {default: 6379, help: "port to listen on"},
      bind: {default: "127.0.0.1", value: "ADDRESS", help: "address to listen on"}
    }
  })
  let listener = tcp_listen(opts.bind, opts.port)
  server.start(listener)
  print("mini_redis listening on {opts.bind}:{opts.port}")
end
