## The gen_server that keeps channel subscriptions and fans published messages out. A subscriber
## gets `{tag: "message", channel, payload}` for every message on a channel it's subscribed to.

load "std/log"
load "std/gen_server"

let NAME = "mini_redis_pubsub"

# channels: channel -> {"<pid>": pid}; by_pid: "<pid>" -> {channel: true}. String keys because big
# int-keyed sets are linear scans. Subscribers are monitored, so a connection that dies without
# unsubscribing leaves nothing behind.

fn subscribe(s, pid, channel)
  let pk = "{pid}"
  let mine = s.by_pid[pk]
  if mine == nil
    mine = {}
    s.by_pid[pk] = mine
    monitor(pid)
  end
  mine[channel] = true
  let subs = s.channels[channel]
  if subs == nil
    subs = {}
    s.channels[channel] = subs
  end
  subs[pk] = pid
end

fn unsubscribe(s, pid, channel)
  let pk = "{pid}"
  let mine = s.by_pid[pk]
  if mine == nil or not has_key(mine, channel)
    return nil
  end
  delete(mine, channel)
  if len(mine) == 0
    delete(s.by_pid, pk)
    demonitor(pid)
  end
  let subs = s.channels[channel]
  delete(subs, pk)
  if len(subs) == 0
    delete(s.channels, channel)
  end
end

fn forget(s, pid)
  let mine = s.by_pid["{pid}"]
  if mine == nil then return nil end
  for channel in keys(mine)
    unsubscribe(s, pid, channel)
  end
end

fn publish(s, channel, payload)
  let subs = s.channels[channel]
  if subs == nil then return 0 end
  let msg = {tag: "message", channel: channel, payload: payload}
  for pk, pid in subs
    send(pid, msg)
  end
  len(subs)
end

let MODULE = {
  init: fn()
    register(NAME, self())
    {state: {channels: {}, by_pid: {}}}
  end,
  handle_call: fn(msg, from, s)
    match msg
    when {op: "subscribe", channel: channel}
      subscribe(s, from.pid, channel)
      {reply: true, state: s}
    when {op: "unsubscribe", channel: channel}
      unsubscribe(s, from.pid, channel)
      {reply: true, state: s}
    when {op: "publish", channel: channel, payload: payload}
      {reply: publish(s, channel, payload), state: s}
    else
      {reply: nil, state: s}
    end
  end,
  handle_cast: fn(msg, s)
    error("pubsub: unknown cast {msg}")
  end,
  handle_info: fn(msg, s)
    match msg
    when {tag: "DOWN", pid: pid}
      forget(s, pid)
    else
      log.warn("pubsub: unexpected message {msg}")
    end
    {state: s}
  end
}

## Registers it as `NAME` and returns its handle.
fn start()
  gen_server.start(MODULE)
end

## Subscribes the calling process. Waits until done, so a message published after this returns reaches it.
fn join(channel)
  gen_server.call(NAME, {op: "subscribe", channel: channel})
end

fn leave(channel)
  gen_server.call(NAME, {op: "unsubscribe", channel: channel})
end

## Returns how many subscribers `channel` had.
fn publish_to(channel, payload)
  gen_server.call(NAME, {op: "publish", channel: channel, payload: payload})
end

export NAME, start, join, leave, publish_to
