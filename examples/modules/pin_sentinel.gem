# Module-level variable pinned inside a function — exercises renaming of
# `^name` when the module is loaded under a prefix.
let sentinel = "S"

fn classify(v)
  match v
  when ^sentinel
    "sentinel"
  when {k: ^sentinel}
    "nested sentinel"
  else
    "other"
  end
end

# A pattern binding named like a module-level variable refers to the bound
# value inside its arm.
fn unwrap(v)
  match v
  when {k: sentinel}
    sentinel
  end
end

export classify, unwrap
