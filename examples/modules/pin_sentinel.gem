# Module-level variable pinned inside a function — exercises renaming of
# `^name` when the module is loaded under a prefix.
let sentinel = "S"

fn classify(v)
  match v
  when ^sentinel
    "sentinel"
  when {k: ^sentinel}
    "nested sentinel"
  else
    "other"
  end
end

# A pattern binding next to a module-level variable (one named like it is
# a compile error).
fn unwrap(v)
  match v
  when {k: got}
    got
  end
end

export classify, unwrap
