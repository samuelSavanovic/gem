# Exports names bound in every module-scope way: a fn, a let, a
# destructuring let, a selective import and a loaded module's namespace.
load "std/string"
load "std/string" (upper)

fn double(n)
  n * 2
end

fn hidden()
  "private"
end

let limit = 10
let {lo, hi} = {lo: 1, hi: 9}

export double, limit, lo, hi, upper, string
