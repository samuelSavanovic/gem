# for 123: block-scoped names in module top-level code that reuse a module name (or one the loading
# program uses at top level) must shadow, not write either slot
let x = 1
let fs = []
for x in [10, 20]
  push(fs, fn() x end)
end
let z = "mod-z"
if true
  let bz = "block-z"
  push(fs, fn() bz end)
end
for y in ["mod-loop"]
  push(fs, fn() y end)
end

# module-scope destructuring binds prefixed module names, so two modules can destructure the same names
let {a, b} = {a: "mod-a", b: "mod-b"}

fn shadow_report()
  [fs[0](), fs[1](), fs[2](), fs[3](), x, z, a, b]
end

export shadow_report
