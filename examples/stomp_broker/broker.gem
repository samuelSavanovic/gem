## broker — the STOMP broker's supervision tree (see README.md).

load "std/supervisor"
load "std/dynamic_supervisor"
load "./destination"
load "./registry"
load "./connection"

fn accept_loop(listener)
  let next_id = 0
  while true
    let fd = tcp_accept(listener)
    next_id += 1
    let r = pcall connection.start(fd, next_id)
    if not r.ok
      # process table full: refuse this client
      tcp_close(fd)
    end
  end
end

## Starts the broker on `listener` and returns the supervisor's handle.
## `stop` doesn't close the listener.
fn start(listener)
  supervisor.start({
    strategy: "one_for_one",
    name: "stomp_broker_sup",
    children: [
      # Temporary children: a crashed destination has lost its subscribers,
      # so the registry starts a fresh one on the next lookup instead.
      {id: "destinations", start: fn()
        dynamic_supervisor.start({
          name: registry.DESTINATIONS,
          child: {start: fn(args) destination.start(args.name, args.kind) end, restart: "temporary"}
        })
      end},
      {id: "registry", start: registry.start},
      {id: "acceptor", start: fn()
        spawn do
          accept_loop(listener)
        end
      end}
    ]
  })
end

## Stops the broker; open connections stay open until their clients leave.
fn stop(sup)
  supervisor.stop(sup)
end

export start, stop
