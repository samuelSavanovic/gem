## broker — the STOMP broker's supervision tree (see README.md).

load "std/supervisor"
load "std/dynamic_supervisor"
load "./destination"
load "./registry"
load "./connection"

# Accepting fails when the process is out of file descriptors: log it
# once and retry every 50 ms until it succeeds again.
fn accept_loop(listener, write_timeout_ms)
  let next_id = 0
  let failing = false
  while true
    let a = pcall tcp_accept(listener)
    if not a.ok
      if not failing
        eprint("stomp: {a.error}; retrying")
        failing = true
      end
      sleep(50)
      continue
    end
    failing = false
    let fd = a.value
    next_id += 1
    let r = pcall connection.start(fd, next_id, write_timeout_ms)
    if not r.ok
      # process table full: refuse this client
      tcp_close(fd)
    end
  end
end

## Starts the broker on `listener` and returns the supervisor's handle.
## A client that doesn't take a frame within `write_timeout_ms` is
## disconnected. `stop` doesn't close the listener.
fn start(listener, {write_timeout_ms = 10000} = {})
  supervisor.start({
    strategy: "one_for_one",
    name: "stomp_broker_sup",
    children: [
      # Temporary children: after a crash the registry starts a fresh one
      # on the next lookup, and the connections subscribe to it again.
      {id: "destinations", start: fn()
        dynamic_supervisor.start({
          name: registry.DESTINATIONS,
          child: {start: fn(args) destination.start(args.name, args.kind) end, restart: "temporary"}
        })
      end},
      {id: "registry", start: registry.start},
      {id: "acceptor", start: fn()
        spawn do
          accept_loop(listener, write_timeout_ms)
        end
      end}
    ]
  })
end

## Stops the broker. Connections aren't part of it: each one left open
## gets an ERROR and is closed when it next needs a destination, a
## subscriber as soon as its destinations stop.
fn stop(sup)
  supervisor.stop(sup)
end

export start, stop
