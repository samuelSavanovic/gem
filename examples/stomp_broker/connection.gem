## connection — one client connection: a writer and a reader process.
##
##   connection.start(fd, 7)    # 7 becomes the session id
##
## The writer owns the socket's writes and runs the protocol: it handles
## the frames the reader parses and the MESSAGEs destinations deliver. The
## reader only reads and parses. Splitting them lets the writer wait in one
## `receive` for both, without ever blocking in `tcp_read`.

load "std/gen_server"
load "std/string"
load "./frame"
load "./registry"

let READ_SIZE = 65536

# ─── Reader ────────────────────────────────────────────────────

# Reads frames until the client closes, and sends each to `writer` as
# {tag: "frame", frame}. Then sends {tag: "eof"}, or {tag: "bad_frame"}
# on a frame that doesn't parse.
#
# No read timeout: the broker offers no heart-beats ("0,0" in CONNECTED),
# so a subscriber that is quiet for hours is still a live client.
fn reader_loop(fd, writer)
  # Bytes of a frame that hasn't ended yet. A chunk without a NUL only
  # adds to it, so a large frame arriving in many chunks is copied once.
  let pending = buf_new()
  while true
    let chunk = tcp_read(fd, READ_SIZE)
    if chunk == nil or chunk == ""
      send(writer, {tag: "eof"})
      return nil
    end
    if string.index_of(chunk, "\0") < 0
      buf_push(pending, chunk)
      continue
    end
    let rest = send_frames(to_string(pending) + chunk, writer)
    if rest == nil
      return nil
    end
    pending = buf_new()
    buf_push(pending, rest)
  end
end

# Sends every complete frame in `data` to `writer` and returns the bytes
# after the last one, or nil after a malformed frame.
fn send_frames(data, writer)
  let pos = 0
  while true
    pos = skip_heartbeats(data, pos)
    let nul = string.index_of(data, "\0", pos)
    if nul < 0
      return substr(data, pos, len(data) - pos)
    end
    let f = frame.parse_frame(substr(data, pos, nul - pos))
    if f == nil
      send(writer, {tag: "bad_frame"})
      return nil
    end
    send(writer, {tag: "frame", frame: f})
    pos = nul + 1
  end
end

# A heart-beat is a bare newline (LF or CRLF) between frames.
fn skip_heartbeats(data, pos)
  let n = len(data)
  while pos < n
    let c = ord(data, pos)
    if c != 10 and c != 13
      break
    end
    pos += 1
  end
  pos
end

# ─── Writer ────────────────────────────────────────────────────

# Every handler takes the connection state and a frame and returns true
# to keep the connection open, false to close it.

fn writer_loop(conn)
  while true
    receive
    when {tag: "frame", frame: f}
      if not handle_frame(conn, f) then return nil end
    when {tag: "deliver", frame: f}
      if not write_frame(conn, f) then return nil end
    when {tag: "eof"}
      return nil
    when {tag: "bad_frame"}
      send_error(conn, "malformed frame")
      return nil
    when {tag: "EXIT", reason: reason}
      # The reader ended. After a normal exit its eof is already here or
      # handled; any other reason means it crashed.
      if reason != "normal" then return nil end
    when other
      nil
    end
  end
end

fn handle_frame(conn, f)
  if not conn.connected
    if f.command == "CONNECT" or f.command == "STOMP"
      return handle_connect(conn, f)
    end
    return send_error(conn, "expected CONNECT, got {f.command}")
  end
  let ok = dispatch(conn, f)
  let receipt = f.headers.receipt
  if ok and receipt != nil
    ok = write_frame(conn, {command: "RECEIPT", headers: {"receipt-id": receipt}, body: ""})
  end
  ok and f.command != "DISCONNECT"
end

fn dispatch(conn, f)
  match f.command
  when "SUBSCRIBE" then handle_subscribe(conn, f)
  when "UNSUBSCRIBE" then handle_unsubscribe(conn, f)
  when "SEND" then handle_send(conn, f)
  when "DISCONNECT" then true
  else
    send_error(conn, "unknown command: {f.command}")
  end
end

fn handle_connect(conn, f)
  conn.connected = true
  write_frame(conn, {
    command: "CONNECTED",
    headers: {version: "1.2", session: "{conn.id}", "heart-beat": "0,0"},
    body: ""
  })
end

fn handle_subscribe(conn, f)
  let destination = f.headers.destination
  let id = f.headers.id
  if destination == nil or id == nil
    return send_error(conn, "SUBSCRIBE requires destination and id headers")
  end
  if has_key(conn.subs, id)
    return send_error(conn, "subscription id {id} is already in use")
  end
  let dest = registry.lookup_or_create(destination)
  gen_server.cast(dest, {op: "subscribe", conn_pid: self(), sub_id: id})
  conn.subs[id] = dest
  true
end

fn handle_unsubscribe(conn, f)
  let id = f.headers.id
  if id == nil
    return send_error(conn, "UNSUBSCRIBE requires an id header")
  end
  let dest = conn.subs[id]
  if dest != nil
    gen_server.cast(dest, {op: "unsubscribe", conn_pid: self(), sub_id: id})
    delete(conn.subs, id)
  end
  true
end

fn handle_send(conn, f)
  let destination = f.headers.destination
  if destination == nil
    return send_error(conn, "SEND requires a destination header")
  end
  let dest = registry.lookup_or_create(destination)
  gen_server.cast(dest, {op: "publish", body: f.body, headers: f.headers})
  true
end

# Writes `f` and returns whether all of it went out. A client that stops
# reading blocks this write, and deliveries queue up in the writer's
# mailbox meanwhile.
fn write_frame(conn, f)
  let bytes = frame.render_frame(f)
  tcp_write(conn.fd, bytes) == len(bytes)
end

# Sends an ERROR frame. Returns false: STOMP closes the connection after
# an ERROR.
fn send_error(conn, message)
  write_frame(conn, {command: "ERROR", headers: {message: message}, body: ""})
  false
end

# The writer process: starts the reader, runs the protocol, then closes the
# socket on every path, a crash included. It traps exits so that a reader
# that crashes arrives as a message instead of killing it before the close.
fn run_writer(fd, id)
  process_flag("trap_exit", true)
  let reader = nil
  let r = pcall do
    let me = self()
    reader = spawn_link do
      reader_loop(fd, me)
    end
    writer_loop({fd: fd, id: id, connected: false, subs: {}})
  end
  if reader != nil
    kill(reader, "shutdown")
  end
  tcp_close(fd)
  if not r.ok
    error(r.error)
  end
end

## Starts the processes for the accepted socket `fd` and returns the
## writer's pid; `id` becomes the session id. They own `fd` from here on
## and close it when the client leaves.
##
## Raises `spawn: process table full` when no process can start; `fd` is
## then still the caller's to close.
fn start(fd, id)
  spawn do
    run_writer(fd, id)
  end
end

export start
