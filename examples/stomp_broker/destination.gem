## destination — one topic or queue: a gen_server holding its subscribers.
##
##   let pid = destination.start("/topic/news", "topic").pid
##   gen_server.cast(pid, {op: "subscribe", conn_pid: writer, sub_id: "s1"})
##   gen_server.cast(pid, {op: "publish", body: "hi", headers: {}})
##   gen_server.call(pid, {op: "info"})    # {name, kind, subscribers: 1}
##
## `conn_pid` is a connection's writer; it gets `{tag: "deliver", frame}`.

load "std/gen_server"

fn remove_subs(state, keep)
  let kept = []
  for s in state.subs
    if keep(s)
      push(kept, s)
    end
  end
  state.subs = kept
  if state.next >= len(kept)
    state.next = 0
  end
end

fn deliver(state, body, publish_headers)
  let n = len(state.subs)
  if n == 0
    return nil
  end
  if state.kind == "topic"
    for s in state.subs
      send_message(state, s, body, publish_headers)
    end
  else
    send_message(state, state.subs[state.next], body, publish_headers)
    state.next = (state.next + 1) % n
  end
end

fn send_message(state, sub, body, publish_headers)
  state.next_msg_id = state.next_msg_id + 1
  let headers = {
    destination: state.name,
    "message-id": "{state.next_msg_id}",
    subscription: sub.sub_id
  }
  if has_key(publish_headers, "content-type")
    headers["content-type"] = publish_headers["content-type"]
  end
  send(sub.conn_pid, {tag: "deliver", frame: {command: "MESSAGE", headers: headers, body: body}})
end

fn server(name, kind)
  {
    init: fn()
      {state: {name: name, kind: kind, subs: [], next: 0, next_msg_id: 0}}
    end,

    handle_call: fn(msg, from, state)
      match msg
      when {op: "info"}
        {reply: {name: state.name, kind: state.kind, subscribers: len(state.subs)}, state: state}
      else
        error("destination: unknown call {msg}")
      end
    end,

    handle_cast: fn(msg, state)
      match msg
      when {op: "subscribe", conn_pid: cp, sub_id: sid}
        monitor(cp)    # its DOWN drops what a vanished client left behind
        push(state.subs, {conn_pid: cp, sub_id: sid})
      when {op: "unsubscribe", conn_pid: cp, sub_id: sid}
        remove_subs(state, fn(s) s.conn_pid != cp or s.sub_id != sid end)
      when {op: "publish", body: body, headers: headers}
        deliver(state, body, headers)
      else
        error("destination: unknown cast {msg}")
      end
      {state: state}
    end,

    handle_info: fn(msg, state)
      match msg
      when {tag: "DOWN", pid: dead}
        remove_subs(state, fn(s) s.conn_pid != dead end)
      else
        nil
      end
      {state: state}
    end
  }
end

## Starts destination `name` of `kind` ("topic" or "queue"); returns `{pid}`.
fn start(name, kind)
  gen_server.start(server(name, kind))
end

export start
