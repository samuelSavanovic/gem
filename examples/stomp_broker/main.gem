# A STOMP 1.2 broker: topics, queues, receipts, no persistence.
#
#   build/gem examples/stomp_broker/main.gem
#
# then talk to it on port 61613 (README.md has a session to paste into
# nc). test.gem runs the broker against a client written in Gem.

load "./broker"

let PORT = 61613

fn main()
  let listener = tcp_listen("0.0.0.0", PORT)
  broker.start(listener)
  print("STOMP broker listening on port {PORT}")
end
