# lsp/server.gem — main loop. Reads stdin frames via rpc, dispatches each
# through the dispatcher returned by handlers.make_dispatcher().
#
# The loop is synchronous: rpc.read_message blocks the OS thread
# (fgets/fread on stdin), so spawning per-request workers wouldn't run
# concurrently with the next read. Doc-process send/receive yields
# cooperatively, so registered doc processes get scheduled between frames.
# A request cannot be cancelled mid-flight; docs/LSP_ROADMAP.md
# ("Synchronous main loop instead of spawn-per-request") describes what
# that would take.

load "./rpc"
load "./handlers"
load "./workspace"

fn run()
  # Spawn the workspace process from main before the dispatcher loop.
  # It owns a cross-file AST/symbol cache for goto-def + completion.
  workspace.start()
  let d = handlers.make_dispatcher()
  while true
    let msg = rpc.read_message()
    if msg == nil
      exit(0)
    end
    d.dispatch(msg)
  end
end

export run
