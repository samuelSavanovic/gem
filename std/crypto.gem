## crypto — SHA-256 digests, HMAC-SHA256, and comparing secrets.
##
##   load "std/crypto"
##   crypto.sha256_hex("abc")          # "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
##   let sig = crypto.hmac_sha256_hex(secret, body)
##   crypto.equal(sig, header_sig)     # compare in constant time
##
## The raw forms return 32 bytes; the `_hex` forms return them as 64
## lowercase hex digits. Strings are bytes, so text hashes as its UTF-8
## bytes. An argument that isn't a string raises `crypto.<fn>: <arg> must
## be a string, got <type>`. Hashing runs inline on the scheduler thread,
## at about 175 MB/s (macOS arm64, `-o` build).

load "std/hex"

extern fn gem_sha256(s: Bytes) -> Table
extern fn gem_hmac_sha256(key: Bytes, msg: Bytes) -> Table
extern fn gem_bytes_equal_ct(a: Bytes, b: Bytes) -> Bool

fn check(fname, what, s)
  if type(s) != "string"
    error("crypto.{fname}: {what} must be a string, got {type(s)}")
  end
end

## Returns the SHA-256 digest of `s`: 32 bytes.
fn sha256(s)
  check("sha256", "s", s)
  gem_sha256(s)
end

## Returns the SHA-256 digest of `s` as 64 hex digits.
##
##   crypto.sha256_hex("")    # "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
fn sha256_hex(s)
  check("sha256_hex", "s", s)
  hex.encode(gem_sha256(s))
end

## Returns the HMAC-SHA256 of `msg` under `key`: 32 bytes. A key longer
## than 64 bytes is hashed first, as RFC 2104 says.
fn hmac_sha256(key, msg)
  check("hmac_sha256", "key", key)
  check("hmac_sha256", "msg", msg)
  gem_hmac_sha256(key, msg)
end

## Returns the HMAC-SHA256 of `msg` under `key` as 64 hex digits.
##
##   crypto.hmac_sha256_hex("key", "The quick brown fox jumps over the lazy dog")
##   # "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
fn hmac_sha256_hex(key, msg)
  check("hmac_sha256_hex", "key", key)
  check("hmac_sha256_hex", "msg", msg)
  hex.encode(gem_hmac_sha256(key, msg))
end

## Returns true when `a` and `b` hold the same bytes, taking a time that
## depends only on their lengths: use it, not `==`, to check a MAC or a
## token, so the time doesn't tell an attacker how much of a guess was
## right.
fn equal(a, b)
  check("equal", "a", a)
  check("equal", "b", b)
  gem_bytes_equal_ct(a, b)
end

export sha256, sha256_hex, hmac_sha256, hmac_sha256_hex, equal
