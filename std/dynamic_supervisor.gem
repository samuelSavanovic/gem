## dynamic_supervisor — start children on demand from one template and
## restart them when they die.
##
##   let ds = dynamic_supervisor.start({child: {start: fn(args) worker(args) end}})
##   let pid = dynamic_supervisor.start_child(ds, {id: 1})
##   dynamic_supervisor.which_children(ds)    # [{pid: pid, args: {id: 1}}]
##   dynamic_supervisor.terminate_child(ds, pid)    # true
##
## A supervisor (the `target` argument) is named by the `{pid}` handle
## `start` returns, a bare pid or a registered name; a name nobody holds,
## also that of a supervisor that has stopped, raises
## `dynamic_supervisor.<fn>: no process registered as "<name>"`. Every
## call but `start` blocks the caller, and `start_child`,
## `terminate_child` and `which_children` raise `dynamic_supervisor.<fn>:
## supervisor exited: <reason>` at once when it is dead or dies first, and
## `...: timeout` after `timeout_ms` (nil: no limit). They monitor the
## supervisor only for the call and leave no monitor or `DOWN` behind, but
## after a timeout a late `{tag: "_dsup_reply"}` may land in the caller's
## mailbox.
##
## Stopping a child (`terminate_child`, the supervisor's own shutdown)
## sends it the exit signal `"shutdown"`, then, if it is still running
## after its `shutdown` budget, the untrappable `"kill"`.

# Design. Mirrors Erlang `simple_one_for_one` / Elixir `DynamicSupervisor`:
# every child is started from the same template, and a crashed child is
# restarted by replaying `template.start(args)` with its original args.
# The supervisor traps exits and monitors and links each child. The
# restart signal is the child's DOWN; the EXIT a child's death also sends
# is dropped. The runtime queues a dead process's DOWN before its EXIT,
# so the EXIT is always dropped right after its DOWN is taken, and any
# EXIT the main loop sees is an exit signal (a `kill` of the supervisor,
# from a child as well as from anyone else). A child's budget comes from
# the template's `shutdown`, else from an int or nil `shutdown` key on the
# handle its `start` returned (a supervisor's handle has `shutdown: nil`),
# else DEFAULT_SHUTDOWN_MS; stop_child applies it. When the supervisor
# exits (an exit signal, `stop`, restart intensity reached, or any error
# in the supervisor, but not the untrappable "kill", which ends it at
# once), it first stops each child that way, last started first (a
# restarted child keeps its place); then it exits. terminate_child stops
# the child inside the supervisor, which answers nothing else meanwhile. Requests are answered with `_dsup_reply`
# messages carrying a pcall-shaped result.

let RESTARTS = {permanent: true, transient: true, temporary: true}
# How long a child gets to exit after "shutdown" before it is killed, when
# neither the template nor the child's handle says (see the top of the
# file).
let DEFAULT_SHUTDOWN_MS = 5000
let INTENSITY = "dynamic_supervisor: max restart intensity reached"

# A bare pid, a `{pid}` handle or a registered name → pid; nil for a name
# nobody holds or anything else.
fn pid_of(t)
  let kind = type(t)
  if kind == "int"
    return t
  end
  if kind == "string"
    return whereis(t)
  end
  if kind == "table" and type(t.pid) == "int"
    return t.pid
  end
  nil
end

# As pid_of, but raises `<caller>: ...` instead of returning nil.
fn target_pid(target, caller)
  let pid = pid_of(target)
  if pid == nil
    if type(target) == "string"
      error("{caller}: no process registered as \"{target}\"")
    end
    error("{caller}: expected a pid, a \{pid\} handle or a registered name, got {type(target)}")
  end
  pid
end

# The pid a child's `start` returned, which may be a `{pid}` handle.
fn started_pid(v)
  let pid = v
  if type(v) == "table"
    pid = v.pid
  end
  if type(pid) != "int"
    error("child start must return a pid or a \{pid\} handle, got {type(v)}")
  end
  pid
end

# A child's shutdown budget: the template's `shutdown`, else the one the
# handle its `start` returned asks for, else DEFAULT_SHUTDOWN_MS.
fn shutdown_of(template, handle)
  if has_key(template, "shutdown")
    return template.shutdown
  end
  # The handle belongs to the child's own API: only an int or nil there is
  # a budget; anything else (a `shutdown` method, say) is no marker.
  if type(handle) == "table" and has_key(handle, "shutdown")
    let s = handle.shutdown
    if s == nil or type(s) == "int"
      return s
    end
  end
  DEFAULT_SHUTDOWN_MS
end

# Starts a child from the template: {pid, args, shutdown}.
fn start_from_template(state, args)
  let handle = state.template.start(args)
  let pid = started_pid(handle)
  let shutdown = shutdown_of(state.template, handle)
  monitor(pid)
  # A child that has already exited gives an EXIT "noproc" here (the
  # supervisor traps exits) after its DOWN "noproc".
  link(pid)
  {pid: pid, args: args, shutdown: shutdown}
end

# Drops the EXIT that the death of `pid` (with `reason`) queued right after
# its DOWN, which the caller has just taken. Matching the reason leaves an
# exit signal the child sent before it died (`kill(sup, r)`) in the mailbox.
fn drop_exit(pid, reason)
  receive
  when {tag: "EXIT", pid: ^pid, reason: ^reason}
    nil
  after 0
    nil
  end
end

fn check_intensity(state)
  let now = time_ms()
  let recent = [now]
  for t in state.restart_times
    if now - t <= state.max_seconds
      push(recent, t)
    end
  end
  state.restart_times = recent
  if len(recent) > state.max_restarts
    error(INTENSITY)
  end
end

# The index of the running child `pid` in `children`, or -1.
fn find_child_index(children, pid)
  if pid == -1
    return -1
  end
  for i, c in children
    if c.pid == pid
      return i
    end
  end
  -1
end

fn reply(to, ref, res)
  send(to, {tag: "_dsup_reply", ref: ref, result: res})
end

fn handle_start_child(state, args, to, ref)
  let res = pcall(fn() start_from_template(state, args) end)
  if res.ok
    push(state.children, res.value)
    res.value = res.value.pid
  end
  reply(to, ref, res)
end

# Takes the DOWN of `pid` within `timeout_ms` (nil: no limit): its reason,
# or nil after the timeout.
fn await_down(pid, timeout_ms)
  if timeout_ms == nil
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return reason
    end
  end
  receive
  when {tag: "DOWN", pid: ^pid, reason: reason}
    reason
  after timeout_ms
    nil
  end
end

# Stops the child `pid`: the exit signal "shutdown", up to `shutdown` ms
# (nil: no limit) for its DOWN, then the untrappable "kill". Takes its DOWN
# and drops the EXIT that follows, also for a child that had died already
# and whose DOWN is still queued. Returns the DOWN's reason, or nil when
# there was none left to take.
fn stop_child(pid, shutdown)
  if not kill(pid, "shutdown")
    let gone = await_down(pid, 0)
    if gone != nil
      drop_exit(pid, gone)
    end
    return gone
  end
  let reason = await_down(pid, shutdown)
  if reason == nil
    kill(pid, "kill")
    # The DOWN is queued by now: the child was alive when the wait ended,
    # and kill delivers it, or it died just then and delivered it itself.
    reason = await_down(pid, nil)
  end
  drop_exit(pid, reason)
  reason
end

# Stops the child (stop_child) and removes it, then answers. The
# supervisor handles nothing else meanwhile.
fn handle_terminate_child(state, pid, to, ref)
  let idx = find_child_index(state.children, pid)
  if idx == -1
    reply(to, ref, {ok: true, value: false})
    return nil
  end
  stop_child(pid, state.children[idx].shutdown)
  remove_at(state.children, idx)
  reply(to, ref, {ok: true, value: true})
end

# A child that was already gone when the supervisor monitored it gives
# "noproc": its real exit reason is unknown, and a transient child is taken
# to have exited normally.
fn should_restart(restart, reason)
  if restart == "permanent"
    return true
  end
  restart == "transient" and reason != "normal" and reason != "shutdown" and reason != "noproc"
end

fn handle_down(state, pid, reason)
  let idx = find_child_index(state.children, pid)
  if idx == -1
    return nil
  end
  drop_exit(pid, reason)
  if not should_restart(state.template.restart, reason)
    remove_at(state.children, idx)
    return nil
  end
  check_intensity(state)
  state.children[idx] = pending(state.children[idx].args)
  start_pending(state)
end

# A child that isn't running and is owed a restart (start_pending).
fn pending(args)
  {pid: -1, args: args, shutdown: nil, pending: true}
end

fn is_pending(child)
  child.pending == true
end

fn has_pending(children)
  for c in children
    if is_pending(c)
      return true
    end
  end
  false
end

# Prints the error of a restart's `start` and where it was raised.
fn report_failed_restart(res)
  eprint("dynamic_supervisor: restart of a child failed: {res.error}")
  for f in res.stack
    eprint("  at {f.name} ({f.file}:{f.line})")
  end
end

# Starts the pending children in order, up to the first whose `start`
# raises: that one and the pending ones after it stay pending, and a
# `_dsup_retry` message to the supervisor itself (one queued at a time)
# makes dsup_loop try again, counted as a restart.
fn start_pending(state)
  for i = 0, len(state.children)
    let c = state.children[i]
    if is_pending(c)
      let started = pcall start_from_template(state, c.args)
      if not started.ok
        report_failed_restart(started)
        if not state.retry_queued
          state.retry_queued = true
          send(self(), {tag: "_dsup_retry"})
        end
        return nil
      end
      state.children[i] = started.value
    end
  end
  nil
end

fn handle_which_children(state, to, ref)
  let result = []
  for c in state.children
    if c.pid != -1
      push(result, {pid: c.pid, args: c.args})
    end
  end
  reply(to, ref, {ok: true, value: result})
end

# Runs until the supervisor must exit, and returns the exit reason.
fn dsup_loop(state)
  receive
  when {tag: "_dsup_start_child", args: args, reply_to: to, ref: ref}
    handle_start_child(state, args, to, ref)
    dsup_loop(state)
  when {tag: "_dsup_terminate_child", pid: pid, reply_to: to, ref: ref}
    handle_terminate_child(state, pid, to, ref)
    dsup_loop(state)
  when {tag: "DOWN", pid: pid, reason: reason}
    handle_down(state, pid, reason)
    dsup_loop(state)
  when {tag: "_dsup_which_children", reply_to: to, ref: ref}
    handle_which_children(state, to, ref)
    dsup_loop(state)
  when {tag: "_dsup_retry"}
    state.retry_queued = false
    if has_pending(state.children)
      check_intensity(state)
      start_pending(state)
    end
    dsup_loop(state)
  when {tag: "EXIT", reason: reason}
    if reason != "normal"
      # An exit signal (`kill(sup, "shutdown")`, from a child or anyone
      # else, or a linked parent that died; see the top of the file).
      return reason
    end
    dsup_loop(state)
  when other
    dsup_loop(state)
  end
end

# Stops every running child, last started first (a restarted child keeps
# its place; stop_child), whatever the supervisor's own exit reason: a
# child that traps exits only has to know "shutdown".
fn shutdown_children(children)
  let i = len(children) - 1
  while i >= 0
    if children[i].pid != -1
      stop_child(children[i].pid, children[i].shutdown)
    end
    i -= 1
  end
end

# The re-raise below reports its own stack: print where the error came
# from first, unless it is the intensity error, whose origin says nothing.
fn report_stack(res)
  if res.error != INTENSITY
    eprint("dynamic_supervisor: exiting on an error raised at:")
    for f in res.stack
      eprint("  at {f.name} ({f.file}:{f.line})")
    end
  end
end

# The supervisor process: runs the loop, and on the way out (an exit
# signal or an error) shuts the children down before it exits with the
# same reason.
fn dsup_main(state, caller, ref)
  process_flag("trap_exit", true)
  send(caller, {tag: "_dsup_started", ref: ref})
  let res = pcall dsup_loop(state)
  let reason = res.value
  if not res.ok
    reason = res.error
  end
  shutdown_children(state.children)
  if not res.ok
    report_stack(res)
    error(res.error)
  end
  process_flag("trap_exit", false)
  kill(self(), reason)
end

## Spawns a dynamic supervisor with no children and returns its handle
## `{pid, shutdown: nil}`.
##
## `opts.child` is the template `{start, restart, shutdown}`: `start(args)`
## spawns a child and returns its pid or `{pid}` handle (not a registered
## name, as `supervisor` allows; the process such a `start` spawned is left
## running, unsupervised); `restart` is `"permanent"` (the default: always
## restart), `"transient"` (restart unless it exits with `"normal"`,
## `"shutdown"` or `"noproc"`) or `"temporary"` (never); `shutdown` is how long, in
## milliseconds, a child gets to exit after `"shutdown"` before it is
## killed with the untrappable `"kill"` (an int `<= 0` doesn't wait; `nil`
## waits with no limit). Left out, each child's budget comes from an int
## or `nil` `shutdown` key on the handle its `start` returned, else 5000.
## The supervisor gives up and exits when more than `opts.max_restarts`
## (default 3) restarts fall within `opts.max_seconds` MILLISECONDS,
## despite the name (default 5000, i.e. 5 s). `opts.name` registers it.
##
## Raises, and starts nothing, for bad options or a name that is taken.
##
## A restart whose `start` raises (a gen_server whose `init` fails, say)
## is printed on stderr and tried again, after the requests already
## queued; each try counts as a restart, so the restart limit ends a
## `start` that keeps failing. Until a try succeeds, `which_children`
## leaves the child out.
##
## Returns once the supervisor process traps exits, so a `kill` of it is
## handled from then on. The supervisor is not linked to the caller: the caller
## dying leaves it running, and it dying doesn't kill the caller. Its exit
## reason is the exit signal's reason or `"dynamic_supervisor: max restart
## intensity reached"`, which is also printed on stderr. Before it exits
## it stops its children as `terminate_child` does, last started first (a
## restarted child keeps its place). `kill(ds.pid, reason)` is handled
## when it next reads its mailbox; use `stop` to know it is gone.
## `kill(ds.pid, "kill")` ends it at once, without stopping its children.
fn start(opts)
  if type(opts) != "table"
    error("dynamic_supervisor.start: expected an options table \{child, ...\}, got {type(opts)}")
  end
  let {child, max_restarts = 3, max_seconds = 5000, name = nil} = opts
  if type(child) != "table"
    error("dynamic_supervisor.start: expected a child template \{start, restart, shutdown\}, got {type(child)}")
  end
  if type(child.start) != "fn"
    error("dynamic_supervisor.start: the child template's start must be a fn, got {type(child.start)}")
  end
  let {start, restart = "permanent"} = child
  if not has_key(RESTARTS, restart)
    error("dynamic_supervisor.start: unknown restart \"{restart}\"")
  end
  if type(max_restarts) != "int"
    error("dynamic_supervisor.start: max_restarts must be an int, got {type(max_restarts)}")
  end
  if type(max_seconds) != "int"
    error("dynamic_supervisor.start: max_seconds must be an int (milliseconds), got {type(max_seconds)}")
  end
  if name != nil
    if type(name) != "string"
      error("dynamic_supervisor.start: name must be a string, got {type(name)}")
    end
    if whereis(name) != nil
      error("dynamic_supervisor.start: the name \"{name}\" is already registered")
    end
  end
  let template = {start: start, restart: restart}
  if has_key(child, "shutdown")
    if child.shutdown != nil and type(child.shutdown) != "int"
      error("dynamic_supervisor.start: the child template's shutdown must be an int (milliseconds) or nil, got {type(child.shutdown)}")
    end
    template.shutdown = child.shutdown
  end
  let caller = self()
  let ref = make_ref()
  let pid = spawn do
    dsup_main({
      template: template,
      children: [],
      max_restarts: max_restarts,
      max_seconds: max_seconds,
      restart_times: [],
      retry_queued: false
    }, caller, ref)
  end
  # The new process hasn't run yet: register it here, so the name is taken
  # before anything else can run.
  if name != nil
    register(name, pid)
  end
  # Wait until it traps exits, so a `kill` of it from here on is handled.
  monitor(pid)
  receive
  when {tag: "_dsup_started", ref: ^ref}
    drop_monitor(pid, true)
  when {tag: "DOWN", pid: ^pid, reason: reason}
    error("dynamic_supervisor.start: supervisor exited: {reason}")
  end
  # `shutdown: nil`: a supervisor above this one waits for its whole
  # shutdown instead of killing it midway (see the top of the file).
  {pid: pid, shutdown: nil}
end

fn check_timeout(timeout_ms, caller)
  if timeout_ms != nil and type(timeout_ms) != "int"
    error("{caller}: timeout must be an int (milliseconds) or nil, got {type(timeout_ms)}")
  end
end

# Ends the monitor of `pid` a request took: `added` is what its `monitor`
# returned. A monitor the caller already had is left alone. One the request
# added is removed, and its DOWN dropped if the target died meanwhile.
fn drop_monitor(pid, added)
  if added and not demonitor(pid)
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    after 0
      nil
    end
  end
end

# After a request matched the DOWN of `pid` (with `reason`): when the
# monitor was the caller's own (`added` false), puts the DOWN back for it.
fn return_down(pid, added, reason)
  if not added
    send(self(), {tag: "DOWN", pid: pid, reason: reason})
  end
  nil
end

# Waits for the reply to `ref` or the DOWN of `pid`: {result} or {down}.
fn await_reply(pid, ref)
  receive
  when {tag: "_dsup_reply", ref: ^ref, result: res}
    {result: res}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  end
end

# As await_reply, or nil after `timeout_ms`.
fn await_reply_for(pid, ref, timeout_ms)
  receive
  when {tag: "_dsup_reply", ref: ^ref, result: res}
    {result: res}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  after timeout_ms
    nil
  end
end

# Sends `msg` to the supervisor `target` and waits for its reply (forever
# when `timeout_ms` is nil). Raises `<caller>: ...` when the supervisor is
# dead or dies, when `timeout_ms` passes, or with the error the request
# failed with.
fn request(target, msg, caller, timeout_ms)
  let pid = target_pid(target, caller)
  check_timeout(timeout_ms, caller)
  let ref = make_ref()
  msg.reply_to = self()
  msg.ref = ref
  let added = monitor(pid)
  send(pid, msg)
  let r = nil
  if timeout_ms == nil
    r = await_reply(pid, ref)
  else
    r = await_reply_for(pid, ref, timeout_ms)
  end
  if r == nil
    drop_monitor(pid, added)
    error("{caller}: timeout")
  end
  if has_key(r, "down")
    return_down(pid, added, r.down)
    error("{caller}: supervisor exited: {r.down}")
  end
  drop_monitor(pid, added)
  let res = r.result
  if not res.ok
    error("{caller}: {res.error}")
  end
  res.value
end

## Starts a child by calling the template's `start(args)` in the
## supervisor, and returns the child's pid (a bare pid, also when `start`
## returned a handle).
##
## `args` is any value; a restart passes the same `args` again. Raises
## `dynamic_supervisor.start_child: <error>` when `start` raises or
## returns something other than a pid or handle; the supervisor keeps
## running, and a process the rejected `start` spawned is left running
## unsupervised. A restart whose `start` raises is retried (see `start`).
##
## The supervisor runs `start` in its own process and answers no other
## request meanwhile, so a slow `start` (a gen_server's `init`) holds up
## its other callers, and one slower than `timeout_ms` makes `start_child`
## raise `dynamic_supervisor.start_child: timeout` although the child is
## started.
fn start_child(target, args, timeout_ms = 5000)
  request(target, {tag: "_dsup_start_child", args: args}, "dynamic_supervisor.start_child", timeout_ms)
end

## Stops a child and returns true once it has exited; the child is not
## restarted. Returns false when the supervisor doesn't have `child` (a
## pid, a `{pid}` handle or a registered name), also for a name nobody
## holds or a value that is not a pid.
##
## The child gets the exit signal `"shutdown"`, then, if it is still
## running after its `shutdown` budget (see `start`), the untrappable
## `"kill"`. The supervisor handles nothing else meanwhile, so its other
## callers wait too. By default the call waits with no limit, since the
## budget bounds it; after a `timeout_ms` it raises, but the child is
## still stopped and removed. Processes the child spawned itself (such as
## its tasks) keep running.
fn terminate_child(target, child, timeout_ms = nil)
  request(target, {tag: "_dsup_terminate_child", pid: pid_of(child)}, "dynamic_supervisor.terminate_child", timeout_ms)
end

## Returns the running children as `{pid, args}` tables, in the order
## they were started (a restarted child keeps its place).
##
##   dynamic_supervisor.which_children(ds)    # [{pid: 2, args: {id: 1}}]
fn which_children(target, timeout_ms = 5000)
  request(target, {tag: "_dsup_which_children"}, "dynamic_supervisor.which_children", timeout_ms)
end

## Stops the supervisor, waits until it has exited, and returns nil (also
## for one already gone, given by pid or handle; by name see the header).
##
## The supervisor stops its children one at a time, last started first
## (a restarted child keeps its place), as `terminate_child` does, so they are all down when `stop` returns.
## Only direct children are stopped: processes a child spawned itself
## (such as its tasks, which aren't linked to it) keep running. By default
## `stop` waits with no limit, since the budgets bound the shutdown; with
## a `timeout_ms` it raises `dynamic_supervisor.stop: the supervisor did
## not stop within <ms> ms` after that long (the shutdown goes on).
##
## Sends the exit signal `"shutdown"`. Takes the supervisor's `DOWN`,
## unless the caller monitors it itself: that monitor still gets it.
fn stop(target, timeout_ms = nil)
  let pid = target_pid(target, "dynamic_supervisor.stop")
  check_timeout(timeout_ms, "dynamic_supervisor.stop")
  let added = monitor(pid)
  kill(pid, "shutdown")
  if timeout_ms == nil
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return_down(pid, added, reason)
    end
  else
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return_down(pid, added, reason)
    after timeout_ms
      drop_monitor(pid, added)
      error("dynamic_supervisor.stop: the supervisor did not stop within {timeout_ms} ms")
    end
  end
end

export start, start_child, terminate_child, which_children, stop
