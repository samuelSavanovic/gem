## gen_server — a process that holds state and answers requests.
##
##   let counter = gen_server.start({
##     init: fn() {state: 0} end,
##     handle_call: fn(msg, from, n) {reply: n, state: n} end,
##     handle_cast: fn(msg, n) {state: n + 1} end,
##     handle_info: fn(msg, n) {state: n} end
##   })
##   gen_server.cast(counter, "incr")
##   gen_server.call(counter, "get")    # 1
##
## `call` and `cast` take the `{pid}` handle `start` returns, a bare pid or
## a registered name; a name nobody holds (also once its server has died)
## raises `gen_server.<fn>: no process registered as "<name>"`. Errors start
## with `gen_server.<fn>: `. Callbacks run in the server process. One that
## raises kills the server; so does a result of the wrong shape, with
## `gen_server: <callback> returned ..., expected ...`, which a pending
## `call` raises as `gen_server.call: server exited: gen_server: ...`.
## Extra keys in a result are ignored (`{stop: ...}` does nothing).
##
## There is no stop: end a server with `kill(h.pid, reason)`, or run it
## under a supervisor and stop that. `start` takes no name: to call by
## name, `register(name, h.pid)`; under a supervisor, do it in the child's
## `start` fn so a restart registers the new server.

# The pid for a `{pid}` handle, a bare pid or a registered name.
fn target_pid(target, caller)
  let t = type(target)
  if t == "int"
    return target
  end
  if t == "table" and type(target.pid) == "int"
    return target.pid
  end
  if t == "string"
    let pid = whereis(target)
    if pid == nil
      error("{caller}: no process registered as \"{target}\"")
    end
    return pid
  end
  error("{caller}: expected a \{pid\} handle, a pid or a registered name, got {t}")
end

# Schedules the idle timeout. Returns the pending timer as `{timer, ref}`,
# or nil. The `_gs_timeout` message carries a fresh ref, so a timeout that
# was already queued when a callback cancelled or replaced it is recognised
# as stale and ignored.
fn set_timeout(pending, timeout_ms)
  if pending != nil
    cancel_timer(pending.timer)
  end
  if timeout_ms != nil
    let ref = make_ref()
    return {timer: send_after(self(), {tag: "_gs_timeout", ref: ref}, timeout_ms), ref: ref}
  end
  nil
end

fn describe(v)
  let t = type(v)
  if t == "nil"
    return "nil"
  end
  if t == "table"
    return "a table with keys {keys(v)}"
  end
  if t == "int"
    return "an int"
  end
  "a {t}"
end

# A callback result that isn't what the callback must return is a bug in the
# module: the server dies with an error naming the callback, and a pending
# `call` fails at once through its monitor.
fn bad_result(callback, result, expected)
  error("gen_server: {callback} returned {describe(result)}, expected {expected}")
end

# A `timeout` in a callback result must be an int (milliseconds) or nil.
fn check_result_timeout(callback, result)
  let t = result.timeout
  if t != nil and type(t) != "int"
    error("gen_server: {callback} returned a timeout that is {describe(t)}, expected an int (milliseconds) or nil")
  end
end

fn check_state_result(callback, result)
  if type(result) != "table" or not has_key(result, "state")
    bad_result(callback, result, "\{state: state\}")
  end
  check_result_timeout(callback, result)
end

fn check_call_result(result)
  if type(result) == "table"
    if has_key(result, "noreply")
      if has_key(result, "reply")
        bad_result("handle_call", result, "\{reply: value, state: state\} or \{noreply: state\}, not both")
      end
      check_result_timeout("handle_call", result)
      return nil
    end
    if has_key(result, "reply") and has_key(result, "state")
      check_result_timeout("handle_call", result)
      return nil
    end
  end
  bad_result("handle_call", result, "\{reply: value, state: state\} or \{noreply: state\}")
end

fn loop(module, state, pending)
  receive
  when {tag: "_gs_call", from: from, msg: msg}
    let result = module.handle_call(msg, from, state)
    check_call_result(result)
    let new_state = result.noreply
    if has_key(result, "reply")
      send(from.pid, {tag: "_gs_reply", ref: from.ref, value: result.reply})
      new_state = result.state
    end
    loop(module, new_state, set_timeout(pending, result.timeout))
  when {tag: "_gs_cast", msg: msg}
    let result = module.handle_cast(msg, state)
    check_state_result("handle_cast", result)
    loop(module, result.state, set_timeout(pending, result.timeout))
  when {tag: "_gs_timeout", ref: ref}
    if pending == nil or ref != pending.ref
      # Queued before a callback cancelled or replaced that timeout.
      loop(module, state, pending)
    else
      let result = module.handle_info("timeout", state)
      check_state_result("handle_info", result)
      loop(module, result.state, set_timeout(nil, result.timeout))
    end
  when other
    let result = module.handle_info(other, state)
    check_state_result("handle_info", result)
    loop(module, result.state, set_timeout(pending, result.timeout))
  end
end

let CALLBACKS = ["init", "handle_call", "handle_cast", "handle_info"]

# Raises `gen_server.start: ...` unless `module` is a table with every
# callback as a fn.
fn check_module(module)
  if type(module) != "table"
    error("gen_server.start: expected a module table \{init, handle_call, handle_cast, handle_info\}, got {type(module)}")
  end
  for name in CALLBACKS
    let kind = type(module[name])
    if kind != "fn"
      error("gen_server.start: the module's {name} must be a fn, got {kind}")
    end
  end
end

## Spawns a server running `module` and returns its handle `{pid}`.
##
## `module` is a table of four fns: `init()` returns `{state}`;
## `handle_call(msg, from, state)` returns `{reply, state}`, or `{noreply:
## state}` to answer later with `reply` (`from` is `{pid, ref}`:
## `from.pid` is the caller; pass `from` itself to `reply`);
## `handle_cast(msg, state)` and `handle_info(msg, state)` return
## `{state}`. Any result may add `timeout: ms`: if no message comes within
## that long, `handle_info` gets `"timeout"`. It covers only the next
## wait: return it from every callback to keep it. A plain `"timeout"`
## message looks the same to `handle_info`. `handle_info` gets every
## message that isn't a call or a cast, such as the `DOWN` of a process
## the server monitors.
##
## Raises, and starts nothing, if `module` is not a table or a callback is
## not a fn.
##
## Returns at once: `init` runs later, in the server. The server is
## neither linked to nor monitored by the caller, so either can die
## without taking the other along; a server whose `init` raises dies, and
## the next `call` raises `gen_server.call: server exited: <error>`.
fn start(module)
  check_module(module)
  let pid = spawn(fn()
    let result = module.init()
    check_state_result("init", result)
    loop(module, result.state, set_timeout(nil, result.timeout))
  end)
  {pid: pid}
end

fn check_timeout(timeout_ms, caller)
  if timeout_ms != nil and type(timeout_ms) != "int"
    error("{caller}: timeout must be an int (milliseconds) or nil, got {type(timeout_ms)}")
  end
end

# Ends the monitor of `pid` a request took: `added` is what its `monitor`
# returned. A monitor the caller already had is left alone. One the request
# added is removed, and its DOWN dropped if the target died meanwhile.
fn drop_monitor(pid, added)
  if added and not demonitor(pid)
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    after 0
      nil
    end
  end
end

# After a request matched the DOWN of `pid` (with `reason`): when the
# monitor was the caller's own (`added` false), puts the DOWN back for it.
fn return_down(pid, added, reason)
  if not added
    send(self(), {tag: "DOWN", pid: pid, reason: reason})
  end
  nil
end

# Waits for the reply to `ref` or the DOWN of `pid`: {value} or {down}.
fn await_reply(pid, ref)
  receive
  when {tag: "_gs_reply", ref: ^ref, value: v}
    {value: v}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  end
end

# As await_reply, or nil after `timeout_ms`.
fn await_reply_for(pid, ref, timeout_ms)
  receive
  when {tag: "_gs_reply", ref: ^ref, value: v}
    {value: v}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  after timeout_ms
    nil
  end
end

## Sends `msg` to the server's `handle_call` and returns its reply.
##
## Waits at most `timeout_ms` (nil: until the reply comes), then raises
## `gen_server.call: timeout`. Raises `gen_server.call: server exited:
## <reason>` at once when the server is dead (reason `"noproc"`) or dies
## before replying, and raises when `target` is not a handle, pid or
## registered name (see the header for a name nobody holds).
##
##   gen_server.call(counter, "get")          # 1
##   gen_server.call("counter", "get", nil)   # by name, no timeout
##
## Blocks the caller. It monitors the server only for the call and leaves
## no monitor and no `DOWN` behind; a monitor the caller set up itself
## stays and still gets its `DOWN`. After a timeout the server may still
## reply: the late `{tag: "_gs_reply"}` lands in the caller's mailbox, and
## no later `call` takes it, so a long-lived caller needs a catch-all arm.
## A caller that dies mid-call doesn't affect the server. Don't call a
## server from its own callbacks: that call waits out its timeout, then
## the server dies with `gen_server.call: timeout`.
fn call(target, msg, timeout_ms = 5000)
  # The monitor makes a dead server fail the call at once; `added` says
  # whether the call owns it (a process monitors a target at most once).
  let pid = target_pid(target, "gen_server.call")
  check_timeout(timeout_ms, "gen_server.call")
  let ref = make_ref()
  let added = monitor(pid)
  send(pid, {tag: "_gs_call", from: {pid: self(), ref: ref}, msg: msg})
  let res = nil
  if timeout_ms == nil
    res = await_reply(pid, ref)
  else
    res = await_reply_for(pid, ref, timeout_ms)
  end
  if res == nil
    drop_monitor(pid, added)
    error("gen_server.call: timeout")
  end
  if has_key(res, "down")
    return_down(pid, added, res.down)
    error("gen_server.call: server exited: {res.down}")
  end
  drop_monitor(pid, added)
  res.value
end

## Sends `msg` to the server's `handle_cast` and returns nil without
## waiting.
##
##   gen_server.cast(counter, "incr")    # nil
##
## A cast through a pid or handle to a dead server is dropped silently;
## through a registered name it raises, as the header says.
fn cast(target, msg)
  send(target_pid(target, "gen_server.cast"), {tag: "_gs_cast", msg: msg})
  nil
end

## Answers a call that `handle_call` deferred with `{noreply: state}`;
## `from` is the one `handle_call` got. Returns nil.
##
## Works from any process, so the server can hand `from` to a worker. A
## reply to a caller that has given up (timed out or died) is dropped or
## left in its mailbox, as in `call`. Call `reply` once per `from`: a
## second reply, or a `reply` followed by a `{reply: ...}` result, leaves
## an extra `{tag: "_gs_reply"}` in the caller's mailbox.
fn reply(from, value)
  send(from.pid, {tag: "_gs_reply", ref: from.ref, value: value})
  nil
end

export start, call, cast, reply
