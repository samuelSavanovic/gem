## gen_server: a process that holds state and answers calls and casts.
## A callback that raises or returns the wrong shape kills the server.
## A target is the `{pid}` from `start`, a pid or a name.

fn target_pid(target, caller)
  let t = type(target)
  if t == "int"
    return target
  end
  if t == "table" and type(target.pid) == "int"
    return target.pid
  end
  if t == "string"
    let pid = whereis(target)
    if pid == nil
      error("{caller}: no process registered as \"{target}\"")
    end
    return pid
  end
  error("{caller}: expected a \{pid\} handle, a pid or a registered name, got {t}")
end

# each timeout carries a fresh ref, so a stale one queued before a callback replaced it is ignored
fn set_timeout(pending, timeout_ms)
  if pending != nil
    cancel_timer(pending.timer)
  end
  if timeout_ms != nil
    let ref = make_ref()
    return {timer: send_after(self(), {tag: "_gs_timeout", ref: ref}, timeout_ms), ref: ref}
  end
  nil
end

fn describe(v)
  let t = type(v)
  if t == "nil"
    return "nil"
  end
  if t == "table"
    return "a table with keys {keys(v)}"
  end
  if t == "int"
    return "an int"
  end
  "a {t}"
end

fn bad_result(callback, result, expected)
  error("gen_server: {callback} returned {describe(result)}, expected {expected}")
end

fn check_result_timeout(callback, result)
  let t = result.timeout
  if t != nil and type(t) != "int"
    error("gen_server: {callback} returned a timeout that is {describe(t)}, expected an int (milliseconds) or nil")
  end
end

fn check_state_result(callback, result)
  if type(result) != "table" or not has_key(result, "state")
    bad_result(callback, result, "\{state: state\}")
  end
  check_result_timeout(callback, result)
end

fn check_call_result(result)
  if type(result) == "table"
    if has_key(result, "noreply")
      if has_key(result, "reply")
        bad_result("handle_call", result, "\{reply: value, state: state\} or \{noreply: state\}, not both")
      end
      check_result_timeout("handle_call", result)
      return nil
    end
    if has_key(result, "reply") and has_key(result, "state")
      check_result_timeout("handle_call", result)
      return nil
    end
  end
  bad_result("handle_call", result, "\{reply: value, state: state\} or \{noreply: state\}")
end

fn loop(module, state, pending)
  receive
  when {tag: "_gs_call", from: from, msg: msg}
    let result = module.handle_call(msg, from, state)
    check_call_result(result)
    let new_state = if has_key(result, "reply")
      send(from.pid, {tag: "_gs_reply", ref: from.ref, value: result.reply})
      result.state
    else
      result.noreply
    end
    loop(module, new_state, set_timeout(pending, result.timeout))
  when {tag: "_gs_cast", msg: msg}
    let result = module.handle_cast(msg, state)
    check_state_result("handle_cast", result)
    loop(module, result.state, set_timeout(pending, result.timeout))
  when {tag: "_gs_stop", reason: reason}
    # a callback may have trapped exits, which would make the kill a message
    process_flag("trap_exit", false)
    kill(self(), reason)
  when {tag: "_gs_timeout", ref: ref}
    if pending == nil or ref != pending.ref
      # stale: queued before a callback replaced it
      loop(module, state, pending)
    else
      let result = module.handle_info("timeout", state)
      check_state_result("handle_info", result)
      loop(module, result.state, set_timeout(nil, result.timeout))
    end
  when other
    let result = module.handle_info(other, state)
    check_state_result("handle_info", result)
    loop(module, result.state, set_timeout(pending, result.timeout))
  end
end

let CALLBACKS = ["init", "handle_call", "handle_cast", "handle_info"]

fn check_module(module)
  if type(module) != "table"
    error("gen_server.start: expected a module table \{init, handle_call, handle_cast, handle_info\}, got {type(module)}")
  end
  for name in CALLBACKS
    let kind = type(module[name])
    if kind != "fn"
      error("gen_server.start: the module's {name} must be a fn, got {kind}")
    end
  end
end

## Spawns a server for `module` (init, handle_call, handle_cast, handle_info); returns `{pid}` after init.
## `name` is registered before `init` runs; raises if `init` fails.
## Any callback result may add `timeout: ms` to get `"timeout"` in `handle_info` when idle.
fn start(module, {name = nil} = {})
  check_module(module)
  if name != nil
    if type(name) != "string"
      error("gen_server.start: name must be a string, got {type(name)}")
    end
    if whereis(name) != nil
      error("gen_server.start: the name \"{name}\" is already registered")
    end
  end
  let caller = self()
  let ref = make_ref()
  let pid = spawn do
    serve(module, caller, ref)
  end
  # it hasn't run yet, so the name is in place before init
  if name != nil
    register(name, pid)
  end
  monitor(pid)
  receive
  when {tag: "_gs_started", ref: ^ref}
    drop_monitor(pid, true)
  when {tag: "_gs_init_failed", ref: ^ref, error: e}
    # its exit comes next; take it so no DOWN is left behind
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    end
    error("gen_server.start: init failed: {e}")
  when {tag: "DOWN", pid: ^pid, reason: reason}
    error("gen_server.start: server exited: {reason}")
  end
  {pid: pid}
end

fn run_init(module)
  let result = module.init()
  check_state_result("init", result)
  result
end

fn serve(module, caller, ref)
  let res = pcall run_init(module)
  if not res.ok
    eprint("gen_server: init raised at:")
    for f in res.stack
      eprint("  at {f.name} ({f.file}:{f.line})")
    end
    send(caller, {tag: "_gs_init_failed", ref: ref, error: res.error})
    # init may have trapped exits
    process_flag("trap_exit", false)
    kill(self(), res.error)
  end
  send(caller, {tag: "_gs_started", ref: ref})
  loop(module, res.value.state, set_timeout(nil, res.value.timeout))
end

fn check_timeout(timeout_ms, caller)
  if timeout_ms != nil and type(timeout_ms) != "int"
    error("{caller}: timeout must be an int (milliseconds) or nil, got {type(timeout_ms)}")
  end
end

# removes the monitor only if this request `added` it, and drops its DOWN if the target died meanwhile
fn drop_monitor(pid, added)
  if added and not demonitor(pid)
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    after 0
      nil
    end
  end
end

# A monitor the caller had before the request still gets its DOWN.
fn return_down(pid, added, reason)
  if not added
    send(self(), {tag: "DOWN", pid: pid, reason: reason})
  end
  nil
end

fn await_reply(pid, ref)
  receive
  when {tag: "_gs_reply", ref: ^ref, value: v}
    {value: v}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  end
end

fn await_reply_for(pid, ref, timeout_ms)
  receive
  when {tag: "_gs_reply", ref: ^ref, value: v}
    {value: v}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  after timeout_ms
    nil
  end
end

## Sends `msg` to `handle_call` and returns the reply.
## Raises `gen_server.call: timeout` after `timeout_ms` (nil: forever), or `gen_server.call: server exited: <reason>`.
fn call(target, msg, timeout_ms = 5000)
  # `added` is false when the caller already monitors pid
  let pid = target_pid(target, "gen_server.call")
  check_timeout(timeout_ms, "gen_server.call")
  let ref = make_ref()
  let added = monitor(pid)
  send(pid, {tag: "_gs_call", from: {pid: self(), ref: ref}, msg: msg})
  let res = if timeout_ms == nil
    await_reply(pid, ref)
  else
    await_reply_for(pid, ref, timeout_ms)
  end
  if res == nil
    drop_monitor(pid, added)
    error("gen_server.call: timeout")
  end
  if has_key(res, "down")
    return_down(pid, added, res.down)
    error("gen_server.call: server exited: {res.down}")
  end
  drop_monitor(pid, added)
  res.value
end

## Sends `msg` to `handle_cast` and returns nil without waiting.
fn cast(target, msg)
  send(target_pid(target, "gen_server.cast"), {tag: "_gs_cast", msg: msg})
  nil
end

## Answers a call that `handle_call` deferred with `{noreply: state}`, given its `from`. Works from any process.
fn reply(from, value)
  if type(from) != "table" or type(from.pid) != "int"
    error("gen_server.reply: expected the \{pid, ref\} from that handle_call got, got {describe(from)}")
  end
  send(from.pid, {tag: "_gs_reply", ref: from.ref, value: value})
  nil
end

## Stops the server with `reason` after what's already queued and waits for it to exit (`timeout_ms` nil: no limit).
fn stop(target, reason = "normal", timeout_ms = 5000)
  let pid = target_pid(target, "gen_server.stop")
  if type(reason) != "string"
    error("gen_server.stop: reason must be a string, got {type(reason)}")
  end
  check_timeout(timeout_ms, "gen_server.stop")
  let added = monitor(pid)
  send(pid, {tag: "_gs_stop", reason: reason})
  if timeout_ms == nil
    receive
    when {tag: "DOWN", pid: ^pid, reason: r}
      return_down(pid, added, r)
    end
    return nil
  end
  receive
  when {tag: "DOWN", pid: ^pid, reason: r}
    return_down(pid, added, r)
  after timeout_ms
    drop_monitor(pid, added)
    error("gen_server.stop: the server did not stop within {timeout_ms} ms")
  end
end

export start, call, cast, reply, stop
