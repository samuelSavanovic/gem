# std/http — HTTP/1.1 server with routing and keep-alive.
#
#   let app = http.router()
#   app.get("/hello/:name") do |req|
#     http.ok("hello {req.params.name}")
#   end
#   http.serve(app, {port: 8080})        # or: let server = http.start(app, ...)
#
# Each connection runs in its own process. A handler that raises (or returns
# something that isn't a response table) gets a 500, and the error and its
# stack go to stderr. Request header names are lowercased.

load "std/string"
load "std/url"
load "std/mime"
load "std/json"
load "std/time"

let IDLE_TIMEOUT_MS = 30000
let READ_SIZE = 8192
let MAX_HEADER_BYTES = 65536
let TEXT_PLAIN = "text/plain; charset=utf-8"

let STATUS_TEXT = {
  200: "OK",
  201: "Created",
  204: "No Content",
  301: "Moved Permanently",
  302: "Found",
  304: "Not Modified",
  400: "Bad Request",
  401: "Unauthorized",
  403: "Forbidden",
  404: "Not Found",
  405: "Method Not Allowed",
  431: "Request Header Fields Too Large",
  500: "Internal Server Error",
  502: "Bad Gateway",
  503: "Service Unavailable"
}

# ─── Response builders ───

fn response(status, headers, body)
  {status: status, headers: headers, body: body}
end

fn ok(body, content_type = "text/plain; charset=utf-8")
  {status: 200, headers: {"Content-Type": content_type}, body: body}
end

fn html(body)
  {status: 200, headers: {"Content-Type": "text/html; charset=utf-8"}, body: body}
end

fn json_response(data)
  {status: 200, headers: {"Content-Type": "application/json; charset=utf-8"}, body: json.encode(data)}
end

fn redirect(location, status = 302)
  {status: status, headers: {"Location": location, "Content-Type": TEXT_PLAIN}, body: ""}
end

fn not_found(body = "Not Found")
  {status: 404, headers: {"Content-Type": TEXT_PLAIN}, body: body}
end

fn bad_request(body = "Bad Request")
  {status: 400, headers: {"Content-Type": TEXT_PLAIN}, body: body}
end

fn server_error(body = "Internal Server Error")
  {status: 500, headers: {"Content-Type": TEXT_PLAIN}, body: body}
end

# ─── Cookies ───

fn set_cookie(resp, name, value, {path = "/", http_only = true, secure = false, same_site = "Lax", max_age = nil, expires = nil} = {})
  let cookie_str = build_string() do |add|
    add(name, "=", value)
    add("; Path=", path)
    if max_age != nil
      add("; Max-Age=", max_age)
    end
    if expires != nil
      add("; Expires=", time.http_date(expires))
    end
    if http_only
      add("; HttpOnly")
    end
    if secure
      add("; Secure")
    end
    add("; SameSite=", same_site)
  end

  let new_headers = {}
  for k, v in resp.headers
    new_headers[k] = v
  end

  # Several cookies share one header value; serialize_response splits them
  # back into one Set-Cookie line each.
  let existing = new_headers["Set-Cookie"]
  if existing != nil
    new_headers["Set-Cookie"] = "{existing}\r\nSet-Cookie: {cookie_str}"
  else
    new_headers["Set-Cookie"] = cookie_str
  end

  {status: resp.status, headers: new_headers, body: resp.body}
end

fn delete_cookie(resp, name, {path = "/"} = {})
  set_cookie(resp, name, "", {max_age: 0, path: path})
end

# ─── Cookie parsing ───

fn parse_cookies(cookie_header)
  let cookies = {}
  if cookie_header == nil
    return cookies
  end
  for pair in string.split(cookie_header, ";")
    let eq = string.index_of(pair, "=")
    if eq > 0
      let name = string.trim(substr(pair, 0, eq))
      cookies[name] = string.trim(substr(pair, eq + 1, len(pair) - eq - 1))
    end
  end
  cookies
end

# ─── Form parsing ───

fn parse_form(body)
  url.parse_query(body)
end

# ─── Security ───

fn html_escape(s)
  let out = str_replace(s, "&", "&amp;")
  out = str_replace(out, "<", "&lt;")
  out = str_replace(out, ">", "&gt;")
  out = str_replace(out, '"', "&quot;")
  str_replace(out, "'", "&#x27;")
end

# ─── Router ───

fn match_route(pattern, path)
  let pat_segs = string.split(pattern, "/")
  let path_segs = string.split(path, "/")
  if len(pat_segs) != len(path_segs)
    return nil
  end
  let params = {}
  for i, ps in pat_segs
    let us = path_segs[i]
    if len(ps) > 0 and ord(ps, 0) == 58
      params[substr(ps, 1, len(ps) - 1)] = url.decode(us)
    elif ps != us
      return nil
    end
  end
  params
end

fn normalize_path(p)
  let result = []
  for s in string.split(p, "/")
    if s == ".."
      if len(result) > 0
        pop(result)
      end
    elif s != "." and s != ""
      push(result, s)
    end
  end
  "/{string.join(result, "/")}"
end

# The static file under one of `static_routes` for a GET of `path`, as a
# match result, or nil.
fn match_static(static_routes, path)
  for sr in static_routes
    if string.starts_with(path, sr.prefix)
      let rel = substr(path, len(sr.prefix), len(path) - len(sr.prefix))
      if rel == "" or rel == "/"
        rel = "/index.html"
      end
      let file_path = "{sr.dir}{normalize_path(rel)}"
      if file_exists(file_path)
        let content = read_file(file_path)
        let ct = mime.lookup(file_path)
        let handler = fn(req)
          {status: 200, headers: {"Content-Type": ct, "Cache-Control": "public, max-age=3600"}, body: content}
        end
        return {handler: handler, params: {}}
      end
    end
  end
  nil
end

fn router()
  let routes = []
  let static_routes = []

  let add_route = fn(method, pattern, handler)
    push(routes, {method: method, pattern: pattern, handler: handler})
  end

  let r = {}

  r.get = fn(pattern, handler)
    add_route("GET", pattern, handler)
  end

  r.post = fn(pattern, handler)
    add_route("POST", pattern, handler)
  end

  r.put = fn(pattern, handler)
    add_route("PUT", pattern, handler)
  end

  r.patch = fn(pattern, handler)
    add_route("PATCH", pattern, handler)
  end

  r.delete = fn(pattern, handler)
    add_route("DELETE", pattern, handler)
  end

  r.static = fn(url_prefix, dir_path)
    push(static_routes, {prefix: url_prefix, dir: dir_path})
  end

  r.match = fn(method, path)
    for route in routes
      if route.method == method
        let params = match_route(route.pattern, path)
        if params != nil
          return {handler: route.handler, params: params}
        end
      end
    end
    if method == "GET"
      return match_static(static_routes, path)
    end
    nil
  end

  r
end

# ─── HTTP parsing ───

# Index of the first "\r\n\r\n" in `s`, or -1.
fn find_header_end(s)
  let slen = len(s)
  let i = 0
  while i < slen - 3
    if ord(s, i) == 13 and ord(s, i + 1) == 10 and ord(s, i + 2) == 13 and ord(s, i + 3) == 10
      return i
    end
    i += 1
  end
  -1
end

fn last_bytes(s, n)
  if len(s) <= n
    return s
  end
  substr(s, len(s) - n, n)
end

# Reads until the end of the request head. Returns {data, header_end}
# (`data` holds everything read so far, `conn_buf` included), nil when the
# peer closed or went idle, or {too_large: true} past MAX_HEADER_BYTES.
# Chunks collect in a buffer and only the new bytes are scanned, so a peer
# sending one byte at a time costs linear time.
fn read_head(client_fd, conn_buf)
  let header_end = find_header_end(conn_buf)
  if header_end >= 0
    return {data: conn_buf, header_end: header_end}
  end
  let acc = buf_new()
  buf_push(acc, conn_buf)
  let have = len(conn_buf)
  let tail = last_bytes(conn_buf, 3)
  while header_end < 0
    if have > MAX_HEADER_BYTES
      return {too_large: true}
    end
    let chunk = tcp_read(client_fd, READ_SIZE, IDLE_TIMEOUT_MS)
    # nil = idle timeout, "" = EOF; both end the connection.
    if chunk == nil or chunk == ""
      return nil
    end
    let window = "{tail}{chunk}"
    let found = find_header_end(window)
    if found >= 0
      header_end = have - len(tail) + found
    end
    buf_push(acc, chunk)
    have = have + len(chunk)
    tail = last_bytes(window, 3)
  end
  {data: to_string(acc), header_end: header_end}
end

fn parse_request_line(line)
  let sp1 = string.index_of(line, " ")
  if sp1 < 0
    return nil
  end
  let rest = substr(line, sp1 + 1, len(line) - sp1 - 1)
  let sp2 = string.index_of(rest, " ")
  if sp2 < 0
    return nil
  end
  {method: substr(line, 0, sp1), raw_path: substr(rest, 0, sp2)}
end

# Header names are lowercased and values trimmed. A repeated header's
# values are joined with ", " (cookies with "; ").
fn parse_headers(header_block)
  let headers = {}
  for line in string.split(header_block, "\r\n")
    let colon = string.index_of(line, ":")
    if colon > 0
      let key = string.lower(string.trim(substr(line, 0, colon)))
      let value = string.trim(substr(line, colon + 1, len(line) - colon - 1))
      let prev = headers[key]
      if prev == nil
        headers[key] = value
      elif key == "cookie"
        headers[key] = "{prev}; {value}"
      else
        headers[key] = "{prev}, {value}"
      end
    end
  end
  headers
end

# The Content-Length as an int (0 when absent), or nil when it isn't a
# non-negative integer.
fn content_length(headers)
  let cl = headers["content-length"]
  if cl == nil
    return 0
  end
  let r = pcall to_int(cl)
  if not r.ok or r.value < 0
    return nil
  end
  r.value
end

# ─── Response serialization ───

fn status_text(code)
  let text = STATUS_TEXT[code]
  if text == nil
    return "Unknown"
  end
  text
end

fn serialize_response(resp, keep_alive)
  let body = resp.body
  if body == nil
    body = ""
  end
  let headers = resp.headers
  if headers == nil
    headers = {}
  end
  build_string() do |add|
    add("HTTP/1.1 ", resp.status, " ", status_text(resp.status), "\r\n")
    add("Content-Length: ", len(body), "\r\n")
    if keep_alive
      add("Connection: keep-alive\r\n")
    else
      add("Connection: close\r\n")
    end
    for k, v in headers
      if k == "Set-Cookie"
        for part in string.split(v, "\r\nSet-Cookie: ")
          add("Set-Cookie: ", part, "\r\n")
        end
      else
        add(k, ": ", v, "\r\n")
      end
    end
    add("\r\n")
    add(body)
  end
end

fn is_response(resp)
  if type(resp) != "table" or type(resp.status) != "int"
    return false
  end
  let body_ok = resp.body == nil or type(resp.body) == "string"
  body_ok and (resp.headers == nil or type(resp.headers) == "table")
end

# ─── Error reporting ───

# The frames of `stack` above the handler call: std/http's own frames and
# the closure `pcall` wraps the call in are cut.
fn handler_frames(stack)
  let frames = []
  for f in stack
    if f.name == "http.call_handler"
      break
    end
    push(frames, f)
  end
  if len(frames) > 0
    pop(frames)
  end
  frames
end

fn report_error(what, stack)
  let frames = handler_frames(stack)
  let out = build_string() do |add|
    add("http: ", what)
    if len(frames) > 0
      add("\nStack trace:")
      for f in frames
        add("\n  at ", f.name, " (", f.file, ":", f.line, ")")
      end
    end
  end
  eprint(out)
end

# Runs the handler. Returns its response, or a 500 after reporting the
# error (or the bad return value) on stderr.
fn call_handler(handler, req)
  let r = pcall handler(req)
  if not r.ok
    report_error("{req.method} {req.path}: {r.error}", r.stack)
    return server_error()
  end
  if not is_response(r.value)
    report_error("{req.method} {req.path}: handler returned {r.value}, not a response table", [])
    return server_error()
  end
  r.value
end

# ─── Connection handler ───

fn send_and_close(client_fd, resp)
  tcp_write(client_fd, serialize_response(resp, false))
  nil
end

# Process one request from the connection. Returns the bytes already read
# past this request (for keep-alive), or nil when the connection should
# close.
fn process_one_request(client_fd, router_ref, conn_buf)
  let head = read_head(client_fd, conn_buf)
  if head == nil
    return nil
  end
  if head.too_large
    return send_and_close(client_fd, response(431, {"Content-Type": TEXT_PLAIN}, "Request Header Fields Too Large"))
  end
  let data = head.data
  let header_end = head.header_end
  let header_section = substr(data, 0, header_end)
  let after_headers = substr(data, header_end + 4, len(data) - header_end - 4)

  let request_line = header_section
  let header_block = ""
  let first_line_end = string.index_of(header_section, "\r\n")
  if first_line_end >= 0
    request_line = substr(header_section, 0, first_line_end)
    header_block = substr(header_section, first_line_end + 2, len(header_section) - first_line_end - 2)
  end

  let req_info = parse_request_line(request_line)
  if req_info == nil
    return send_and_close(client_fd, bad_request())
  end
  let headers = parse_headers(header_block)
  let body_len = content_length(headers)
  if body_len == nil
    return send_and_close(client_fd, bad_request())
  end

  # Read the body, keeping any bytes past it for the next request.
  let body = ""
  let next_buf = after_headers
  if body_len > 0
    let body_buf = buf_new()
    buf_push(body_buf, after_headers)
    let have = len(after_headers)
    while have < body_len
      let chunk = tcp_read(client_fd, READ_SIZE, IDLE_TIMEOUT_MS)
      if chunk == nil or chunk == ""
        return nil
      end
      buf_push(body_buf, chunk)
      have = have + len(chunk)
    end
    let full_body = to_string(body_buf)
    body = substr(full_body, 0, body_len)
    next_buf = substr(full_body, body_len, len(full_body) - body_len)
  end

  let parsed = url.parse(req_info.raw_path)
  let req = {
    method: req_info.method,
    path: parsed.path,
    query: parsed.query,
    headers: headers,
    body: body,
    cookies: parse_cookies(headers["cookie"]),
    params: {}
  }

  let matched = router_ref.match(req.method, req.path)
  let resp = nil
  if matched != nil
    req.params = matched.params
    resp = call_handler(matched.handler, req)
  else
    resp = not_found()
  end

  let connection_hdr = headers["connection"]
  let keep_alive = connection_hdr == nil or string.lower(connection_hdr) != "close"
  tcp_write(client_fd, serialize_response(resp, keep_alive))
  if not keep_alive
    return nil
  end
  next_buf
end

# Keep-alive loop: serve requests on `client_fd` until the peer closes or
# sends `Connection: close`. `conn_buf` carries the bytes already read past
# the previous request.
fn handle_connection_loop(client_fd, router_ref)
  let conn_buf = ""
  while conn_buf != nil
    let r = pcall process_one_request(client_fd, router_ref, conn_buf)
    if r.ok
      conn_buf = r.value
    else
      eprint("http: internal error: {r.error}")
      pcall send_and_close(client_fd, server_error())
      conn_buf = nil
    end
  end
  tcp_close(client_fd)
end

# ─── Server ───

# Accept loop: a process per connection. When the process table is full,
# that connection gets a 503 and the loop carries on.
fn accept_loop(server_fd, router_ref)
  while true
    let client_fd = tcp_accept(server_fd)
    let r = pcall spawn(fn()
      handle_connection_loop(client_fd, router_ref)
    end)
    if not r.ok
      eprint("http: {r.error}; refusing a connection")
      pcall send_and_close(client_fd, response(503, {"Content-Type": TEXT_PLAIN}, "Service Unavailable"))
      tcp_close(client_fd)
    end
  end
end

# Starts the server in its own process and returns {pid: acceptor_pid}.
fn start(router_ref, {port = 8080, host = "0.0.0.0"} = {})
  let server_fd = tcp_listen(host, port)
  let pid = spawn(fn()
    accept_loop(server_fd, router_ref)
  end)
  {pid: pid}
end

# Runs the server and blocks until the acceptor dies: returns nil when it
# was killed with "normal" or "shutdown", raises otherwise.
fn serve(router_ref, opts = {})
  let pid = start(router_ref, opts).pid
  monitor(pid)
  receive
  when {tag: "DOWN", pid: ^pid, reason: reason}
    if reason != "normal" and reason != "shutdown"
      error("http.serve: acceptor died: {reason}")
    end
    nil
  end
end

export response, ok, html, json_response, redirect, not_found, bad_request,
  server_error, set_cookie, delete_cookie, parse_form, html_escape, router, start, serve
