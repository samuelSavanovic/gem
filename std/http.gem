## http — HTTP/1.1 server with routing, keep-alive and static files.
##
##   load "std/http"
##   let app = http.router()
##   app.get("/hello/:name") do |req|
##     http.ok("hello {req.params.name}")
##   end
##   http.serve(app, {port: 8080})    # blocks; or http.start, later http.stop
##
## A handler gets a request table and returns a response table {status,
## headers, body}; the builders below make one. The request has just
## these keys (no client address, no raw query string): `method` ("HEAD"
## when a HEAD runs a GET route); `path`, raw (not percent-decoded),
## without the query; `query`, as by `url.parse_query` ({} when none; a
## repeated key keeps its last value); `params` (see `router`);
## `headers`, lowercase names, a repeated header's values joined with
## ", " ("; " for Cookie); `cookies`, names to raw values (decode with
## `url.decode`; a pair without `=` is dropped); `body`, "" when none.
##
## A handler that raises or returns an invalid response (see `response`)
## gets a 500, its error and stack go to stderr, and the server keeps
## running. An unmatched request gets a 404, a malformed one a 400, a
## too-big body a 413; each has its status text as a plain-text body
## ("Not Found").
##
## Each connection runs in its own process, so handlers run in parallel,
## and module-level state a handler changes is that connection's copy:
## keep shared state in a process. Stopping the server kills the
## connection processes and cuts off requests in flight.

load "std/string"
load "std/url"
load "std/mime"
load "std/json"
load "std/time"

# Processes and sockets. `start` spawns a server process (the pid in the
# handle it returns). It traps exits, spawns the acceptor linked, and
# monitors every connection process: the acceptor registers each one
# (`_http_conn`) right after spawning it, so a connection accepted just
# before a stop is still killed. Each connection claims its socket and the
# server claims the listener, so whichever way a process ends, its socket
# closes (the untrappable "kill" included). The server still closes the
# socket of a connection that dies, and a connection tells the server
# (`_http_closing`) before closing its socket itself; both are no-ops now
# that the runtime closes them. Killing the server process (as `stop` and
# a supervisor do) arrives as an EXIT: it kills the acceptor and the
# connections, closes every socket, then exits with that reason. A connection whose handler traps exits gets an EXIT message
# instead; it closes its own socket after that request. `serve` has the
# server monitor its caller, so killing the caller stops the server.

# Runtime helper, one C pass (a Gem loop over `ord` costs about 50 ns a
# byte): the length of the prefix of `s` made of bytes from `accept`.
extern fn gem_bytes_span(s: Bytes, accept: Bytes) -> Int

let READ_SIZE = 8192
let MAX_HEADER_BYTES = 65536
let MAX_LINE = 4096
let MAX_CHUNK_SIZE_LEN = 64
let DEFAULT_MAX_BODY = 8388608
let DEFAULT_IDLE_TIMEOUT_MS = 30000
let DEFAULT_REQUEST_TIMEOUT_MS = 30000
let DEFAULT_WRITE_TIMEOUT_MS = 30000
let ACCEPT_BACKOFF_MS = 50
let MAX_EMPTY_LINE_HEADS = 16
let DRAIN_QUIET_MS = 100
let REFUSE_DRAIN_MS = 50
let STOP_TIMEOUT_MS = 5000
let TEXT_PLAIN = "text/plain; charset=utf-8"

# The bytes from `lo` to `hi` (inclusive), minus those in `except`.
fn byte_range(lo, hi, except = "")
  build_string() do |add|
    for c = lo, hi + 1
      let b = chr(c)
      if not has_text(except, b)
        add(b)
      end
    end
  end
end

# Bytes allowed in a request line or header field line: HTAB, SP, visible
# ASCII and obs-text (RFC 9112 §2.2, §5.5).
let FIELD_BYTES = "\t{byte_range(32, 126)}{byte_range(128, 255)}"
# Bytes allowed in a request header name: field bytes but whitespace and
# `:` (the span of these from a line's start ends at its colon).
let NAME_BYTES = "{byte_range(33, 126, ":")}{byte_range(128, 255)}"
# The same, uppercase letters excluded (a name made of these needs no
# lowercasing).
let LOWER_NAME_BYTES = "{byte_range(33, 126, ":ABCDEFGHIJKLMNOPQRSTUVWXYZ")}{byte_range(128, 255)}"
# Bytes of an HTTP token (header names).
let TOKEN_BYTES = "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
# A token without uppercase letters (a Connection value that is one
# lowercase token, the common case, needs no splitting).
let LOWER_TOKEN_BYTES = "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyz"
# Every byte but CR and LF.
let NO_CRLF_BYTES = "{byte_range(0, 9)}{byte_range(11, 12)}{byte_range(14, 255)}"
# Bytes allowed in a cookie name, value or attribute: no `;`, `,`,
# whitespace or control bytes.
let COOKIE_BYTES = "{byte_range(33, 126, ";,")}{byte_range(128, 255)}"

let STATUS_TEXT = {
  100: "Continue",
  101: "Switching Protocols",
  200: "OK",
  201: "Created",
  202: "Accepted",
  204: "No Content",
  206: "Partial Content",
  301: "Moved Permanently",
  302: "Found",
  303: "See Other",
  304: "Not Modified",
  307: "Temporary Redirect",
  308: "Permanent Redirect",
  400: "Bad Request",
  401: "Unauthorized",
  403: "Forbidden",
  404: "Not Found",
  405: "Method Not Allowed",
  408: "Request Timeout",
  409: "Conflict",
  410: "Gone",
  413: "Content Too Large",
  415: "Unsupported Media Type",
  422: "Unprocessable Content",
  429: "Too Many Requests",
  431: "Request Header Fields Too Large",
  500: "Internal Server Error",
  501: "Not Implemented",
  502: "Bad Gateway",
  503: "Service Unavailable",
  504: "Gateway Timeout",
  505: "HTTP Version Not Supported"
}

# ─── Response builders ───

## Returns the response table {status, headers, body}, adding no
## headers (no Content-Type).
##
## A handler's response is valid when `status` is an int from 200 to 999,
## `body` is nil or a string, and `headers` is nil or a table of name to
## value. Names must be HTTP tokens, and a value a string, number or bool
## (sent as `"{value}"`) with no CR or LF, or an array of them (one line
## per element); a nil value or another table is invalid. The server
## writes Content-Length and Connection and drops the handler's own and
## any Transfer-Encoding, but a Connection header listing `close` still
## closes the connection. 204 and 304 responses go without a body. The
## builders check none of this; the server does when the handler returns.
##
##   http.response(201, {"Location": "/items/7"}, "")
fn response(status, headers, body)
  {status: status, headers: headers, body: body}
end

## Returns a 200 response with `body` and the Content-Type
## `content_type` (default plain UTF-8 text).
##
##   http.ok("hi")                         # text/plain; charset=utf-8
##   http.ok(csv, "text/csv")
fn ok(body, content_type = "text/plain; charset=utf-8")
  {status: 200, headers: {"Content-Type": content_type}, body: body}
end

## Returns a 200 response with `body` as `text/html; charset=utf-8`.
## Escape user data in it with `html_escape`.
fn html(body)
  {status: 200, headers: {"Content-Type": "text/html; charset=utf-8"}, body: body}
end

## Returns a 200 response with `data` encoded by `json.encode`, as
## `application/json; charset=utf-8`.
##
##   http.json_response({id: 7, tags: ["a"]})    # body {"id":7,"tags":["a"]}
##
## For another status, build it with `response`:
##
##   http.response(201, {"Content-Type": "application/json; charset=utf-8"}, json.encode(data))
##
## Raises what `json.encode` raises for data it can't encode (a fn, for
## one); in a handler that is a 500.
fn json_response(data)
  {status: 200, headers: {"Content-Type": "application/json; charset=utf-8"}, body: json.encode(data)}
end

## Returns a redirect to `location` with an empty plain-text body;
## `status` is 302 unless given. It isn't checked: pass 301, 303, 307 or
## 308.
##
##   http.redirect("/login")
##   http.redirect("/new-home", 301)
fn redirect(location, status = 302)
  {status: status, headers: {"Location": location, "Content-Type": TEXT_PLAIN}, body: ""}
end

## Returns a 404 plain-text response; `body` defaults to "Not Found".
fn not_found(body = "Not Found")
  {status: 404, headers: {"Content-Type": TEXT_PLAIN}, body: body}
end

## Returns a 400 plain-text response; `body` defaults to "Bad Request".
fn bad_request(body = "Bad Request")
  {status: 400, headers: {"Content-Type": TEXT_PLAIN}, body: body}
end

## Returns a 500 plain-text response; `body` defaults to
## "Internal Server Error".
fn server_error(body = "Internal Server Error")
  {status: 500, headers: {"Content-Type": TEXT_PLAIN}, body: body}
end

# ─── Cookies ───

# True when `s` can go into a Set-Cookie line as a name, value or
# attribute: no `;`, `,`, whitespace or control bytes.
fn cookie_text_ok(s)
  gem_bytes_span(s, COOKIE_BYTES) == len(s)
end

fn check_cookie_text(caller, what, s)
  if not cookie_text_ok(s)
    error("{caller}: invalid cookie {what} \"{s}\" (no ;, comma, whitespace or control bytes)")
  end
end

# The Set-Cookie line's value; raises on a name, value or attribute that
# could change the cookie's meaning or inject a header.
fn cookie_line(caller, name, value, path, http_only, secure, same_site, max_age, expires)
  if value == nil or type(value) == "table"
    error("{caller}: cookie value must be a string or a number, got {type(value)}")
  end
  let n = "{name}"
  let v = "{value}"
  if n == "" or has_text(n, "=")
    error("{caller}: invalid cookie name \"{n}\" (empty or contains =)")
  end
  check_cookie_text(caller, "name", n)
  check_cookie_text(caller, "value", v)
  check_cookie_text(caller, "path", "{path}")
  check_cookie_text(caller, "same_site", "{same_site}")
  if max_age != nil and type(max_age) != "int"
    error("{caller}: max_age must be an int or nil, got {type(max_age)} {max_age}")
  end
  if expires != nil and type(expires) != "int"
    error("{caller}: expires must be an int (epoch ms), got {type(expires)}")
  end
  build_string() do |add|
    add(n, "=", v)
    if path != nil
      add("; Path=", path)
    end
    if max_age != nil
      add("; Max-Age=", max_age)
    end
    if expires != nil
      add("; Expires=", time.http_date(expires))
    end
    if http_only
      add("; HttpOnly")
    end
    if secure
      add("; Secure")
    end
    if same_site != nil
      add("; SameSite=", same_site)
    end
  end
end

# A copy of `resp` with one more Set-Cookie line. Several cookies make the
# header value an array, sent as one Set-Cookie line each.
fn add_set_cookie(resp, cookie_str)
  let new_headers = {}
  if resp.headers != nil
    for k, v in resp.headers
      new_headers[k] = v
    end
  end
  let existing = new_headers["Set-Cookie"]
  if existing == nil
    new_headers["Set-Cookie"] = cookie_str
  elif type(existing) == "table"
    let all = []
    for c in existing
      push(all, c)
    end
    push(all, cookie_str)
    new_headers["Set-Cookie"] = all
  else
    new_headers["Set-Cookie"] = [existing, cookie_str]
  end
  {status: resp.status, headers: new_headers, body: resp.body}
end

## Returns a copy of `resp` with one more Set-Cookie header; `resp` is
## left unchanged and its `headers` may be nil. Each cookie is sent as its
## own Set-Cookie line.
##
## Options: `path` (default "/"), `http_only` (default true), `secure`
## (default false), `same_site` (default "Lax"), `max_age` (seconds, int)
## and `expires` (epoch ms, int); nil leaves an attribute out. A nil or
## table `value` raises.
##
##   http.set_cookie(http.ok("hi"), "sid", token, {max_age: 3600})
##   # Set-Cookie: sid=<token>; Path=/; Max-Age=3600; HttpOnly; SameSite=Lax
##
## Raises `http.set_cookie: invalid cookie <name|value|path|same_site>
## "..." (...)` when one of those holds `;`, `,`, whitespace or a control
## byte, or the name is empty or has `=` (encode arbitrary data first with
## `url.encode`; a handler reads it back from `req.cookies` with
## `url.decode`); also when `max_age` or `expires` isn't an int.
fn set_cookie(resp, name, value, {path = "/", http_only = true, secure = false, same_site = "Lax", max_age = nil, expires = nil} = {})
  add_set_cookie(resp, cookie_line("http.set_cookie", name, value, path, http_only, secure, same_site, max_age, expires))
end

## Returns a copy of `resp` with a Set-Cookie header that deletes cookie
## `name` (empty value, `Max-Age=0`). Give the same `path` the cookie was
## set with (default "/"). Raises like `set_cookie`, with
## `http.delete_cookie: `.
##
##   http.delete_cookie(http.redirect("/"), "sid")
fn delete_cookie(resp, name, {path = "/"} = {})
  add_set_cookie(resp, cookie_line("http.delete_cookie", name, "", path, true, false, "Lax", 0, nil))
end

# ─── Cookie parsing ───

fn parse_cookies(cookie_header)
  let cookies = {}
  if cookie_header == nil
    return cookies
  end
  for pair in string.split(cookie_header, ";")
    let eq = string.index_of(pair, "=")
    if eq > 0
      let name = string.trim(substr(pair, 0, eq))
      cookies[name] = string.trim(substr(pair, eq + 1, len(pair) - eq - 1))
    end
  end
  cookies
end

# ─── Form parsing ───

## Returns the fields of a URL-encoded form body (`a=1&b=x+y`) as a
## table of strings, decoded as by `url.parse_query`: `+` is a space, a
## key without `=` gets "", and a repeated key keeps its last value.
##
##   http.parse_form("name=Ann+Lee&age=30")    # {name: "Ann Lee", age: "30"}
##   http.parse_form(req.body)
##
## Raises `http.parse_form: body must be a string, got <type>` for a
## non-string `body`.
fn parse_form(body)
  if type(body) != "string"
    error("http.parse_form: body must be a string, got {type(body)}")
  end
  url.parse_query(body)
end

# ─── Security ───

## Returns `s` with `&`, `<`, `>`, `"` and `'` replaced by HTML entities,
## safe to put in HTML text or a quoted attribute.
##
##   http.html_escape("<b>\"Tom\" & 'Jerry'</b>")
##   # "&lt;b&gt;&quot;Tom&quot; &amp; &#x27;Jerry&#x27;&lt;/b&gt;"
##
## Raises `http.html_escape: s must be a string, got <type>` when `s`
## isn't a string (convert numbers with "{n}").
fn html_escape(s)
  if type(s) != "string"
    error("http.html_escape: s must be a string, got {type(s)}")
  end
  let out = str_replace(s, "&", "&amp;")
  out = str_replace(out, "<", "&lt;")
  out = str_replace(out, ">", "&gt;")
  out = str_replace(out, '"', "&quot;")
  str_replace(out, "'", "&#x27;")
end

# ─── Router ───

# The params of `path` for a route pattern with parameters (split into
# `pat_segs`), or nil when it doesn't match. `path_segs` is the path split
# at "/".
fn match_route(pat_segs, path_segs)
  if len(pat_segs) != len(path_segs)
    return nil
  end
  let params = {}
  for i, ps in pat_segs
    let us = path_segs[i]
    if len(ps) > 0 and ord(ps, 0) == 58
      params[substr(ps, 1, len(ps) - 1)] = url.decode(str_replace(us, "+", "%2B"))   # `+` is literal in a path
    elif ps != us
      return nil
    end
  end
  params
end

fn normalize_path(p)
  let result = []
  for s in string.split(p, "/")
    if s == ".."
      if len(result) > 0
        pop(result)
      end
    elif s != "." and s != ""
      push(result, s)
    end
  end
  "/{string.join(result, "/")}"
end

# True when `prefix` (plen bytes, a prefix of `path`) ends at a segment
# boundary of `path`: `/static` matches `/static` and `/static/x`, not
# `/staticx`.
fn at_segment(path, prefix, plen)
  plen == 0 or len(path) == plen or ord(path, plen) == 47 or ord(prefix, plen - 1) == 47
end

# The static file under one of `static_routes` for a GET of `path`, as a
# match result, or nil.
fn match_static(static_routes, path)
  for sr in static_routes
    let plen = len(sr.prefix)
    if string.starts_with(path, sr.prefix) and at_segment(path, sr.prefix, plen)
      # Decoded before the `..` check in normalize_path; `+` is literal in a
      # path. A NUL would cut the name short in the file system's calls.
      let rel = url.decode(str_replace(substr(path, plen, len(path) - plen), "+", "%2B"))
      if rel == "" or rel == "/"
        rel = "/index.html"
      end
      let file_path = "{sr.dir}{normalize_path(rel)}"
      if find(file_path, "\0") < 0 and file_exists(file_path) and not is_dir(file_path)
        let content = read_file(file_path)
        let ct = mime.lookup(file_path)
        let handler = fn(req)
          {status: 200, headers: {"Content-Type": ct, "Cache-Control": "public, max-age=3600"}, body: content}
        end
        return {handler: handler, params: {}}
      end
    end
  end
  nil
end

## Returns a new, empty router. Register routes on it, then pass it to
## `start` or `serve`:
##
##   app.get(pattern, handler)     # also app.post, put, patch, delete
##   app.static(url_prefix, dir)   # GET files under dir
##   app.match(method, path)       # {handler, params} or nil
##
## A pattern segment starting with `:` matches any one segment, also an
## empty one (`/users/` matches `/users/:id` with id ""), and puts it,
## percent-decoded (`%XX` only: `+` stays `+`, unlike `url.decode`), in
## `req.params`; other segments match literally. Trailing slashes are
## not normalized: `/users/42/` doesn't match `/users/:id`.
## The first matching route registered wins. A HEAD request runs the GET
## route and gets its headers without the body. An unmatched method gets
## a 404 (no 405). `match` takes a path without its query string and
## doesn't fall back from HEAD to GET.
##
##   app.get("/users/:id") do |req|
##     http.ok("user {req.params.id}")    # GET /users/42 -> "user 42"
##   end
##
## `static` serves `dir`'s files for GETs of `url_prefix` and below, with
## Content-Type from `std/mime`. The prefix matches whole segments
## (`/static` serves `/static/a.css`, not `/staticx`), the prefix itself
## gives `index.html`, `..` can't leave `dir`, and a directory or missing
## file is a 404. `dir` is relative to the current directory, not the
## source file; a missing `dir` just gives 404s. The path is
## percent-decoded (`%XX` only, as for `:params`) before the lookup.
## Routes are tried before static dirs.
## Each request reads the whole file, so don't serve huge files this way.
## Files are sent with `Cache-Control: public, max-age=3600`, so browsers
## may show a stale copy for up to an hour.
fn router()
  let routes = []
  let static_routes = []

  # A pattern without parameters matches its own text only: `segs` is nil
  # and no split is needed.
  let add_route = fn(method, pattern, handler)
    let segs = if has_text(pattern, ":") then string.split(pattern, "/") end
    push(routes, {method: method, pattern: pattern, segs: segs, handler: handler})
  end

  let r = {}

  r.get = fn(pattern, handler)
    add_route("GET", pattern, handler)
  end

  r.post = fn(pattern, handler)
    add_route("POST", pattern, handler)
  end

  r.put = fn(pattern, handler)
    add_route("PUT", pattern, handler)
  end

  r.patch = fn(pattern, handler)
    add_route("PATCH", pattern, handler)
  end

  r.delete = fn(pattern, handler)
    add_route("DELETE", pattern, handler)
  end

  r.static = fn(url_prefix, dir_path)
    push(static_routes, {prefix: url_prefix, dir: dir_path})
  end

  r.match = fn(method, path)
    let path_segs = nil
    for route in routes
      if route.method == method
        if route.segs == nil
          if route.pattern == path
            return {handler: route.handler, params: {}}
          end
        else
          if path_segs == nil
            path_segs = string.split(path, "/")
          end
          let params = match_route(route.segs, path_segs)
          if params != nil
            return {handler: route.handler, params: params}
          end
        end
      end
    end
    if method == "GET"
      return match_static(static_routes, path)
    end
    nil
  end

  r
end

# ─── Reading requests ───

# A connection's reader: the bytes received but not yet consumed (`data`
# from `pos` on), and the deadline for the request being read (nil while
# waiting for its first byte).
fn new_reader(fd, cfg)
  {fd: fd, data: "", pos: 0, deadline: nil, idle_ms: cfg.idle_ms, request_ms: cfg.request_ms, write_ms: cfg.write_ms}
end

fn pending(rd)
  len(rd.data) - rd.pos
end

# Starts the clock for the request being read.
fn start_deadline(rd)
  if rd.deadline == nil and rd.request_ms != nil
    rd.deadline = time_ms() + rd.request_ms
  end
end

# The next bytes from the peer: each read waits at most `idle_ms` (nil:
# no limit), and never past the request's deadline. nil when the peer
# closed or the time ran out.
fn read_more(rd)
  let wait = rd.idle_ms
  if rd.deadline != nil
    let left = rd.deadline - time_ms()
    if left <= 0
      return nil
    end
    if wait == nil or left < wait
      wait = left
    end
  end
  # nil = timeout, "" = EOF; both end the connection.
  let chunk = tcp_read(rd.fd, READ_SIZE, wait)
  if chunk == nil or chunk == ""
    return nil
  end
  start_deadline(rd)
  chunk
end

# Appends the next bytes to the reader; false when there are none. (For
# short lines: read_exact takes big bodies without copying them here.)
fn fill(rd)
  let chunk = read_more(rd)
  if chunk == nil
    return false
  end
  if rd.pos < len(rd.data)
    chunk = "{substr(rd.data, rd.pos, len(rd.data) - rd.pos)}{chunk}"
  end
  rd.data = chunk
  rd.pos = 0
  true
end

fn last_bytes(s, n)
  if len(s) <= n
    return s
  end
  substr(s, len(s) - n, n)
end

# Reads up to the end of the request head and returns the head without its
# final blank line, nil when the peer closed or the time ran out,
# {too_large: true} when the head is over MAX_HEADER_BYTES, or
# {bare_lf: true} when "\n\n" comes before any CRLF CRLF (a head ending in
# bare LFs, which would otherwise wait for the timeout; a bare LF inside a
# complete head is caught by parse_head). Chunks collect
# in a buffer and only the new bytes are scanned, so a peer sending one
# byte at a time costs linear time.
fn read_head(rd)
  let found = find(rd.data, "\r\n\r\n", rd.pos)
  if found < 0 and rd.pos == len(rd.data)
    # Nothing pending (the usual case): one read mostly brings the whole
    # head, and then needs no buffer.
    let chunk = read_more(rd)
    if chunk == nil
      return nil
    end
    rd.data = chunk
    rd.pos = 0
    found = find(chunk, "\r\n\r\n", 0)
  end
  if found < 0
    if find(rd.data, "\n\n", rd.pos) >= 0
      return {bare_lf: true}
    end
    let acc = buf_new()
    let rest = substr(rd.data, rd.pos, len(rd.data) - rd.pos)
    buf_push(acc, rest)
    let have = len(rest)
    let tail = last_bytes(rest, 3)
    while found < 0
      let chunk = read_more(rd)
      if chunk == nil
        return nil
      end
      let window = "{tail}{chunk}"
      let at = find(window, "\r\n\r\n", 0)
      if at >= 0
        found = have - len(tail) + at
      elif find(window, "\n\n", 0) >= 0
        return {bare_lf: true}
      end
      buf_push(acc, chunk)
      have += len(chunk)
      tail = last_bytes(window, 3)
      if found < 0 and have > MAX_HEADER_BYTES
        return {too_large: true}
      end
    end
    rd.data = to_string(acc)
    rd.pos = 0
  end
  if found - rd.pos > MAX_HEADER_BYTES
    return {too_large: true}
  end
  let head = substr(rd.data, rd.pos, found - rd.pos)
  rd.pos = found + 4
  {text: head}
end

# Exactly n bytes; nil when the peer closed or the time ran out first.
# Each chunk read goes straight into the result (only the part past the
# n bytes is kept in the reader).
fn read_exact(rd, n)
  let have = pending(rd)
  if have >= n
    let s = substr(rd.data, rd.pos, n)
    rd.pos = rd.pos + n
    return s
  end
  let out = buf_new()
  buf_push(out, substr(rd.data, rd.pos, have))
  rd.data = ""
  rd.pos = 0
  while have < n
    let chunk = read_more(rd)
    if chunk == nil
      return nil
    end
    let need = n - have
    if len(chunk) > need
      buf_push(out, substr(chunk, 0, need))
      rd.data = chunk
      rd.pos = need
      have = n
    else
      buf_push(out, chunk)
      have += len(chunk)
    end
  end
  to_string(out)
end

# The next CRLF-terminated line (for chunked bodies): {line}, {closed: true}
# when the peer closed or the time ran out, or {bad: true} for a bare LF or
# a line over MAX_LINE bytes.
fn read_line(rd)
  let scan = rd.pos
  while true
    let nl = find(rd.data, "\n", scan)
    if nl >= 0
      if nl == rd.pos or ord(rd.data, nl - 1) != 13 or nl - rd.pos - 1 > MAX_LINE
        return {bad: true}
      end
      let line = substr(rd.data, rd.pos, nl - rd.pos - 1)
      rd.pos = nl + 1
      return {line: line}
    end
    let before = pending(rd)
    if before > MAX_LINE
      return {bad: true}
    end
    if not fill(rd)
      return {closed: true}
    end
    scan = rd.pos + before
  end
end

# A chunk size: hex digits, leading zeros allowed (at most MAX_CHUNK_SIZE_LEN
# characters in all, 15 significant digits).
fn parse_hex(s)
  let n_len = len(s)
  if n_len == 0 or n_len > MAX_CHUNK_SIZE_LEN
    return nil
  end
  let start = 0
  while start < n_len - 1 and ord(s, start) == 48
    start += 1
  end
  if n_len - start > 15
    return nil
  end
  let n = 0
  for i = start, n_len
    let c = ord(s, i)
    let d = if c >= 48 and c <= 57
      c - 48
    elif c >= 97 and c <= 102
      c - 87
    elif c >= 65 and c <= 70
      c - 55
    else
      -1
    end
    if d < 0
      return nil
    end
    n = n * 16 + d
  end
  n
end

# Decodes a chunked request body: {body}, {status: 400 or 413} for a
# malformed or oversized one, or nil when the peer closed or the time ran
# out. Chunk extensions and trailer fields are discarded.
fn read_chunked(rd, max_body)
  let out = buf_new()
  let total = 0
  while true
    let r = read_line(rd)
    if r.closed
      return nil
    elif r.bad
      return {status: 400}
    end
    let size_str = r.line
    if not line_bytes_ok(size_str)
      return {status: 400}
    end
    let semi = find(size_str, ";", 0)
    if semi >= 0
      size_str = substr(size_str, 0, semi)
    end
    let size = parse_hex(string.trim(size_str))
    if size == nil
      return {status: 400}
    end
    if size == 0
      break
    end
    total += size
    if total > max_body
      return {status: 413}
    end
    let piece = read_exact(rd, size)
    if piece == nil
      return nil
    end
    buf_push(out, piece)
    let end_r = read_line(rd)
    if end_r.closed
      return nil
    elif end_r.bad or end_r.line != ""
      return {status: 400}
    end
  end
  let trailer_bytes = 0
  while true
    let r = read_line(rd)
    if r.closed
      return nil
    elif r.bad
      return {status: 400}
    end
    if r.line == ""
      break
    end
    if not line_bytes_ok(r.line)
      return {status: 400}
    end
    trailer_bytes += len(r.line)
    if trailer_bytes > MAX_HEADER_BYTES
      return {status: 400}
    end
  end
  {body: to_string(out)}
end

# ─── Parsing requests ───

# False when `line` has a control byte other than HTAB (a CR or LF in it
# is bare: lines are split at CRLF).
fn line_bytes_ok(line)
  gem_bytes_span(line, FIELD_BYTES) == len(line)
end

fn is_digit(c)
  c >= 48 and c <= 57
end

# "GET /path HTTP/1.1" as {method, target, http10}, or the status to
# reject it with: 400 when malformed, 505 for an HTTP version other than
# 1.0 and 1.1.
fn parse_request_line(line)
  if not line_bytes_ok(line)
    return 400
  end
  let sp1 = find(line, " ", 0)
  if sp1 <= 0
    return 400
  end
  let sp2 = find(line, " ", sp1 + 1)
  if sp2 <= sp1 + 1 or len(line) - sp2 - 1 != 8
    return 400
  end
  let version = substr(line, sp2 + 1, 8)
  if version != "HTTP/1.1" and version != "HTTP/1.0"
    if substr(version, 0, 5) == "HTTP/" and is_digit(ord(version, 5)) and ord(version, 6) == 46 and is_digit(ord(version, 7))
      return 505
    end
    return 400
  end
  {method: substr(line, 0, sp1), target: substr(line, sp1 + 1, sp2 - sp1 - 1), http10: version == "HTTP/1.0"}
end

# str_replace (in C) returns its input unchanged when nothing matches.
fn has_text(s, t)
  len(str_replace(s, t, "")) != len(s)
end

# A header name in lowercase (ASCII letters only); the name itself when it
# has no uppercase letter.
fn lower_name(name)
  let n = len(name)
  let i = gem_bytes_span(name, LOWER_NAME_BYTES)
  if i == n
    return name
  end
  let out = buf_new()
  let run = 0                     # the bytes from here on aren't copied yet
  while i < n
    # name[i] is an uppercase letter
    if i > run
      buf_push(out, substr(name, run, i - run))
    end
    buf_push(out, chr(ord(name, i) + 32))
    run = i + 1
    # The next one, 32 bytes at a time (linear, also for a long name).
    i = run
    while i < n
      let w = n - i
      if w > 32
        w = 32
      end
      let k = gem_bytes_span(substr(name, i, w), LOWER_NAME_BYTES)
      i += k
      if k < w
        break
      end
    end
  end
  if run < n
    buf_push(out, substr(name, run, n - run))
  end
  to_string(out)
end

fn is_ows(c)
  c == 32 or c == 9
end

# `s` from `from` on, without leading and trailing spaces and tabs (the
# only whitespace a checked header line can hold).
fn trimmed_from(s, from)
  let stop = len(s)
  let start = from + gem_bytes_span(substr(s, from, stop - from), " \t")
  while stop > start and is_ows(ord(s, stop - 1))
    stop -= 1
  end
  substr(s, start, stop - start)
end

# The request head as {method, target, http10, headers}, or the status to
# reject it with (400 for a malformed request line or header line, or a
# control byte other than HTAB anywhere: lines are split at CRLF, so a CR
# or LF left in a line is bare, and RFC 9112 §2.2 makes a bare one a
# smuggling risk). One pass over the lines. Header names are lowercased
# and values trimmed; a repeated header's values are joined with ", "
# (cookies with "; "), once at the end. A header line needs a name
# without whitespace before its colon. An HTTP/1.1 request needs exactly
# one Host header (RFC 9112 §3.2).
fn parse_head(head)
  let n = len(head)
  let eol = find(head, "\r\n", 0)
  if eol < 0
    eol = n
  end
  let info = parse_request_line(substr(head, 0, eol))
  if type(info) == "int"
    # A bad byte anywhere in the head makes it a 400, not a 505.
    if info == 505
      let lines = str_replace(head, "\r\n", "")
      if gem_bytes_span(lines, FIELD_BYTES) != len(lines)
        return 400
      end
    end
    return info
  end
  let headers = {}
  let repeated = nil              # key -> its values, for repeated headers
  let pos = eol + 2
  while pos <= n
    let stop = find(head, "\r\n", pos)
    if stop < 0
      stop = n
    end
    let line = substr(head, pos, stop - pos)
    pos = stop + 2
    let colon = gem_bytes_span(line, NAME_BYTES)
    if colon == 0 or colon == len(line) or ord(line, colon) != 58 or not line_bytes_ok(line)
      return 400
    end
    let key = lower_name(substr(line, 0, colon))
    let value = trimmed_from(line, colon + 1)
    let prev = headers[key]
    if prev == nil
      headers[key] = value
    else
      if repeated == nil
        repeated = {}
      end
      let parts = repeated[key]
      if parts == nil
        parts = [prev]
        repeated[key] = parts
      end
      push(parts, value)
    end
  end
  if not info.http10 and (headers.host == nil or (repeated != nil and repeated.host != nil))
    return 400
  end
  if repeated != nil
    for key, parts in repeated
      let sep = if key == "cookie" then "; " else ", " end
      headers[key] = string.join(parts, sep)
    end
  end
  info.headers = headers
  info
end

# A Content-Length value as an int (0 when absent), or nil when it isn't a
# plain decimal number.
fn content_length(value)
  if value == nil
    return 0
  end
  if len(value) == 0 or len(value) > 15 or gem_bytes_span(value, "0123456789") != len(value)
    return nil
  end
  to_int(value)
end

# A comma-separated header value (Connection, Transfer-Encoding) as its
# lowercased tokens.
fn token_list(value)
  let out = []
  if value == nil
    return out
  end
  let n = len(value)
  if n > 0 and gem_bytes_span(value, LOWER_TOKEN_BYTES) == n
    push(out, value)              # one lowercase token: nothing to split
    return out
  end
  for part in string.split(value, ",")
    let t = string.lower(string.trim(part))
    if t != ""
      push(out, t)
    end
  end
  out
end

fn has_token(tokens, t)
  for x in tokens
    if x == t
      return true
    end
  end
  false
end

# ─── Responses ───

fn status_text(code)
  if code == 200
    return "OK"                   # no read of STATUS_TEXT: in a new
  end                             # process, that copies the table first
  let text = STATUS_TEXT[code]
  if text == nil
    return "Unknown"
  end
  text
end

# The server writes these itself; a handler's own are dropped.
fn is_framing_header(name)
  let l = len(name)
  if l != 10 and l != 14 and l != 17
    return false
  end
  let n = lower_name(name)
  n == "content-length" or n == "transfer-encoding" or n == "connection"
end

fn has_cr_or_lf(s)
  gem_bytes_span(s, NO_CRLF_BYTES) != len(s)
end

# True for an HTTP token (a header name): letters, digits and
# !#$%&'*+-.^_`|~ only.
fn is_token(s)
  len(s) > 0 and gem_bytes_span(s, TOKEN_BYTES) == len(s)
end

# nil when `resp` can be sent, else what is wrong with it.
fn response_problem(resp)
  if type(resp) != "table"
    return "handler returned {resp}, not a response table"
  end
  let status = resp.status
  if type(status) != "int"
    return "invalid response: status must be an int, got {type(status)} {status}"
  end
  if status < 200 or status > 999
    return "invalid response: status {status} is not from 200 to 999 (1xx responses are not supported)"
  end
  if resp.body != nil and type(resp.body) != "string"
    return "invalid response: body must be nil or a string, got {type(resp.body)}"
  end
  let headers = resp.headers
  if headers == nil
    return nil
  end
  if type(headers) != "table"
    return "invalid response: headers must be nil or a table, got {type(headers)}"
  end
  for name, value in headers
    if type(name) != "string" or not is_token(name)
      return "invalid response: header name \"{name}\" is not an HTTP token"
    end
    let values = if type(value) == "table"
      # `__is_array_n` is the check array patterns compile to.
      if not __is_array_n(value, len(value))
        return "invalid response: header {name} must be a string, number, bool or array of them, got a table with keys other than 0 .. n-1"
      end
      value
    else
      [value]
    end
    for v in values
      let t = type(v)
      if t != "string" and t != "int" and t != "float" and t != "bool"
        return "invalid response: header {name} must be a string, number, bool or array of them, got {t}"
      end
      if t == "string" and has_cr_or_lf(v)
        return "invalid response: header {name} has a CR or LF in its value"
      end
    end
  end
  nil
end

# The response's bytes. `head_only` (a HEAD request) leaves the body out
# but keeps its Content-Length; 1xx, 204 and 304 responses have neither.
fn serialize_response(resp, keep_alive, head_only = false)
  let body = resp.body
  if body == nil
    body = ""
  end
  let status = resp.status
  let bodiless = status < 200 or status == 204 or status == 304
  build_string() do |add|
    add("HTTP/1.1 ", status, " ", status_text(status), "\r\n")
    if not bodiless
      add("Content-Length: ", len(body), "\r\n")
    end
    if keep_alive
      add("Connection: keep-alive\r\n")
    else
      add("Connection: close\r\n")
    end
    if resp.headers != nil
      for k, v in resp.headers
        if not is_framing_header(k)
          if type(v) == "table"
            for part in v
              add(k, ": ", part, "\r\n")
            end
          else
            add(k, ": ", v, "\r\n")
          end
        end
      end
    end
    add("\r\n")
    if not bodiless and not head_only
      add(body)
    end
  end
end

# True when the handler's own Connection header asks to close.
fn response_closes(resp)
  if resp.headers == nil
    return false
  end
  for k, v in resp.headers
    if len(k) == 10 and lower_name(k) == "connection" and has_token(token_list("{v}"), "close")
      return true
    end
  end
  false
end

# ─── Error reporting ───

# The directory part of a frame's file ("" when it has none).
fn dir_of(file)
  let i = len(file) - 1
  while i >= 0 and ord(file, i) != 47
    i -= 1
  end
  substr(file, 0, i + 1)
end

fn probe()
  error("probe")
end

# The directory of std/http's own file as stack frames show it (std/http's
# path depends on the install root and the project layout), or nil.
fn std_dir()
  let r = pcall probe()
  if r.ok or len(r.stack) == 0 or type(r.stack[0].file) != "string"
    return nil
  end
  let d = dir_of(r.stack[0].file)
  if d == ""
    return nil
  end
  d
end

# The frames of `stack` (a handler's error, from the pcall around the
# call) without the closure `pcall` wraps the call in and without the
# std frames on top: a builder such as `set_cookie` that raised, and the
# std functions it called, such as `json.encode` in `json_response`. A
# std frame is one whose file is in std/http's directory (when that can't
# be found, one of an `http.` function).
fn handler_frames(stack)
  let dir = std_dir()
  let frames = []
  for f in stack
    let std_frame = if dir == nil
      string.starts_with(f.name, "http.")
    else
      type(f.file) == "string" and string.starts_with(f.file, dir)
    end
    if len(frames) > 0 or not std_frame
      push(frames, f)
    end
  end
  if len(frames) > 0
    pop(frames)
  end
  frames
end

fn report_error(what, stack)
  let frames = handler_frames(stack)
  let out = build_string() do |add|
    add("http: ", what)
    if len(frames) > 0
      add("\nStack trace:")
      for f in frames
        add("\n  at ", f.name, " (", f.file, ":", f.line, ")")
      end
    end
  end
  eprint(out)
end

# Runs the handler. Returns its response, or a 500 after reporting the
# error (or what is wrong with the response) on stderr.
fn call_handler(handler, req)
  let r = pcall handler(req)
  if not r.ok
    report_error("{req.method} {req.path}: {r.error}", r.stack)
    return server_error()
  end
  let problem = response_problem(r.value)
  if problem != nil
    report_error("{req.method} {req.path}: {problem}", [])
    return server_error()
  end
  r.value
end

# ─── Connections ───

# Reads and discards what the peer still sends, until it pauses for
# DRAIN_QUIET_MS or `total_ms` (default 1 s) have passed, so that closing with unread
# request bytes doesn't reset the connection before the peer has read the
# response.
fn drain(fd, total_ms = 1000)
  let until = time_ms() + total_ms
  while time_ms() < until
    let chunk = tcp_read(fd, READ_SIZE, DRAIN_QUIET_MS)
    if chunk == nil or chunk == ""
      return nil
    end
  end
  nil
end

# Answers `status` with its default text, then drains; the connection is
# to be closed (returns false).
fn reject(rd, status, head_only = false)
  let resp = response(status, {"Content-Type": TEXT_PLAIN}, status_text(status))
  tcp_write(rd.fd, serialize_response(resp, false, head_only), rd.write_ms)
  drain(rd.fd)
  false
end

# The process table is full: 503, then close. The acceptor runs this, so
# the write doesn't wait: a fresh socket takes the short response at once.
fn refuse(fd)
  let resp = response(503, {"Content-Type": TEXT_PLAIN}, status_text(503))
  tcp_write(fd, serialize_response(resp, false), 0)
  drain(fd, REFUSE_DRAIN_MS)
  tcp_close(fd)
end

# Reads the body announced by the head into `req.body`. Returns nil when
# it was read, a status to reject the request with, or false when the
# peer closed or the time ran out.
fn read_body(rd, cfg, head, req)
  let headers = head.headers
  let te = headers["transfer-encoding"]
  let chunked = false
  let n = 0
  if te != nil
    if headers["content-length"] != nil or head.http10
      return 400
    end
    let codings = token_list(te)
    if len(codings) != 1 or codings[0] != "chunked"
      return 501
    end
    chunked = true
  else
    n = content_length(headers["content-length"])
    if n == nil
      return 400
    end
    if n > cfg.max_body
      return 413
    end
    if n == 0
      return nil
    end
  end
  let expect = headers["expect"]
  if expect != nil and string.lower(expect) == "100-continue" and not head.http10
    if not send_all(rd, "HTTP/1.1 100 Continue\r\n\r\n")
      return false
    end
  end
  if chunked
    let r = read_chunked(rd, cfg.max_body)
    if r == nil
      return false
    elif r.status != nil
      return r.status
    end
    req.body = r.body
  else
    let body = read_exact(rd, n)
    if body == nil
      return false
    end
    req.body = body
  end
  nil
end

# `text` without its leading CRLFs.
fn skip_crlfs(text)
  let i = 0
  let n = len(text)
  while i + 1 < n and ord(text, i) == 13 and ord(text, i + 1) == 10
    i += 2
  end
  substr(text, i, n - i)
end

# Reads the next request head, ignoring empty lines (CRLFs) before its
# request line (RFC 9112 §2.2): the head's text, nil when the peer closed
# or the time ran out, {too_large: true} or {only_empty: true} when there
# was nothing but empty lines for too long.
fn read_request_head(rd)
  for attempt = 0, MAX_EMPTY_LINE_HEADS
    let raw = read_head(rd)
    if raw == nil or raw.too_large or raw.bare_lf
      return raw
    end
    let text = raw.text
    if len(text) > 0 and ord(text, 0) == 13
      text = skip_crlfs(text)
    end
    if text != ""
      return {text: text}
    end
  end
  {only_empty: true}
end

# The path and query of an absolute-form target (`http://host/x?y`, as a
# request to a proxy sends it), as an origin-form target (`/x?y`); any
# other target unchanged.
fn origin_target(target)
  if len(target) == 0 or ord(target, 0) == 47
    return target
  end
  let scheme_end = string.index_of(target, "://")
  if scheme_end < 0
    return target
  end
  let scheme = string.lower(substr(target, 0, scheme_end))
  if scheme != "http" and scheme != "https"
    return target
  end
  let host_start = scheme_end + 3
  let n = len(target)
  for i = host_start, n
    let c = ord(target, i)
    if c == 47
      return substr(target, i, n - i)
    elif c == 63
      return "/{substr(target, i, n - i)}"
    end
  end
  "/"
end

# The path and query of an origin-form target, as url.parse gives them
# (without its byte loop for the usual target with no `?` or `#`).
fn parse_target(target)
  if find(target, "?", 0) < 0 and find(target, "#", 0) < 0
    return {path: target, query: {}}
  end
  url.parse(target)
end

# After a handler ran: when it turned on trap_exit, turns it off again (a
# connection process doesn't trap exits, so `stop` can kill it between
# requests) and returns true when the server asked it to exit meanwhile
# (its EXIT message is queued) or is gone.
fn stop_requested(server)
  if not process_flag("trap_exit", false)
    return false
  end
  let asked = receive
  when {tag: "EXIT", pid: ^server} then true
  after 0 then false
  end
  let info = process_info(server)
  asked or info == nil or info.state == "dead"
end

# Serves one request. Returns true to keep the connection open.
fn process_one_request(rd, cfg)
  rd.deadline = nil
  if pending(rd) > 0
    start_deadline(rd)
  end
  let raw = read_request_head(rd)
  if raw == nil
    return false
  end
  if raw.too_large
    return reject(rd, 431)
  elif raw.only_empty or raw.bare_lf
    return reject(rd, 400)
  end
  let head = parse_head(raw.text)
  if type(head) == "int"
    return reject(rd, head)
  end
  let head_only = head.method == "HEAD"
  let headers = head.headers
  let parsed = parse_target(origin_target(head.target))
  let req = {
    method: head.method,
    path: parsed.path,
    query: parsed.query,
    headers: headers,
    body: "",
    cookies: parse_cookies(headers["cookie"]),
    params: {}
  }
  let bad = read_body(rd, cfg, head, req)
  if bad == false
    return false
  elif bad != nil
    return reject(rd, bad, head_only)
  end

  let tokens = token_list(headers["connection"])
  let keep_alive = not has_token(tokens, "close")
  if head.http10
    keep_alive = keep_alive and has_token(tokens, "keep-alive")
  end

  let route_method = if head_only then "GET" else req.method end
  let matched = cfg.router.match(route_method, req.path)
  let resp = nil
  if matched != nil
    req.params = matched.params
    resp = call_handler(matched.handler, req)
    if stop_requested(cfg.server)
      keep_alive = false
    end
  else
    resp = not_found()
  end
  if response_closes(resp)
    keep_alive = false
  end
  if not send_all(rd, serialize_response(resp, keep_alive, head_only))
    keep_alive = false
  end
  keep_alive
end

# Writes a response. `write_ms` bounds the wait for progress, not the whole
# response: a slow client that keeps taking bytes gets all of it. Each
# tcp_write waits up to write_ms; one that writes nothing ends the
# response, so a client that stops taking bytes loses its connection
# between write_ms and twice that after its last byte (logged), as does
# one that has gone (not logged). Returns false when the response was cut.
fn send_all(rd, out)
  let rest = out
  while true
    let t0 = time_ms()
    let n = tcp_write(rd.fd, rest, rd.write_ms)
    if n == len(rest)
      return true
    elif n == 0
      if rd.write_ms != nil and time_ms() - t0 >= rd.write_ms
        eprint("http: closing a connection: the client took no bytes of a {len(out)}-byte response for {rd.write_ms} ms")
      end
      return false
    end
    rest = substr(rest, n)
  end
end

# Keep-alive loop: serve requests on `fd` until the peer closes, goes idle,
# or a request or response asks to close. Claims the socket first, so it
# closes however this process ends, and tells the server process before
# closing it.
fn handle_connection(fd, cfg)
  claim(fd)
  let rd = new_reader(fd, cfg)
  let open = true
  while open
    let r = pcall process_one_request(rd, cfg)
    if r.ok
      open = r.value
    else
      eprint("http: internal error: {r.error}")
      pcall reject(rd, 500)
      open = false
    end
  end
  send(cfg.server, {tag: "_http_closing", pid: self()})
  tcp_close(fd)
end

# ─── Server ───

# Accept loop: a process per connection, registered with the server
# process. When the process table is full, that connection gets a 503;
# when accepting fails (out of file descriptors), the loop logs it once
# and retries every ACCEPT_BACKOFF_MS until it succeeds again.
fn accept_loop(listen_fd, cfg)
  let failing = false
  while true
    let a = pcall tcp_accept(listen_fd)
    if a.ok
      failing = false
      let fd = a.value
      let r = pcall spawn(fn()
        handle_connection(fd, cfg)
      end)
      if r.ok
        # Registered here, not by the connection on its first run: the
        # acceptor is killed before the server's shut-down sweep, so every
        # connection it spawned is in the server's mailbox by then.
        send(cfg.server, {tag: "_http_conn", pid: r.value, fd: fd})
      else
        eprint("http: {r.error}; refusing a connection")
        pcall refuse(fd)
      end
    else
      if not failing
        eprint("http: {a.error}; retrying every {ACCEPT_BACKOFF_MS} ms")
        failing = true
      end
      sleep(ACCEPT_BACKOFF_MS)
    end
  end
end

# A message to the server process, from a connection or the runtime:
# start tracking a connection ("_http_conn", from the acceptor), stop
# tracking it ("_http_closing": it closes its own socket next), its
# "DOWN" (close its socket if it still holds one), or an "EXIT". `conns`
# maps each tracked connection's pid to its socket. A new connection is
# monitored at once when `unwatched` is nil, else its pid is pushed there
# for `watch_new` (see server_main). Returns the reason to shut down for,
# or nil. One catch-all receive and a dispatch on the tag cost less per
# message than a pattern per kind, and anything else sent to the server
# is dropped instead of piling up.
fn server_message(conns, msg, acceptor, watch, unwatched = nil)
  if type(msg) != "table" or type(msg.pid) != "int"
    return nil
  end
  let tag = msg.tag
  if tag == "_http_conn"
    conns[msg.pid] = msg.fd
    if unwatched == nil
      monitor(msg.pid)
    else
      push(unwatched, msg.pid)
    end
  elif tag == "_http_closing"
    delete(conns, msg.pid)
  elif tag == "DOWN"
    if watch != nil and msg.pid == watch
      return "shutdown"
    end
    let fd = delete(conns, msg.pid)
    if fd != nil
      tcp_close(fd)
    end
  elif tag == "EXIT"
    if msg.pid == acceptor
      eprint("http: acceptor died: {msg.reason}")
      return "acceptor died: {msg.reason}"
    elif msg.reason != "normal"
      return msg.reason
    end
  end
  nil
end

# Monitors the connections in `unwatched` that are still tracked (not
# closed meanwhile), and empties it. Monitoring one that has died already
# queues its DOWN at once, so the delay loses nothing.
fn watch_new(conns, unwatched)
  for pid in unwatched
    if conns[pid] != nil
      monitor(pid)
    end
  end
  while len(unwatched) > 0
    pop(unwatched)
  end
end

# Kills the acceptor and every connection and closes their sockets. A
# connection that traps exits isn't killed; it closes its own socket.
fn shut_down(listen_fd, acceptor, conns, watch)
  kill(acceptor, "shutdown")
  tcp_close(listen_fd)
  for pid in keys(conns)
    kill(pid, "shutdown")
  end
  # The DOWN of each connection killed above is queued by now. A
  # connection spawned just before the acceptor died may still be
  # registering: kill it too.
  let more = true
  while more
    receive
    when msg
      server_message(conns, msg, nil, watch)    # nil: the acceptor's EXIT is expected now
      if type(msg) == "table" and msg.tag == "_http_conn"
        kill(msg.pid, "shutdown")
      end
    after 0
      more = false
    end
  end
end

# The server process: traps exits, so that being killed (`stop`, a
# supervisor) or the acceptor dying arrives as an EXIT message and it can
# shut down cleanly before it exits with that reason. `watch` (serve's
# caller, or nil) is monitored: when it dies, the server shuts down too.
fn server_main(listen_fd, cfg, starter, ref, watch)
  claim(listen_fd)
  process_flag("trap_exit", true)
  if watch != nil
    monitor(watch)
  end
  cfg.server = self()
  let a = pcall spawn_link(fn()
    accept_loop(listen_fd, cfg)
  end)
  if not a.ok
    tcp_close(listen_fd)
    send(starter, {tag: "_http_started", ref: ref, error: a.error})
    return nil
  end
  let acceptor = a.value
  send(starter, {tag: "_http_started", ref: ref, error: nil})
  # A short connection has usually finished by the time the server runs:
  # its "_http_closing" is queued right behind its "_http_conn". So the
  # server takes every queued message before it monitors the connections
  # registered meanwhile, and one that has closed needs no monitor (and
  # sends no DOWN).
  let conns = {}
  let unwatched = []
  let reason = nil
  while reason == nil
    receive
    when msg
      reason = server_message(conns, msg, acceptor, watch, unwatched)
    end
    let more = reason == nil
    while more
      receive
      when msg
        reason = server_message(conns, msg, acceptor, watch, unwatched)
        more = reason == nil
      after 0
        more = false
      end
    end
    watch_new(conns, unwatched)
  end
  shut_down(listen_fd, acceptor, conns, watch)
  process_flag("trap_exit", false)
  kill(self(), reason)
end

fn check_int(caller, name, v, min)
  if type(v) != "int" or v < min
    error("{caller}: {name} must be an int >= {min}, got {v}")
  end
end

## Starts a server for `router_ref` without blocking and returns
## `{pid}`, the server process.
##
## Options: `port` (default 8080, 0 to 65535; 0 binds a free port but
## nothing tells you which), `host`
## (an IP address, default "0.0.0.0"; "127.0.0.1" for local only),
## `max_body` (bytes, default 8 MB; a bigger body gets 413),
## `idle_timeout_ms` (default 30000: the longest wait for each read, also
## for the next request on a kept-alive connection) and
## `request_timeout_ms` (default 30000: a request's head and body must
## arrive within it) and `write_timeout_ms` (default 30000: a response
## is cut once the client takes no bytes of it for a whole
## write_timeout_ms, which is between write_timeout_ms and twice that
## after the last byte it took, so one that stops reading can't hold its
## connection; a slow one that keeps reading gets the whole response). A timeout of nil means no limit; past a read
## one, the connection is closed without a response, past the write one,
## it is closed with the response cut short and a line on stderr. Other
## keys are ignored.
##
##   let server = http.start(app, {port: 8080, host: "127.0.0.1"})
##   ...
##   http.stop(server)
##
## Raises `http.start: ...` when the port can't be bound (in use, bad
## host), for a first argument that isn't from `router()`, or for a bad
## option. The server isn't linked to the caller: it keeps running after
## the caller exits, until `stop` or an exit signal (any reason but
## "normal") kills it, so it can be a supervisor child. Killing it closes
## the port and every connection.
fn start(router_ref, opts = {})
  launch("http.start", router_ref, nil, opts)
end

# A timeout option (its default when left out): nil (no limit) or an
# int > 0.
fn timeout_opt(caller, name, value)
  if value == nil
    return nil
  elif type(value) != "int"
    error("{caller}: {name} must be an int > 0 (milliseconds) or nil, got {type(value)}")
  elif value <= 0
    error("{caller}: {name} must be an int > 0 (milliseconds) or nil, got {value}")
  end
  value
end

# `start`, with the server watching `watch` (nil: nobody); errors start
# with `caller`.
fn launch(caller, router_ref, watch, opts)
  if type(opts) != "table"
    error("{caller}: opts must be a table, got {type(opts)}")
  end
  let {port = 8080, host = "0.0.0.0", max_body = DEFAULT_MAX_BODY, idle_timeout_ms = DEFAULT_IDLE_TIMEOUT_MS, request_timeout_ms = DEFAULT_REQUEST_TIMEOUT_MS, write_timeout_ms = DEFAULT_WRITE_TIMEOUT_MS} = opts
  if type(port) != "int" or port < 0 or port > 65535
    error("{caller}: port must be an int from 0 to 65535, got {port}")
  end
  if type(host) != "string"
    error("{caller}: host must be a string (an IP address), got {type(host)}")
  end
  check_int(caller, "max_body", max_body, 0)
  idle_timeout_ms = timeout_opt(caller, "idle_timeout_ms", idle_timeout_ms)
  request_timeout_ms = timeout_opt(caller, "request_timeout_ms", request_timeout_ms)
  write_timeout_ms = timeout_opt(caller, "write_timeout_ms", write_timeout_ms)
  if type(router_ref) != "table" or type(router_ref.match) != "fn"
    error("{caller}: expected a router from http.router(), got {type(router_ref)}")
  end
  let cfg = {router: router_ref, max_body: max_body, idle_ms: idle_timeout_ms, request_ms: request_timeout_ms, write_ms: write_timeout_ms, server: nil}
  let l = pcall tcp_listen(host, port)
  if not l.ok
    error("{caller}: {l.error}")
  end
  let listen_fd = l.value
  let me = self()
  let ref = make_ref()
  let s = pcall spawn(fn()
    server_main(listen_fd, cfg, me, ref, watch)
  end)
  if not s.ok
    tcp_close(listen_fd)
    error("{caller}: {s.error}")
  end
  receive
  when {tag: "_http_started", ref: ^ref, error: e}
    if e != nil
      error("{caller}: {e}")
    end
  after STOP_TIMEOUT_MS
    error("{caller}: the server process did not start")
  end
  {pid: s.value}
end

# Ends the monitor of `pid` a request took: `added` is what its `monitor`
# returned. A monitor the caller already had is left alone. One the request
# added is removed, and its DOWN dropped if the target died meanwhile.
fn drop_monitor(pid, added)
  if added and not demonitor(pid)
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    after 0
      nil
    end
  end
end

# After a request matched the DOWN of `pid` (with `reason`): when the
# monitor was the caller's own (`added` false), puts the DOWN back for it.
fn return_down(pid, added, reason)
  if not added
    send(self(), {tag: "DOWN", pid: pid, reason: reason})
  end
  nil
end

## Starts a server like `start` (same options and errors, prefixed
## `http.serve: `) and blocks until it exits.
##
## The caller can't get the server's pid, so `serve` doesn't return while
## the server runs. To stop it, kill the process that called `serve` with
## an exit signal (any reason but "normal"): that process dies, and the
## server notices and shuts down. If that process traps exits, the signal
## is only a message and the server keeps running. To stop a server and
## carry on, use `start` and `stop` instead. Other messages to the caller
## stay in its mailbox.
##
## Raises `http.serve: server died: <reason>` if the server dies on its
## own.
fn serve(router_ref, opts = {})
  let pid = launch("http.serve", router_ref, self(), opts).pid
  monitor(pid)
  receive
  when {tag: "DOWN", pid: ^pid, reason: reason}
    if reason != "normal" and reason != "shutdown"
      error("http.serve: server died: {reason}")
    end
    nil
  end
end

fn target_pid(t, caller)
  let kind = type(t)
  if kind == "int"
    return t
  elif kind == "string"
    let pid = whereis(t)
    if pid == nil
      error("{caller}: no process registered as \"{t}\"")
    end
    return pid
  elif kind == "table" and type(t.pid) == "int"
    return t.pid
  end
  error("{caller}: expected a server pid, \{pid\} handle or registered name, got {t}")
end

## Stops a server and returns nil once its listening socket and every
## connection are closed, so the port can be bound again at once. Stopping
## a server that already stopped returns nil too.
##
## `server` is the handle from `start`, the server pid, or a name the pid
## was registered under; any process given is killed, server or not.
## Requests in flight are cut off (also the one whose handler calls
## `stop`; `stop` doesn't return to it). Waits at most `timeout_ms` (nil:
## no limit).
##
## Raises `http.stop: the server did not stop within <ms> ms`, and for a
## `server` that is none of the above (`no process registered as "..."`).
## The caller's own monitor of the server still gets its DOWN; `stop`
## leaves nothing else in the mailbox.
fn stop(server, timeout_ms = 5000)
  if timeout_ms != nil and type(timeout_ms) != "int"
    error("http.stop: timeout_ms must be an int (milliseconds) or nil, got {type(timeout_ms)}")
  end
  let pid = target_pid(server, "http.stop")
  let added = monitor(pid)
  kill(pid, "shutdown")
  if timeout_ms == nil
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return_down(pid, added, reason)
    end
    return nil
  end
  receive
  when {tag: "DOWN", pid: ^pid, reason: reason}
    return_down(pid, added, reason)
  after timeout_ms
    drop_monitor(pid, added)
    error("http.stop: the server did not stop within {timeout_ms} ms")
  end
end

export response, ok, html, json_response, redirect, not_found, bad_request,
  server_error, set_cookie, delete_cookie, parse_form, html_escape, router,
  start, serve, stop
