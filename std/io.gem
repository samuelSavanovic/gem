## io — read a file, or stdin, a line at a time.
##
##   load "std/io"
##   io.lines("access.log") do |line|
##     count += 1
##   end
##   let r = io.reader("-")           # "-" reads stdin
##   let first = r.next()             # nil at the end
##
## Lines come without their `\n` (or `\r\n`); a last line with no newline
## comes as it is, and an empty file has no lines. A regular file is read
## in 64 KB blocks with `read_file(path, offset, count)`, so memory stays
## flat however large it is, and nothing stays open between blocks: a
## process that dies mid-file leaves nothing behind. A pipe or FIFO
## (`/dev/stdin`, a `<(cmd)` path) can't be reopened at an offset, so it
## is read whole, with `read_file(path)`, before its first line; so is a
## device.
## File reads go through the I/O thread pool, so other processes run
## meanwhile. stdin (`"-"`) is read with `input()`, which blocks every
## process while it waits for a line.
##
## A path that can't be read raises `read_file`'s error (`read_file:
## cannot open '<path>': ...`) at the first block.

let BLOCK = 65536

fn check_path(fname, path)
  if type(path) != "string"
    error("io.{fname}: path must be a string, got {type(path)}")
  end
end

# The line of `text` from `start` to the newline at `nl`, without a `\r`
# before it.
fn cut(text, start, nl)
  if nl > start and ord(text, nl - 1) == 13
    return substr(text, start, nl - 1 - start)
  end
  substr(text, start, nl - start)
end

# A fn returning the file's next block on each call, "" at the end. A
# regular file (or a path stat finds nothing at) is read in blocks;
# anything else (a pipe, FIFO, device, directory or dangling link) is
# one read_file(path), the whole of it, which raises for a directory or
# a dangling link.
fn block_source(path)
  let st = stat(path)
  let in_blocks = st == nil or st.type == "file"
  let offset = 0
  let done = false
  fn()
    if done
      return ""
    end
    if not in_blocks
      done = true
      return read_file(path)
    end
    let chunk = read_file(path, offset, BLOCK)
    offset += len(chunk)
    done = chunk == ""
    chunk
  end
end

# The pieces of a line that spans blocks, joined; collecting them keeps a
# long line linear.
fn join_parts(parts)
  if len(parts) == 1
    return parts[0]
  end
  build_string do |add|
    for part in parts
      add(part)
    end
  end
end

## Calls `f(line)` for each line of the file at `path` (`"-"`: stdin), in
## order, and returns nil. To stop early, use `reader`.
##
##   io.lines("names.txt") do |name|
##     print(name)
##   end
fn lines(path, f)
  check_path("lines", path)
  if path == "-"
    let line = input()
    while line != nil
      f(line)
      line = input()
    end
    return nil
  end
  let next_block = block_source(path)
  let parts = []
  while true
    let chunk = next_block()
    if chunk == ""
      break
    end
    let pos = 0
    let nl = find(chunk, "\n", 0)
    if nl >= 0 and len(parts) > 0
      push(parts, substr(chunk, 0, nl + 1))
      let line = join_parts(parts)
      parts = []
      f(cut(line, 0, len(line) - 1))
      pos = nl + 1
      nl = find(chunk, "\n", pos)
    end
    while nl >= 0
      f(cut(chunk, pos, nl))
      pos = nl + 1
      nl = find(chunk, "\n", pos)
    end
    if pos < len(chunk)
      push(parts, substr(chunk, pos))
    end
  end
  if len(parts) > 0
    f(join_parts(parts))
  end
  nil
end

## Returns a reader of the lines of the file at `path` (`"-"`: stdin):
## `r.next()` returns the next line, or nil at the end (and on every call
## after it). The reader holds no open file, so dropping it unfinished
## leaks nothing.
##
##   let r = io.reader("data.csv")
##   let header = r.next()
##   let row = r.next()
##   while row != nil
##     handle(header, row)
##     row = r.next()
##   end
fn reader(path)
  check_path("reader", path)
  if path == "-"
    return {next: fn() input() end}
  end
  let next_block = block_source(path)
  let chunk = ""
  let pos = 0
  let parts = []
  let next = fn()
    while true
      let nl = find(chunk, "\n", pos)
      if nl >= 0
        let start = pos
        pos = nl + 1
        if len(parts) == 0
          return cut(chunk, start, nl)
        end
        push(parts, substr(chunk, start, nl + 1 - start))
        let line = join_parts(parts)
        parts = []
        return cut(line, 0, len(line) - 1)
      end
      if pos < len(chunk)
        push(parts, substr(chunk, pos))
      end
      chunk = next_block()
      pos = 0
      if chunk == ""
        if len(parts) == 0
          return nil
        end
        let last = join_parts(parts)
        parts = []
        return last
      end
    end
  end
  {next: next}
end

## Returns every line of the file at `path` (`"-"`: stdin) as an array.
## Holds the whole file in memory: for a large file, use `lines`.
fn read_lines(path)
  check_path("read_lines", path)
  let out = []
  lines(path) do |line|
    push(out, line)
  end
  out
end

export lines, reader, read_lines
