## json — parse JSON text into Gem values and encode values as JSON.
##
##   load "std/json"
##   let v = json.parse('{"name": "gem", "tags": ["a", "b"]}')
##   v.tags[1]                              # "b"
##   json.encode({b: 1, a: [1, "x"]})       # '{"b":1,"a":[1,"x"]}'
##
## JSON maps to Gem as: object ↔ table with string keys, array ↔ table
## with keys 0 .. n-1, string ↔ string (UTF-8), number ↔ int or float,
## true/false ↔ bool, null ↔ nil. Both directions refuse nesting deeper
## than 1,000 arrays/objects. Errors start with `json.parse: ` or
## `json.encode: `.

# Passes all 283 required cases of https://github.com/nst/JSONTestSuite
# (`make test-json-suite`). The 1,000-level depth cap (see SPEC) keeps
# both recursive walks well inside the 8 MB process stack; the encoder's
# cap also stops cyclic tables.

let max_parse_depth = 1000
let max_encode_depth = 1000

# ─── Scanner ──────────────────────────────────────────────────────
# Byte-level cursor over the input. Bytes are compared as numbers
# (`ord`), never as 1-byte strings, and string/number tokens are cut out
# with `substr`, so the hot loops don't allocate per byte.

# True when the JSON number `text` (already validated) is below 1 in
# magnitude, from its decimal exponent: the position of its first
# nonzero digit plus the written exponent. Decides whether a number
# to_float can't represent underflows or overflows.
fn magnitude_below_one(text)
  let i = 0
  if ord(text, 0) == 45
    i = 1
  end
  let n = len(text)
  # e = the exponent of the first nonzero digit + 1, before the written one
  let e = 0
  let seen = false
  let in_frac = false
  while i < n
    let c = ord(text, i)
    if c == 46
      in_frac = true
    elif c == 101 or c == 69
      break
    elif in_frac
      if not seen
        if c == 48
          e -= 1
        else
          seen = true
        end
      end
    elif seen or c != 48
      seen = true
      e += 1
    end
    i += 1
  end
  if not seen
    return true
  end
  if i < n
    i += 1
    let neg = ord(text, i) == 45
    if neg or ord(text, i) == 43
      i += 1
    end
    # Skip leading zeros; more than 18 significant exponent digits can't
    # be a float in range either way, so clamp so to_int can't fail.
    while i < n - 1 and ord(text, i) == 48
      i += 1
    end
    let digits = substr(text, i, n - i)
    let x = 1000000000000000000
    if len(digits) < 19
      x = to_int(digits)
    end
    if neg
      x = -x
    end
    return e + x <= 0
  end
  e <= 0
end

fn make_scanner(input)
  let pos = 0
  let length = len(input)

  let fail = fn(msg)
    error("json.parse: {msg} at byte {pos}")
  end

  # Current byte, or -1 at the end of the input.
  let peek = fn()
    if pos >= length
      return -1
    end
    ord(input, pos)
  end

  let advance = fn()
    pos += 1
  end

  let skip_ws = fn()
    while pos < length
      let c = ord(input, pos)
      if c != 32 and c != 9 and c != 10 and c != 13
        break
      end
      pos += 1
    end
  end

  let at_end = fn()
    pos >= length
  end

  let literal = fn(text, value)
    if substr(input, pos, len(text)) != text
      fail("expected '{text}'")
    end
    pos += len(text)
    value
  end

  let hex4 = fn()
    if pos + 4 > length
      fail("unterminated unicode escape")
    end
    let code = 0
    for i = 0, 4
      let c = ord(input, pos)
      let v = -1
      if c >= 48 and c <= 57
        v = c - 48
      elif c >= 65 and c <= 70
        v = c - 55
      elif c >= 97 and c <= 102
        v = c - 87
      end
      if v < 0
        fail("invalid hex digit in unicode escape")
      end
      code = code * 16 + v
      pos += 1
    end
    code
  end

  # Appends one `\uXXXX` escape (a surrogate pair counts as one) as UTF-8.
  # A surrogate that isn't half of a high-low pair is an error, either
  # half, since it has no UTF-8 encoding.
  let unicode_escape = fn(buf)
    let at = pos - 2
    let code = hex4()
    if code >= 56320 and code <= 57343
      pos = at
      fail("lone surrogate in unicode escape")
    end
    if code >= 55296 and code <= 56319
      if substr(input, pos, 2) != "\\u"
        pos = at
        fail("lone surrogate in unicode escape")
      end
      pos += 2
      let lo = hex4()
      if lo < 56320 or lo > 57343
        pos = at
        fail("lone surrogate in unicode escape")
      end
      code = (code - 55296) * 1024 + (lo - 56320) + 65536
    end
    if code < 128
      buf_push(buf, chr(code))
    elif code < 2048
      buf_push(buf, chr(192 + code / 64))
      buf_push(buf, chr(128 + code % 64))
    elif code < 65536
      buf_push(buf, chr(224 + code / 4096))
      buf_push(buf, chr(128 + (code / 64) % 64))
      buf_push(buf, chr(128 + code % 64))
    else
      buf_push(buf, chr(240 + code / 262144))
      buf_push(buf, chr(128 + (code / 4096) % 64))
      buf_push(buf, chr(128 + (code / 64) % 64))
      buf_push(buf, chr(128 + code % 64))
    end
  end

  # The cursor is on the opening quote.
  let read_string = fn()
    pos += 1
    let start = pos
    # Fast path: no escapes, the string is one substr.
    while pos < length
      let c = ord(input, pos)
      if c == 34
        pos += 1
        return substr(input, start, pos - 1 - start)
      end
      if c == 92
        break
      end
      if c < 32
        fail("unescaped control character in string")
      end
      pos += 1
    end
    let buf = buf_new()
    buf_push(buf, substr(input, start, pos - start))
    while true
      if pos >= length
        fail("unterminated string")
      end
      let c = ord(input, pos)
      if c == 34
        pos += 1
        break
      end
      if c == 92
        pos += 1
        if pos >= length
          fail("unterminated escape sequence")
        end
        let e = ord(input, pos)
        pos += 1
        if e == 110
          buf_push(buf, "\n")
        elif e == 116
          buf_push(buf, "\t")
        elif e == 114
          buf_push(buf, "\r")
        elif e == 92
          buf_push(buf, "\\")
        elif e == 34
          buf_push(buf, "\"")
        elif e == 47
          buf_push(buf, "/")
        elif e == 98
          buf_push(buf, chr(8))
        elif e == 102
          buf_push(buf, chr(12))
        elif e == 117
          unicode_escape(buf)
        else
          pos -= 1
          fail("invalid escape sequence")
        end
      elif c < 32
        fail("unescaped control character in string")
      else
        let run = pos
        while pos < length
          let d = ord(input, pos)
          if d == 34 or d == 92 or d < 32
            break
          end
          pos += 1
        end
        buf_push(buf, substr(input, run, pos - run))
      end
    end
    to_string(buf)
  end

  let skip_digits = fn()
    let start = pos
    while pos < length
      let c = ord(input, pos)
      if c < 48 or c > 57
        break
      end
      pos += 1
    end
    pos - start
  end

  # The cursor is on `-` or a digit. Integers that don't fit in 64 bits
  # parse as floats.
  let read_number = fn()
    let start = pos
    if peek() == 45
      pos += 1
    end
    let int_digits = 0
    if peek() == 48
      pos += 1
      int_digits = 1
    else
      int_digits = skip_digits()
      if int_digits == 0
        fail("expected digit")
      end
    end
    let is_float = false
    if peek() == 46
      is_float = true
      pos += 1
      if skip_digits() == 0
        fail("expected digit after decimal point")
      end
    end
    let c = peek()
    if c == 101 or c == 69
      is_float = true
      pos += 1
      let sign = peek()
      if sign == 43 or sign == 45
        pos += 1
      end
      if skip_digits() == 0
        fail("expected digit in exponent")
      end
    end
    let text = substr(input, start, pos - start)
    if not is_float and int_digits < 19
      return to_int(text)
    end
    if not is_float
      let r = pcall to_int(text)
      if r.ok
        return r.value
      end
    end
    let f = pcall to_float(text)
    if f.ok
      return f.value
    end
    # to_float refuses only a result out of float range: an underflow
    # reads as zero, an overflow is an error.
    if magnitude_below_one(text)
      if ord(text, 0) == 45
        return -0.0
      end
      return 0.0
    end
    pos = start
    fail("number out of range")
  end

  {peek: peek, advance: advance, skip_ws: skip_ws, at_end: at_end, fail: fail,
   literal: literal, read_string: read_string, read_number: read_number}
end

# ─── Parser ───────────────────────────────────────────────────────

fn parse_value(s, depth)
  s.skip_ws()
  let c = s.peek()
  if c == 34
    return s.read_string()
  end
  if c == 123
    return parse_object(s, depth + 1)
  end
  if c == 91
    return parse_array(s, depth + 1)
  end
  if c == 45 or (c >= 48 and c <= 57)
    return s.read_number()
  end
  if c == 116
    return s.literal("true", true)
  end
  if c == 102
    return s.literal("false", false)
  end
  if c == 110
    return s.literal("null", nil)
  end
  if c < 0
    s.fail("unexpected end of input")
  end
  s.fail("unexpected character '{chr(c)}'")
end

# `depth` is the nesting level of this object/array (1 for the outermost).
fn check_depth(s, depth)
  if depth > max_parse_depth
    s.fail("nesting deeper than {max_parse_depth} levels")
  end
end

fn parse_object(s, depth)
  check_depth(s, depth)
  s.advance()
  s.skip_ws()
  let obj = {}
  if s.peek() == 125
    s.advance()
    return obj
  end
  while true
    s.skip_ws()
    if s.peek() != 34
      s.fail("expected string key in object")
    end
    let key = s.read_string()
    s.skip_ws()
    if s.peek() != 58
      s.fail("expected ':' in object")
    end
    s.advance()
    obj[key] = parse_value(s, depth)
    s.skip_ws()
    let next = s.peek()
    if next != 44 and next != 125
      s.fail("expected ',' or '}' in object")
    end
    s.advance()
    if next == 125
      break
    end
  end
  obj
end

fn parse_array(s, depth)
  check_depth(s, depth)
  s.advance()
  s.skip_ws()
  let arr = []
  if s.peek() == 93
    s.advance()
    return arr
  end
  while true
    push(arr, parse_value(s, depth))
    s.skip_ws()
    let next = s.peek()
    if next != 44 and next != 93
      s.fail("expected ',' or ']' in array")
    end
    s.advance()
    if next == 93
      break
    end
  end
  arr
end

# ─── Public API: parse ────────────────────────────────────────────

## Parses the JSON text `input` (one value, surrounding whitespace
## allowed) and returns it as a Gem value.
##
## A number without `.` or exponent is an int; one with them is a float,
## and so is an integer too big for 64 bits. A number too small for a
## float reads as 0.0. Escapes, `\uXXXX` surrogate pairs included,
## become UTF-8. A repeated object key keeps its last value. A JSON
## `null` reads as nil, so an object member that is null reads like a
## missing one.
##
##   json.parse('[1, 2.5, null]')     # [1, 2.5, nil]
##   json.parse('{"a":1,"a":2}')      # {a: 2}
##   json.parse("1e2")                # 100.0
##
## Raises `json.parse: <what> at byte <offset>` on invalid JSON (trailing
## data, a lone surrogate, a number too large for a float included), and
## if `input` is not a string (a buffer too).
fn parse(input)
  if type(input) != "string"
    error("json.parse: expected a string, got {type(input)}")
  end
  let s = make_scanner(input)
  let val = parse_value(s, 0)
  s.skip_ws()
  if not s.at_end()
    s.fail("unexpected data after JSON value")
  end
  val
end

# ─── Encoder ──────────────────────────────────────────────────────

let hex_digits = "0123456789abcdef"

# Appends `str` as a JSON string literal. Runs of bytes that need no
# escape go into the buffer as one piece.
fn encode_string(str, buf)
  buf_push(buf, "\"")
  let n = len(str)
  let run = 0
  let i = 0
  while i < n
    let c = ord(str, i)
    if c >= 32 and c != 34 and c != 92
      i += 1
      continue
    end
    if i > run
      buf_push(buf, substr(str, run, i - run))
    end
    if c == 34
      buf_push(buf, "\\\"")
    elif c == 92
      buf_push(buf, "\\\\")
    elif c == 10
      buf_push(buf, "\\n")
    elif c == 13
      buf_push(buf, "\\r")
    elif c == 9
      buf_push(buf, "\\t")
    elif c == 8
      buf_push(buf, "\\b")
    elif c == 12
      buf_push(buf, "\\f")
    else
      buf_push(buf, "\\u00")
      buf_push(buf, hex_digits[c / 16])
      buf_push(buf, hex_digits[c % 16])
    end
    i += 1
    run = i
  end
  if run == 0
    buf_push(buf, str)
  elif run < n
    buf_push(buf, substr(str, run, n - run))
  end
  buf_push(buf, "\"")
end

# A table is a JSON array when its keys are exactly 0 .. n-1 (in any
# order; keys are distinct, so "all ints in range" is enough). Returns
# "array" (keys in place, `t[i]` is direct), "unordered" (a permutation of
# 0 .. n-1) or "object". One pass, no allocation.
fn table_kind(t)
  let n = len(t)
  let i = 0
  let in_place = true
  for k, v in t
    if type(k) != "int" or k < 0 or k >= n
      return "object"
    end
    if k != i
      in_place = false
    end
    i += 1
  end
  if in_place
    return "array"
  end
  "unordered"
end

fn encode_key(k, buf)
  let kt = type(k)
  if kt == "string"
    encode_string(k, buf)
  elif kt == "int"
    buf_push(buf, "\"")
    buf_push(buf, k)
    buf_push(buf, "\"")
  else
    error("json.encode: cannot encode a {kt} table key (only string and int keys)")
  end
end

fn encode_table(t, buf, depth)
  if depth > max_encode_depth
    error("json.encode: nesting deeper than {max_encode_depth} levels (or a cyclic table)")
  end
  let kind = table_kind(t)
  if kind == "object"
    buf_push(buf, '{')
    let first = true
    for k, v in t
      if not first
        buf_push(buf, ",")
      end
      first = false
      encode_key(k, buf)
      buf_push(buf, ":")
      encode_value(v, buf, depth)
    end
    buf_push(buf, '}')
    return nil
  end
  let items = t
  if kind == "unordered"
    # Put the values in index order first, so the walk below stays linear.
    items = []
    for i = 0, len(t)
      push(items, nil)
    end
    for k, v in t
      items[k] = v
    end
  end
  buf_push(buf, "[")
  for i = 0, len(items)
    if i > 0
      buf_push(buf, ",")
    end
    encode_value(items[i], buf, depth)
  end
  buf_push(buf, "]")
end

fn encode_value(val, buf, depth)
  let t = type(val)
  if t == "string"
    encode_string(val, buf)
  elif t == "nil"
    buf_push(buf, "null")
  elif t == "int" or t == "float" or t == "bool"
    buf_push(buf, val)
  elif t == "table"
    encode_table(val, buf, depth + 1)
  else
    error("json.encode: cannot encode a {t}")
  end
end

# ─── Public API: encode ───────────────────────────────────────────

## Returns `val` as compact JSON text (no spaces or newlines).
##
## A table whose keys are exactly the ints 0 .. n-1 (the empty table
## too) becomes an array; any other table becomes an object, its int keys
## written as strings and its members in the table's iteration order. A
## key whose value is nil is written as `null`. Strings are written byte
## for byte: `"`, `\` and control bytes are escaped, other bytes (UTF-8
## or not) are not.
##
##   json.encode({a: 1, b: [1, nil]})    # '{"a":1,"b":[1,null]}'
##   json.encode({})                     # "[]"
##   json.encode({0: "a", 2: "b"})       # '{"0":"a","2":"b"}'
##   json.encode(2.0)                    # "2.0"
##
## An infinite or NaN float comes out as `inf`, `-inf` or `nan`, which
## is not valid JSON.
##
## Raises for a fn, buffer or other value with no JSON form, for a table
## key that is not a string or int, and for nesting deeper than 1,000
## levels, which includes any cyclic table.
fn encode(val)
  let buf = buf_new()
  encode_value(val, buf, 0)
  to_string(buf)
end

export parse, encode
