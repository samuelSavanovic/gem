## log — leveled log lines on stderr.
##
##   load "std/log"
##   log.set_level("debug")             # default "info"
##   log.info("listening on {port}")    # 2026-04-28T14:30:00Z [INFO] listening on 8080
##   log.error("db: {r.error}")
##
## Each line is a UTC timestamp, the level in capitals, and the message
## converted as string interpolation does (a buffer shows as
## `<buffer:N>`; pass `to_string(buf)`). A `\n` in the message starts a
## line with no timestamp or level. The level is module state, so
## it is per process: a spawned process starts with the level its parent
## had at the spawn. Set it in main before spawning (before
## `http.start`), or in the process that logs.

load "std/time"

let LEVELS = {debug: 0, info: 1, warn: 2, error: 3}

let min_level = 1

# log.error, defined at the bottom, hides the `error` builtin in this whole
# file; top-level code above that `let` still reaches it.
let raise = error

fn emit(label, msg)
  eprint("{time.iso8601()} [{label}] {msg}")
end

## Sets the lowest level that is printed, in this process: "debug",
## "info", "warn" or "error". Lines below it are dropped.
##
## Raises on any other `level` (names are lowercase).
fn set_level(level)
  if not has_key(LEVELS, level)
    raise("log.set_level: unknown level {level}; use \"debug\", \"info\", \"warn\" or \"error\"")
  end
  min_level = LEVELS[level]
end

## Prints `msg` at level DEBUG, which is hidden by default.
fn debug(msg)
  if min_level <= 0
    emit("DEBUG", msg)
  end
end

## Prints `msg` at level INFO.
fn info(msg)
  if min_level <= 1
    emit("INFO", msg)
  end
end

## Prints `msg` at level WARN.
fn warn(msg)
  if min_level <= 2
    emit("WARN", msg)
  end
end

## Prints `msg` at level ERROR, which every level shows. It does not
## raise.
let error = fn(msg)
  # A `let`, not a `fn`, so that `raise` above can still take the builtin.
  emit("ERROR", msg)
end

export set_level, debug, info, warn, error
