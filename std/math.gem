## math — min, max, clamp and assert.
##
##   load "std/math"
##   let pct = math.clamp(done * 100 / total, 0, 100)
##   math.assert(len(rows) > 0, "no rows")
##
## The math builtins (`floor`, `sqrt`, `abs`...) need no load. `min`,
## `max` and `clamp` take any values `<` can order: ints and floats,
## mixed, or strings. Values `<` can't compare (an int and a string,
## `nil`) raise the operator's type error.

## Returns the smaller of `a` and `b`, or `b` when they tie.
##
##   math.min(3, 1)      # 1
##   math.min(2, 2.0)    # 2.0
fn min(a, b)
  if a < b
    return a
  end
  b
end

## Returns the larger of `a` and `b`, or `b` when they tie.
##
##   math.max(1, 2.5)    # 2.5
fn max(a, b)
  if a > b
    return a
  end
  b
end

## Returns `val` limited to the range `low` .. `high`, both included.
##
##   math.clamp(150, 0, 100)    # 100
##   math.clamp(-3, 0, 100)     # 0
##
## Raises if `low` is greater than `high`.
fn clamp(val, low, high)
  if high < low
    error("math.clamp: low ({low}) is greater than high ({high})")
  end
  if val < low
    return low
  end
  if val > high
    return high
  end
  val
end

## Raises "assertion failed", or "assertion failed: <msg>" when `msg` is
## given, unless `cond` is truthy. Only `nil` and `false` fail; 0 and ""
## pass.
##
##   math.assert(len(rows) > 0, "no rows")
fn assert(cond, msg = nil)
  if not cond
    if msg == nil
      error("assertion failed")
    end
    error("assertion failed: {msg}")
  end
end

export min, max, clamp, assert
