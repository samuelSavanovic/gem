# mime — content types by file extension, and back.
#
#   load "std/mime"
#   mime.lookup("site/index.HTML")       # "text/html; charset=utf-8"
#   mime.lookup("png")                   # "image/png"
#   mime.lookup("notes")                 # "application/octet-stream"
#   mime.ext("image/jpeg")               # ".jpg"
#
# Both ignore case, take a string (or a buffer) and raise `mime.<fn>: ...`
# on anything else.

load "std/string"

let types = {
  html: "text/html",
  htm: "text/html",
  css: "text/css",
  js: "application/javascript",
  mjs: "application/javascript",
  json: "application/json",
  xml: "application/xml",
  txt: "text/plain",
  csv: "text/csv",
  png: "image/png",
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  gif: "image/gif",
  svg: "image/svg+xml",
  ico: "image/x-icon",
  webp: "image/webp",
  avif: "image/avif",
  woff: "font/woff",
  woff2: "font/woff2",
  ttf: "font/ttf",
  otf: "font/otf",
  pdf: "application/pdf",
  zip: "application/zip",
  gz: "application/gzip",
  mp3: "audio/mpeg",
  mp4: "video/mp4",
  webm: "video/webm",
  wasm: "application/wasm"
}

let charset_prefixes = ["text/", "application/json", "application/javascript", "application/xml"]

# The string to work on: a string, or a buffer's contents.
fn text(fname, what, v)
  let t = type(v)
  if t == "string"
    return v
  end
  if t == "buffer"
    return to_string(v)
  end
  error("mime.{fname}: {what} must be a string, got {t}")
end

# The extension of a path's last segment ("a/b.tar.gz" → "gz", "a.d/x" →
# ""). A string with no `/` and no `.` is taken as a bare extension.
fn ext_from_path(path_or_ext)
  let n = len(path_or_ext)
  let i = n - 1
  while i >= 0
    let c = ord(path_or_ext, i)
    if c == 46
      return substr(path_or_ext, i + 1, n - i - 1)
    end
    if c == 47
      return ""
    end
    i -= 1
  end
  path_or_ext
end

fn needs_charset(content_type)
  for prefix in charset_prefixes
    if string.starts_with(content_type, prefix)
      return true
    end
  end
  false
end

# lookup(path_or_ext): "index.html", ".html" and "html" all give the type;
# an unknown or missing extension gives "application/octet-stream".
fn lookup(path_or_ext)
  path_or_ext = text("lookup", "path_or_ext", path_or_ext)
  let ct = types[string.lower(ext_from_path(path_or_ext))]
  if ct == nil
    return "application/octet-stream"
  end
  if needs_charset(ct)
    return "{ct}; charset=utf-8"
  end
  ct
end

# ext(content_type): ".html" for "text/html" (parameters such as
# "; charset=utf-8" are ignored), or nil for an unknown type.
fn ext(content_type)
  content_type = text("ext", "content_type", content_type)
  let base = content_type
  let semi = string.index_of(content_type, ";")
  if semi >= 0
    base = substr(content_type, 0, semi)
  end
  base = string.lower(string.trim(base))
  for e, ct in types
    if ct == base
      return ".{e}"
    end
  end
  nil
end

export lookup, ext
