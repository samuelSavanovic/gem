## mime — content types by file extension, and back.
##
##   load "std/mime"
##   mime.lookup("site/index.HTML")    # "text/html; charset=utf-8"
##   mime.lookup("png")                # "image/png"
##   mime.lookup("notes")              # "application/octet-stream"
##   mime.ext("image/jpeg")            # ".jpg"
##
## Both ignore case and take a string or a buffer. Any other argument
## raises `mime.<fn>: <arg> must be a string, got <type>`. The known
## extensions are html htm css js mjs json xml txt md csv yaml yml toml
## map ics rss atom png jpg jpeg gif svg ico webp avif bmp tif tiff woff
## woff2 ttf otf pdf zip gz tar mp3 wav ogg oga flac m4a mp4 ogv mov webm
## wasm; any other is application/octet-stream. JavaScript is
## `text/javascript` (RFC 9239); `ext` also knows the older
## `application/javascript`.

load "std/string"

let types = {
  html: "text/html",
  htm: "text/html",
  css: "text/css",
  js: "text/javascript",
  mjs: "text/javascript",
  json: "application/json",
  xml: "application/xml",
  txt: "text/plain",
  md: "text/markdown",
  csv: "text/csv",
  yaml: "application/yaml",
  yml: "application/yaml",
  toml: "application/toml",
  map: "application/json",
  ics: "text/calendar",
  rss: "application/rss+xml",
  atom: "application/atom+xml",
  png: "image/png",
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  gif: "image/gif",
  svg: "image/svg+xml",
  ico: "image/x-icon",
  webp: "image/webp",
  avif: "image/avif",
  bmp: "image/bmp",
  tif: "image/tiff",
  tiff: "image/tiff",
  woff: "font/woff",
  woff2: "font/woff2",
  ttf: "font/ttf",
  otf: "font/otf",
  pdf: "application/pdf",
  zip: "application/zip",
  gz: "application/gzip",
  tar: "application/x-tar",
  mp3: "audio/mpeg",
  wav: "audio/wav",
  ogg: "audio/ogg",
  oga: "audio/ogg",
  flac: "audio/flac",
  m4a: "audio/mp4",
  mp4: "video/mp4",
  ogv: "video/ogg",
  mov: "video/quicktime",
  webm: "video/webm",
  wasm: "application/wasm"
}

let charset_prefixes = ["text/", "application/json", "application/javascript", "application/xml", "application/yaml", "application/toml"]

# Content types `ext` knows besides those in `types`: older names of the
# same type.
let aliases = {
  "application/javascript": ".js",
  "application/x-javascript": ".js",
  "text/x-markdown": ".md",
  "application/x-yaml": ".yaml",
  "text/yaml": ".yaml",
  "audio/x-wav": ".wav",
  "audio/wave": ".wav"
}

# The string to work on: a string, or a buffer's contents.
fn text(fname, what, v)
  let t = type(v)
  if t == "string"
    return v
  end
  if t == "buffer"
    return to_string(v)
  end
  error("mime.{fname}: {what} must be a string, got {t}")
end

# The extension of a path's last segment ("a/b.tar.gz" → "gz", "a.d/x" →
# ""). A string with no `/` and no `.` is taken as a bare extension.
fn ext_from_path(path_or_ext)
  let n = len(path_or_ext)
  let i = n - 1
  while i >= 0
    let c = ord(path_or_ext, i)
    if c == 46
      return substr(path_or_ext, i + 1, n - i - 1)
    end
    if c == 47
      return ""
    end
    i -= 1
  end
  path_or_ext
end

fn needs_charset(content_type)
  for prefix in charset_prefixes
    if string.starts_with(content_type, prefix)
      return true
    end
  end
  false
end

## Returns the content type for a path's extension, or for a bare
## extension: "index.html", ".html" and "html" all give the same type.
##
## Text types (text/*, JSON, JavaScript, application/xml) get
## "; charset=utf-8"; image/svg+xml doesn't. An unknown or missing
## extension gives "application/octet-stream". Only the last `.` of the
## last path segment counts.
##
##   mime.lookup("site/index.HTML")    # "text/html; charset=utf-8"
##   mime.lookup("a/b.tar.gz")         # "application/gzip"
##   mime.lookup("a.d/README")         # "application/octet-stream"
fn lookup(path_or_ext)
  path_or_ext = text("lookup", "path_or_ext", path_or_ext)
  let ct = types[string.lower(ext_from_path(path_or_ext))]
  if ct == nil
    return "application/octet-stream"
  end
  if needs_charset(ct)
    return "{ct}; charset=utf-8"
  end
  ct
end

## Returns the usual extension, with its dot, for `content_type`, or nil
## for an unknown type. Parameters such as "; charset=utf-8" and
## surrounding spaces are ignored.
##
##   mime.ext("text/html; charset=utf-8")    # ".html"
##   mime.ext("image/jpeg")                  # ".jpg"
##   mime.ext("application/x-nope")          # nil
fn ext(content_type)
  content_type = text("ext", "content_type", content_type)
  let base = content_type
  let semi = string.index_of(content_type, ";")
  if semi >= 0
    base = substr(content_type, 0, semi)
  end
  base = string.lower(string.trim(base))
  # First match in `types` order, so list the preferred extension (jpg,
  # html) before its aliases.
  for e, ct in types
    if ct == base
      return ".{e}"
    end
  end
  aliases[base]
end

export lookup, ext
