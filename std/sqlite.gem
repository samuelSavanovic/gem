## sqlite — SQLite databases, a thin layer over the sqlite_* builtins.
##
##   load "std/sqlite"
##   let db = sqlite.open("app.db")          # or ":memory:"
##   sqlite.exec(db, "CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY, text TEXT)")
##   sqlite.query(db, "INSERT INTO notes(text) VALUES (?)", ["hi"])
##   let rows = sqlite.query(db, "SELECT id, text FROM notes WHERE id = ?", [sqlite.last_id(db)])
##   sqlite.close(db)
##
## A handle `db` is a value of type "sqlite", an owned resource like a
## socket: it belongs to the process that opened it, `claim(db)` makes
## another process its owner, and it closes when a process that claimed it
## exits, or when its opener crashes or is killed (a normal return leaves
## it open). Errors start with the function's name: an SQLite error raises
## `sqlite.<fn>: <SQLite's message>` (`sqlite.query: UNIQUE constraint
## failed: t.name`), a closed handle `...: not an open database handle`,
## and anything else `...: expected a database handle, got <type>`.
## `exec` and `query` run on the scheduler thread without yielding, so
## they stall every process while they run: keep queries short and
## indexed.
##
## A handle is one connection, shared by every process that has it: a
## transaction opened with `exec(db, "BEGIN")` takes in every statement any
## process runs on `db` until COMMIT or ROLLBACK, so don't yield (sleep,
## receive, a long loop) inside a transaction on a shared handle, or open
## one handle per process. A nested BEGIN raises.
##
##   sqlite.exec(db, "BEGIN")
##   let r = pcall sqlite.query(db, "INSERT INTO notes(text) VALUES (?)", ["a"])
##   if r.ok
##     sqlite.exec(db, "COMMIT")
##   else
##     sqlite.exec(db, "ROLLBACK")
##   end

load "std/string"

# open and close run on the I/O thread pool; exec, query, last_id and
# changes run inline on the scheduler thread without yielding. Handles are
# ids in one registry for the whole program (runtime/gem_builtins_sqlite.c),
# never reused after a close.

# Raises `msg`, an error of the sqlite_* builtin under `sqlite.<name>`,
# with the module's name in place of the builtin's.
fn raise_as(name, msg)
  if string.starts_with(msg, "sqlite_")
    let colon = find(msg, ": ")
    if colon >= 0
      msg = substr(msg, colon + 2)
    end
  end
  error("sqlite.{name}: {msg}")
end

## Opens (creating if needed) the database file at `path` and returns its
## handle. ":memory:" opens a private in-memory database. Foreign keys are
## enforced, and a file database uses WAL journaling. There is no busy
## timeout: a write while another connection holds the write lock raises
## `...: database is locked` at once.
##
## Raises if the file can't be opened. Blocks only the calling process
## while the file opens.
fn open(path)
  let r = pcall sqlite_open(path)
  if not r.ok
    raise_as("open", r.error)
  end
  r.value
end

## Closes `db`, from any process. The handle is invalid afterwards, for
## every process. Closing a closed handle returns nil.
##
## Raises if `db` is not a handle. Blocks only the calling process.
fn close(db)
  let r = pcall sqlite_close(db)
  if not r.ok
    raise_as("close", r.error)
  end
  r.value
end

## Runs `sql`, which takes no parameters, and returns nil. Several
## statements separated by `;` all run; rows they return are discarded.
## Use it for DDL, PRAGMA and migration scripts. A statement with a
## placeholder raises `sqlite.exec: statement <n> has parameters; use
## sqlite_query to bind them`, after the statements before it have run.
## Use `query` to pass parameters.
##
##   sqlite.exec(db, "CREATE TABLE a(x); CREATE TABLE b(y)")
fn exec(db, sql)
  let r = pcall sqlite_exec(db, sql)
  if not r.ok
    raise_as("exec", r.error)
  end
  r.value
end

## Runs one statement with its placeholders bound from `params` and
## returns its rows: an array of records keyed by column name (an empty
## table, printed `{}`, when there are none, as for INSERT, UPDATE and
## DELETE). `params` is an array bound in order (`?N` takes the Nth
## param, and each `:name` the next one in order of first use), or a
## record of names: `:name`, `@name` and `$name` take the value at `name`
## (a key holding nil binds NULL). `params` may be nil (no params).
##
## Params may be nil, bools (stored as 1 and 0), ints, floats or strings.
## Columns come back as ints, floats, strings or nil; a NULL column is
## still a key of the record, holding nil. Strings keep every byte, NULs
## included, both ways; a BLOB column comes back as a string too. When two
## columns share a name the last one wins; name them with `AS`. Empty or
## comment-only `sql` returns an empty table.
##
##   sqlite.query(db, "SELECT id, text FROM notes WHERE id = ?", [1])
##   # [{id: 1, text: "hi"}]
##   sqlite.query(db, "SELECT id FROM notes WHERE text = :t", {t: "hi"})
##   # [{id: 1}]
##
## Raises `sqlite.query: expected one SQL statement, got several ...`,
## before anything runs, when `sql` holds more than one statement (a
## trailing `;`, whitespace and comments are fine). Raises if `params` is
## not a table, if an array's length differs from the statement's
## parameter count (the highest `?N`; a reused `?N` or `:name` counts
## once), if a record lacks a placeholder's name, has a key no placeholder
## names, or meets a positional `?`, or if a param is of another type.
fn query(db, sql, params = [])
  let r = pcall sqlite_query(db, sql, params)
  if not r.ok
    raise_as("query", r.error)
  end
  r.value
end

## Returns the rowid of the last row inserted through `db`, or 0 before
## any insert.
fn last_id(db)
  let r = pcall sqlite_last_insert_id(db)
  if not r.ok
    raise_as("last_id", r.error)
  end
  r.value
end

## Returns how many rows the last INSERT, UPDATE or DELETE through `db`
## changed (0 before any). Other statements leave it unchanged. After a
## multi-statement `exec` it counts the last such statement.
fn changes(db)
  let r = pcall sqlite_changes(db)
  if not r.ok
    raise_as("changes", r.error)
  end
  r.value
end

export open, close, exec, query, last_id, changes
