## string — split, join, search, trim and change ASCII case.
##
##   load "std/string"
##   let parts = string.split("a,b,c", ",")    # ["a", "b", "c"]
##   string.join(parts, "-")                   # "a-b-c"
##   string.index_of("hello", "l")             # 2
##
## Strings are bytes: positions are byte offsets, `upper` and `lower`
## change ASCII letters only, and `trim` strips ASCII whitespace. Any
## argument that takes a string also takes a buffer (its contents are
## used); results are always strings. An argument of any other type
## raises `string.<fn>: <arg> must be a string, got <type>`, where <arg>
## is the parameter name (`s`, `delim`, `needle`...).

# The string to work on: a string, or a buffer's contents.
fn text(fname, what, v)
  let t = type(v)
  if t == "string"
    return v
  end
  if t == "buffer"
    return to_string(v)
  end
  error("string.{fname}: {what} must be a string, got {t}")
end

fn is_space(c)
  c == 32 or (c >= 9 and c <= 13)
end

## Splits `s` at every occurrence of `delim` and returns the pieces, left
## to right.
##
## Delimiters next to each other or at either end give empty pieces, so
## the result always has one more piece than `s` has delimiters. An empty
## `delim` gives `[s]`. Matches don't overlap:
## `split("aaa", "aa")` is `["", "a"]`.
##
##   string.split("a,b,c", ",")    # ["a", "b", "c"]
##   string.split("a,,b,", ",")    # ["a", "", "b", ""]
##   string.split("", ",")         # [""]
fn split(s, delim)
  s = text("split", "s", s)
  delim = text("split", "delim", delim)
  let dlen = len(delim)
  if dlen == 0
    return [s]
  end
  let parts = []
  let start = 0                    # start of the current piece
  while true
    let at = find(s, delim, start)
    if at < 0
      break
    end
    push(parts, substr(s, start, at - start))
    start = at + dlen
  end
  push(parts, substr(s, start, len(s) - start))
  parts
end

## Returns the byte offset of the first `needle` in `s` at or after
## `start`, or -1 when there is none.
##
## A negative `start` counts as 0. An empty `needle` is found at `start`
## (-1 when `start` is past the end).
##
##   string.index_of("hello", "l")       # 2
##   string.index_of("hello", "l", 3)    # 3
##   string.index_of("hello", "z")       # -1
##
## Raises if `start` is not an int.
fn index_of(s, needle, start = 0)
  s = text("index_of", "s", s)
  needle = text("index_of", "needle", needle)
  if type(start) != "int"
    error("string.index_of: start must be an int, got {type(start)}")
  end
  find(s, needle, start)
end

## Returns true when `needle` occurs anywhere in `s`. An empty `needle`
## is always found.
##
##   string.contains("hello", "ell")    # true
fn contains(s, needle)
  s = text("contains", "s", s)
  needle = text("contains", "needle", needle)
  find(s, needle) >= 0
end

## Joins the elements of `arr` into one string, with `delim` between
## each pair.
##
## Elements are converted as string interpolation does, so they don't
## have to be strings. An empty array gives "".
##
##   string.join(["a", "b"], ", ")      # "a, b"
##   string.join(["a", 1, nil], "-")    # "a-1-nil"
##
## Raises if `arr` is not an array: a table whose keys are exactly
## 0 .. n-1, added in that order (as `push` and `[...]` literals do). A
## table whose int keys were assigned out of order is rejected, naming a
## key, though `table.*` and `json.encode` accept it.
fn join(arr, delim)
  if type(arr) != "table"
    error("string.join: arr must be an array, got {type(arr)}")
  end
  delim = text("join", "delim", delim)
  build_string() do |add|
    let n = 0
    for i, x in arr
      if i != n
        error("string.join: arr must be an array, got a table with key {i}")
      end
      if n > 0
        add(delim)
      end
      add(x)
      n += 1
    end
  end
end

## Returns `s` without its leading and trailing ASCII whitespace (space,
## tab, newline, vertical tab, form feed, carriage return).
##
##   string.trim("  hi there\n")    # "hi there"
fn trim(s)
  s = text("trim", "s", s)
  let slen = len(s)
  let start = 0
  while start < slen and is_space(ord(s, start))
    start += 1
  end
  let stop = slen
  while stop > start and is_space(ord(s, stop - 1))
    stop -= 1
  end
  if start == 0 and stop == slen
    return s
  end
  substr(s, start, stop - start)
end

## Returns true when `s` begins with `prefix`. Every string begins with "".
##
##   string.starts_with("hello", "he")    # true
fn starts_with(s, prefix)
  s = text("starts_with", "s", s)
  prefix = text("starts_with", "prefix", prefix)
  let plen = len(prefix)
  plen <= len(s) and substr(s, 0, plen) == prefix
end

## Returns true when `s` ends with `suffix`. Every string ends with "".
##
##   string.ends_with("hello", "lo")    # true
fn ends_with(s, suffix)
  s = text("ends_with", "s", s)
  suffix = text("ends_with", "suffix", suffix)
  let plen = len(suffix)
  plen <= len(s) and substr(s, len(s) - plen, plen) == suffix
end

# Shift the bytes in lo .. hi by delta, copying unchanged runs whole.
fn shift_range(s, lo, hi, delta)
  let slen = len(s)
  let run = 0
  let out = build_string() do |add|
    for i = 0, slen
      let c = ord(s, i)
      if c >= lo and c <= hi
        if i > run
          add(substr(s, run, i - run))
        end
        add(chr(c + delta))
        run = i + 1
      end
    end
    if run > 0 and run < slen
      add(substr(s, run, slen - run))
    end
  end
  if run == 0
    return s
  end
  out
end

## Returns `s` with the ASCII letters a-z changed to A-Z. Other bytes,
## UTF-8 sequences included, are unchanged.
##
##   string.upper("héllo")    # "HéLLO"
fn upper(s)
  s = text("upper", "s", s)
  shift_range(s, 97, 122, -32)
end

## Returns `s` with the ASCII letters A-Z changed to a-z. Other bytes,
## UTF-8 sequences included, are unchanged.
##
##   string.lower("HÉLLO")    # "hÉllo"
fn lower(s)
  s = text("lower", "s", s)
  shift_range(s, 65, 90, 32)
end

## Returns `s` repeated `n` times, or "" when `n` is 0 or negative.
##
##   string.repeat("ab", 3)    # "ababab"
##
## Raises if `n` is not an int.
fn repeat(s, n)
  s = text("repeat", "s", s)
  if type(n) != "int"
    error("string.repeat: n must be an int, got {type(n)}")
  end
  build_string() do |add|
    for i = 0, n
      add(s)
    end
  end
end

export split, index_of, join, trim, starts_with, ends_with, upper, lower, contains, repeat
