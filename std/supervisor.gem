## supervisor — start a fixed set of child processes and restart them
## when they die.
##
##   let sup = supervisor.start({
##     strategy: "one_for_one",
##     name: "app_sup",
##     children: [
##       {id: "db", start: fn() gen_server.start(db_server) end},
##       {id: "acceptor", restart: "transient", shutdown: 1000, start: start_acceptor}
##     ]
##   })
##   supervisor.which_children(sup)        # or sup.pid, or "app_sup"
##   supervisor.stop(sup)
##
## A supervisor is named by the `{pid}` handle `start` returns, a bare pid
## or a registered name. Errors start with `supervisor.<fn>: `. A name
## nobody holds, also that of a supervisor that has stopped, raises
## `supervisor.<fn>: no process registered as "<name>"`.

# Design. The supervisor traps exits and monitors and links each child.
# The restart signal is the child's DOWN; the EXIT a child's death also
# sends is dropped. The runtime queues a dead process's DOWN before its
# EXIT, so the EXIT is always dropped right after its DOWN is taken, and
# any EXIT the main loop sees is an exit signal (a `kill` of the
# supervisor, from a child as well as from anyone else). Stopping a child
# (stop_child: the supervisor's own shutdown, a one_for_all restart) sends
# it "shutdown", waits up to its budget for its DOWN, then sends the
# untrappable "kill". The budget comes from the spec's `shutdown`, else
# from an int or nil `shutdown` key on the handle its `start` returned (a
# supervisor's handle has `shutdown: nil`, so a nested supervisor gets all
# the time its own ordered shutdown takes), else DEFAULT_SHUTDOWN_MS. When
# the supervisor exits (an exit signal, `stop`, restart intensity reached,
# or any error in the supervisor, but not the untrappable "kill", which
# ends it at once), it first stops each running child that way, in
# reverse spec order (a restarted child keeps its place); then it exits. A nested supervisor does the same, so the
# whole tree is down when it exits.

let STRATEGIES = {one_for_one: true, one_for_all: true}
let RESTARTS = {permanent: true, transient: true, temporary: true}
# How long a child gets to exit after "shutdown" before it is killed, when
# neither its spec nor its handle says (see the top of the file).
let DEFAULT_SHUTDOWN_MS = 5000
let INTENSITY = "supervisor: max restart intensity reached"

# Turns a bare pid, a `{pid}` handle or a registered name into a pid.
fn target_pid(t, caller)
  let kind = type(t)
  if kind == "int"
    return t
  elif kind == "string"
    let pid = whereis(t)
    if pid == nil
      error("{caller}: no process registered as \"{t}\"")
    end
    return pid
  elif kind == "table" and type(t.pid) == "int"
    return t.pid
  end
  error("{caller}: expected a pid, a \{pid\} handle or a registered name, got {kind}")
end

# A child's shutdown budget: its spec's `shutdown`, else the one the handle
# its `start` returned asks for, else DEFAULT_SHUTDOWN_MS.
fn shutdown_of(spec, handle)
  if has_key(spec, "shutdown")
    return spec.shutdown
  end
  # The handle belongs to the child's own API: only an int or nil there is
  # a budget; anything else (a `shutdown` method, say) is no marker.
  if type(handle) == "table" and has_key(handle, "shutdown")
    let s = handle.shutdown
    if s == nil or type(s) == "int"
      return s
    end
  end
  DEFAULT_SHUTDOWN_MS
end

# Starts the child of `spec`: {id, pid, shutdown}.
fn start_child(spec)
  let handle = spec.start()
  let pid = target_pid(handle, "supervisor: start of child \"{spec.id}\"")
  let shutdown = shutdown_of(spec, handle)
  monitor(pid)
  # A child that has already exited gives an EXIT "noproc" here (the
  # supervisor traps exits) after its DOWN "noproc".
  link(pid)
  {id: spec.id, pid: pid, shutdown: shutdown}
end

# Takes the DOWN of `pid` within `timeout_ms` (nil: no limit): its reason,
# or nil after the timeout.
fn await_down(pid, timeout_ms)
  if timeout_ms == nil
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return reason
    end
  end
  receive
  when {tag: "DOWN", pid: ^pid, reason: reason}
    reason
  after timeout_ms
    nil
  end
end

# Stops the child `pid`: the exit signal "shutdown", up to `shutdown` ms
# (nil: no limit) for its DOWN, then the untrappable "kill". Takes its DOWN
# and drops the EXIT that follows, also for a child that had died already
# and whose DOWN is still queued. Returns the DOWN's reason, or nil when
# there was none left to take.
fn stop_child(pid, shutdown)
  if not kill(pid, "shutdown")
    let gone = await_down(pid, 0)
    if gone != nil
      drop_exit(pid, gone)
    end
    return gone
  end
  let reason = await_down(pid, shutdown)
  if reason == nil
    kill(pid, "kill")
    # The DOWN is queued by now: the child was alive when the wait ended,
    # and kill delivers it, or it died just then and delivered it itself.
    reason = await_down(pid, nil)
  end
  drop_exit(pid, reason)
  reason
end

# Drops the EXIT that the death of `pid` (with `reason`) queued right after
# its DOWN, which the caller has just taken. Matching the reason leaves an
# exit signal the child sent before it died (`kill(sup, r)`) in the mailbox.
fn drop_exit(pid, reason)
  receive
  when {tag: "EXIT", pid: ^pid, reason: ^reason}
    nil
  after 0
    nil
  end
end

fn find_child(children, pid)
  for i = 0, len(children)
    if children[i].pid == pid
      return i
    end
  end
  -1
end

fn restart_of(spec)
  let {restart = "permanent"} = spec
  restart
end

# A child that was already gone when the supervisor monitored it gives
# "noproc": its real exit reason is unknown, and a transient child is taken
# to have exited normally (restarting it would replay a `start` whose child
# may well have finished its job).
fn should_restart(spec, reason)
  let restart = restart_of(spec)
  if restart == "permanent"
    return true
  end
  restart == "transient" and reason != "normal" and reason != "shutdown" and reason != "noproc"
end

# Records a restart at `now`, dropping restarts older than the window, and
# raises when the supervisor has restarted too often.
fn note_restart(state, now)
  let recent = []
  for t in state.restart_times
    if now - t <= state.max_seconds
      push(recent, t)
    end
  end
  push(recent, now)
  state.restart_times = recent
  if len(recent) > state.max_restarts
    error(INTENSITY)
  end
end

# A child that isn't running.
fn not_running(spec)
  {id: spec.id, pid: -1, shutdown: nil}
end

# A child that isn't running and is owed a restart (start_pending).
fn pending(spec)
  {id: spec.id, pid: -1, shutdown: nil, pending: true}
end

fn is_pending(child)
  child.pending == true
end

# Stops every running child but the one at `dead_idx`, in reverse spec
# order (stop_child), and marks pending the dead child and every child it
# stopped or that was pending, except temporary ones. A child that was not
# running and not pending stays down.
fn stop_all_for_restart(state, dead_idx)
  let children = state.children
  let specs = state.specs
  let revive = []
  for i = 0, len(children)
    let was_up = children[i].pid != -1 or is_pending(children[i])
    push(revive, i == dead_idx or (was_up and restart_of(specs[i]) != "temporary"))
  end
  let i = len(children) - 1
  while i >= 0
    if i != dead_idx and children[i].pid != -1
      stop_child(children[i].pid, children[i].shutdown)
    end
    i -= 1
  end
  for j = 0, len(specs)
    if revive[j]
      children[j] = pending(specs[j])
    else
      children[j] = not_running(specs[j])
    end
  end
end

# Prints the error of a restart's `start` and where it was raised.
fn report_failed_restart(spec, res)
  eprint("supervisor: restart of child \"{spec.id}\" failed: {res.error}")
  for f in res.stack
    eprint("  at {f.name} ({f.file}:{f.line})")
  end
end

# Starts the pending children in spec order, up to the first whose `start`
# raises: that one and the pending ones after it stay pending, and a
# `_sup_retry` message to the supervisor itself (one queued at a time)
# makes sup_loop try again, counted as a restart.
fn start_pending(state)
  for i = 0, len(state.children)
    if is_pending(state.children[i])
      let started = pcall start_child(state.specs[i])
      if not started.ok
        report_failed_restart(state.specs[i], started)
        if not state.retry_queued
          state.retry_queued = true
          send(self(), {tag: "_sup_retry"})
        end
        return nil
      end
      state.children[i] = started.value
    end
  end
  nil
end

fn has_pending(children)
  for c in children
    if is_pending(c)
      return true
    end
  end
  false
end

fn handle_down(state, dead_pid, reason)
  let idx = find_child(state.children, dead_pid)
  if idx == -1
    return state
  end
  drop_exit(dead_pid, reason)
  let spec = state.specs[idx]
  if not should_restart(spec, reason)
    state.children[idx] = not_running(spec)
    return state
  end
  note_restart(state, time_ms())
  if state.strategy == "one_for_one"
    state.children[idx] = pending(spec)
  else
    stop_all_for_restart(state, idx)
  end
  start_pending(state)
  state
end

fn children_info(state)
  let result = []
  for i = 0, len(state.children)
    let spec = state.specs[i]
    push(result, {id: spec.id, pid: state.children[i].pid, restart: restart_of(spec)})
  end
  result
end

# Runs until the supervisor must exit, and returns the exit reason.
fn sup_loop(state)
  receive
  when {tag: "DOWN", pid: dead_pid, reason: reason}
    sup_loop(handle_down(state, dead_pid, reason))
  when {tag: "_sup_retry"}
    state.retry_queued = false
    if has_pending(state.children)
      note_restart(state, time_ms())
      start_pending(state)
    end
    sup_loop(state)
  when {tag: "_sup_which_children", from: from, ref: ref}
    send(from, {tag: "_sup_children", ref: ref, children: children_info(state)})
    sup_loop(state)
  when {tag: "EXIT", reason: reason}
    if reason != "normal"
      # An exit signal (`kill(sup, "shutdown")`, from a child or anyone
      # else, or a linked parent that died; see the top of the file).
      return reason
    end
    sup_loop(state)
  when other
    sup_loop(state)
  end
end

# Stops every running child, in reverse spec order (stop_child), whatever the
# supervisor's own exit reason: a child that traps exits only has to know
# "shutdown".
fn shutdown_children(children)
  let i = len(children) - 1
  while i >= 0
    if children[i].pid != -1
      stop_child(children[i].pid, children[i].shutdown)
    end
    i -= 1
  end
end

# Prints where the error of `res` was raised (a child's `start`, most
# likely), unless it is the intensity error, whose origin says nothing.
fn report_stack(res)
  if res.error != INTENSITY
    eprint("supervisor: exiting on an error raised at:")
    for f in res.stack
      eprint("  at {f.name} ({f.file}:{f.line})")
    end
  end
end

# The supervisor process: starts the children and tells `caller` (waiting
# in `start`, under `ref`) that they have started, runs the loop, and on the
# way out (an exit signal or an error) shuts the children down before it
# exits with the same reason. A child's `start` that raises during this
# first start stops the children started before it, then tells `caller`
# which child failed, then exits with the error as its reason.
fn sup_main(state, caller, ref)
  process_flag("trap_exit", true)
  for spec in state.specs
    let started = pcall start_child(spec)
    if not started.ok
      report_stack(started)
      shutdown_children(state.children)
      send(caller, {tag: "_sup_start_failed", ref: ref, id: spec.id, error: started.error})
      process_flag("trap_exit", false)
      kill(self(), started.error)
    end
    push(state.children, started.value)
  end
  send(caller, {tag: "_sup_started", ref: ref})
  let res = pcall sup_loop(state)
  let reason = res.value
  if not res.ok
    reason = res.error
  end
  shutdown_children(state.children)
  if not res.ok
    report_stack(res)
    error(res.error)
  end
  process_flag("trap_exit", false)
  kill(self(), reason)
end

# Raises `supervisor.start: ...` for a child list that isn't an array of
# `{id, start, restart, shutdown}` specs with distinct ids.
fn check_children(children)
  if type(children) != "table"
    error("supervisor.start: children must be an array of child specs, got {type(children)}")
  end
  let seen = {}
  for spec in children
    if type(spec) != "table"
      error("supervisor.start: a child spec must be a table, got {type(spec)}")
    end
    if spec.id == nil
      error("supervisor.start: a child spec has no id")
    end
    if has_key(seen, spec.id)
      error("supervisor.start: duplicate child id \"{spec.id}\"")
    end
    seen[spec.id] = true
    if type(spec.start) != "fn"
      error("supervisor.start: start of child \"{spec.id}\" must be a fn, got {type(spec.start)}")
    end
    let restart = restart_of(spec)
    if not has_key(RESTARTS, restart)
      error("supervisor.start: unknown restart \"{restart}\" for child \"{spec.id}\"")
    end
    if has_key(spec, "shutdown") and spec.shutdown != nil and type(spec.shutdown) != "int"
      error("supervisor.start: shutdown of child \"{spec.id}\" must be an int (milliseconds) or nil, got {type(spec.shutdown)}")
    end
  end
end

## Spawns a supervisor that starts the children in `spec.children` and
## returns its handle `{pid, shutdown: nil}`.
##
## `spec` takes `children`: an array of `{id, start, restart, shutdown}`
## specs, where `id` is required and unique, `start` spawns the child and
## returns the pid, `{pid}` handle or registered name of the process it
## spawned (any int is trusted as a pid: one that is not a live process
## counts as dead at once with reason `"noproc"`, so a permanent child is
## restarted until the restart limit stops the supervisor), and `restart`
## is `"permanent"` (the default: always restart), `"transient"` (restart
## unless it exits with `"normal"`, `"shutdown"` or `"noproc"`) or
## `"temporary"` (never). `shutdown` is how long, in
## milliseconds, the child gets to exit after `"shutdown"` before it is
## killed with the untrappable `"kill"` (an int `<= 0` doesn't wait; `nil`
## waits with no limit). Left out, it comes from an int or `nil`
## `shutdown` key on the handle `start` returned, else 5000: a
## supervisor's own handle says `nil`, so a nested supervisor finishes its
## ordered shutdown. Write `shutdown: x` only when `x` is set: `nil` there
## is not the default. `strategy` is `"one_for_one"` (the default: restart
## the dead child) or `"one_for_all"` (stop the others, in reverse spec
## order, then start again, in spec order, the dead child and the others
## that were running or owed a restart, except temporary ones). The supervisor gives up and exits
## when more than `max_restarts` (default 3) restarts fall within
## `max_seconds` MILLISECONDS, despite the name (default 5000, i.e. 5 s).
## `name` registers it.
##
## A restart runs `start` again from scratch: no state carries over. It
## happens in the supervisor, after the child's death, so for a moment a
## call by the child's registered name raises `no process registered`. A
## restart whose `start` raises (a gen_server whose `init` fails, say) is
## printed on stderr and tried again, after the requests already queued;
## each try counts as a restart, so the restart limit ends a `start` that
## keeps failing. Until a try succeeds, `which_children` shows the child
## with pid -1. In `"one_for_all"`, the children before the failing one
## stay up, and it and the ones after it start, in order, on the next try.
##
## Raises, and starts nothing, for a bad spec (e.g. `supervisor.start:
## duplicate child id "d"`) or a name that is taken.
##
## Returns once every child's `start` has returned, so a name a child's
## `start` registers is taken by then. The supervisor calls them in order,
## in its own process, so `self()` there is the supervisor, and a `start`
## that waits for an answer from the caller of `supervisor.start` never
## gets one. A `start` that raises stops the children started before it,
## ends the supervisor and makes `supervisor.start` raise
## `supervisor.start: child "<id>" failed to start: <error>`, once the
## supervisor has exited; where the error was raised is printed on stderr.
##
## The supervisor is not linked to the caller: the caller dying leaves it
## running, and it dying later (on its restart limit or an exit signal)
## doesn't kill the caller. Its exit reason is the exit signal's reason or
## `"supervisor: max restart intensity reached"`, which is also printed on
## stderr. Before it exits it stops its children as `stop` does. `kill(sup.pid, reason)` is handled when it next reads
## its mailbox; use `stop` to know it is gone. `kill(sup.pid, "kill")`
## ends it at once, without stopping its children: those that don't trap
## exits die through their links, the others get an `EXIT` and run on.
## Children are linked to the supervisor, so a child that traps exits gets
## its `EXIT` messages; it should clean up and return on one from the
## supervisor, or it is killed when its budget runs out.
fn start(spec)
  if type(spec) != "table"
    error("supervisor.start: expected a spec table \{strategy, children, ...\}, got {type(spec)}")
  end
  let {strategy = "one_for_one", max_restarts = 3, max_seconds = 5000, children = [], name = nil} = spec
  if not has_key(STRATEGIES, strategy)
    error("supervisor.start: unknown strategy \"{strategy}\"")
  end
  if type(max_restarts) != "int"
    error("supervisor.start: max_restarts must be an int, got {type(max_restarts)}")
  end
  if type(max_seconds) != "int"
    error("supervisor.start: max_seconds must be an int (milliseconds), got {type(max_seconds)}")
  end
  if name != nil
    if type(name) != "string"
      error("supervisor.start: name must be a string, got {type(name)}")
    end
    if whereis(name) != nil
      error("supervisor.start: the name \"{name}\" is already registered")
    end
  end
  check_children(children)
  let specs = children
  let caller = self()
  let ref = make_ref()
  let pid = spawn do
    sup_main({
      strategy: strategy,
      children: [],
      specs: specs,
      max_restarts: max_restarts,
      max_seconds: max_seconds,
      restart_times: [],
      retry_queued: false
    }, caller, ref)
  end
  # The new process hasn't run yet: register it here, so a child's `start`
  # can already find the supervisor by name.
  if name != nil
    register(name, pid)
  end
  monitor(pid)
  receive
  when {tag: "_sup_started", ref: ^ref}
    drop_monitor(pid, true)
  when {tag: "_sup_start_failed", ref: ^ref, id: id, error: e}
    # Its exit is next: wait for it, so its name is free when this raises.
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    end
    error("supervisor.start: child \"{id}\" failed to start: {e}")
  when {tag: "DOWN", pid: ^pid, reason: reason}
    error("supervisor.start: supervisor exited: {reason}")
  end
  # `shutdown: nil`: a supervisor above this one waits for its whole
  # shutdown instead of killing it midway (see the top of the file).
  {pid: pid, shutdown: nil}
end

fn check_timeout(timeout_ms, caller)
  if timeout_ms != nil and type(timeout_ms) != "int"
    error("{caller}: timeout must be an int (milliseconds) or nil, got {type(timeout_ms)}")
  end
end

# Ends the monitor of `pid` a request took: `added` is what its `monitor`
# returned. A monitor the caller already had is left alone. One the request
# added is removed, and its DOWN dropped if the target died meanwhile.
fn drop_monitor(pid, added)
  if added and not demonitor(pid)
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    after 0
      nil
    end
  end
end

# After a request matched the DOWN of `pid` (with `reason`): when the
# monitor was the caller's own (`added` false), puts the DOWN back for it.
fn return_down(pid, added, reason)
  if not added
    send(self(), {tag: "DOWN", pid: pid, reason: reason})
  end
  nil
end

# Waits for the answer to `ref` or the DOWN of `pid`: {children} or {down}.
fn await_children(pid, ref)
  receive
  when {tag: "_sup_children", ref: ^ref, children: children}
    {children: children}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  end
end

# As await_children, or nil after `timeout_ms`.
fn await_children_for(pid, ref, timeout_ms)
  receive
  when {tag: "_sup_children", ref: ^ref, children: children}
    {children: children}
  when {tag: "DOWN", pid: ^pid, reason: reason}
    {down: reason}
  after timeout_ms
    nil
  end
end

## Returns the supervisor's children as `{id, pid, restart}` tables in
## spec order; `pid` is -1 for a child that is not running.
##
##   supervisor.which_children(sup)   # [{id: "db", pid: 2, restart: "permanent"}, ...]
##
## Raises `supervisor.which_children: supervisor exited: <reason>` at once
## when the supervisor is dead or dies first, and `...: timeout` after
## `timeout_ms` (nil: no limit).
##
## Blocks until the supervisor answers. Monitors the supervisor for the request only, as `gen_server.call`
## does, and leaves no monitor or `DOWN` behind. After a timeout, a late
## `{tag: "_sup_children"}` answer may land in the caller's mailbox.
fn which_children(target, timeout_ms = 5000)
  let pid = target_pid(target, "supervisor.which_children")
  check_timeout(timeout_ms, "supervisor.which_children")
  let ref = make_ref()
  let added = monitor(pid)
  send(pid, {tag: "_sup_which_children", from: self(), ref: ref})
  let res = nil
  if timeout_ms == nil
    res = await_children(pid, ref)
  else
    res = await_children_for(pid, ref, timeout_ms)
  end
  if res == nil
    drop_monitor(pid, added)
    error("supervisor.which_children: timeout")
  end
  if has_key(res, "down")
    return_down(pid, added, res.down)
    error("supervisor.which_children: supervisor exited: {res.down}")
  end
  drop_monitor(pid, added)
  res.children
end

## Stops the supervisor, waits until it has exited, and returns nil (also
## for one already gone, given by pid or handle; by name see the header).
##
## The supervisor stops its children one at a time, in reverse spec order:
## each gets the exit signal `"shutdown"`, then, if it is still running
## after its `shutdown` budget, the untrappable `"kill"`. So the whole tree
## is down, and every name registered in it free, when `stop` returns.
## Only direct children are stopped: processes a child spawned itself
## (such as its tasks, which aren't linked to it) keep running. By default
## `stop` waits with no limit, since the budgets bound the shutdown; with a
## `timeout_ms` it raises `supervisor.stop: the supervisor did not stop
## within <ms> ms` after that long (the shutdown goes on).
##
## Blocks the caller. Takes the supervisor's `DOWN`, unless the caller
## monitors it itself: that monitor still gets it.
fn stop(target, timeout_ms = nil)
  let pid = target_pid(target, "supervisor.stop")
  check_timeout(timeout_ms, "supervisor.stop")
  let added = monitor(pid)
  kill(pid, "shutdown")
  if timeout_ms == nil
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return_down(pid, added, reason)
    end
  else
    receive
    when {tag: "DOWN", pid: ^pid, reason: reason}
      return_down(pid, added, reason)
    after timeout_ms
      drop_monitor(pid, added)
      error("supervisor.stop: the supervisor did not stop within {timeout_ms} ms")
    end
  end
end

export start, which_children, stop
