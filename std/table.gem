# table — helpers for arrays (tables with keys 0 .. n-1).
#
#   let evens = table.filter(nums) do |n|
#     n % 2 == 0
#   end
#   let names = table.map(users, fn(u) u.name end)
#   table.sort(users, fn(a, b) a.age - b.age end)
#
# Only `sort` changes its argument; the others build new tables. They
# take arrays (`copy` takes any table): on a record, `for x in t` sees
# `nil` for every entry, so pass `keys(t)` or `values(t)`.

# The identity of a table as an int (runtime/gem_core.c), so `unique` can
# key tables by a hashed string. Stable during `unique`'s loop: the items
# are older than the loop, and a region reset only moves what the loop
# allocated.
extern fn gem_table_id(t: Table) -> Int

# True when `t` holds array entries. An empty table counts as neither.
fn is_array(t)
  for k, v in t
    return type(k) == "int"
  end
  false
end

fn each(arr, f)
  for item in arr
    f(item)
  end
end

fn map(arr, f)
  let result = []
  for item in arr
    push(result, f(item))
  end
  result
end

fn filter(arr, f)
  let result = []
  for item in arr
    if f(item)
      push(result, item)
    end
  end
  result
end

fn reduce(arr, init, f)
  let acc = init
  for item in arr
    acc = f(acc, item)
  end
  acc
end

fn find(arr, f)
  for item in arr
    if f(item)
      return item
    end
  end
  nil
end

fn any(arr, f)
  for item in arr
    if f(item)
      return true
    end
  end
  false
end

fn all(arr, f)
  for item in arr
    if not f(item)
      return false
    end
  end
  true
end

fn count(arr, f)
  let n = 0
  for item in arr
    if f(item)
      n += 1
    end
  end
  n
end

fn reverse(arr)
  let result = []
  let i = len(arr) - 1
  while i >= 0
    push(result, arr[i])
    i -= 1
  end
  result
end

fn contains(arr, value)
  for item in arr
    if item == value
      return true
    end
  end
  false
end

fn index_of(arr, value)
  for i, item in arr
    if item == value
      return i
    end
  end
  -1
end

# `length` elements from `start` (negative counts from the end); with no
# `length`, everything from `start` on.
fn slice(arr, start, length = nil)
  let n = len(arr)
  if start < 0
    start = n + start
  end
  if start < 0
    start = 0
  end
  let stop = n
  if length != nil and start + length < n
    stop = start + length
  end
  let result = []
  for i = start, stop
    push(result, arr[i])
  end
  result
end

fn concat(a, b)
  let result = []
  for item in a
    push(result, item)
  end
  for item in b
    push(result, item)
  end
  result
end

# Shallow copy of an array or a record.
fn copy(tbl)
  let result = {}
  for k, v in tbl
    # push keeps an array's copy linear (a new int key is otherwise a scan)
    if type(k) == "int" and k == len(result)
      push(result, v)
    else
      result[k] = v
    end
  end
  result
end

# Appends `x` to `result`: the elements of an array, nothing for an empty
# table, `x` itself for anything else.
fn push_flat(result, x)
  if type(x) != "table"
    push(result, x)
  elif is_array(x)
    for sub in x
      push(result, sub)
    end
  elif len(x) > 0
    push(result, x)
  end
end

fn flat_map(arr, f)
  let result = []
  for item in arr
    push_flat(result, f(item))
  end
  result
end

fn flatten(arr)
  let result = []
  for item in arr
    push_flat(result, item)
  end
  result
end

fn zip(a, b)
  let n = len(a)
  if len(b) < n
    n = len(b)
  end
  let result = []
  for i = 0, n
    push(result, [a[i], b[i]])
  end
  result
end

# Drops repeated values, keeping the first. Values are the same when `==`
# says so: `1`, `1.0` and `"1"` all differ, and tables compare by identity.
# A string key that stands for `item` under `==` (only string keys are
# hashed; other keys are found by a linear scan), or nil for values that
# need the scan: functions and NaN.
fn unique_key(item)
  let t = type(item)
  if t == "string"
    return "s{item}"
  elif t == "int"
    return "i{item}"
  elif t == "float"
    if item != item
      return nil
    end
    if item == 0.0
      return "f0"
    end
    return "f{item}"
  elif t == "table"
    return "t{gem_table_id(item)}"
  elif t == "bool" or t == "nil"
    return "{t}{item}"
  end
  nil
end

fn unique(arr)
  let seen = {}
  let others = []
  let result = []
  for item in arr
    let key = unique_key(item)
    if key == nil
      if item == item and not contains(others, item)
        push(others, item)
        push(result, item)
      elif item != item
        push(result, item)
      end
    elif not has_key(seen, key)
      seen[key] = true
      push(result, item)
    end
  end
  result
end

fn group_by(arr, f)
  let groups = {}
  for item in arr
    let key = f(item)
    if type(key) == "int" and key < 0
      error("table.group_by: key {key} is a negative int, which can't be a table key; return a string")
    end
    if not has_key(groups, key)
      groups[key] = []
    end
    push(groups[key], item)
  end
  groups
end

# Sorts `arr` in place and returns it. `cmp(a, b)` returns a negative
# number when `a` comes first, zero when they tie, and a positive number
# otherwise. The `sort` builtin leaves the array unsorted, with no error,
# when the comparator returns a bool, so this checks what `cmp` returns for
# the first two elements first and raises if it isn't a number. A `let`,
# not a `fn`, so that its body still reaches the `sort` builtin.
let sort = fn(arr, cmp = nil)
  if type(arr) != "table"
    error("table.sort: arr must be an array, got {type(arr)}")
  end
  if cmp == nil
    return sort(arr)
  end
  if len(arr) >= 2
    let t = type(cmp(arr[0], arr[1]))
    if t != "int" and t != "float"
      error("table.sort: the comparator must return a number (negative, zero or positive), got {t}")
    end
  end
  sort(arr, cmp)
end

export each, map, filter, reduce, find, any, all, reverse, contains, slice, index_of, concat, copy, flat_map, zip, unique, count, flatten, group_by, sort
