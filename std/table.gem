## table — map, filter, search, slice, group and sort arrays.
##
##   load "std/table"
##   let evens = table.filter(nums) do |n|
##     n % 2 == 0
##   end
##   let names = table.map(users, fn(u) u.name end)
##   table.sort(users, fn(a, b) a.age - b.age end)
##
## An array is a table with keys 0 .. n-1. Only `sort` changes its
## argument; the others return new tables. They take arrays (`copy` takes
## any table): on a record, `for x in t` sees `nil` for every entry, so
## pass `keys(t)` or `values(t)`. They don't check: a record, a string, or
## a table mixing int and string keys gives `nil` entries or a wrong result,
## not an error (`table.map({a: 1}, f)` is `[nil]`). Values are compared
## with `==`: `1` and `1.0` differ, and tables are equal only when they are
## the same table.

# The identity of a table as an int (runtime/gem_core.c), so `unique` can
# key tables by a hashed string. Stable during `unique`'s loop: the items
# are older than the loop, and a region reset only moves what the loop
# allocated.
extern fn gem_table_id(t: Table) -> Int

# True when `t` holds array entries. An empty table counts as neither.
fn is_array(t)
  for k, v in t
    return type(k) == "int"
  end
  false
end

## Calls `f(item)` for each element, in order, and returns nil.
fn each(arr, f)
  for item in arr
    f(item)
  end
end

## Returns a new array of `f(item)` for each element.
##
##   table.map([1, 2, 3], fn(x) x * 10 end)    # [10, 20, 30]
fn map(arr, f)
  let result = []
  for item in arr
    push(result, f(item))
  end
  result
end

## Returns a new array of the elements for which `f(item)` is truthy, in
## order.
##
##   table.filter([1, 2, 3, 4], fn(n) n % 2 == 0 end)    # [2, 4]
fn filter(arr, f)
  let result = []
  for item in arr
    if f(item)
      push(result, item)
    end
  end
  result
end

## Folds the array from the left: starts from `init` and replaces it with
## `f(acc, item)` for each element. Returns `init` for an empty array.
##
##   table.reduce([1, 2, 3], 0, fn(acc, x) acc + x end)    # 6
fn reduce(arr, init, f)
  let acc = init
  for item in arr
    acc = f(acc, item)
  end
  acc
end

## Returns the first element for which `f(item)` is truthy, or nil.
##
##   table.find([1, 2, 3], fn(x) x > 1 end)    # 2
##
## A found `nil` looks the same as no match; use `index_of` or `any` to
## tell them apart.
fn find(arr, f)
  for item in arr
    if f(item)
      return item
    end
  end
  nil
end

## Returns true when `f(item)` is truthy for some element, stopping at the
## first. False for an empty array.
fn any(arr, f)
  for item in arr
    if f(item)
      return true
    end
  end
  false
end

## Returns true when `f(item)` is truthy for every element, stopping at
## the first that isn't. True for an empty array.
fn all(arr, f)
  for item in arr
    if not f(item)
      return false
    end
  end
  true
end

## Returns how many elements `f(item)` is truthy for.
fn count(arr, f)
  let n = 0
  for item in arr
    if f(item)
      n += 1
    end
  end
  n
end

## Returns a new array with the elements in reverse order.
##
##   table.reverse([1, 2, 3])    # [3, 2, 1]
fn reverse(arr)
  let result = []
  let i = len(arr) - 1
  while i >= 0
    push(result, arr[i])
    i -= 1
  end
  result
end

## Returns true when an element `==` `value`.
##
##   table.contains([1, 2], 2)      # true
##   table.contains([1], 1.0)       # false
##
## Scans the array on every call; for repeated lookups, build a table
## keyed by the values and use `has_key`.
fn contains(arr, value)
  for item in arr
    if item == value
      return true
    end
  end
  false
end

## Returns the index of the first element `==` `value`, or -1.
##
##   table.index_of(["a", "b"], "b")    # 1
fn index_of(arr, value)
  for i, item in arr
    if item == value
      return i
    end
  end
  -1
end

## Returns a new array of up to `length` elements from index `start`, or
## of everything from `start` on when `length` is left out.
##
## A negative `start` counts from the end (clipped to 0). A `start` past
## the end, or a `length` of 0 or less, gives an empty array.
##
##   table.slice([1, 2, 3, 4], 1, 2)    # [2, 3]
##   table.slice([1, 2, 3, 4], -2)      # [3, 4]
fn slice(arr, start, length = nil)
  let n = len(arr)
  if start < 0
    start = n + start
  end
  if start < 0
    start = 0
  end
  let stop = n
  if length != nil and start + length < n
    stop = start + length
  end
  let result = []
  for i = start, stop
    push(result, arr[i])
  end
  result
end

## Returns a new array of the elements of `a` followed by those of `b`.
##
##   table.concat([1, 2], [3])    # [1, 2, 3]
fn concat(a, b)
  let result = []
  for item in a
    push(result, item)
  end
  for item in b
    push(result, item)
  end
  result
end

## Returns a shallow copy of an array or a record: a new table with the
## same keys and values. Nested tables are shared, not copied.
fn copy(tbl)
  let result = {}
  for k, v in tbl
    # push keeps an array's copy linear (a new int key is otherwise a scan)
    if type(k) == "int" and k == len(result)
      push(result, v)
    else
      result[k] = v
    end
  end
  result
end

# Appends `x` to `result`: the elements of an array, nothing for an empty
# table, `x` itself for anything else.
fn push_flat(result, x)
  if type(x) != "table"
    push(result, x)
  elif is_array(x)
    for sub in x
      push(result, sub)
    end
  elif len(x) > 0
    push(result, x)
  end
end

## Returns a new array of the results of `f(item)`, with array results
## spliced in: an array adds its elements, an empty table adds nothing,
## and anything else (a record included) is added as one element.
##
##   table.flat_map([1, 2], fn(x) [x, x] end)    # [1, 1, 2, 2]
fn flat_map(arr, f)
  let result = []
  for item in arr
    push_flat(result, f(item))
  end
  result
end

## Returns a new array with the elements of nested arrays spliced in, one
## level deep. Empty tables are dropped; records and other values stay.
##
##   table.flatten([[1, 2], 3, [[4]], []])    # [1, 2, 3, [4]]
fn flatten(arr)
  let result = []
  for item in arr
    push_flat(result, item)
  end
  result
end

## Returns an array of pairs `[a[i], b[i]]`, as long as the shorter of
## the two.
##
##   table.zip([1, 2, 3], ["a", "b"])    # [[1, "a"], [2, "b"]]
fn zip(a, b)
  let n = len(a)
  if len(b) < n
    n = len(b)
  end
  let result = []
  for i = 0, n
    push(result, [a[i], b[i]])
  end
  result
end

# A string key that stands for `item` under `==` (only string keys are
# hashed; other keys are found by a linear scan), or nil for values that
# need the scan: functions and NaN.
fn unique_key(item)
  let t = type(item)
  if t == "string"
    return "s{item}"
  elif t == "int"
    return "i{item}"
  elif t == "float"
    if item != item
      return nil
    end
    if item == 0.0
      return "f0"
    end
    return "f{item}"
  elif t == "table"
    return "t{gem_table_id(item)}"
  elif t == "bool" or t == "nil"
    return "{t}{item}"
  end
  nil
end

## Returns a new array without repeated values, keeping the first of each
## in order. NaN never equals itself, so every NaN is kept.
##
##   table.unique([1, 1.0, "1", 1, 2])    # [1, 1.0, "1", 2]
fn unique(arr)
  let seen = {}
  let others = []
  let result = []
  for item in arr
    let key = unique_key(item)
    if key == nil
      if item == item and not contains(others, item)
        push(others, item)
        push(result, item)
      elif item != item
        push(result, item)
      end
    elif not has_key(seen, key)
      seen[key] = true
      push(result, item)
    end
  end
  result
end

## Returns a table mapping each key `f(item)` to the array of elements
## that gave it, in order. A key can be any value except a negative int
## (a table key matches only that same table).
##
##   table.group_by(["apple", "avocado", "banana"], fn(s) substr(s, 0, 1) end)
##   # {a: ["apple", "avocado"], b: ["banana"]}
##
## To `json.encode` the result, return string keys: int keys 0 .. n-1
## encode as an array, and bool, nil and float keys can't be encoded.
##
## Raises if `f` returns a negative int.
fn group_by(arr, f)
  let groups = {}
  for item in arr
    let key = f(item)
    if type(key) == "int" and key < 0
      error("table.group_by: key {key} is a negative int, which can't be a table key; return a string")
    end
    if not has_key(groups, key)
      groups[key] = []
    end
    push(groups[key], item)
  end
  groups
end

## Sorts the array `arr` in place and returns it. Not guaranteed stable.
## Without `cmp`, numbers sort ascending and strings by byte order; mixed
## types go nil, bools, numbers, strings, fns, tables (bools, fns and
## tables tie among themselves, in no set order). `cmp(a, b)` returns a
## negative number when `a` comes first, zero when they tie, and a
## positive number otherwise.
##
##   table.sort(users, fn(a, b) a.age - b.age end)
##
## Raises `table.sort: arr must be an array, ...` if `arr` is not an
## array (a table whose keys are 0 .. n-1), and `table.sort: the comparator
## must return a number ...` if `cmp` returns something other than a number
## (a bool, say) for the first two elements. Only that first call is
## checked: a non-number later counts as a tie and silently mis-sorts.
let sort = fn(arr, cmp = nil)
  # The `sort` builtin leaves the array unsorted, with no error, when the
  # comparator returns a bool, so this checks what `cmp` returns for the
  # first two elements first. A `let`, not a `fn`, so that its body still
  # reaches the `sort` builtin.
  if type(arr) != "table"
    error("table.sort: arr must be an array, got {type(arr)}")
  end
  # `__is_array_n` is the check array patterns compile to.
  if not __is_array_n(arr, len(arr))
    error("table.sort: arr must be an array, got a table with keys other than 0 .. n-1")
  end
  if cmp == nil
    return sort(arr)
  end
  if len(arr) >= 2
    let t = type(cmp(arr[0], arr[1]))
    if t != "int" and t != "float"
      error("table.sort: the comparator must return a number (negative, zero or positive), got {t}")
    end
  end
  sort(arr, cmp)
end

export each, map, filter, reduce, find, any, all, reverse, contains, slice, index_of, concat, copy, flat_map, zip, unique, count, flatten, group_by, sort
