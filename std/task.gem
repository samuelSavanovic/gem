## task — run a function in its own process and wait for its result.
##
##   let t = task.async do
##     fetch(url)
##   end
##   let body = task.await(t)
##
## A task is the table `async` returns; its `pid` is the task process
## (`kill(t.pid, reason)` stops it, and `await` then raises `task exited`).
## Only the process that called `async` (its owner) can await it, and only
## once. A failed await raises an error starting with `task.await: `
## (`task.await_all: ` from `await_all`), except that the task's own error
## is raised unchanged; it is not printed on stderr. The task is not
## linked to its owner: the owner dying leaves it running. Don't trap
## exits in a task: then a timeout can't stop it.

## Spawns a process that runs `f()` and returns the task to await.
##
##   let t = task.async(fn() 21 * 2 end)
##   task.await(t)    # 42
##
## Raises if `f` is not a fn.
##
## Returns at once. The owner monitors the task; the task sends its result
## to the owner and exits, so a `{tag: "_task_result"}` message and the
## task's `DOWN` land in the owner's mailbox. `await` removes both; a task
## that is never awaited leaves them there. `monitor(t.pid)` returns false
## and adds nothing: `await` takes the only `DOWN`.
fn async(f)
  if type(f) != "fn"
    error("task.async: expected a function, got {type(f)}")
  end
  let owner = self()
  let ref = make_ref()
  let pid = spawn(fn()
    send(owner, {tag: "_task_result", ref: ref, result: pcall f()})
  end)
  monitor(pid)
  {pid: pid, ref: ref, owner: owner, done: false}
end

# Removes the DOWN message for `pid` from the mailbox, waiting for it when
# `wait` is true.
fn flush_down(pid, wait)
  if wait
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    end
  else
    receive
    when {tag: "DOWN", pid: ^pid}
      nil
    after 0
      nil
    end
  end
end

# Kills the task process and drops its DOWN. For a task that has already
# exited, the kill does nothing (a pid never refers to a later process) and
# only the DOWN is dropped. A task that traps exits is not killed.
fn stop(pid, reason)
  kill(pid, reason)
  flush_down(pid, false)
end

# The result for a task whose process exited before its result was received.
fn exited_without_result(reason, caller)
  if reason == "normal"
    return {ok: false, error: "{caller}: task exited with reason \"normal\" before its result was received; a catch-all receive may have taken the result", down: true}
  end
  {ok: false, error: "{caller}: task exited: {reason}", down: true}
end

# Waits for the result or the DOWN of the task (`ref`, `pid`). Returns the
# result table, or nil when `timeout_ms` passes first.
fn receive_result(ref, pid, timeout_ms, caller)
  if timeout_ms == nil
    receive
    when {tag: "_task_result", ref: ^ref, result: res}
      res
    when {tag: "DOWN", pid: ^pid, reason: reason}
      exited_without_result(reason, caller)
    end
  else
    receive
    when {tag: "_task_result", ref: ^ref, result: res}
      res
    when {tag: "DOWN", pid: ^pid, reason: reason}
      exited_without_result(reason, caller)
    after timeout_ms
      nil
    end
  end
end

fn check_timeout(timeout_ms, caller)
  if timeout_ms != nil and type(timeout_ms) != "int"
    error("{caller}: timeout must be an int (milliseconds) or nil, got {type(timeout_ms)}")
  end
end

fn check_owner(t, caller)
  if type(t) != "table" or not has_key(t, "ref")
    error("{caller}: expected a task from task.async, got {type(t)}")
  end
  if t.owner != self()
    error("{caller}: only the process that started a task can await it")
  end
  if t.done
    error("{caller}: task was already awaited")
  end
end

# Waits for `t` and returns {ok: true, value: v} or {ok: false, error: msg}
# (the table may carry other keys). On timeout the task is stopped. `caller`
# names the API function in error messages.
fn collect(t, timeout_ms, caller)
  t.done = true
  let ref = t.ref
  let pid = t.pid
  let res = receive_result(ref, pid, 0, caller)
  if res == nil
    if process_info(pid) == nil
      # The process is gone, so its DOWN was delivered, and the check above
      # found neither the DOWN nor a result in the mailbox.
      return {ok: false, error: "{caller}: task exited and its result is no longer in the mailbox; a catch-all receive may have taken it"}
    end
    res = receive_result(ref, pid, timeout_ms, caller)
  end
  if res == nil
    stop(pid, "timeout")
    return {ok: false, error: "{caller}: timeout"}
  end
  if not has_key(res, "down")
    # The task exits right after sending its result, so its DOWN follows.
    flush_down(pid, true)
  end
  res
end

# Stops a task that will not be awaited and drops anything it already sent.
fn discard(t)
  if t.done
    return nil
  end
  t.done = true
  let ref = t.ref
  stop(t.pid, "cancelled")
  receive
  when {tag: "_task_result", ref: ^ref}
    nil
  after 0
    nil
  end
end

## Waits for task `t` and returns the value of its fn.
##
## Raises the task's error message when its fn raised. Raises
## `task.await: timeout` after `timeout_ms` (nil, the default: no limit)
## and kills the task with reason `"timeout"`. Raises `task.await: task
## exited: <reason>` when the task process died without a result, and
## raises when `t` was already awaited or belongs to another process.
##
##   task.await(task.async(fn() error("bad") end))    # raises "bad"
##   task.await(t, 1000)                              # at most 1 s
##
## Blocks the caller. Removes the task's result and `DOWN` from the
## mailbox, also on timeout, unless the task traps exits: then it runs on
## after the timeout, and its result and `DOWN` arrive later and stay in
## the owner's mailbox. A `receive` in the owner that takes any message
## can take them first; `await` then raises an error saying so.
fn await(t, timeout_ms = nil)
  check_owner(t, "task.await")
  check_timeout(timeout_ms, "task.await")
  let res = collect(t, timeout_ms, "task.await")
  if not res.ok
    error(res.error)
  end
  res.value
end

## Waits for every task in `tasks` and returns their values in the same
## order.
##
##   task.await_all([task.async(fn() 1 end), task.async(fn() 2 end)])   # [1, 2]
##   len(task.await_all([]))                                           # 0
##
## `timeout_ms` covers the whole call (nil, the default: no limit). Tasks
## are awaited in list order, so a failure is raised only when its turn
## comes (a slow task before it delays it), and only the first failing
## task in list order is reported. When a task fails or the time runs
## out, raises as `await` would (messages start with `task.await_all: `,
## except a task's own error, raised unchanged) and kills the tasks not
## awaited yet with reason `"cancelled"` (the one that timed out gets
## `"timeout"`). Raises if a task appears twice or `await` would refuse
## one; then it awaits nothing and leaves the tasks running, still
## awaitable (unawaited, their result and `DOWN` stay in the mailbox).
##
## Blocks the caller, and cleans the mailbox as `await` does.
fn await_all(tasks, timeout_ms = nil)
  if type(tasks) != "table"
    error("task.await_all: expected an array of tasks, got {type(tasks)}")
  end
  check_timeout(timeout_ms, "task.await_all")
  let seen = {}
  for t in tasks
    check_owner(t, "task.await_all")
    if has_key(seen, t.ref)
      error("task.await_all: the same task appears more than once")
    end
    seen[t.ref] = true
  end
  let deadline = if timeout_ms != nil then time_ms() + timeout_ms end
  let results = []
  for i = 0, len(tasks)
    let remaining = if deadline != nil
      let left = deadline - time_ms()
      if left < 0 then 0 else left end
    end
    let res = collect(tasks[i], remaining, "task.await_all")
    if not res.ok
      for j = i + 1, len(tasks)
        discard(tasks[j])
      end
      error(res.error)
    end
    push(results, res.value)
  end
  results
end

export async, await, await_all
