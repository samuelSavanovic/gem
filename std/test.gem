## test: a small harness for self-checking programs. Register cases with `case`, check with the asserts, call `run`.
## Cases are module state, so register them in the main process.

let cases = []
let owner = self()

## Registers a case for `run`. Raises in a spawned process, whose copy of the cases `run` never sees.
fn case(name, body)
  if self() != owner
    error("test.case: called in a spawned process; register cases at the top level or from main, where `test.run` runs them")
  end
  push(cases, {name: name, body: body})
end

fn is_identifier(s)
  if len(s) == 0
    return false
  end
  for i, ch in s
    let c = ord(ch)
    let letter = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
    if not letter and (i == 0 or c < 48 or c > 57)
      return false
    end
  end
  true
end

fn quote(s)
  let q = str_replace(s, "\\", "\\\\")
  q = str_replace(q, "\"", "\\\"")
  q = str_replace(q, "\n", "\\n")
  q = str_replace(q, "\r", "\\r")
  q = str_replace(q, "\t", "\\t")
  q = str_replace(q, "\0", "\\0")
  "\"{q}\""
end

fn show(v)
  if type(v) == "string"
    return quote(v)
  end
  to_string(v)
end

# never print both sides the same: add the types when they differ (1 vs 1.0), say so when they print alike
fn show_pair(expected, actual)
  let e = show(expected)
  let a = show(actual)
  if type(expected) != type(actual)
    return "expected {e} ({type(expected)}), got {a} ({type(actual)})"
  end
  if e == a
    return "expected {e}, got a different {type(actual)} {a}"
  end
  "expected {e}, got {a}"
end

fn key_step(k)
  if type(k) == "string" and is_identifier(k)
    return ".{k}"
  end
  "[{show(k)}]"
end

# table keys are scanned, so diff's memo keys on two ids (stable: a reset only moves what its loop allocated)
extern fn gem_table_id(t: Table) -> Int

# e.g. `.a[1]`; only built for a failure message
fn path_to(nodes, n, k)
  let steps = [key_step(k)]
  let i = n
  while nodes.parent[i] >= 0
    push(steps, key_step(nodes.key[i]))
    i = nodes.parent[i]
  end
  build_string do |add|
    let j = len(steps) - 1
    while j >= 0
      add(steps[j])
      j -= 1
    end
  end
end

fn failure(nodes, kind, e, a, key, n)
  if kind == "missing"
    return "actual is missing key {path_to(nodes, n, key)}"
  end
  if kind == "extra"
    for k, v in a
      if not has_key(e, k)
        return "actual has extra key {path_to(nodes, n, k)}"
      end
    end
  end
  "at {path_to(nodes, n, key)}, {show_pair(e, a)}"
end

# nil if `actual` deeply equals `expected`, else the first difference in key order.
# A pair of tables met again (shared or cyclic) counts as equal: it's compared further up or already was.
# The stack is parallel arrays, not records: the loop's reset copies whatever is live, and records are much slower.
fn diff(actual, expected)
  if type(actual) != "table" or type(expected) != "table"
    if actual == expected
      return nil
    end
    return show_pair(expected, actual)
  end
  if actual == expected
    return nil
  end
  let seen = {}
  # per expanded pair that pushed work: the key it was reached by and its parent (-1 at the root)
  let node_key = []
  let node_parent = []
  # kind "" compares a pair of tables; "missing", "extra" and "value" report a failure for node `parent`
  let w_kind = [""]
  let w_e = [expected]
  let w_a = [actual]
  let w_key = [""]
  let w_parent = [-1]
  while len(w_e) > 0
    let kind = pop(w_kind)
    let e = pop(w_e)
    let a = pop(w_a)
    let key = pop(w_key)
    let parent = pop(w_parent)
    if kind != ""
      return failure({key: node_key, parent: node_parent}, kind, e, a, key, parent)
    end
    let id = "{gem_table_id(e)} {gem_table_id(a)}"
    if not has_key(seen, id)
      let n = len(node_key)
      let base = len(w_e)
      # an extra key is reported after everything else in the pair
      if len(a) != len(e)
        push(w_kind, "extra")
        push(w_e, e)
        push(w_a, a)
        push(w_key, "")
        push(w_parent, n)
      end
      let first = len(w_e)
      for k, ev in e
        let av = a[k]
        let missing = av == nil and not has_key(a, k)
        let both = type(ev) == "table" and type(av) == "table"
        if both and ev != av and small_flat_equal(ev, av)
          continue
        end
        if missing or ev != av
          if missing
            push(w_kind, "missing")
          elif both
            push(w_kind, "")
          else
            push(w_kind, "value")
          end
          push(w_e, ev)
          push(w_a, av)
          push(w_key, k)
          push(w_parent, n)
          if not both
            break
          end
        end
      end
      if len(w_e) > base
        push(node_key, key)
        push(node_parent, parent)
      end
      # re-comparing a small flat pair costs about a `seen` lookup, so only remember bigger ones
      if len(w_e) > first or len(e) > 8
        seen[id] = true
      end
      # so the first key ends up on top
      let i = first
      let j = len(w_e) - 1
      while i < j
        swap(w_kind, i, j)
        swap(w_e, i, j)
        swap(w_a, i, j)
        swap(w_key, i, j)
        swap(w_parent, i, j)
        i += 1
        j -= 1
      end
    end
  end
  nil
end

# Small tables with the same keys and equal non-table values (arrays of small records) are settled in place.
# Anything else, including any difference, goes through diff's stack, which finds it again in order.
fn small_flat_equal(e, a)
  if len(e) > 8 or len(e) != len(a)
    return false
  end
  for k, ev in e
    let av = a[k]
    if type(ev) == "table" or ev != av or (av == nil and not has_key(a, k))
      return false
    end
  end
  true
end

fn swap(arr, i, j)
  let t = arr[i]
  arr[i] = arr[j]
  arr[j] = t
end

## Raises "test.assert: assertion failed" (plus ": <msg>") unless `cond` is truthy.
fn assert(cond, msg = nil)
  if not cond
    if msg == nil
      error("test.assert: assertion failed")
    end
    error("test.assert: assertion failed: {msg}")
  end
end

## Raises unless `actual` deeply equals `expected`, showing the first difference and its path.
## Tables compare by keys and values in any order (a key holding nil counts); other values use `==`.
fn assert_eq(actual, expected, msg = nil)
  let d = diff(actual, expected)
  if d == nil
    return nil
  end
  let prefix = if msg != nil then "test.assert_eq: {msg}: " else "test.assert_eq: " end
  if type(actual) == "table" and type(expected) == "table"
    error("{prefix}expected {show(expected)}, got {show(actual)}: {d}")
  end
  error("{prefix}{d}")
end

## Raises when `actual` deeply equals `expected`.
fn assert_neq(actual, expected, msg = nil)
  if diff(actual, expected) == nil
    if msg != nil
      error("test.assert_neq: {msg}: both values are {show(actual)}")
    end
    error("test.assert_neq: both values are {show(actual)}")
  end
end

## Calls `body()` and returns the message of the error it raised; raises if `body` returns normally.
fn assert_throws(body)
  if type(body) != "fn"
    error("test.assert_throws: body must be a fn, got {type(body)}")
  end
  let r = pcall body()
  if r.ok
    error("test.assert_throws: expected an error, but the call returned normally")
  end
  r.error
end

## Runs every case, prints PASS/FAIL lines and a `<n> passed / <m> failed` summary, exits 1 if any failed.
fn run()
  let passed = 0
  let failed = 0
  for c in cases
    let r = pcall c.body()
    if r.ok
      print("PASS {c.name}")
      passed += 1
    else
      print("FAIL {c.name}: {r.error}")
      failed += 1
    end
  end
  print("{passed} passed / {failed} failed")
  if failed > 0
    exit(1)
  end
end

export case, assert, assert_eq, assert_neq, assert_throws, run
