# std/test — minimal test harness for self-validating example programs.
#
# Register cases with test.case(name, fn). Use the assert helpers inside;
# they raise via error() on failure. test.run() executes each registered
# case under pcall, prints a one-line PASS/FAIL per case, prints a
# summary, and exits with status 1 if any case failed.
#
# Cases live in a module-level variable, which is per process: test.run()
# runs only the cases registered by the process that calls it. Register
# cases at the top level (or from main) and call test.run() there.

let cases = []

fn case(name, body)
  push(cases, {name: name, body: body})
end

fn is_identifier(s)
  if len(s) == 0
    return false
  end
  for i, ch in s
    let c = ord(ch)
    let letter = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
    if not letter and (i == 0 or c < 48 or c > 57)
      return false
    end
  end
  true
end

fn quote(s)
  let q = str_replace(s, "\\", "\\\\")
  q = str_replace(q, "\"", "\\\"")
  q = str_replace(q, "\n", "\\n")
  q = str_replace(q, "\r", "\\r")
  q = str_replace(q, "\t", "\\t")
  q = str_replace(q, "\0", "\\0")
  "\"{q}\""
end

fn show(v)
  if type(v) == "string"
    return quote(v)
  end
  to_string(v)
end

# Shows a differing pair so the two sides never read the same: the types
# are added when they differ (1 vs 1.0), and a pair that prints the same
# (two different functions) says so.
fn show_pair(expected, actual)
  let e = show(expected)
  let a = show(actual)
  if type(expected) != type(actual)
    return "expected {e} ({type(expected)}), got {a} ({type(actual)})"
  end
  if e == a
    return "expected {e}, got a different {type(actual)} {a}"
  end
  "expected {e}, got {a}"
end

fn key_step(k)
  if type(k) == "string" and is_identifier(k)
    return ".{k}"
  end
  "[{show(k)}]"
end

# The path to key `k` of the table on top of `stack`, such as `.a[1]`.
# Built only for a failure message: every frame but the root holds the key
# it was reached by.
fn path_to(stack, k)
  build_string do |add|
    for i, f in stack
      if i > 0
        add(key_step(f.key))
      end
    end
    add(key_step(k))
  end
end

# True when the pair (expected, actual) repeats one already being compared
# further up the path, which happens only for cyclic structures. Up to
# depth 32 every ancestor is checked; deeper, only the ancestor at the
# largest power of two not above the depth (Brent's cycle check), so a
# deep acyclic structure costs O(1) per table and a cycle is still caught
# within a few laps of it.
fn on_path(stack, expected, actual)
  let depth = len(stack)
  if depth <= 32
    for f in stack
      if f.expected == expected and f.actual == actual
        return true
      end
    end
    return false
  end
  let p = 32
  while p * 2 <= depth
    p = p * 2
  end
  let f = stack[p - 1]
  f.expected == expected and f.actual == actual
end

# Structural comparison. Returns nil when `actual` deeply equals
# `expected`, else a description of the first difference. Non-tables
# compare with `==` (so 1 and 1.0 differ); tables are equal when they have
# the same keys with deeply equal values, in any insertion order. The walk
# uses an explicit stack, so nesting depth doesn't touch the C stack, and
# a pair of tables that repeats one further up the path counts as equal
# (see on_path), so cyclic structures terminate.
fn diff(actual, expected)
  if type(actual) != "table" or type(expected) != "table"
    if actual == expected
      return nil
    end
    return show_pair(expected, actual)
  end
  let stack = []
  if actual != expected
    push(stack, {expected: expected, actual: actual, key: nil, ks: keys(expected), i: 0})
  end
  while len(stack) > 0
    let f = stack[-1]
    if f.i == len(f.ks)
      if len(f.actual) != len(f.expected)
        for k in keys(f.actual)
          if not has_key(f.expected, k)
            return "actual has extra key {path_to(stack, k)}"
          end
        end
      end
      pop(stack)
    else
      let k = f.ks[f.i]
      f.i = f.i + 1
      if not has_key(f.actual, k)
        return "actual is missing key {path_to(stack, k)}"
      end
      let e = f.expected[k]
      let a = f.actual[k]
      if type(e) == "table" and type(a) == "table"
        if e != a and not on_path(stack, e, a)
          push(stack, {expected: e, actual: a, key: k, ks: keys(e), i: 0})
        end
      elif e != a
        return "at {path_to(stack, k)}, {show_pair(e, a)}"
      end
    end
  end
  nil
end

fn assert(cond, msg = nil)
  if not cond
    if msg == nil
      error("test.assert: assertion failed")
    end
    error("test.assert: assertion failed: {msg}")
  end
end

fn assert_eq(actual, expected)
  let d = diff(actual, expected)
  if d == nil
    return nil
  end
  if type(actual) == "table" and type(expected) == "table"
    error("test.assert_eq: expected {show(expected)}, got {show(actual)}: {d}")
  end
  error("test.assert_eq: {d}")
end

fn assert_neq(actual, expected)
  if diff(actual, expected) == nil
    error("test.assert_neq: both values are {show(actual)}")
  end
end

# Returns the error message, so a case can check it.
fn assert_throws(body)
  let r = pcall body()
  if r.ok
    error("test.assert_throws: expected an error, but the call returned normally")
  end
  r.error
end

fn run()
  let passed = 0
  let failed = 0
  for c in cases
    let r = pcall c.body()
    if r.ok
      print("PASS {c.name}")
      passed += 1
    else
      print("FAIL {c.name}: {r.error}")
      failed += 1
    end
  end
  print("{passed} passed / {failed} failed")
  if failed > 0
    exit(1)
  end
end

export case, assert, assert_eq, assert_neq, assert_throws, run
