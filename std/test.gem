## test — a minimal harness for self-checking programs.
##
##   load "std/test"
##   test.case("adds") do
##     test.assert_eq(1 + 1, 2)
##   end
##   test.run()    # PASS adds / 1 passed / 0 failed
##
## The assert functions raise with `error()` on failure, with a message
## that starts `test.<fn>: `. `run` catches that per case. Cases are
## module state, so they are per process: a spawned process starts with a
## copy of the cases its parent had registered at the spawn, and cases it
## registers stay in that process. Register cases at the top level (or
## from main) and call `run` there.

let cases = []

## Registers a test case: `body` is called with no arguments by `run`,
## after the cases registered before it. A duplicate `name` is allowed;
## both cases run.
fn case(name, body)
  push(cases, {name: name, body: body})
end

fn is_identifier(s)
  if len(s) == 0
    return false
  end
  for i, ch in s
    let c = ord(ch)
    let letter = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
    if not letter and (i == 0 or c < 48 or c > 57)
      return false
    end
  end
  true
end

fn quote(s)
  let q = str_replace(s, "\\", "\\\\")
  q = str_replace(q, "\"", "\\\"")
  q = str_replace(q, "\n", "\\n")
  q = str_replace(q, "\r", "\\r")
  q = str_replace(q, "\t", "\\t")
  q = str_replace(q, "\0", "\\0")
  "\"{q}\""
end

fn show(v)
  if type(v) == "string"
    return quote(v)
  end
  to_string(v)
end

# Shows a differing pair so the two sides never read the same: the types
# are added when they differ (1 vs 1.0), and a pair that prints the same
# (two different functions) says so.
fn show_pair(expected, actual)
  let e = show(expected)
  let a = show(actual)
  if type(expected) != type(actual)
    return "expected {e} ({type(expected)}), got {a} ({type(actual)})"
  end
  if e == a
    return "expected {e}, got a different {type(actual)} {a}"
  end
  "expected {e}, got {a}"
end

fn key_step(k)
  if type(k) == "string" and is_identifier(k)
    return ".{k}"
  end
  "[{show(k)}]"
end

# The identity of a table as an int (runtime/gem_core.c). Tables as table
# keys are found by a linear scan, so the comparison memo below is keyed
# by a string of two ids instead. An id is stable while the comparison
# runs: the tables compared are all older than its loop, and a region
# reset only moves what was allocated since the loop started.
extern fn gem_table_id(t: Table) -> Int

# The path to key `k` of node `n` (see diff), such as `.a[1]`. Built only
# for a failure message.
fn path_to(nodes, n, k)
  let steps = [key_step(k)]
  let i = n
  while nodes.parent[i] >= 0
    push(steps, key_step(nodes.key[i]))
    i = nodes.parent[i]
  end
  build_string do |add|
    let j = len(steps) - 1
    while j >= 0
      add(steps[j])
      j -= 1
    end
  end
end

fn failure(nodes, kind, e, a, key, n)
  if kind == "missing"
    return "actual is missing key {path_to(nodes, n, key)}"
  end
  if kind == "extra"
    for k, v in a
      if not has_key(e, k)
        return "actual has extra key {path_to(nodes, n, k)}"
      end
    end
  end
  "at {path_to(nodes, n, key)}, {show_pair(e, a)}"
end

# Structural comparison. Returns nil when `actual` deeply equals
# `expected`, else a description of the first difference.
#
# The walk is depth first over an explicit work stack, so nesting depth
# doesn't touch the C stack. A pair of tables met again (a shared
# subtable, or a cycle) counts as equal, since it is either being compared
# further up or already proven equal: `seen` holds the pairs already
# expanded, so each is expanded once and the cost is O(pairs x keys) for
# any graph, cyclic or not. Expanding a pair pushes, in key order, its
# subtable pairs and its first scalar difference, if any, as a failure
# entry; a failure is reported when it reaches the top, after the
# subtables before it, so the difference reported is the first one in key
# order.
#
# The work stack is five parallel arrays rather than an array of records,
# and the memo skips small flat pairs: the loop's per-iteration arena
# reset copies whatever of them is live, and records made it several
# times slower on a large array of small tables.
fn diff(actual, expected)
  if type(actual) != "table" or type(expected) != "table"
    if actual == expected
      return nil
    end
    return show_pair(expected, actual)
  end
  if actual == expected
    return nil
  end
  let seen = {}
  # One node per expanded pair that pushed work, for failure paths: the
  # key the pair was reached by and the node it was reached from (-1 at
  # the root).
  let node_key = []
  let node_parent = []
  # Work entries: a pair of tables to compare (kind "") or a failure to
  # report ("missing", "extra" or "value") for the pair of node `parent`.
  let w_kind = [""]
  let w_e = [expected]
  let w_a = [actual]
  let w_key = [""]
  let w_parent = [-1]
  while len(w_e) > 0
    let kind = pop(w_kind)
    let e = pop(w_e)
    let a = pop(w_a)
    let key = pop(w_key)
    let parent = pop(w_parent)
    if kind != ""
      return failure({key: node_key, parent: node_parent}, kind, e, a, key, parent)
    end
    let id = "{gem_table_id(e)} {gem_table_id(a)}"
    if not has_key(seen, id)
      let n = len(node_key)
      let base = len(w_e)
      # An extra key is reported after everything else in the pair.
      if len(a) != len(e)
        push(w_kind, "extra")
        push(w_e, e)
        push(w_a, a)
        push(w_key, "")
        push(w_parent, n)
      end
      let first = len(w_e)
      for k, ev in e
        let av = a[k]
        let missing = av == nil and not has_key(a, k)
        let both = type(ev) == "table" and type(av) == "table"
        if both and ev != av and small_flat_equal(ev, av)
          continue
        end
        if missing or ev != av
          if missing
            push(w_kind, "missing")
          elif both
            push(w_kind, "")
          else
            push(w_kind, "value")
          end
          push(w_e, ev)
          push(w_a, av)
          push(w_key, k)
          push(w_parent, n)
          if not both
            break
          end
        end
      end
      if len(w_e) > base
        push(node_key, key)
        push(node_parent, parent)
      end
      # Comparing a small flat pair again costs about as much as finding
      # it in `seen`, so only pairs with subtables or more keys are kept.
      if len(w_e) > first or len(e) > 8
        seen[id] = true
      end
      # Reverse what was pushed, so the first key is on top.
      let i = first
      let j = len(w_e) - 1
      while i < j
        swap(w_kind, i, j)
        swap(w_e, i, j)
        swap(w_a, i, j)
        swap(w_key, i, j)
        swap(w_parent, i, j)
        i += 1
        j -= 1
      end
    end
  end
  nil
end

# True when `e` and `a` are small tables of the same keys with equal
# values none of which is a table: diff settles such a pair (an array of
# small records) where it meets it, without pushing it. Anything else,
# including any difference, goes through the work stack, which finds the
# difference again in order.
fn small_flat_equal(e, a)
  if len(e) > 8 or len(e) != len(a)
    return false
  end
  for k, ev in e
    let av = a[k]
    if type(ev) == "table" or ev != av or (av == nil and not has_key(a, k))
      return false
    end
  end
  true
end

fn swap(arr, i, j)
  let t = arr[i]
  arr[i] = arr[j]
  arr[j] = t
end

## Raises "test.assert: assertion failed", plus ": <msg>" when `msg` is
## given, unless `cond` is truthy. Only `nil` and `false` fail.
fn assert(cond, msg = nil)
  if not cond
    if msg == nil
      error("test.assert: assertion failed")
    end
    error("test.assert: assertion failed: {msg}")
  end
end

## Raises unless `actual` deeply equals `expected`, and returns nil.
##
## Non-tables compare with `==`, so 1 and 1.0 differ. Tables are equal
## when they have the same keys with deeply equal values, in any
## insertion order; shared and cyclic tables are fine. A key holding nil
## counts (`{a: 1}` and `{a: 1, b: nil}` differ), `[]` equals `{}`, and two
## different fns are unequal. The message shows
## both values and the first difference, with its path:
##
##   test.assert_eq({a: [1, 2]}, {a: [1, 3]})
##   # test.assert_eq: expected {a: [1, 3]}, got {a: [1, 2]}: at .a[1], expected 3, got 2
fn assert_eq(actual, expected)
  let d = diff(actual, expected)
  if d == nil
    return nil
  end
  if type(actual) == "table" and type(expected) == "table"
    error("test.assert_eq: expected {show(expected)}, got {show(actual)}: {d}")
  end
  error("test.assert_eq: {d}")
end

## Raises when `actual` deeply equals `expected` (as `assert_eq` compares
## them).
fn assert_neq(actual, expected)
  if diff(actual, expected) == nil
    error("test.assert_neq: both values are {show(actual)}")
  end
end

## Calls `body()` and returns the message of the error it raised, so a
## case can check it. Raises if `body` returns normally, and
## `test.assert_throws: body must be a fn, got <type>` when it isn't a fn.
##
##   let msg = test.assert_throws(fn() error("bad") end)    # "bad"
##
## An error raised with a non-string value comes back as pcall reports
## it: `error({code: 1})` gives the string "error".
fn assert_throws(body)
  if type(body) != "fn"
    error("test.assert_throws: body must be a fn, got {type(body)}")
  end
  let r = pcall body()
  if r.ok
    error("test.assert_throws: expected an error, but the call returned normally")
  end
  r.error
end

## Runs every registered case, prints `PASS <name>` or
## `FAIL <name>: <error>` for each and then `<n> passed / <m> failed` on
## stdout, and exits the program with status 1 if any case failed (the
## whole program, even when called from a spawned process).
## Otherwise it returns nil; the cases stay registered, so a second call
## runs them again. A failing assert ends its case at once, skipping any
## cleanup after it, and a FAIL line shows only the message, not the
## file or line: pass `msg` to `assert` or keep cases small.
fn run()
  let passed = 0
  let failed = 0
  for c in cases
    let r = pcall c.body()
    if r.ok
      print("PASS {c.name}")
      passed += 1
    else
      print("FAIL {c.name}: {r.error}")
      failed += 1
    end
  end
  print("{passed} passed / {failed} failed")
  if failed > 0
    exit(1)
  end
end

export case, assert, assert_eq, assert_neq, assert_throws, run
