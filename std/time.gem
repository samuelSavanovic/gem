# time — wall-clock time as epoch milliseconds, and formatting it.
#
#   let started = time.now()
#   print("up since {time.iso8601(started)}")     # 2026-04-28T14:30:00Z
#   print(time.format(started, "%H:%M:%S"))
#
# Times are ints: milliseconds since 1970-01-01T00:00:00Z (negative before
# it). Formatting drops the milliseconds, rounding down. `fmt` takes
# `strftime` specifiers (`%Y-%m-%d %H:%M:%S`). For measuring durations
# use the `time_ms()` builtin, which a change of the system clock can't
# move.

fn now()
  epoch_ms()
end

# `ms` formatted in UTC.
fn format(ms, fmt)
  format_time(ms, fmt)
end

# `ms` formatted in the machine's local time zone.
fn format_local(ms, fmt)
  format_time_local(ms, fmt)
end

# "Tue, 28 Apr 2026 14:30:00 GMT" (RFC 7231, for HTTP headers).
fn http_date(ms = epoch_ms())
  format_time(ms, "%a, %d %b %Y %H:%M:%S GMT")
end

# "2026-04-28T14:30:00Z"
fn iso8601(ms = epoch_ms())
  format_time(ms, "%Y-%m-%dT%H:%M:%SZ")
end

# "2026-04-28"
fn date(ms = epoch_ms())
  format_time(ms, "%Y-%m-%d")
end

export now, format, format_local, http_date, iso8601, date
