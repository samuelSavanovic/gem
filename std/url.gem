## url — percent-encoding, query strings and request targets.
##
##   load "std/url"
##   url.encode("a b/é")                     # "a%20b%2F%C3%A9"
##   url.decode("a%20b+c")                   # "a b c"
##   let u = url.parse("/search?q=gem&page=2")
##   u.path                                  # "/search"
##   u.query.page                            # "2" (values are strings)
##   url.build_query({q: "a b", page: 2})    # "q=a%20b&page=2"
##
## Strings are bytes, so UTF-8 text encodes byte by byte. A buffer works
## wherever a string does. An argument of the wrong type raises
## `url.<fn>: <arg> must be a string, got <type>` (`... must be a table`
## for `build_query`).

load "std/string"

# The string to work on: a string, or a buffer's contents.
fn text(fname, what, v)
  let t = type(v)
  if t == "string"
    return v
  end
  if t == "buffer"
    return to_string(v)
  end
  error("url.{fname}: {what} must be a string, got {t}")
end

# RFC 3986 unreserved: A-Z a-z 0-9 - _ . ~
fn is_unreserved(c)
  (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 95 or c == 46 or c == 126
end

fn hex_val(c)
  if c >= 48 and c <= 57
    return c - 48
  end
  if c >= 65 and c <= 70
    return c - 55
  end
  if c >= 97 and c <= 102
    return c - 87
  end
  -1
end

## Returns `s` percent-encoded: every byte except the RFC 3986
## unreserved ones (A-Z a-z 0-9 - _ . ~) becomes `%XX` in uppercase hex.
## Spaces become `%20`, not `+`, and `/` is encoded too, so the result is
## safe as one path segment or one query key or value.
##
##   url.encode("a b/é")      # "a%20b%2F%C3%A9"
##   url.encode("abc-_.~")    # "abc-_.~"
fn encode(s)
  s = text("encode", "s", s)
  let slen = len(s)
  let hex = "0123456789ABCDEF"
  let run = 0                      # start of the pending unreserved run
  let out = build_string() do |add|
    for i = 0, slen
      let c = ord(s, i)
      if not is_unreserved(c)
        if i > run
          add(substr(s, run, i - run))
        end
        add("%", hex[c / 16], hex[c % 16])
        run = i + 1
      end
    end
    if run > 0 and run < slen
      add(substr(s, run, slen - run))
    end
  end
  if run == 0
    return s
  end
  out
end

## Returns `s` with each `%XX` (either case of hex) turned back into its
## byte and each `+` into a space, as in form and query encoding; in a
## path segment `+` is literal, so don't decode paths with it. A `%` not
## followed by two hex digits is kept as it is; it never raises on
## malformed input.
##
##   url.decode("a%20b+c")    # "a b c"
##   url.decode("%2b")        # "+"
##   url.decode("100%")       # "100%"
fn decode(s)
  s = text("decode", "s", s)
  unescape(s)
end

# decode without the argument check.
fn unescape(s)
  let t = str_replace(s, "+", " ")
  let tlen = len(t)
  if len(str_replace(t, "%", "")) == tlen     # no `%`: no copy, all in C
    return t
  end
  build_string() do |add|
    let start = 0                  # first byte not yet added
    let at = string.index_of(t, "%")
    while at >= 0
      let hi = -1
      let lo = -1
      if at + 2 < tlen
        hi = hex_val(ord(t, at + 1))
        lo = hex_val(ord(t, at + 2))
      end
      if hi >= 0 and lo >= 0
        add(substr(t, start, at - start), chr(hi * 16 + lo))
        start = at + 3
        if start < tlen and ord(t, start) == 37    # adjacent `%XX`: skip the search
          at = start
        else
          at = string.index_of(t, "%", start)
        end
      else
        at = string.index_of(t, "%", at + 1)
      end
    end
    add(substr(t, start, tlen - start))
  end
end

# Add the pair s[start .. stop) (its first `=` at eq, or -1) to result.
fn add_pair(result, s, start, eq, stop)
  let key_end = stop
  let v = ""
  if eq >= 0
    key_end = eq
    v = unescape(substr(s, eq + 1, stop - eq - 1))
  end
  let k = unescape(substr(s, start, key_end - start))
  if len(k) > 0
    result[k] = v
  end
end

## Parses a query string (without its `?`) into a table of decoded keys
## and values, all strings.
##
## A pair without `=` gets the value "", a pair with an empty key is
## dropped, and a repeated key keeps its last value. Only the first `=`
## of a pair splits it. An empty `s` gives {}.
##
##   url.parse_query("a=1&b=x+y")    # {a: "1", b: "x y"}
##   url.parse_query("c&a=1&a=2")    # {c: "", a: "2"}
fn parse_query(s)
  s = text("parse_query", "s", s)
  let result = {}
  let slen = len(s)
  let start = 0                    # start of the current pair
  let eq = -1                      # the pair's first `=`, or -1
  for i = 0, slen
    let c = ord(s, i)
    if c == 38
      add_pair(result, s, start, eq, i)
      start = i + 1
      eq = -1
    elif c == 61 and eq < 0
      eq = i
    end
  end
  add_pair(result, s, start, eq, slen)
  result
end

## Returns the query string (without a `?`) for the pairs of `tbl`, in
## insertion order.
##
## Keys and values are converted with `to_string`, then `encode`d. Pairs
## whose value is nil are left out; an empty table gives "". There is no
## multi-value form: a table value is sent as its `to_string` text
## (`{tags: ["a"]}` gives `tags=%5B%22a%22%5D`); repeat the key yourself.
##
##   url.build_query({q: "a b", page: 2})    # "q=a%20b&page=2"
##   url.build_query({x: nil, y: true})      # "y=true"
fn build_query(tbl)
  if type(tbl) != "table"
    error("url.build_query: tbl must be a table, got {type(tbl)}")
  end
  let sep = ""
  build_string() do |add|
    for k, v in tbl
      if v != nil
        add(sep, encode(to_string(k)), "=", encode(to_string(v)))
        sep = "&"
      end
    end
  end
end

## Splits a request target such as "/p?q=1" into
## `{path, query_string, query}`, where `query` is
## `parse_query(query_string)`.
##
## The path is not decoded. A `#fragment` is dropped. Without a `?`,
## `query_string` is "" and `query` is {}. `target` is a path, not a full
## URL: "http://h/p" comes back whole as the path.
##
##   let u = url.parse("/search?q=gem#top")
##   u.path            # "/search"
##   u.query_string    # "q=gem"
##   u.query.q         # "gem"
fn parse(target)
  target = text("parse", "target", target)
  let tlen = len(target)
  let qmark = -1
  let stop = tlen                  # end of the target before any `#`
  for i = 0, tlen
    let c = ord(target, i)
    if c == 35
      stop = i
      break
    elif c == 63 and qmark < 0
      qmark = i
    end
  end
  if qmark < 0
    return {path: substr(target, 0, stop), query_string: "", query: {}}
  end
  let qs = substr(target, qmark + 1, stop - qmark - 1)
  {path: substr(target, 0, qmark), query_string: qs, query: parse_query(qs)}
end

export encode, decode, parse_query, build_query, parse
