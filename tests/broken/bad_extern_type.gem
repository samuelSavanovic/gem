# Extern declarations with types that cannot be marshaled: an unknown type
# name, Nil as a parameter, and a Table param and return on a blocking extern.
extern fn f(x: Foo) -> Int
extern fn g(x: Nil) -> Int
extern blocking fn h(t: Table) -> Int
extern blocking fn k(x: Int) -> Table
extern fn ok(t: Table, b: Bytes) -> Table
