# An `if`, `match` or `receive` used inside an expression: one error each,
# with the block skipped whole (seven errors).
let a = 1
print(if a > 0 then 1 else 2 end)
let b = 1 + match a
when 1 then 2
end
let c = [if true then 1 end, 2]
let d = {k: receive
when x then x
end}
let e = "{if true then 1 end}"
let f = if a > 0 then 1 else 2 end + 1
let g = match a
when 1 then {n: 1}
end.n
print(a, b, c, d, e, f, g)
