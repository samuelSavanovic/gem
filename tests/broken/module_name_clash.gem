# Two different modules can't share a namespace name in one file: a
# compile error at the second `load`. The same module again is fine.
load "std/string"
load "std/string"
load "./modules/string"
load "./modules/string" as my_string
print(string.upper("a"), my_string.upper2("b"))

# expect: module name `string` is already used by `load "std/string"`
