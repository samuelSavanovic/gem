# A pattern binds each name once; `_` may repeat.
# expect: 'x' is bound twice in this pattern
match [1, 2]
when [x, x] then print(x)
when [_, _] then print(1)
when {p, p: z} then print(z)
end
let [c, c] = [1, 2]
let {d, d} = {d: 1}
for e, e in {a: 1}
  print(e)
end
for _, _ in {a: 1}
  print(1)
end
