# libFuzzer harness for the front end: each input is lexed, parsed, lowered and folded. Bad source
# must end up as errors in the sink; anything that raises or crashes is a compiler bug, with the input
# as the repro. Run by `make fuzz-parser`.

load "../../compiler/parser" (parse_source)
load "../../compiler/lower" (lower)
load "../../compiler/fold" (fold_constants)
load "../../compiler/errors" (make_error_sink)

extern include "libfuzzer_driver.h"
extern fn gem_fuzz_main(target: Table) -> Int
extern fn gem_fuzz_abort() -> Int

fn front_end(src)
  let sink = make_error_sink()
  let ast = parse_source(src, "fuzz.gem", sink)
  if not sink.has_any()
    fold_constants(lower(ast))
  end
end

fn fuzz_one(src)
  let r = pcall front_end(src)
  if not r.ok
    eprint("parser_fuzz: internal error: {r.error}")
    for f in r.stack
      eprint("  at {f.name} ({f.file}:{f.line})")
    end
    gem_fuzz_abort()
  end
end

fn main()
  fuzz_one("let x = 1\n")
  exit(gem_fuzz_main({run: fuzz_one}))
end
